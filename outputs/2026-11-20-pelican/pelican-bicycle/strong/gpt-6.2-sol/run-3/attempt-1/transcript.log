{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/vellery_pelican_build.py <<'PY'\nfrom math import atan2, cos, hypot, pi, sin, sqrt\nfrom pathlib import Path\n\ncrank_x, crank_y = 442, 469\nradius = 29\nsteps = 24\n\ndef point(x, y):\n    return f\\\"{x:.2f} {y:.2f}\\\"\n\ndef leg_pose(phase, hip, thigh, shin):\n    angle = phase * 2 * pi\n    pedal = (crank_x + radius * cos(angle), crank_y + radius * sin(angle))\n    ankle = (pedal[0] - 6, pedal[1] - 13)\n    dx, dy = ankle[0] - hip[0], ankle[1] - hip[1]\n    distance = hypot(dx, dy)\n    along = (thigh * thigh - shin * shin + distance * distance) / (2 * distance)\n    bend = sqrt(thigh * thigh - along * along)\n    knee = (hip[0] + (along * dx + bend * dy) / distance,\n            hip[1] + (along * dy - bend * dx) / distance)\n    mid = (knee[0] + (ankle[0] - knee[0]) * 0.28,\n           knee[1] + (ankle[1] - knee[1]) * 0.28)\n    path = f\\\"M{point(*hip)} Q{point(*knee)} {point(*mid)} L{point(*ankle)}\\\"\n    return path, point(*pedal)\n\ndef leg(phase, hip, thigh, shin, outline, fill, toe, width):\n    poses = [leg_pose((i % steps) / steps + phase, hip, thigh, shin) for i in range(steps + 1)]\n    paths, pedals = zip(*poses)\n    return f\\\"\\\"\\\"\n    <g fill=\\\"none\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\">\n      <path d=\\\"{paths[0]}\\\" stroke=\\\"{outline}\\\" stroke-width=\\\"{width + 5}\\\">\n        <animate attributeName=\\\"d\\\" dur=\\\"1.32s\\\" repeatCount=\\\"indefinite\\\"\n          values=\\\"{';'.join(paths)}\\\"/>\n      </path>\n      <path d=\\\"{paths[0]}\\\" stroke=\\\"{fill}\\\" stroke-width=\\\"{width}\\\">\n        <animate attributeName=\\\"d\\\" dur=\\\"1.32s\\\" repeatCount=\\\"indefinite\\\"\n          values=\\\"{';'.join(paths)}\\\"/>\n      </path>\n    </g>\n    <g transform=\\\"translate({pedals[0]})\\\">\n      <animateTransform attributeName=\\\"transform\\\" type=\\\"translate\\\" dur=\\\"1.32s\\\"\n        repeatCount=\\\"indefinite\\\" values=\\\"{';'.join(pedals)}\\\"/>\n      <path d=\\\"M-10-15 Q-5-19-2-13 Q3-10 11-10 Q18-9 20-5\n        L16-3 20-1 Q14 0 8-2 Q0 1-7-2 L-11-6Z\\\" fill=\\\"{fill}\\\"\n        stroke=\\\"{outline}\\\" stroke-width=\\\"2.3\\\" stroke-linejoin=\\\"round\\\"/>\n      <path d=\\\"M1-7 Q8-7 15-4 M2-4Q9-3 14-2\\\" fill=\\\"none\\\" stroke=\\\"{toe}\\\"\n        stroke-width=\\\"1.4\\\" stroke-linecap=\\\"round\\\"/>\n    </g>\\\"\\\"\\\"\n\nfar_leg = leg(.5, (422, 332), 78, 85, '#935440', '#ca7548', '#ab5f43', 10)\nnear_leg = leg(0, (443, 339), 79, 86, '#98513d', '#f2a257', '#ca7246', 12)\n\nsvg = '''<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 960 640\\\" width=\\\"960\\\" height=\\\"640\\\"\n  role=\\\"img\\\" aria-labelledby=\\\"title description\\\">\n  <title id=\\\"title\\\">A pelican pedals along the coast</title>\n  <desc id=\\\"description\\\">A white pelican with an amber bill sits on a coral bicycle, gripping\n    the handlebars with a wing and pedaling as both wheels spin.</desc>\n  <defs>\n    <linearGradient id=\\\"sky\\\" x2=\\\"0\\\" y2=\\\"1\\\">\n      <stop stop-color=\\\"#c5e2df\\\"/>\n      <stop offset=\\\"1\\\" stop-color=\\\"#f4efe1\\\"/>\n    </linearGradient>\n    <linearGradient id=\\\"sea\\\" x2=\\\"0\\\" y2=\\\"1\\\">\n      <stop stop-color=\\\"#8ebbbb\\\"/>\n      <stop offset=\\\"1\\\" stop-color=\\\"#bfd6ca\\\"/>\n    </linearGradient>\n    <linearGradient id=\\\"road\\\" x2=\\\"0\\\" y2=\\\"1\\\">\n      <stop stop-color=\\\"#f6e5c6\\\"/>\n      <stop offset=\\\"1\\\" stop-color=\\\"#e5c7a0\\\"/>\n    </linearGradient>\n    <linearGradient id=\\\"plumage\\\" x2=\\\".2\\\" y2=\\\"1\\\">\n      <stop stop-color=\\\"#fff8e9\\\"/>\n      <stop offset=\\\".6\\\" stop-color=\\\"#f4efe1\\\"/>\n      <stop offset=\\\"1\\\" stop-color=\\\"#d5e0da\\\"/>\n    </linearGradient>\n    <linearGradient id=\\\"pouch\\\" x2=\\\".15\\\" y2=\\\"1\\\">\n      <stop stop-color=\\\"#f9c4