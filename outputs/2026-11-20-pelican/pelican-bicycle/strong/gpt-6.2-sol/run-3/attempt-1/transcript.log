{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/vellery_verify_pelican.py <<'PY'\nfrom math import cos, hypot, pi, sin\nfrom pathlib import Path\nimport re\nimport subprocess\nfrom xml.etree import ElementTree as ET\n\nsvg = Path('pelican.svg')\nnamespace = 'http://www.w3.org/2000/svg'\nET.register_namespace('', namespace)\ntag = lambda name: f'{{{namespace}}}{name}'\nnumber = re.compile(r'[-+]?(?:\\\\d+(?:\\\\.\\\\d*)?|\\\\.\\\\d+)')\n\ndef interpolate(left, right, amount):\n    a = tuple(float(m.group()) for m in number.finditer(left))\n    b = tuple(float(m.group()) for m in number.finditer(right))\n    assert number.sub('#', left) == number.sub('#', right)\n    values = iter(x + (y - x) * amount for x, y in zip(a, b))\n    return number.sub(lambda m: f'{next(values):.4f}', left)\n\ndef values_at(animation, time):\n    duration = float(animation.attrib['dur'].removesuffix('s'))\n    progress = (time / duration) % 1\n    values = [value.strip() for value in animation.attrib.get(\n        'values', f\\\"{animation.get('from')};{animation.get('to')}\\\").split(';')]\n    fractions = ([float(x) for x in animation.get('keyTimes').split(';')]\n                 if animation.get('keyTimes') else\n                 [i / (len(values) - 1) for i in range(len(values))])\n    index = next(i for i in range(len(fractions) - 1) if progress < fractions[i + 1])\n    return interpolate(values[index], values[index + 1],\n                       (progress - fractions[index]) / (fractions[index + 1] - fractions[index]))\n\ntree = ET.parse(svg)\nroot = tree.getroot()\nbike = root.find(f\\\".//*[@id='bicycle-and-rider']\\\")\nfeet = [bike[3], bike[-3]]\ncranks = [root.find(f\\\".//*[@id='{side}-crank']\\\") for side in ('far', 'near')]\nassert len(bike.findall(f\\\"./{tag('g')}/{tag('use')}/{tag('animateTransform')}\\\")) == 2\nassert all(animation.get('repeatCount') == 'indefinite'\n           for animation in root.iter() if 