{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"node <<'JS'\nconst { spawn } = require('node:child_process');\nconst { resolve } = require('node:path');\nconst { pathToFileURL } = require('node:url');\nconst { writeFileSync, mkdtempSync } = require('node:fs');\nconst assert = require('node:assert/strict');\n\nconst preview = mkdtempSync('/tmp/pelican-2x567b0a-browser-');\nconst chrome = spawn('/root/.cache/ms-playwright/chromium_headless_shell-1248/chrome-headless-shell-linux64/chrome-headless-shell', [\n  '--no-sandbox', '--disable-dev-shm-usage', '--remote-debugging-pipe',\n  '--allow-file-access-from-files', '--user-data-dir=' + preview, 'about:blank',\n], { stdio: ['ignore', 'ignore', 'ignore', 'pipe', 'pipe'] });\nlet nextId = 0;\nlet pending = new Map();\nlet buffer = '';\nchrome.stdio[4].on('data', chunk => {\n  buffer += chunk.toString();\n  let end;\n  while ((end = buffer.indexOf('\\\\0')) >= 0) {\n    const message = JSON.parse(buffer.slice(0, end));\n    buffer = buffer.slice(end + 1);\n    if (pending.has(message.id)) {\n      const { resolve, reject } = pending.get(message.id);\n      pending.delete(message.id);\n      if (message.error) reject(message.error);\n      else resolve(message.result);\n    }\n  }\n});\n\nfunction send(method, params = {}, sessionId) {\n  const id = ++nextId;\n  return new Promise((resolve, reject) => {\n    pending.set(id, { resolve, reject });\n    chrome.stdio[3].write(JSON.stringify({id, method, params, sessionId}) + '\\\\0');\n  });\n}\n\n(async () => {\n  const watchdog = setTimeout(() => { chrome.kill(); process.exitCode = 1; console.error('Browser test timed out'); }, 15000);\n  try {\n    const { targetInfos } = await send('Target.getTargets');\n    const { sessionId } = await send('Target.attachToTarget', {\n      targetId: targetInfos.find(target => target.type === 'page').targetId, flatten: true,\n    });\n    const page = (method, params) => send(method, params, sessionId);\n    const evaluate = async expression => {\n      const result = await page('Runtime.evaluate', { expression, returnByValue: true });\n      assert.ok(\"'!result.exceptionDetails, JSON.stringify(result.exceptionDetails));\n      return result.result.value;\n    };\n    await page('\"'Emulation.setDeviceMetricsOverride', { width: 960, height: 660, deviceScaleFactor: 1, mobile: false });\n    await page('Page.navigate', { url: pathToFileURL(resolve('pelican.svg')).href });\n    for (let i = 0; i < 40; i++) {\n      if (await evaluate(\\\"document.documentElement.localName === 'svg' && \"'!!document.getElementById('\"'near-leg')\\\")) break;\n      await new Promise(resolve => setTimeout(resolve, 75));\n    }\n\n    const poses = await evaluate(\"'`(() => {\n      const svg = document.documentElement;\n      svg.pauseAnimations();\n      const sample = time => {\n        svg.setCurrentTime(time);\n        const part = side => {\n          const pedal = document.querySelector('\"'#' + side + '-leg > g').transform.animVal.getItem(0).matrix;\n          const bone = document.getElementById(side + '-leg-bones');\n          const ankle = bone.getPointAtLength(bone.getTotalLength());\n          return [pedal.e, pedal.f, ankle.x, ankle.y];\n        };\n        const wheel = document.querySelector('#wheel > g').transform.animVal.getItem(0).angle;\n        return { points: [part('near'), part('far')], wheel };\n      };\n      return Array.from({length: 65}, (_, index) => sample(index * 1.6 / 64));\n    })()\"'`);\n    const close = (a, b, epsilon = .18) => assert.ok(Math.abs(a-b) <= epsilon, a + '\"' vs ' + b);\n    for (let index = 0; index < poses.length; index++) {\n      const { points } = poses[index];\n      for (let side = 0; side < 2; side++) {\n        const [px, py, ax, ay] = points[side];\n        const phase = (49 + side * 180 + index * 360 / 64) * Math.PI / 180;\n        close(px, 457 + 34 * Math.cos(phase), .35);\n        close(py, 496 + 34 * Math.sin(phase), .35);\n        close(ax, px - 4);\n        close(ay, py - 10);\n      }\n      close(points[0][0] + points[1][0], 914);\n      close(points[0][1] + points[1][1], 992);\n    }\n    close(poses[10].wheel, 90);\n    assert.deepEqual(poses[0].points, poses[64].points);\n\n    for (const time of [0, .275, .675]) {\n      await evaluate('document.documentElement.setCurrentTime(' + time + ')');\n      const { data } = await page('Page.captureScreenshot', { format: 'png' });\n      writeFileSync(preview + '/frame-' + time + '.png', Buffer.from(data, 'base64'));\n    }\n    console.log('Verified 65 Chromium poses, opposite pedal phases, ankle alignment, wheel rotation, and a seamless pedal loop.');\n    console.log(preview);\n  } finally {\n    clearTimeout(watchdog);\n    chrome.kill();\n  }\n})().catch(error => { console.error(error); process.exitCode = 1; });\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
