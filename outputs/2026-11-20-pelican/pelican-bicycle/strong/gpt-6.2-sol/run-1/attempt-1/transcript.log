{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom math import cos, hypot, radians, sin\nfrom pathlib import Path\nfrom xml.etree import ElementTree as ET\nfrom tempfile import TemporaryDirectory\nimport re\nimport subprocess\nfrom PIL import Image, ImageChops\n\nsvg_ns = 'http://www.w3.org/2000/svg'\nET.register_namespace('', svg_ns)\ndef tag(name):\n    return f'{{{svg_ns}}}{name}'\n\nfile = Path('pelican.svg')\nroot = ET.parse(file).getroot()\nparents = {child: parent for parent in root.iter() for child in parent}\nnodes = {node.get('id'): node for node in root.iter() if node.get('id')}\nwheel_uses = [node for node in root.iter(tag('use')) if node.get('href') == '#wheel']\nassert len(wheel_uses) == 2\nfor wheel in wheel_uses:\n    spin = wheel.find(tag('animateTransform'))\n    assert spin.get('dur') == '1s' and spin.get('repeatCount') == 'indefinite'\n    assert float(spin.get('to')) - float(spin.get('from')) == 360\n\ndef samples(source):\n    return [[float(value) for value in re.findall(r'-?\\\\d+(?:\\\\.\\\\d+)?', frame)]\n            for frame in source.split(';')]\n\nfor side in ('near', 'far'):\n    leg = nodes[f'{side}-leg-bones'].find(tag('animate'))\n    pedal = nodes[f'{side}-leg'].find(f'{tag(\\\"g\\\")}/{tag(\\\"animateTransform\\\")}')\n    assert leg.get('dur') == pedal.get('dur') == '1.6s'\n    leg_frames, pedal_frames = samples(leg.get('values')), samples(pedal.get('values'))\n    assert len(leg_frames) == len(pedal_frames) == 25\n    assert leg_frames[0] == leg_frames[-1] and pedal_frames[0] == pedal_frames[-1]\n    for frame, (pose, (x, y)) in enumerate(zip(leg_frames, pedal_frames)):\n        phase = radians(49 + (180 if side == 'far' else 0) + frame * 15)\n        assert hypot(x - (457 + 34*cos(phase)), y - (496 + 34*sin(phase))) < .08\n        assert hypot(pose[-2] - x + 4, pose[-1] - y + 10) < .001\n\ndef draw_frame(index, temp):\n    tree = ET.parse(file)\n    root = tree.getroot()\n    time = 1.6 * index / 24\n    for parent in root.iter():\n        for animation in list(parent):\n            if animation.tag not in (tag('animate'), tag('animateTransform')):\n                continue\n            values = animation.get('values')\n            duration = float(animation.get('dur').removesuffix('s'))\n            attr = animation.get('attributeName')\n            transform = animation.get('type')\n            if values and (parent.get('id', '').endswith('-leg-bones') or len(values.split(';')) == 25):\n                value = values.split(';')[index].strip()\n                parent.set(attr, f'{transform}({value})' if transform else value)\n            if animation.get('from') is not None:\n                start = samples(animation.get('from'))[0]\n                end = samples(animation.get('to'))[0]\n                fraction = (time % duration) / duration\n                value = ' '.join(str(a + (b - a)*fraction) for a, b in zip(start, end))\n                parent.set(attr, f'{transform}({value})' if transform else value)\n            parent.remove(animation)\n    frame_svg = Path(temp) / f'{index}.svg'\n    frame_png = frame_svg.with_suffix('.png')\n    tree.write(frame_svg, encoding='utf-8')\n    subprocess.run(['rsvg-convert', str(frame_svg), '-o', str(frame_png)], check=True)\n    return Image.open(frame_png).convert('RGB')\n\nwith TemporaryDirectory(prefix='pelican-2x567b0a-poses-') as temp:\n    frames = [draw_frame(i, temp) for i in (0, 6, 12, 18)]\n    for ref, frame in zip(frames, frames[1:]):\n        for box in ((180, 389, 396, 604), (573, 389, 789, 604), (350, 345, 560, 542)):\n            assert ImageChops.difference(ref.crop(box), frame.crop(box)).getbbox() is not None\n    montage = Image.new('RGB', (960, 660))\n    for i, frame in enumerate(frames):\n        montage.paste(frame.resize((480, 330), Image.Resampling.LANCZOS), ((i % 2)*480, (i // 2)*330))\n    montage.save('/tmp/pelican-2x567b0a-poses.png')\nprint('Verified both pedal and leg loops at 25 keyframes, two wheel rotations, and four rendered poses.')\nPY\nls -la\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
