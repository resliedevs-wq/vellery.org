{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nfrom math import cos, sin, radians, hypot, sqrt\nfrom textwrap import indent\n\nfile = Path(\\\"pelican.svg\\\")\nsvg = file.read_text()\ncenter_x, center_y = 457, 496\nradius = 34\nsamples = 24\n\ndef fmt(number):\n    return f\\\"{number:.1f}\\\".removesuffix(\\\".0\\\")\n\ndef point(x, y):\n    return f\\\"{fmt(x)} {fmt(y)}\\\"\n\ndef bent_leg(hip, ankle, thigh_length, shin_length):\n    dx, dy = ankle[0] - hip[0], ankle[1] - hip[1]\n    distance = hypot(dx, dy)\n    along = (thigh_length**2 + distance**2 - shin_length**2) / (2 * distance)\n    out = sqrt(thigh_length**2 - along**2)\n    knee = (hip[0] + (along * dx + out * dy) / distance,\n            hip[1] + (along * dy - out * dx) / distance)\n    return f\\\"M{point(*hip)}L{point(*knee)}L{point(*ankle)}\\\"\n\ndef leg_markup(far):\n    angle = 229 if far else 49\n    hip = (422, 341) if far else (445, 339)\n    length = (92, 98) if far else (90, 101)\n    color = \\\"#ba7752\\\" if far else \\\"#e7a05e\\\"\n    light = \\\"#e8a871\\\" if far else \\\"#ffca84\\\"\n    poses = []\n    pedals = []\n\n    for frame in range(samples + 1):\n        phase = radians(angle + frame * 360 / samples)\n        x, y = center_x + radius * cos(phase), center_y + radius * sin(phase)\n        pedals.append(point(x, y))\n        poses.append(bent_leg(hip, (x - 4, y - 10), *length))\n\n    # Reuse one animated path for the outline and the two color strokes.\n    tag = \\\"far\\\" if far else \\\"near\\\"\n    pose_values = \\\";\\\\n      \\\".join(\\\";\\\".join(poses[i:i + 4]) for i in range(0, len(poses), 4))\n    pedal_values = \\\";\\\\n      \\\".join(\\\";\\\".join(pedals[i:i + 6]) for i in range(0, len(pedals), 6))\n    far_crank = f\\\"\\\"\\\"<g transform=\\\"translate({center_x} {center_y})\\\">\n  <g transform=\\\"rotate({angle})\\\">\n    <animateTransform attributeName=\\\"transform\\\" type=\\\"rotate\\\" from=\\\"{angle}\\\" to=\\\"{angle + 360}\\\" dur=\\\"1.6s\\\" repeatCount=\\\"indefinite\\\"/>\n    <path d=\\\"M0 0H{radius}\\\" stroke=\\\"#30443a\\\" stroke-width=\\\"7\\\"/>\n    <path d=\\\"M2 0h29\\\" stroke=\\\"#a1916e\\\" stroke-width=\\\"2.8\\\"/>\n  </g>\n</g>\n\\\"\\\"\\\" if far else \\\"\\\"\n    return far_crank + f\\\"\\\"\\\"<g id=\\\"{tag}-leg\\\">\n  <defs>\n    <path id=\\\"{tag}-leg-bones\\\" d=\\\"{poses[0]}\\\">\n      <animate attributeName=\\\"d\\\" dur=\\\"1.6s\\\" repeatCount=\\\"indefinite\\\" values=\\\"\n      {pose_values}\\\"/>\n    </path>\n  </defs>\n  <use href=\\\"#{tag}-leg-bones\\\" fill=\\\"none\\\" stroke=\\\"#513d33\\\" stroke-width=\\\"15\\\"/>\n  <use href=\\\"#{tag}-leg-bones\\\" fill=\\\"none\\\" stroke=\\\"{color}\\\" stroke-width=\\\"10\\\"/>\n  <use href=\\\"#{tag}-leg-bones\\\" transform=\\\"translate(-2 -1)\\\" fill=\\\"none\\\" stroke=\\\"{light}\\\" stroke-width=\\\"2.5\\\"/>\n  <g transform=\\\"translate({pedals[0]})\\\" color=\\\"{color}\\\">\n    <animateTransform attributeName=\\\"transform\\\" type=\\\"translate\\\" dur=\\\"1.6s\\\" repeatCount=\\\"indefinite\\\" values=\\\"\n      {pedal_values}\\\"/>\n    <use href=\\\"#pedal\\\"/>\n    <use href=\\\"#foot\\\"/>\n  </g>\n</g>\\\"\\\"\\\"\n\nfor label in (\\\"FAR\\\", \\\"NEAR\\\"):\n    svg = svg.replace(f\\\"      <\"'!-- {label}_LEG -->\", indent(leg_markup(label == \"FAR\"), \"      \"))\nsvg = svg.replace('\"'<g>\\\\n          <animateTransform attributeName=\\\"transform\\\" type=\\\"rotate\\\" from=\\\"49\\\"', '<g transform=\\\"rotate(49)\\\">\\\\n          <animateTransform attributeName=\\\"transform\\\" type=\\\"rotate\\\" from=\\\"49\\\"')\nfile.write_text(svg)\nPY\nrsvg-convert pelican.svg -o /tmp/pelican-2x567b0a-preview.png\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
