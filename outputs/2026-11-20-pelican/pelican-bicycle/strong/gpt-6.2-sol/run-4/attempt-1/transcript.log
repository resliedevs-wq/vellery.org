{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/pelican-motion.py <<'PY'\nfrom math import cos, hypot, pi, sin, sqrt\nfrom pathlib import Path\n\nfile = Path(\\\"pelican.svg\\\")\nsvg = file.read_text()\nsteps = 32\nduration = \\\"1.42s\\\"\n\ndef point(x, y):\n    return f\\\"{x:.2f} {y:.2f}\\\"\n\nfor side, phase, hip, upper, lower in (\n    (\\\"far\\\", 220, (407, 282), 98, 103),\n    (\\\"near\\\", 40, (439, 285), 100, 103),\n):\n    pedal_points = []\n    leg_paths = []\n    for step in range(steps):\n        angle = (phase / 360 + step / steps) * 2 * pi\n        pedal_x = 451 + 40 * cos(angle)\n        pedal_y = 458 + 40 * sin(angle)\n        ankle_x, ankle_y = pedal_x - 8, pedal_y - 12\n        dx, dy = ankle_x - hip[0], ankle_y - hip[1]\n        distance = hypot(dx, dy)\n        projection = (upper**2 - lower**2 + distance**2) / (2 * distance)\n        offset = sqrt(upper**2 - projection**2)\n        knee_x = hip[0] + (dx * projection + dy * offset) / distance\n        knee_y = hip[1] + (dy * projection - dx * offset) / distance\n        before_x = .88 * knee_x + .12 * hip[0]\n        before_y = .88 * knee_y + .12 * hip[1]\n        after_x = .87 * knee_x + .13 * ankle_x\n        after_y = .87 * knee_y + .13 * ankle_y\n        pedal_points.append(point(pedal_x, pedal_y))\n        leg_paths.append(\n            f\\\"M{point(*hip)} L{point(before_x, before_y)} \\\"\n            f\\\"Q{point(knee_x, knee_y)} {point(after_x, after_y)} L{point(ankle_x, ankle_y)}\\\"\n        )\n    pedal_points.append(pedal_points[0])\n    leg_paths.append(leg_paths[0])\n\n    label = side.upper()\n    svg = svg.replace(f\\\"@{label}_POINT@\\\", pedal_points[0])\n    svg = svg.replace(\n        f\\\"@{label}_PEDAL_ANIM@\\\",\n        f'<animateTransform attributeName=\\\"transform\\\" type=\\\"translate\\\" dur=\\\"{duration}\\\" repeatCount=\\\"indefinite\\\"\\\\n'\n        f'      values=\\\"{\\\"; \\\".join(pedal_points)}\\\"/>',\n    )\n    keyframes = \\\";\\\\n              \\\".join(leg_paths)\n    svg = svg.replace(\n        f'    <path id=\\\"{side}-leg-outline\\\" d=\\\"@{label}_D@\\\"',\n        f'    <use href=\\\"#{side}-leg-path\\\"',\n    ).replace(\n        f'    <path id=\\\"{side}-leg-color\\\" d=\\\"@{label}_D@\\\"',\n        f'    <use href=\\\"#{side}-leg-path\\\"',\n    ).replace(\n        f'    <path id=\\\"{side}-leg-light\\\" d=\\\"@{label}_D@\\\"',\n        f'    <use href=\\\"#{side}-leg-path\\\"',\n    ).replace(\n        f'    @{label}_LEG_ANIM@\\\\n', \\\"\\\",\n    )\n    definition = (\n        f'    <path id=\\\"{side}-leg-path\\\" d=\\\"{leg_paths[0]}\\\">\\\\n'\n        f'      <animate attributeName=\\\"d\\\" dur=\\\"{duration}\\\" repeatCount=\\\"indefinite\\\"\\\\n'\n        f'        values=\\\"{keyframes}\\\"/>\\\\n'\n        f'    </path>\\\\n'\n    )\n    svg = svg.replace(\\\"  </defs>\\\", f\\\"{definition}  </defs>\\\")\n\nassert \\\"@\\\" not in svg\nfile.write_text(svg)\nPY\npython3 /tmp/pelican-motion.py\nrsvg-convert pelican.svg -o /tmp/pelican-preview.png\nfind /root/.cache/ms-playwright -maxdepth 4 -type f -name 'chrome*' -print\nnode -p 'process.version + \\\" \\\" + typeof WebSocket'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
