{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/check-pelican.py <<'PY'\nimport math\nimport re\nimport subprocess\nfrom pathlib import Path\nfrom xml.etree import ElementTree as ET\n\nsvg = 'http://www.w3.org/2000/svg'\nET.register_namespace('', svg)\nsource = Path('pelican.svg')\nnumber = re.compile(r'[-+]?(?:\\\\d*\\\\.\\\\d+|\\\\d+\\\\.?\\\\d*)')\n\ndef values(text):\n    return [float(piece) for piece in number.findall(text)]\n\ndef sample(animation, time):\n    if animation.get('values'):\n        keys = animation.get('values').split(';')\n    else:\n        keys = [animation.get('from'), animation.get('to')]\n    times = animation.get('keyTimes')\n    times = [float(t) for t in times.split(';')] if times else [i / (len(keys) - 1) for i in range(len(keys))]\n    progress = (time / float(animation.get('dur')[:-1])) % 1\n    index = next(i for i in range(len(times) - 1) if times[i + 1] >= progress)\n    fraction = (progress - times[index]) / (times[index + 1] - times[index])\n    first, second = keys[index:index + 2]\n    assert number.sub('#', first).strip() == number.sub('#', second).strip(), (first, second)\n    start = values(first)\n    finish = values(second)\n    interpolated = iter(a + (b - a) * fraction for a, b in zip(start, finish))\n    return number.sub(lambda match: f'{next(interpolated):.5f}', first).strip()\n\nroot = ET.parse(source).getroot()\nassert root.tag == f'{{{svg}}}svg'\nids = {element.get('id'): element for element in root.iter() if element.get('id')}\nanimations = []\nfor element in root.iter():\n    if 'href' in element.attrib:\n        assert element.attrib['href'][1:] in ids\n    for child in element:\n        if child.tag in [f'{{{svg}}}animate', f'{{{svg}}}animateTransform']:\n            animations.append((element, child))\nassert len(animations) == 14, len(animations)\nrider = [(el, anim) for el, anim in animations if el.tag.endswith('}g') and anim.get('dur') == '1.42s']\nleg_animations = [ids[f'{side}-leg-path'][0] for side in ['far', 'near']]\nmax_crank_error = 0\nmax_ankle_error = 0\nfor i in range(400):\n    time = 1.42 * i / 400\n    for index in range(2):\n        crank = rider[index * 2][1]\n        pedal = rider[index * 2 + 1][1]\n        angle = math.radians(values(sample(crank, time))[0])\n        pedal_x, pedal_y = values(sample(pedal, time))\n        ankle_x, ankle_y = values(sample(leg_animations[index], time))[-2:]\n        max_crank_error = max(\n            max_crank_error, math.hypot(451 + 40 * math.cos(angle) - pedal_x, 458 + 40 * math.sin(angle) - pedal_y)\n        )\n        max_ankle_error = max(max_ankle_error, math.hypot(ankle_x - pedal_x + 8, ankle_y - pedal_y + 12))\nassert max_crank_error < .20, max_crank_error\nassert max_ankle_error < .001, max_ankle_error\n\nfor i, time in enumerate([0, .355, .71, 1.065]):\n    frame = ET.parse(source)\n    for element in frame.getroot().iter():\n        for child in list(element):\n            if child.tag not in [f'{{{svg}}}animate', f'{{{svg}}}animateTransform']:\n                continue\n            value = sample(child, time)\n            attribute = child.get('attributeName')\n            if child.get('type'):\n                value = f\\\"{child.get('type')}({value})\\\"\n            element.set(attribute, value)\n            element.remove(child)\n    frame_path = Path(f'/tmp/pelican-frame-{i}.svg')\n    frame.write(frame_path, encoding='unicode')\n    subprocess.run(['rsvg-convert', str(frame_path), '-o', f'/tmp/pelican-frame-{i}.png'], check=True)\n\nprint(f'{len(animations)} animation tracks, crank alignment within {max_crank_error:.2f}px, ankle alignment within .001px')\nPY\npython3 /tmp/check-pelican.py\nls -l pelican.svg\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
