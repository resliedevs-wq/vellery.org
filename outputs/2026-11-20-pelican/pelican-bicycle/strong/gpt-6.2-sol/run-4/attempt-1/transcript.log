{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/verify-pelican.cjs <<'JS'\nconst { chromium } = require('/tmp/wr/node_modules/playwright');\nconst assert = require('node:assert/strict');\n\n(async () => {\n  const browser = await chromium.launch({\n    executablePath: '/root/.cache/ms-playwright/chromium_headless_shell-1248/chrome-headless-shell-linux64/chrome-headless-shell',\n    args: ['--no-sandbox'],\n  });\n  try {\n    const page = await browser.newPage({ viewport: { width: 960, height: 640 }, reducedMotion: 'no-preference' });\n    const issues = [];\n    page.on('pageerror', error => issues.push(error.message));\n    page.on('console', message => {\n      if (message.type() === 'error') issues.push(message.text());\n    });\n    await page.goto('file:///tmp/vellery-k5ia69az/work/pelican.svg');\n    const result = await page.evaluate(() => {\n      const svg = document.documentElement;\n      svg.pauseAnimations();\n      const pedalTransforms = [...document.querySelectorAll('g > animateTransform')].filter(\n        element => element.getAttribute('dur') === '1.42s'\n      );\n      const [farCrank, farPedal, nearCrank, nearPedal] = pedalTransforms;\n      const wheel = document.querySelector('#wheel > use');\n      let crankError = 0;\n      let ankleError = 0;\n      const getMatrix = element => element.transform.animVal.getItem(0).matrix;\n      for (let i = 0; i < 200; i += 1) {\n        svg.setCurrentTime((i / 200) * 1.42);\n        for (const [crank, pedal, leg] of [\n          [farCrank, farPedal, document.querySelector('#far-leg-path')],\n          [nearCrank, nearPedal, document.querySelector('#near-leg-path')],\n        ]) {\n          const crankTip = new DOMPoint(40, 0).matrixTransform(getMatrix(crank.parentElement));\n          const platform = getMatrix(pedal.parentElement);\n          const ankle = leg.getPointAtLength(leg.getTotalLength());\n          crankError = Math.max(\n            crankError,\n            Math.hypot(platform.e - 451 - crankTip.x, platform.f - 458 - crankTip.y)\n          );\n          ankleError = Math.max(ankleError, Math.hypot(ankle.x - platform.e + 8, ankle.y - platform.f + 12));\n        }\n      }\n      svg.setCurrentTime(0);\n      const wheelAtStart = getMatrix(wheel).a;\n      svg.setCurrentTime(.215);\n      const wheelAtQuarterTurn = getMatrix(wheel).a;\n      return { crankError, ankleError, wheelAtStart, wheelAtQuarterTurn };\n    });\n    for (const [index, time] of [0, .355, .71, 1.065].entries()) {\n      await page.evaluate(seconds => document.documentElement.setCurrentTime(seconds), time);\n      await page.screenshot({ path: \"'`/tmp/pelican-frame-${index}.png` });\n    }\n    assert.deepEqual(issues, []);\n    assert.ok(result.crankError < .23, JSON.stringify(result));\n    assert.ok(result.ankleError < .02, JSON.stringify(result));\n    assert.ok(Math.abs(result.wheelAtStart - 1) < .0001, JSON.stringify(result));\n    assert.ok(Math.abs(result.wheelAtQuarterTurn) < .001, JSON.stringify(result));\n    console.log(JSON.stringify(result));\n  } finally {\n    await browser.close();\n  }\n})().catch(error => {\n  console.error(error);\n  process.exitCode = 1;\n});\nJS\nnode /tmp/verify-pelican.cjs'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
