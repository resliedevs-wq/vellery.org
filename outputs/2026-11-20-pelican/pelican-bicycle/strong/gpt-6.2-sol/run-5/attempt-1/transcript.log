ill=\"none\" stroke=\"#b9674c\" stroke-width=\"1.5\" stroke-linecap=\"round\" opacity=\".8\"/>\n      <path d=\"M609 204c22-3 41 1 58 5l139 19c8 1 13 5 12 10-1 5-5 8-10 8 1-5-2-7-10-7-72 5-127 6-157 0-12-3-23-7-33-12-6-3-6-19 1-23Z\" fill=\"url(#bill)\" stroke=\"#593e38\" stroke-width=\"3\" stroke-linejoin=\"round\"/>\n      <path d=\"M623 211c10-2 27 1 40 4l123 15\" fill=\"none\" stroke=\"#ffedab\" stroke-width=\"2.9\" stroke-linecap=\"round\"/>\n      <path d=\"M620 226q10 4 22 6m134 6 24-1m-177-20 7 1\" fill=\"none\" stroke=\"#885341\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n      <path d=\"M533 192c10-11 29-22 46-23m-49 36q6-11 17-19m-5 9q11-10 21-13\" fill=\"none\" stroke=\"#fff9e3\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n      <circle cx=\"593\" cy=\"207\" r=\"10\" fill=\"#ac6550\"/>\n      <circle cx=\"593\" cy=\"207\" r=\"7.2\" fill=\"#fff3be\"/>\n      <g>\n        <animateTransform attributeName=\"transform\" type=\"translate\" values=\"0 0;0 0;0 0\" dur=\"4.7s\" repeatCount=\"indefinite\"/>\n        <ellipse cx=\"594.5\" cy=\"207\" rx=\"4.7\" ry=\"5.3\" fill=\"#243939\">\n          <animate attributeName=\"ry\" values=\"5.3;5.3;.45;5.3;5.3\" keyTimes=\"0;.68;.694;.713;1\" dur=\"4.7s\" repeatCount=\"indefinite\"/>\n        </ellipse>\n        <circle cx=\"596\" cy=\"205.2\" r=\"1.35\" fill=\"#fff8dd\">\n          <animate attributeName=\"opacity\" values=\"1;1;0;1;1\" keyTimes=\"0;.68;.694;.713;1\" dur=\"4.7s\" repeatCount=\"indefinite\"/>\n        </circle>\n      </g>\n    </g>\n\n    <!-- The near wing rests on the handlebar and covers the top of the leg. -->\n    <path d=\"M493 288c22 0 34 13 50 26 19 15 38 22 65 29 15 4 27 9 46 8 10-1 23-5 29 0 7 5 2 12-4 17-2 6-6 10-13 11-7 1-14 2-22-1-55 11-100-10-128-17-31-1-68-6-81-28-6-12 0-26 13-34 12-8 30-12 45-11Z\" fill=\"#465b5a\" stroke=\"#313f3e\" stroke-width=\"3.2\" stroke-linejoin=\"round\"/>\n    <path d=\"M489 291c25 2 40 19 53 30 20 15 44 22 64 27l34 9c-23 6-56 1-84-6l-30-7c-24 6-4