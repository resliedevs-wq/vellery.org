{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/vellery-2uye3_7k/pelican-generate.py <<'PY'\nfrom math import cos, hypot, pi, sin, sqrt\nfrom pathlib import Path\n\nwork = Path(\\\"/tmp/vellery-2uye3_7k\\\")\nsvg = (work / \\\"pelican-layout.svg\\\").read_text()\nduration = \\\"1.42s\\\"\nsteps = 40\n\n\ndef point(x, y):\n    return round(x, 2), round(y, 2)\n\n\ndef offset(position, direction, distance):\n    return (position[0] + direction[0] * distance,\n            position[1] + direction[1] * distance)\n\n\ndef unit(start, end):\n    difference = end[0] - start[0], end[1] - start[1]\n    distance = hypot(*difference)\n    return difference[0] / distance, difference[1] / distance\n\n\ndef normal(direction):\n    return direction[1], -direction[0]\n\n\ndef path_point(position):\n    return \\\" \\\".join(f\\\"{value:.2f}\\\".rstrip(\\\"0\\\").rstrip(\\\".\\\") for value in position)\n\n\ndef poses(hip, angle, thigh, shin):\n    for frame in range(steps + 1):\n        phase = angle + 2 * pi * (frame % steps) / steps\n        pedal = point(533 + 36 * cos(phase), 552 + 36 * sin(phase))\n        ankle = pedal[0] - 9, pedal[1] - 9\n        hx, hy = hip\n        distance = hypot(ankle[0] - hx, ankle[1] - hy)\n        direction = unit(hip, ankle)\n        along = (thigh**2 - shin**2 + distance**2) / (2 * distance)\n        outward = sqrt(thigh**2 - along**2)\n        knee = offset(offset(hip, direction, along), normal(direction), outward)\n        yield pedal, ankle, knee\n\n\ndef leg(hip, angle, thigh, shin, near):\n    foot_frames = []\n    shin_frames = []\n    shine_frames = []\n    feather_frames = []\n    barb_frames = []\n    for pedal, ankle, knee in poses(hip, angle, thigh, shin):\n        foot_frames.append(path_point(pedal))\n\n        shin_direction = unit(knee, ankle)\n        shin_side = normal(shin_direction)\n        calf = offset(knee, shin_direction, 20)\n        lower = offset(ankle, shin_direction, -17)\n        outer_knee = offset(knee, shin_side, 6)\n        outer_ankle = offset(ankle, shin_side, 3.4)\n        inner_ankle = offset(ankle, shin_side, -3.4)\n        inner_knee = offset(knee, shin_side, -7.1)\n        shin_frames.append(\n            f\\\"M{path_point(outer_knee)} Q{path_point(offset(calf, shin_side, 5.9))} {path_point(outer_ankle)} \\\"\n            f\\\"L{path_point(inner_ankle)} Q{path_point(offset(lower, shin_side, -2.6))} {path_point(inner_knee)} Z\\\")\n        shine_frames.append(\n            f\\\"M{path_point(offset(calf, shin_side, 1.9))} \\\"\n            f\\\"Q{path_point(offset(lower, shin_side, 1))} {path_point(offset(ankle, shin_side, 1))}\\\")\n\n        thigh_direction = unit(hip, knee)\n        thigh_side = normal(thigh_direction)\n        upper = offset(hip, thigh_direction, 22)\n        lower = offset(knee, thigh_direction, -16)\n        fringe = offset(knee, shin_direction, 10)\n        feather_frames.append(\n            f\\\"M{path_point(offset(hip, thigh_side, 19))} \\\"\n            f\\\"C{path_point(offset(upper, thigh_side, 21))} {path_point(offset(lower, thigh_side, 15))} {path_point(offset(knee, shin_side, 8.5))} \\\"\n            f\\\"L{path_point(offset(fringe, shin_side, 4))} {path_point(offset(knee, shin_side, 1))} {path_point(offset(fringe, shin_side, -4))} {path_point(offset(knee, shin_side, -7))} \\\"\n            f\\\"C{path_point(offset(lower, thigh_side, -8))} {path_point(offset(upper, thigh_side, -18))} {path_point(offset(hip, thigh_side, -17))} Z\\\")\n        barb_frames.append(\n            f\\\"M{path_point(offset(upper, thigh_side, 8))} \\\"\n            f\\\"Q{path_point(offset(lower, thigh_side, 11))} {path_point(offset(knee, shin_side, 5))}\\\")\n\n    def animated_path(frames, styling):\n        values = \\\";\\\\n          \\\".join(frames)\n        return (\n            f'<path d=\\\"{frames[0]}\\\" {styling}>\\\\n'\n            f'        <animate attributeName=\\\"d\\\" dur=\\\"{duration}\\\" repeatCount=\\\"indefinite\\\" values=\\\"\\\\n'\n            f'          {values}\\\"/>\\\\n'\n            '      </path>')\n\n    shin_fill = \\\"#e89757\\\" if near else \\\"#ac7051\\\"\n    web_fill = \\\"#f5ad66\\\" if near else \\\"#bb8053\\\"\n    feather_fill = \\\"#e6dfbc\\\" if near else \\\"#a5aa8e\\\"\n    shine = \\\"#ffd088\\\" if near else \\\"#dbaa74\\\"\n    barb = \\\"#abb095\\\" if near else \\\"#7d8b76\\\"\n    foot_values = \\\"; \\\".join(foot_frames)\n    return f'''<g stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\">\n      {animated_path(shin_frames, f'fill=\\\"{shin_fill}\\\" stroke=\\\"#5e493a\\\" stroke-width=\\\"2.3\\\"')}\n      {animated_path(shine_frames, f'fill=\\\"none\\\" stroke=\\\"{shine}\\\" stroke-width=\\\"1.5\\\"')}\n      {animated_path(feather_frames, f'fill=\\\"{feather_fill}\\\" stroke=\\\"#3f4b43\\\" stroke-width=\\\"2.5\\\"')}\n      {animated_path(barb_frames, f'fill=\\\"none\\\" stroke=\\\"{barb}\\\" stroke-width=\\\"1.6\\\"')}\n      <g transform=\\\"translate({foot_frames[0]})\\\">\n        <animateTransform attributeName=\\\"transform\\\" type=\\\"translate\\\" dur=\\\"{duration}\\\" repeatCount=\\\"indefinite\\\" values=\\\"{foot_values}\\\"/>\n        <use href=\\\"#pedal\\\"/>\n        <use href=\\\"#foot\\\" fill=\\\"{web_fill}\\\"/>\n      </g>\n    </g>'''\n\n\nsvg = svg.replace('@FAR_LEG@', leg((451, 378), 5*pi/6, 115, 111, False))\nsvg = svg.replace('@NEAR_LEG@', leg((486, 382), -pi/6, 110, 104, True))\nfor angle in [12, 71, 150, -30]:\n    prefix = f'<g>\\\\n        <animateTransform attributeName=\\\"transform\\\" type=\\\"rotate\\\" from=\\\"{angle}\\\"'\n    svg = svg.replace(prefix, prefix.replace('<g>', f'<g transform=\\\"rotate({angle})\\\">'))\n    svg = svg.replace(f'<use href=\\\"#wheel\\\" transform=\\\"rotate({angle})\\\"/>', '<use href=\\\"#wheel\\\"/>')\nsvg = svg.replace('d=\\\"M-3 0H36\\\" transform=\\\"rotate(150)\\\"', 'd=\\\"M-3 0H36\\\"')\nsvg = svg.replace('<g transfor