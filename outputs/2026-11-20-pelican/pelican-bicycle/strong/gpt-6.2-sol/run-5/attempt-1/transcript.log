{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/vellery-2uye3_7k/pelican-sample.py <<'PY'\nfrom math import cos, hypot, radians, sin\nfrom pathlib import Path\nimport re\nimport subprocess\nfrom xml.etree import ElementTree as ET\n\nfrom PIL import Image\n\nroot = Path(\\\"/tmp/vellery-2uye3_7k\\\")\nsource = root / \\\"work/pelican.svg\\\"\nns = \\\"{http://www.w3.org/2000/svg}\\\"\nET.register_namespace(\\\"\\\", \\\"http://www.w3.org/2000/svg\\\")\nnumeric = re.compile(r\\\"-?(?:\\\\d+(?:\\\\.\\\\d*)?|\\\\.\\\\d+)\\\")\ntree = ET.parse(source)\nanimations = [(element, child) for element in tree.iter() for child in element\n              if child.tag in (ns + \\\"animateTransform\\\", ns + \\\"animate\\\")]\n\n\ndef sample(animation, time):\n    phase = (time / float(animation.get(\\\"dur\\\")[:-1])) % 1\n    if \\\"values\\\" in animation.attrib:\n        values = animation.get(\\\"values\\\").split(\\\";\\\")\n    else:\n        values = [animation.get(\\\"from\\\"), animation.get(\\\"to\\\")]\n    times = animation.get(\\\"keyTimes\\\")\n    times = list(map(float, times.split(\\\";\\\"))) if times else [\n        frame / (len(values) - 1) for frame in range(len(values))\n    ]\n    index = next(i for i in range(len(times) - 1) if times[i] <= phase < times[i + 1])\n    fraction = (phase - times[index]) / (times[index + 1] - times[index])\n    start = values[index].strip()\n    end = values[index + 1].strip()\n    assert numeric.sub(\\\"#\\\", start) == numeric.sub(\\\"#\\\", end)\n    numbers = iter(map(float, numeric.findall(end)))\n    return numeric.sub(lambda match: f\\\"{float(match[0]) * (1 - fraction) + next(numbers) * fraction:.4f}\\\", start)\n\n\nrotors = [a for _, a in animations if a.get(\\\"type\\\") == \\\"rotate\\\" and a.get(\\\"from\\\")]\npedals = [a for e, a in animations if e.find(f\\\"{ns}use[@href='#pedal']\\\") is not None]\npaths = [a for _, a in animations if a.get(\\\"attributeName\\\") == \\\"d\\\"]\nassert len(rotors) == 4 and len(pedals) == 2 and len(paths) == 8\nassert all(sample(anim, 0) \"'!= sample(anim, .19) for anim in rotors + pedals + paths)\nassert all(sample(anim, 0) == sample(anim, 1.42) for anim in pedals + paths)\n\nworst = 0\nfor frame in range(120):\n    time = frame * 1.42 / 120\n    for rotor, pedal in zip(rotors[2:], pedals):\n        angle = radians(float(sample(rotor, time)))\n        x, y = map(float, sample(pedal, time).split())\n        worst = max(worst, hypot(x - 533 - 36*cos(angle), y - 552 - 36*sin(angle)))\nassert worst < .12, worst\n\nsheet = Image.new(\"RGB\", (960, 660))\nfor index, time in enumerate([0, .355, .71, 1.065]):\n    svg = ET.parse(source)\n    for element in svg.iter():\n        for animation in list(element):\n            if animation.tag not in (ns + \"animateTransform\", ns + \"animate\"):\n                continue\n            value = sample(animation, time)\n            if animation.tag == ns + \"animateTransform\":\n                value = animation.get(\"type\") + \"(\" + value + \")\"\n            element.set(animation.get(\"attributeName\"), value)\n            element.remove(animation)\n    frame_svg = root / \"pelican-frame.svg\"\n    frame_png = root / \"pelican-frame.png\"\n    svg.write(frame_svg)\n    subprocess.run([\"rsvg-convert\", \"-w\", \"480\", \"-h\", \"330\", \"-o\", str(frame_png), str(frame_svg)], check=True)\n    with Image.open(frame_png) as frame:\n        sheet.paste(frame, (index % 2 * 480, index // 2 * 330))\nsheet.save(root / \"pelican-cycle.png\")\nprint(f\"Verified four rotating assemblies, both animated legs, and pedal alignment across 120 samples (max {worst:.3f} SVG units).\")\nPY\npython3 /tmp/vellery-2uye3_7k/pelican-sample.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
