{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom math import cos, hypot, radians, sin, sqrt\nfrom pathlib import Path\n\nart = Path(\\\"pelican.svg\\\")\nsvg = art.read_text()\nleg_shapes = []\nfor side, hip, phase, lengths, outline, orange, cuff in [\n    (\\\"far\\\", (404, 326), 156, (108, 136), \\\"#633f44\\\", \\\"#c08266\\\", \\\"#dfb18f\\\"),\n    (\\\"near\\\", (446, 322), -24, (105, 135), \\\"#624149\\\", \\\"#e99b6f\\\", \\\"#efd6af\\\"),\n]:\n    frames = []\n    for step in range(41):\n        angle = radians(phase + 360 * (step % 40) / 40)\n        pedal_x, pedal_y = 456 + 40 * cos(angle), 514 + 40 * sin(angle)\n        foot_x, foot_y = pedal_x - 3, pedal_y - 6\n        dx, dy = foot_x - hip[0], foot_y - hip[1]\n        distance = hypot(dx, dy)\n        upper, lower = lengths\n        along = (upper**2 - lower**2 + distance**2) / (2 * distance)\n        forward = sqrt(upper**2 - along**2)\n        knee_x = hip[0] + (along * dx + forward * dy) / distance\n        knee_y = hip[1] + (along * dy - forward * dx) / distance\n        frames.append(f\\\"M{hip[0]} {hip[1]} {knee_x:.2f} {knee_y:.2f} {foot_x:.2f} {foot_y:.2f}\\\")\n    leg_shapes.append(\n        f'    <path id=\\\"{side}-leg-path\\\" d=\\\"{frames[0]}\\\" pathLength=\\\"100\\\">\\\\n'\n        f'      <animate attributeName=\\\"d\\\" dur=\\\"1.55s\\\" repeatCount=\\\"indefinite\\\"\\\\n'\n        f'        values=\\\"' + \\\";\\\\n          \\\".join(frames) + '\\\"/>\\\\n'\n        '    </path>'\n    )\n    initial = radians(phase)\n    offset_x, offset_y = 40 * cos(initial), 40 * sin(initial)\n    motion = f\\\"M0 0 A40 40 0 0 1 {-2 * offset_x:.6f} {-2 * offset_y:.6f} A40 40 0 0 1 0 0\\\"\n    layer = f'''<g id=\\\"{side}-leg\\\">\n      <g fill=\\\"none\\\" stroke-linejoin=\\\"round\\\">\n        <use xlink:href=\\\"#{side}-leg-path\\\" stroke=\\\"{outline}\\\" stroke-width=\\\"12\\\"/>\n        <use xlink:href=\\\"#{side}-leg-path\\\" stroke=\\\"{orange}\\\" stroke-width=\\\"7.5\\\"/>\n        <use xlink:href=\\\"#{side}-leg-path\\\" stroke=\\\"{outline}\\\" stroke-width=\\\"20\\\" stroke-dasharray=\\\"15 100\\\"/>\n        <use xlink:href=\\\"#{side}-leg-path\\\" stroke=\\\"{cuff}\\\" stroke-width=\\\"15\\\" stroke-dasharray=\\\"15 100\\\"/>\n      </g>\n      <g transform=\\\"translate({456 + offset_x:.6f} {514 + offset_y:.6f})\\\">\n        <g>\n          <animateMotion path=\\\"{motion}\\\" dur=\\\"1.55s\\\" repeatCount=\\\"indefinite\\\"/>\n          <path d=\\\"M-14 1h33\\\" stroke=\\\"#273f45\\\" stroke-width=\\\"8\\\"/>\n          <path d=\\\"M-12 2h28\\\" stroke=\\\"#e0af76\\\" stroke-width=\\\"2.6\\\"/>\n          <use xlink:href=\\\"#webbed-foot\\\" transform=\\\"translate(-3 -6)\\\" fill=\\\"{orange}\\\" stroke=\\\"{outline}\\\" stroke-width=\\\"2.6\\\"/>\n          <path d=\\\"m1-6 10 3m-9-6 12 5\\\" stroke=\\\"{outline}\\\" stroke-width=\\\"1.2\\\" opacity=\\\".7\\\"/>\n        </g>\n      </g>\n    </g>'''\n    svg = svg.replace(\\\"{{\\\" + side.upper() + \\\"_LEG}}\\\", layer)\nsvg = svg.replace(\\\"  </defs>\\\", \\\"\\\\n\\\" + \\\"\\\\n\\\".join(leg_shapes) + \\\"\\\\n  </defs>\\\")\nart.write_text(svg)\nPY\nrsvg-convert -o /tmp/pelican-mc4mzppd-first.png pelican.svg\nwc -c pelican.svg\nnode -p 'process.version + \\\" \\\" + typeof WebSocket'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
