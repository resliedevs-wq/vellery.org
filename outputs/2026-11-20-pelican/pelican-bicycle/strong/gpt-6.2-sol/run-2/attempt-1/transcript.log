{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/pelican-mc4mzppd-check.py <<'PY'\nfrom math import cos, hypot, pi, radians, sin\nfrom pathlib import Path\nimport re\nimport subprocess\nimport tempfile\nimport xml.etree.ElementTree as ET\nfrom PIL import Image, ImageChops\n\nSVG = \\\"{http://www.w3.org/2000/svg}\\\"\nXLINK = \\\"{http://www.w3.org/1999/xlink}\\\"\nET.register_namespace(\\\"\\\", SVG[1:-1])\nET.register_namespace(\\\"xlink\\\", XLINK[1:-1])\nsource = Path(\\\"pelican.svg\\\")\nnumbers = re.compile(r\\\"-?(?:\\\\d*\\\\.\\\\d+|\\\\d+)\\\")\nread_numbers = lambda data: [float(n) for n in numbers.findall(data)]\n\ndef pose(t):\n    root = ET.parse(source).getroot()\n    ids = {node.attrib[\\\"id\\\"]: node for node in root.iter() if \\\"id\\\" in node.attrib}\n    for part in root.iter():\n        for attr, val in part.attrib.items():\n            if attr == XLINK + \\\"href\\\" and val.startswith(\\\"#\\\"):\n                assert val[1:] in ids\n            if val.startswith(\\\"url(#\\\"):\n                assert val[5:-1] in ids\n\n    parents = {node: parent for parent in root.iter() for node in parent}\n    crank_angles = {}\n    for animation, parent in parents.items():\n        if animation.tag not in (SVG + \\\"animate\\\", SVG + \\\"animateTransform\\\", SVG + \\\"animateMotion\\\"):\n            continue\n        assert animation.get(\\\"repeatCount\\\") == \\\"indefinite\\\"\n        duration = float(animation.get(\\\"dur\\\")[:-1])\n        progress = (t % duration) / duration\n        attribute = animation.get(\\\"attributeName\\\")\n        if animation.tag == SVG + \\\"animateTransform\\\":\n            saved = read_numbers(animation.get(\\\"from\\\"))\n            finish = read_numbers(animation.get(\\\"to\\\"))\n            values = [x + (y - x) * progress for x, y in zip(saved, finish)]\n            parent.set(attribute, animation.get(\\\"type\\\") + \\\"(\\\" + \\\" \\\".join(map(str, values)) + \\\")\\\")\n            if duration == 1.55:\n                crank_angles[int(saved[0])] = radians(values[0])\n        elif animation.tag == SVG + \\\"animateMotion\\\":\n            x0, y0, rx, ry, rotation, large_arc, sweep, x1, y1, *_ = read_numbers(animation.get(\\\"path\\\"))\n            assert (x0, y0, rx, ry, rotation, large_arc, sweep) == (0, 0, 40, 40, 0, 0, 1)\n            cx, cy = x1 / 2, y1 / 2\n            angle = 2 * pi * progress\n            x = cx - cx * cos(angle) + cy * sin(angle)\n            y = cy - cx * sin(angle) - cy * cos(angle)\n            parent.set(\\\"transform\\\", f\\\"translate({x} {y})\\\")\n        elif attribute == \\\"d\\\":\n            frames = animation.get(\\\"values\\\").split(\\\";\\\")\n            assert frames[0].strip() == frames[-1].strip()\n            assert frames[0].strip() == parent.get(\\\"d\\\")\n            scaled = progress * (len(frames) - 1)\n            start, fraction = int(scaled), scaled % 1\n            values = iter(a + (b - a) * fraction for a, b in zip(read_numbers(frames[start]), read_numbers(frames[start + 1])))\n            parent.set(\\\"d\\\", numbers.sub(lambda _: f\\\"{next(values):.5f}\\\", frames[0]))\n        elif attribute == \\\"stroke-dashoffset\\\":\n            parent.set(attribute, str(-186 * progress))\n        parent.remove(animation)\n\n    for side, phase in ((\\\"far\\\", 215), (\\\"near\\\", 35)):\n        leg = ids[side + \\\"-leg\\\"]\n        foot_wrapper = leg.find(SVG + \\\"g\\\")\n        motion = foot_wrapper.find(SVG + \\\"g\\\")\n        pedal_x, pedal_y = [a + b for a, b in zip(read_numbers(foot_wrapper.get(\\\"transform\\\")), read_numbers(motion.get(\\\"transform\\\")))]\n        crank_angle = crank_angles[phase]\n        crank_x, crank_y = 456 + cos(crank_angle) * 40, 514 + sin(crank_angle) * 40\n        assert hypot(crank_x - pedal_x, crank_y - pedal_y) < .001\n        leg_x, leg_y = read_numbers(leg.find(SVG + \\\"path\\\").get(\\\"d\\\"))[-2:]\n        assert hypot(pedal_x - leg_x - 3, pedal_y - leg_y - 6) < .15\n    return root\n\nfor step in range(129):\n    pose(1.55 * step / 128)\n\nmontage = Image.new(\\\"RGB\\\", (1000, 720))\nwith tempfile.TemporaryDirectory(prefix=\\\"pelican-frames-\\\") as directory:\n    for phase in range(4):\n        tree = pose(phase * 1.55 / 4)\n        svg_path = Path(directory) / \\\"pose.svg\\\"\n        bitmap = Path(directory) / \\\"pose.png\\\"\n        ET.ElementTree(tree).write(svg_path, encoding=\\\"utf-8\\\")\n        subprocess.run([\\\"rsvg-convert\\\", \\\"-o\\\", bitmap, svg_path], check=True)\n        image = Image.open(bitmap).convert(\\\"RGB\\\")\n        if phase == 0:\n            start = image\n        if phase == 1:\n            for box in [(187, 412, 315, 493), (695, 412, 809, 494)]:\n                assert ImageChops.difference(image.crop(box), start.crop(box)).getbbox()\n        montage.paste(image.resize((500, 360), Image.Resampling.LANCZOS), (phase % 2 * 500, phase // 2 * 360))\nmontage.save(\\\"/tmp/pelican-mc4mzppd-motion-proof.png\\\")\nprint(\\\"Verified SVG references, crank-to-pedal alignment, foot contact at 129 positions, and wheel movement in rendered frames.\\\")\nPY\npython3 /tmp/pelican-mc4mzppd-check.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
