{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('pelican.svg')\ns=p.read_text().replace('dur=\\\"1.95s\\\"', 'dur=\\\".65s\\\"').replace('to=\\\"-180 0\\\" dur=\\\"1.3s\\\"', 'to=\\\"-180 0\\\" dur=\\\".173s\\\"').replace('from=\\\"0\\\" to=\\\"24\\\" dur=\\\".65s\\\"', 'from=\\\"0\\\" to=\\\"-156\\\" dur=\\\"1.3s\\\"')\np.write_text(s)\nPY\npython3 - <<'PY'\nfrom xml.etree import ElementTree as ET\nfrom math import hypot\ndoc=ET.parse('pelican.svg')\nns={'s':'http://www.w3.org/2000/svg'}\nparents={c:p for p in doc.iter() for c in p}\ntrans=doc.findall('.//s:animateTransform',ns)\nfeet=[e for e in trans if e.get('type')=='translate' and e.get('values')]\narms=[e for e in doc.findall('.//s:animate',ns) if e.get('values','').startswith('M460 520L')]\nassert len(arms)==4 and len(feet)==2\nfor a,b in zip(arms[::2],feet):\n ends=a.get('values').split(';')\n points=b.get('values').split(';')\n assert len(points)==49 and points[0]==points[-1]\n for arm,pt in zip(ends,points):\n  assert arm.split('L')[1]==pt\n  x,y=map(float,pt.split())\n  assert abs(hypot(x-460,y-520)-34)<.01\nassert all(e.get('repeatCount')=='indefinite' for e in trans)\nassert len([e for e in trans if e.get('type')=='rotate' and e.get('dur')=='.65s'])==2\nprint('Verified SVG, both wheel rotations, and both crank/foot positions at all 49 animation keyframes.')\nPY\ngit status --short\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
