{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport xml.etree.ElementTree as ET\nimport math\nfrom pathlib import Path\nns='{http://www.w3.org/2000/svg}'\nroot=ET.parse('pelican.svg').getroot()\nlegs=[e.get('values').split(';') for e in root.iter(ns+'animate')][::2]\npedals=[e.get('values').split(';') for e in root.iter(ns+'animateTransform') if e.get('values')]\nassert len(legs)==len(pedals)==2\nfor side in range(2):\n  for i in range(65):\n    a=math.tau*i/64+(math.pi if side==0 else 0)\n    px,py=map(float,pedals[side][i].split())\n    lx,ly=map(float,legs[side][i].split('L')[-1].split())\n    assert math.hypot(px-442-31*math.cos(a),py-502-31*math.sin(a))<.01\n    assert abs(lx+13-px)<.01 and abs(ly+8-py)<.01\nfor parent in root.iter():\n  for child in list(parent):\n    if child.tag==ns+'animate':\n      parent.set('d',child.get('values').split(';')[16]);parent.remove(child)\n    elif child.tag==ns+'animateTransform':\n      val=child.get('values')\n      arg=val.split(';')[16] if val else ('180' if child.get('dur')=='0.8s' else '90') if child.get('type')=='rotate' else '-60 0'\n      parent.set('transform',child.get('type')+'('+arg+')');parent.remove(child)\nET.ElementTree(root).write('/tmp/pelican-quarter.svg')\nprint('Validated both pedal orbits and leg endpoints at all 65 keyframes.')\nPY\nrsvg-convert -w 700 /tmp/pelican-quarter.svg -o /tmp/pelican-quarter.png\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
