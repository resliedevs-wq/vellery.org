{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport xml.etree.ElementTree as E, math\nr=E.parse('pelican.svg').getroot()\nns='{http://www.w3.org/2000/svg}'\npaths=[e.get('values').split(';') for e in r.iter(ns+'animate') if e.get('attributeName')=='d']\npedals=[e.get('values').split(';') for e in r.iter(ns+'animateTransform') if e.get('values')]\ndef endpoint(d):return list(map(float,d.rsplit('L',1)[1].split()))\nfor k in range(2):\n for i,p in enumerate(pedals[k]):\n  x,y=map(float,p.split())\n  assert math.dist(endpoint(paths[4*k][i]),(x,y))<.01\n  assert math.dist(endpoint(paths[4*k+2][i]),(x-9,y-7))<.01\n  assert abs(math.hypot(x-460,y-520)-34)<.01\n  ox,oy=map(float,pedals[1-k][i].split())\n  assert abs(x+ox-920)<.01 and abs(y+oy-1040)<.01\n assert pedals[k][0]==pedals[k][-1]\nprint('Both feet follow opposite crank ends throughout the loop.',len(pedals[0]),'keyframes per foot.')\nfor e in r.iter(ns+'animateTransform'):\n if e.get('type')=='rotate':print('Rotation:',e.get('from'),e.get('to'),e.get('dur'),e.get('repeatCount'))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
