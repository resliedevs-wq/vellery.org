\\\"1.6s\\\" repeatCount=\\\"indefinite\\\"/>\n      <g stroke=\\\"#607770\\\" stroke-width=\\\"1.5\\\">''')\nfor i in range(24):\n    a=i*math.pi/12\n    b=a+(-1 if i%2 else 1)*1.15\n    add(f'<path d=\\\"M{8*math.cos(b):.2f} {8*math.sin(b):.2f} L{87*math.cos(a):.2f} {87*math.sin(a):.2f}\\\"/>')\nadd('''</g><path d=\\\"M70 -49 Q75 -43 78 -36\\\" stroke=\\\"#d98645\\\" stroke-width=\\\"5\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\"/>\n      <path d=\\\"M-60 67 l4 -5\\\" stroke=\\\"#384a43\\\" stroke-width=\\\"3\\\"/>\n    </g>\n    <circle r=\\\"9\\\" fill=\\\"#b2b8a0\\\" stroke=\\\"#344742\\\" stroke-width=\\\"3\\\"/>\n  </g>\n  <g id=\\\"ripples\\\" stroke=\\\"#f6f1d8\\\" stroke-width=\\\"2.5\\\" stroke-linecap=\\\"round\\\" opacity=\\\".8\\\">\n    <path d=\\\"M0 0h19m8 0h7m30 13h40m17 -20h16m26 31h28m20 -13h12\\\"/>\n  </g>\n</defs>\n<rect width=\\\"960\\\" height=\\\"680\\\" fill=\\\"url(#sky)\\\"/>\n<circle cx=\\\"661\\\" cy=\\\"157\\\" r=\\\"77\\\" fill=\\\"#f5c178\\\"/>\n<g fill=\\\"#f9f4df\\\">\n <path d=\\\"M0 175h105c-3-5-10-7-19-7-4-12-21-15-32-8-9-13-28-14-38 0-7-2-12 0-16 2z\\\"/>\n <path d=\\\"M739 122h142c-4-5-14-7-24-7-8-13-22-16-34-9-12-20-35-18-44 1-15-4-23 0-28 8-6 0-10 3-12 7z\\\"/>\n <path d=\\\"M180 103h87c-6-4-13-5-18-5-7-11-18-12-26-5-12-7-21-3-25 4-8-1-14 1-18 6z\\\"/>\n</g>\n<g fill=\\\"none\\\" stroke=\\\"#748b7d\\\" stroke-width=\\\"2.4\\\" stroke-linecap=\\\"round\\\">\n <path d=\\\"M134 226q9-2 15 5 4-10 13-12m20 36q7-3 12 2 3-8 9-11m559-67q7-2 12 4 4-8 11-9\\\"/>\n</g>\n<path fill=\\\"#b1c5b1\\\" d=\\\"M0 361v-61q51-14 105 2t109 14q52 1 91 25l48 20z\\\"/>\n<path fill=\\\"#93afa2\\\" d=\\\"M0 368v-46q58-4 113 10t101 12l41 16 36 8z\\\"/>\n<path fill=\\\"url(#water)\\\" d=\\\"M0 359h960v132H0z\\\"/>\n<g><use xlink:href=\\\"#ripples\\\" x=\\\"-24\\\" y=\\\"383\\\"/><use xlink:href=\\\"#ripples\\\" x=\\\"148\\\" y=\\\"423\\\"/><use xlink:href=\\\"#ripples\\\" x=\\\"562\\\" y=\\\"387\\\"/><use xlink:href=\\\"#ripples\\\" x=\\\"824\\\" y=\\\"421\\\"/></g>\n<\"'!-- A lighthouse on the far headland. -->\n<g stroke-linejoin=\"round\">\n <path d=\"M807 328l4-40h10l5 40z\" fill=\"#fff2d3\"/>\n <path d=\"M810 305l1-9h10l2 9z\" fill=\"#c08264\"/>\n <path d=\"M810 288v-9h12v9z\" fill=\"#8caa9d\"/>\n <path d=\"M807 280l9-7 9 7zm2 7h15v3h-15z\" fill=\"#647f73\"/>\n <path d=\"M814 322v-7q2-4 4 0v7\" fill=\"#829b8b\"/>\n <path d=\"M684 363q35-12 53-17t45-16q35-16 65-10l38 7 34-6 41-4v51z\" fill=\"#8aab99\"/>\n <path d=\"M687 364l88-14 14-9 42-6 22 4 49-5 58-6v41z\" fill=\"#72998b\"/>\n</g>\n<path d=\"M0 461q72-19 115-8 68 17 138 12 217-15 337 1 164 18 264-9 58-16 106-10v67H0z\" fill=\"#f4e2bb\"/>\n<path d=\"M0 477q75-20 148-10t131 7q-117 17-279 18z\" fill=\"#d8cca4\"/>\n<path d=\"M0 500q174-20 317-6 236 15 450-5 126-12 193-10v201H0z\" fill=\"#eed4ab\"/>\n<g fill=\"none\" stroke=\"#a7ac85\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M64 469q-1-10-7-14m8 14q2-11 8-17m666 19q2-9 9-14m-12 14q0-10-4-13m158-6q4-12 10-16m-13 16q0-8-4-13\"/></g>\n<ellipse cx=\"474\" cy=\"604\" rx=\"239\" ry=\"12\" fill=\"#c6ae88\" opacity=\".65\"/>\n<g stroke=\"#c6ab85\" stroke-linecap=\"round\" fill=\"none\" stroke-width=\"2\"><animateTransform attributeName=\"transform\" type=\"translate\" from=\"0 0\" to=\"-240 0\" dur=\"1.6s\" repeatCount=\"indefinite\"/>'\"''')\nfor x in range(0,1201,240):\n    add(f'<path transform=\\\"translate({x})\\\" d=\\\"M27 552h13m7 0h3m62 66h22m50-86h13m-135 105h35m5 0h4\\\"/>')\nadd('''</g>\n<g stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\">\n <use xlink:href=\\\"#wheel\\\" x=\\\"289\\\" y=\\\"504\\\"/><use xlink:href=\\\"#wheel\\\" x=\\\"655\\\" y=\\\"504\\\"/>\n''')\n# The two-link legs bend at the hock. Both are keyed to the same crank angle.\ncx,cy,r=442,502,31\ndef pos(t,far):\n    a=t*2*math.pi+(math.pi if far else 0)\n    return cx+r*math.cos(a),cy+r*math.sin(a)\ndef limb(t,far):\n    px,py=pos(t,far)\n    hx,hy=(414,377) if far else (447,380)\n    ex,ey=px-13,py-8\n    dx,dy=ex-hx,ey-hy\n    dist=math.hypot(dx,dy)\n    along=(76**2-90**2+dist**2)/(2*dist)\n    perp=math.sqrt(max(0,76**2-along**2))\n    kx=hx+(dx*along-dy*perp)/dist\n    ky=hy+(dy*along+dx*perp)/dist\n    return f'M{hx} {hy} L{kx:.2f} {ky:.2f} L{ex:.2f} {ey:.2f}'\ndef animated_path(ds,attrs):\n    add(f'<path d=\\\"{ds[0]}\\\" {attrs}><animate attributeName=\\\"d\\\" dur=\\\"1.6s\\\" repeatCount=\\\"indefinite\\\" values=\\\"{\\\";\\\".join(ds)}\\\"/></path>')\ndef leg(far):\n    ds=[limb(i/64,far) for i in range(65)]\n    for width,col in [(12,'#36443c'),(7.4,'#b88352' if far else '#e3a059')]:\n        animated_path(ds,f'fill=\\\"none\\\" stroke=\\\"{col}\\\" stroke-width=\\\"{width}\\\"')\ndef pedal(far):\n    pts=[pos(i/64,far) for i in range(65)]\n    x,y=pts[0]\n    add(f'<g transform=\\\"translate({x} {y})\\\"><animateTransform attributeName=\\\"transform\\\" type=\\\"translate\\\" dur=\\\"1.6s\\\" repeatCount=\\\"indefinite\\\" values=\\\"{\\\";\\\".join(f\\\"{px:.2f} {py:.2f}\\\" for px,py in pts)}\\\"/>')\n    add(f'''<rect x=\\\"-15\\\" y=\\\"-1.5\\\" width=\\\"34\\\" height=\\\"7\\\" rx=\\\"3\\\" fill=\\\"#48564d\\\" stroke=\\\"#263b37\\\" stroke-width=\\\"2\\\"/>\n    <path d=\\\"M-16-10q4-3 8 0l4 3 10-1 10 3q4 2 2 4l-14-1-9 1-8-2q-5-2-3-7z\\\" fill=\\\"{'#c38b56' if far else '#efa75e'}\\\" stroke=\\\"#39483e\\\" stroke-width=\\\"2.7\\\"/>\n    <path d=\\\"M-7-7l10 4m-6-4 14 3\\\" fill=\\\"none\\\" stroke=\\\"#a36f46\\\" stroke-width=\\\"1.4\\\"/></g>''')\ndef crank(far):\n    x,y=pos(0,far)\n    add(f'<g transform=\\\"translate(442 502)\\\"><g><animateTransform attributeName=\\\"transform\\\" type=\\\"rotate\\\" from=\\\"0\\\" to=\\\"360\\\" dur=\\\"1.6s\\\" repeatCount=\\\"indefinite\\\"/><path d=\\\"M0 0h{x-cx}\\\" stroke=\\\"#34453e\\\" stroke-width=\\\"10\\\"/><path d=\\\"M0 0h{x-cx}\\\" stroke=\\\"#afbaaa\\\" stroke-width=\\\"5\\\"/></g></g>')\ncrank(True)\nleg(True)\npedal(True)\nadd('''<\"'!-- Fenders, stays and enamelled frame. -->\n<g stroke=\"