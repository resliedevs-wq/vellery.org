{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport re\nfrom math import hypot\nimport xml.etree.ElementTree as ET\np=Path('pelican.svg')\ns=p.read_text()\ns=re.sub(r'\"'^ <pattern id=\"dots\".*?</pattern>'\"\\\\n','',s,flags=re.M)\np.write_text(s)\nr=ET.parse(p).getroot()\nns={'s':r.tag.split('}')[0][1:]}\naxles=[a for a in r.findall('.//s:animateTransform',ns) if a.get('to')=='360']\nassert len(axles)==2\ntracks=[a.get('values').split(';') for a in r.findall('.//s:animateTransform',ns) if a.get('type')=='translate' and a.get('values')]\nassert len(tracks)==2\nfor t in tracks:\n    assert t[0]==t[-1] and len(t)==49\nfor a,b in zip(*tracks):\n    x,y=map(float,a.split())\n    u,v=map(float,b.split())\n    assert abs(x+u-922)<0.02 and abs(y+v-1036)<0.02 and abs(hypot(x-461,y-518)-35)<0.02\nassert all(a.get('repeatCount')=='indefinite' for a in r.iter() if a.tag.split('}')[-1].startswith('animate'))\nprint('Verified SVG, both wheel rotations, and opposing pedal positions throughout the loop.')\nPY\nls -lh pelican.svg\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
