{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/draw_pelican.py <<'PY'\nfrom math import sin, cos, pi, hypot, sqrt\nfrom pathlib import Path\n\ndef spokes():\n    return '\\\\n'.join(f'<g transform=\\\"rotate({a} 0 0)\\\"><path d=\\\"M-5 -4 L0 -96\\\" stroke=\\\"#567270\\\" stroke-width=\\\"1.8\\\"/><path d=\\\"M0 -96v5\\\" stroke=\\\"#273f40\\\" stroke-width=\\\"2.8\\\"/></g>' for a in range(0,360,20))\n\ndef wheel(x):\n    return f'''<g transform=\\\"translate({x} 517)\\\">\n    <circle r=\\\"102\\\" fill=\\\"none\\\" stroke=\\\"#263d3c\\\" stroke-width=\\\"11\\\"/>\n    <circle r=\\\"98.5\\\" fill=\\\"none\\\" stroke=\\\"#f7e2ae\\\" stroke-width=\\\"4\\\"/>\n    <circle r=\\\"95.5\\\" fill=\\\"none\\\" stroke=\\\"#5a716a\\\" stroke-width=\\\"2.5\\\"/>\n    <g><animateTransform attributeName=\\\"transform\\\" type=\\\"rotate\\\" from=\\\"0\\\" to=\\\"360\\\" dur=\\\"1.6s\\\" repeatCount=\\\"indefinite\\\"/>\n    <use href=\\\"#spokes\\\" xlink:href=\\\"#spokes\\\"/>\n    <g transform=\\\"rotate({45 if x==310 else 150})\\\"><rect x=\\\"-4\\\" y=\\\"-81\\\" width=\\\"8\\\" height=\\\"19\\\" rx=\\\"3\\\" fill=\\\"#e8a548\\\" stroke=\\\"#735e41\\\" stroke-width=\\\"1.6\\\"/></g></g>\n    <circle r=\\\"9\\\" fill=\\\"#f4dfab\\\" stroke=\\\"#263d3c\\\" stroke-width=\\\"4\\\"/><circle r=\\\"3.5\\\" fill=\\\"#56675d\\\"/></g>'''\n\ndef cycle(phase,far):\n    # Articulated hock and webbed foot. Platform stays level around the crank.\n    samples, feet, cranks=[],[],[]\n    hx,hy=(441,359) if far else (420,359)\n    for i in range(49):\n        a=(i%48)/48*2*pi+phase\n        px,py=461+35*cos(a),518+35*sin(a)\n        ax,ay=px-14,py-10\n        dx,dy=ax-hx,ay-hy\n        d=hypot(dx,dy)\n        along=(93**2-94**2+d*d)/(2*d)\n        off=sqrt(max(0,93**2-along**2))\n        kx,ky=hx+(along*dx-off*dy)/d,hy+(along*dy+off*dx)/d\n        samples.append(f'M{hx} {hy} Q{hx-2} {hy+17} {kx:.2f} {ky:.2f} Q{kx-1:.2f} {ky+4:.2f} {ax:.2f} {ay:.2f}')\n        feet.append(f'{px:.2f} {py:.2f}')\n        cranks.append(f'M461 518 L{px:.2f} {py:.2f}')\n    def morph(vals):\n        return '<animate attributeName=\\\"d\\\" dur=\\\"2.4s\\\" repeatCount=\\\"indefinite\\\" values=\\\"'+';'.join(vals)+'\\\"/>'\n    ink='#354443'\n    flesh='#b87b48' if far else '#e59e50'\n    toe='#c48d51' if far else '#f2b55c'\n    crank=f'<path d=\\\"{cranks[0]}\\\" stroke=\\\"{ink}\\\" stroke-width=\\\"11\\\">{morph(cranks)}</path><path d=\\\"{cranks[0]}\\\" stroke=\\\"#c5c8ac\\\" stroke-width=\\\"5\\\">{morph(cranks)}</path>'\n    leg=f'<path d=\\\"{samples[0]}\\\" stroke=\\\"{ink}\\\" stroke-width=\\\"13\\\">{morph(samples)}</path><path d=\\\"{samples[0]}\\\" stroke=\\\"{flesh}\\\" stroke-width=\\\"7\\\">{morph(samples)}</path>'\n    return f'''<g fill=\\\"none\\\" stroke-linejoin=\\\"round\\\" stroke-linecap=\\\"round\\\">{crank}{leg}\n    <g transform=\\\"translate({feet[0]})\\\"><animateTransform attributeName=\\\"transform\\\" type=\\\"translate\\\" dur=\\\"2.4s\\\" repeatCount=\\\"indefinite\\\" values=\\\"{';'.join(feet)}\\\"/>\n    <rect x=\\\"-18\\\" y=\\\"-1\\\" width=\\\"38\\\" height=\\\"8\\\" rx=\\\"3\\\" fill=\\\"{ink}\\\"/><path d=\\\"M-12 3h12m5 0h9\\\" stroke=\\\"#edc278\\\" stroke-width=\\\"2\\\"/>\n    <path d=\\\"M-18 -13 Q-14 -16 -10 -9 Q-4 -9 3 -11 L18 -5 Q22 -3 17 -2 L7 -3 Q9 0 4 -1 L-5 -3 Q-18 -1 -18 -6 Z\\\" fill=\\\"{toe}\\\" stroke=\\\"{ink}\\\" stroke-width=\\\"2.8\\\"/><path d=\\\"m-8 -7 14 4m-8 -6 15 5\\\" stroke=\\\"#a16c40\\\" stroke-width=\\\"1.5\\\"/></g></g>'''\n\nsvg='''<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" xmlns:xlink=\\\"http://www.w3.org/1999/xlink\\\" width=\\\"960\\\" height=\\\"720\\\" viewBox=\\\"0 0 960 720\\\" role=\\\"img\\\" aria-labelledby=\\\"title desc\\\">\n<title id=\\\"title\\\">Pelican on a bicycle</title>\n<desc id=\\\"desc\\\">A white pelican in a red neckerchief sits on the leather saddle of a red bicycle. Its webbed feet pedal in circles and both wheels spin as it rides along the coast.</desc>\n<defs>\n <pattern id=\\\"ripples\\\" width=\\\"179\\\" height=\\\"42\\\" patternUnits=\\\"userSpaceOnUse\\\"><path d=\\\"M9 14h26m6 0h4m62 18h41m5 0h7\\\" fill=\\\"none\\\" stroke=\\\"#eff0cb\\\" stroke-width=\\\"2.6\\\" stroke-linecap=\\\"round\\\"/></pattern>\n <pattern id=\\\"sand\\\" width=\\\"193\\\" height=\\\"39\\\" patternUnits=\\\"userSpaceOnUse\\\"><path d=\\\"M8 14h14m64 19h28m5 0h5m51-25h6\\\" fill=\\\"none\\\" stroke=\\\"#bc9c6b\\\" stroke-width=\\\"2.2\\\" stroke-linecap=\\\"round\\\"/><circle cx=\\\"48\\\" cy=\\\"26\\\" r=\\\"1.4\\\" fill=\\\"#bba476\\\"/></pattern>\n <pattern id=\\\"dots\\\" width=\\\"6\\\" height=\\\"6\\\" patternUnits=\\\"userSpaceOnUse\\\"><circle cx=\\\"1.5\\\" cy=\\\"1.5\\\" r=\\\"0.9\\\" fill=\\\"#cc8d49\\\"/></pattern>\n <g id=\\\"spokes\\\">SPOKES</g>\n</defs>\n<g stroke-linejoin=\\\"round\\\" stroke-linecap=\\\"round\\\">\n<\"'!-- A quiet stretch of headland and the road along the water. -->\n<path fill=\"#fbefd3\" d=\"M0 0h960v720H0z\"/>\n<circle cx=\"744\" cy=\"169\" r=\"92\" fill=\"#f6cd83\"/>\n<path d=\"M767 234h74m-107 9h88m-76 9h42\" stroke=\"#fbefd3\" stroke-width=\"4\"/>\n<g fill=\"none\" stroke=\"#c5bca1\" stroke-width=\"2.6\"><path d=\"M133 185q8 -2 14 5 6 -8 15 -7m-48 21q5 -2 10 3 3 -5 10 -6m672 -82q6 -2 12 4 6 -7 13 -6\"/></g>\n<path fill=\"#c7d4ba\" d=\"M0 337q48 -6 88 -32t75 -21q44 2 87 34t134 27l91 17H0z\"/>\n<path fill=\"#98b6a8\" d=\"M0 328q56 -2 99 9t102 -11q52 -19 91 -8t86 28l64 8H0z\"/>\n<g stroke=\"#687e71\" stroke-width=\"2.1\"><path d=\"m131 320 5 -37h10l5 37\" fill=\"#f9e9c7\"/><path d=\"m134 303 1 -8h13l1 8\" fill=\"#bc7961\" stroke=\"none\"/><path d=\"M136 283v-9h10v9z\" fill=\"#e7cf93\"/><path d=\"m133 274 8 -7 8 7z\" fill=\"#64766b\"/><path d=\"M133 284h16m-9 -8v5\"/></g>\n<path fill=\"#719a8d\" d=\"M0 350q45 -20 79 -18t48 -12q17 -7 35 -2 22 8 46 5t54 9q37 13 86 13l50 9H0z\"/>\n<path fill=\"#a8cfc1\" d=\"M0 350h960v158H0z\"/>\n<path fill=\"url(#rip