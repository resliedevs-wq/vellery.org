{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/make_ride.py <<'PY'\nimport math\nfrom pathlib import Path\n\nparts = []\ndef add(s):\n    parts.append(s)\nadd('''<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" xmlns:xlink=\\\"http://www.w3.org/1999/xlink\\\" viewBox=\\\"0 0 960 700\\\" width=\\\"960\\\" height=\\\"700\\\" role=\\\"img\\\" aria-labelledby=\\\"title desc\\\">\n<title id=\\\"title\\\">Pelican on a coastal bicycle ride</title>\n<desc id=\\\"desc\\\">A white pelican in a sea-green cycling cap sits on the saddle of a vermilion bicycle. Its webbed feet pedal in circles and both spoked wheels turn as it rides past a lighthouse.</desc>\n<defs>\n  <linearGradient id=\\\"sky\\\" x2=\\\"0\\\" y2=\\\"1\\\" gradientUnits=\\\"objectBoundingBox\\\"><stop stop-color=\\\"#a9d6d0\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#e9edd5\\\"/></linearGradient>\n  <linearGradient id=\\\"sea\\\" x2=\\\"0\\\" y2=\\\"1\\\"><stop stop-color=\\\"#82b9b1\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#b3d4be\\\"/></linearGradient>\n  <linearGradient id=\\\"pouch\\\" x2=\\\".25\\\" y2=\\\"1\\\"><stop stop-color=\\\"#ffc070\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#f08252\\\"/></linearGradient>\n  <pattern id=\\\"speckle\\\" width=\\\"113\\\" height=\\\"79\\\" patternUnits=\\\"userSpaceOnUse\\\">\n    <path d=\\\"M9 13h1m39 9h.8m49 21h1m-73 19h1.1m41 7h.8m23-65h.7\\\" stroke=\\\"#244b4b\\\" stroke-opacity=\\\".15\\\" stroke-width=\\\"1.4\\\" stroke-linecap=\\\"round\\\"/>\n    <path d=\\\"M17 29h1.2m54 5h1m33 34h.9m-66-14h1\\\" stroke=\\\"#fff7d9\\\" stroke-opacity=\\\".65\\\" stroke-width=\\\"1.1\\\" stroke-linecap=\\\"round\\\"/>\n  </pattern>\n  <g id=\\\"wheel\\\">\n    <circle r=\\\"92\\\" fill=\\\"none\\\" stroke=\\\"#233f44\\\" stroke-width=\\\"14\\\"/>\n    <circle r=\\\"88\\\" fill=\\\"none\\\" stroke=\\\"#efd8a3\\\" stroke-width=\\\"6.5\\\"/>\n    <circle r=\\\"84\\\" fill=\\\"none\\\" stroke=\\\"#456466\\\" stroke-width=\\\"2.5\\\"/>''')\nfor j in range(24):\n    angle=j*math.tau/24\n    a=angle+(.44 if j%2 else -.44)\n    add(f'<path d=\\\"M{8*math.cos(a):.2f} {8*math.sin(a):.2f} L{83*math.cos(angle):.2f} {83*math.sin(angle):.2f}\\\" fill=\\\"none\\\" stroke=\\\"{(\\\"#587976\\\" if j%2 else \\\"#74908a\\\")}\\\" stroke-width=\\\"1.55\\\"/>')\nadd('''<g stroke=\\\"#e1ab63\\\" stroke-width=\\\"4\\\" stroke-linecap=\\\"round\\\"><path d=\\\"M0 -86a86 86 0 0 1 23 3\\\" fill=\\\"none\\\"/><path d=\\\"M-48 72l-3 -2\\\"/></g>\n  <path d=\\\"M-10 82l1 -7\\\" stroke=\\\"#314d50\\\" stroke-width=\\\"3\\\"/><circle r=\\\"9\\\" fill=\\\"#e9d5ab\\\" stroke=\\\"#28474a\\\" stroke-width=\\\"3\\\"/><circle r=\\\"3\\\" fill=\\\"#617e78\\\"/>\n  </g>\n  <g id=\\\"roadmarks\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\">\n    <path d=\\\"M15 650h47m97-8h20m72 31h57m75-23h13m55 16h32\\\" stroke=\\\"#c5966d\\\" stroke-width=\\\"2\\\"/>\n    <path d=\\\"M44 677h14m40-23h6m104-18h8m128 31h6m86-23h18\\\" stroke=\\\"#f7dcb0\\\" stroke-width=\\\"3\\\"/>\n  </g>\n</defs>\n<g stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\">\n<rect width=\\\"960\\\" height=\\\"700\\\" fill=\\\"url(#sky)\\\"/>\n<circle cx=\\\"762\\\" cy=\\\"144\\\" r=\\\"66\\\" fill=\\\"#ffdf9b\\\"/>\n<g fill=\\\"#f6f3d8\\\">\n  <path d=\\\"M54 166q8-6 24-6 7-18 26-15 10-20 29-17 19 0 25 20 19-7 29 7 20-1 28 9-94 4-161 2z\\\"/>\n  <path d=\\\"M781 161q9-8 21-7 5-14 19-12 10-15 27-10 11 2 16 16 18-3 28 9 17-1 24 5-62 3-135-1z\\\"/>\n</g>\n<g fill=\\\"none\\\" stroke=\\\"#658e87\\\" stroke-width=\\\"2.2\\\"><path d=\\\"M238 118q8-3 13 4 4-8 12-9m-40 25q6-2 10 3 3-6 9-7\\\"/></g>\n<\"'!-- Across the bay -->\n<path d=\"M0 345q73-22 124-10t93 15q44 1 99 15l48 13H0z\" fill=\"#86aca1\"/>\n<g transform=\"translate(108 286)\" stroke=\"#527773\" stroke-width=\"1.7\">\n  <path d=\"M-16 52l4-9h39l8 10\" fill=\"#74978a\" stroke=\"none\"/><path d=\"M-4 47l4-38h9l5 38z\" fill=\"#f8ead0\"/><path d=\"M-2 27h13l1 8H-3z\" fill=\"#cd7053\" stroke=\"none\"/>\n  <path d=\"M-1 9V0h11v9z\" fill=\"#efcc87\"/><path d=\"M-4 0l8-7 9 7z\" fill=\"#577d78\"/><path d=\"M-3 10h15M4 1v7\"/><path d=\"M19 47V35h14v12\" fill=\"#eee3c5\"/><path d=\"M16 35l10-8 10 8z\" fill=\"#c9785c\"/>\n</g>\n<path d=\"M0 350q48-6 81-14 52-12 98 7l47 12 54 18H0z\" fill=\"#608d83\"/>\n<path d=\"M0 362q125-5 228 3t228 6q120-4 255-7t249 1v183H0z\" fill=\"url(#sea)\"/>\n<g fill=\"none\" stroke=\"#e0e6c9\" stroke-width=\"2.3\">\n  <path d=\"M13 393h49m10 0h17m65-19h60m48 18h35m452-2h76m14 0h15m29-16h55m-179 45h46m36 12h87M42 435h100m9 0h25m20-19h37M7 469h51m735 0h71\"/>\n</g>\n<g transform=\"translate(831 365)\"><path d=\"M0 0l-2-32L-18 0z\" fill=\"#faf1cc\"/><path d=\"M2-24L13-1H2z\" fill=\"#d58c64\"/><path d=\"M-21 2h38l-6 4h-27z\" fill=\"#608781\"/></g>\n<!-- The sandy verge -->\n<path d=\"M0 480q118-25 223-1t195 23q133-4 245-20 149-24 297-10v159H0z\" fill=\"#d7d4a1\"/>\n<path d=\"M0 524q118-36 230-13t173 17q134-1 261-30 186-35 296-7v143H0z\" fill=\"#b9c898\"/>\n<path d=\"M0 555q106-21 235-10t234 7q113-12 204-26 162-26 287-12v118H0z\" fill=\"#9eb68b\"/>\n<g fill=\"none\" stroke=\"#748f71\" stroke-width=\"3\">\n<path d=\"M82 551q-3-17-12-27m13 25q2-26 9-41m-8 41q8-17 17-24m-48 30-8-13m9 11 4-18M861 520q-3-20-14-38m15 35q1-32 11-52m-7 49q6-18 16-26m14 26 6-17\"/>\n</g>\n<path d=\"M0 590q165-19 317-14t314-7q198-17 329-9v140H0z\" fill=\"#e7bf91\"/>\n<path d=\"M0 588q165-19 317-14t314-7q198-17 329-9\" fill=\"none\" stroke=\"#efcf9f\" stroke-width=\"6\"/>\n<g><animateTransform attributeName=\"transform\" type=\"translate\" from=\"0 0\" to=\"-480 0\" dur=\"2.4s\" repeatCount=\"indefinite\"/><use xlink:href=\"#roadmarks\"/><use xlink:href=\"#roadmarks\" x=\"480\"/><use xlink:href=\"#roadmarks\" x=\"960\"/></g>\n<ellipse cx=\"476\" cy=\"638\" rx=\"237\" ry=\"8\" fill=\"#bd9b79\" opacity=\".64\"/>\n<!-- Road wheels, with asymmetric rim marks and valves -->\n'\"''')\nfor x in [318,634]:\n    add(f'<g transform=\\\"translate({x} 538)\\\"><g><animateTransform attributeName=\\\"transform\\\" type=\\\"rotate\\\" from=\\\"0\\\" to=\\\"360\\\" dur=\\\"1.2s\\\" repeatCount=\\\"indefinite\\\"/><use xlink:href=\\\"#wheel\\\"/></g></g>')\n# analytic hip-knee-ankle linkage and circular pedals\ndef leg(near):\n    hip=(450,379) if near else (443,379)\n    col='#ec9b58' if near else '#ba7850'\n    foot='#f4a75e' if near else '#ce8552'\n    outline='#344849'\n    pts=[]; feet=[]; ts=[]\n    for i in range(73):\n        a=math.tau*(i/72)+(0 if near else math.pi)+.55\n        x,y=463+30*math.cos(a),532+30*math.sin(a)\n        toes=x-10,y-7\n        dx,dy=toes[0]-hip[0],toes[1]-hip[1]\n        l=math.hypot(dx,dy)\n        m=(100**2-103**2+l*l)/(2*l)\n        h=math.sqrt(100**2-m*m)\n        kx=hip[0]+(dx*m+dy*h)/l\n        ky=hip[1]+(dy*m-dx*h)/l\n        pts.append(f'M{hip[0]} {hip[1]} Q{hip[0]+8} {hip[1]+19} {kx:.2f} {ky:.2f} L{toes[0]:.2f} {toes[1]:.2f}')\n        feet.append(f'{x:.2f} {y:.2f}')\n        ts.append(f'M463 532L{x:.2f} {y:.2f}')\n    def motion(key,vals):\n        return f'<animate attributeName=\\\"{key}\\\" values=\\\"{\\\";\\\".join(vals)}\\\" dur=\\\"1.8s\\\" repeatCount=\\\"indefinite\\\"/>'\n    for sw,sc in [(15,outline),(10,col)]:\n        add(f'<path d=\\\"{pts[0]}\\\" fill=\\\"none\\\" stroke=\\\"{sc}\\\" stroke-width=\\\"{sw}\\\">{motion(\\\"d\\\",pts)}</path>')\n    for sw,sc in [(10,outline),(5.5,'#d6d9ba' if near else '#82918a')]:\n        add(f'<path d=\\\"{ts[0]}\\\" fill=\\\"none\\\" stroke=\\\"{sc}\\\" stroke-width=\\\"{sw}\\\">{motion(\\\"d\\\",ts)}</path>')\n    add(f'<g transform=\\\"translate({feet[0]})\\\"><animateTransform attributeName=\\\"transform\\\" type=\\\"translate\\\" values=\\\"{\\\";\\\".join(feet)}\\\" dur=\\\"1.8s\\\" repeatCount=\\\"indefinite\\\"/>')\n    add(f'''<rect x=\\\"-13\\\" y=\\\"-1\\\" width=\\\"30\\\" height=\\\"7\\\" rx=\\\"2.5\\\" fill=\\\"#30494a\\\"/><path d=\\\"M-9 2h6m6 0h8\\\" stroke=\\\"#c7b98a\\\" stroke-width=\\\"1.6\\\"/>\n    <path d=\\\"M-15-11q3-3 8 0l5 3 12-1 9 4-5 1 7 3q-5 2-15 0L-8-2q-8 1-9-3z\\\" fill=\\\"{foot}\\\" stroke=\\\"{outline}\\\" stroke-width=\\\"2.7\\\"/>\n    <path d=\\\"M-3-6l16 3\\\" stroke=\\\"#a86440\\\" stroke-width=\\\"1.4\\\"/></g>''')\nleg(False)\nadd('''<\"'!-- Enamel frame and metalwork -->\n<g fill=\"none\" stroke=\"#30494b\" stroke-width=\"12\">\n<path d=\"M318 538l112-137 33 131zM430 401l135-15 10 34-112 112z\"/>\n<path d=\"M575 420q18 53 59 118\"/></g>\n<g fill=\"none\" stroke=\"#d96542\" stroke-width=\"6.8\">\n<path d=\"M318 538l112-137 33 131zM430 401l135-15 10 34-112 112z\"/>\n<path d=\"M575 420q18 53 59 118\"/></g>\n<path d=\"M433 398l128-14m-92 137 98-98\" fill=\"none\" stroke=\"#f4a16a\" stroke-width=\"2\"/>\n<path d=\"M429 401l-6-24m143 9-6-22\" stroke=\"#344f51\" stroke-width=\"9\"/><path d=\"M428 395l-5-18m142 4-4-14\" stroke=\"#c3cec0\" stroke-width=\"4\"/>\n<path d=\"M560 365l22-11q8-4 12 0t-3 10l-13 4\" fill=\"none\" stroke=\"#314b4b\" stroke-width=\"7\"/><path d=\"M580 351l10-2\" stroke=\"#9d623f\" stroke-width=\"8\"/>\n<path d=\"M589 365q24 31 1 56\" fill=\"none\" stroke=\"#456264\" stroke-width=\"2.4\"/>\n<path d=\"M387 369q13-7 30-3 14 5 42 1 9-2 12 2 2 5-10 8-29 8-61 4-12-1-13-12z\" fill=\"#784b38\" stroke=\"#30494b\" stroke-width=\"3.5\"/>\n<path d=\"M395 370q12-3 26 0\" fill=\"none\" stroke=\"#c98558\" stroke-width=\"2.8\"/>\n<path d=\"M316 529l145-16a19 19 0 1 1 2 38l-145-4a9 9 0 0 1-2-18z\" fill=\"#678580\" stroke=\"#30494b\" stroke-width=\"3\"/>\n<path d=\"M321 533l119-12\" stroke=\"#aebca6\" stroke-width=\"2\"/>\n<circle cx=\"463\" cy=\"532\" r=\"17\" fill=\"#c2cbb4\" stroke=\"#30494b\" stroke-width=\"3\"/>\n<circle cx=\"318\" cy=\"538\" r=\"5\" fill=\"#d6c69f\" stroke=\"#30494b\" stroke-width=\"2\"/>\n'\"''')\nleg(True)\nadd('''<circle cx=\\\"463\\\" cy=\\\"532\\\" r=\\\"4\\\" fill=\\\"#f7d8a1\\\" stroke=\\\"#344a4a\\\" stroke-width=\\\"2\\\"/>\n<\"'!-- Pelican. The belly overlaps the saddle and the near wing rests on the bars. -->\n<g stroke=\"#2e494b\"