sform=\"translate(476 416)\">\n      <animateTransform attributeName=\"transform\" type=\"translate\"\n        values=\"476 416;491 400;497 424;510 441;476 416\"\n        dur=\"1.4s\" repeatCount=\"indefinite\"\n        calcMode=\"spline\" keyTimes=\"0;0.25;0.5;0.75;1\"\n        keySplines=\"0.45 0 0.55 1;0.45 0 0.55 1;0.45 0 0.55 1;0.45 0 0.55 1\"/>\n      <circle r=\"5.5\" fill=\"#D58636\" stroke=\"#263436\" stroke-width=\"2.4\"/>\n    </g>\n    <g transform=\"translate(452 481)\">\n      <animateTransform attributeName=\"transform\" type=\"translate\"\n        values=\"452 481;488 445;524 481;488 517;452 481\"'''\nif far_anchor not in s:\n    print('far anchor not found')\ns=s.replace(far_anchor,far_insert,1)\n\n# Add animated knee joint for the near leg, before its foot.\nnear_anchor='''    </g>\n    <g transform=\"translate(524 481)\">\n      <animateTransform attributeName=\"transform\" type=\"translate\"\n        values=\"524 481;488 517;452 481;488 445;524 481\"'''\nnear_insert='''    </g>\n    <g transform=\"translate(506 414)\">\n      <animateTransform attributeName=\"transform\" type=\"translate\"\n        values=\"506 414;519 435;498 422;513 406;506 414\"\n        dur=\"1.4s\" repeatCount=\"indefinite\"\n        calcMode=\"spline\" keyTimes=\"0;0.25;0.5;0.75;1\"\n        keySplines=\"0.45 0 0.55 1;0.45 0 0.55 1;0.45 0 0.55 1;0.45 0 0.55 1\"/>\n      <circle r=\"6\" fill=\"#F2A33A\" stroke=\"#263436\" stroke-width=\"2.5\"/>\n      <path d=\"M-2 2 C0 0 3 0 5 1\" fill=\"none\" stroke=\"#C97527\" stroke-width=\"1.4\" stroke-linecap=\"round\"/>\n    </g>\n    <g transform=\"translate(524 481)\">\n      <animateTransform attributeName=\"transform\" type=\"translate\"\n        values=\"524 481;488 517;452 481;488 445;524 481\"'''\nif near_anchor not in s:\n    print('near anchor not found')\ns=s.replace(near_anchor,near_insert,1)\n\np.write_text(s)\nprint('patched')\nPY\npython3 - <<'PY'\nimport xml.etree.ElementTree as ET\nET.parse('pelican.svg'); print('XML 