{"type":"tool_call","callId":"call_00_TaMbiCacjywawi4IYE5H5649","tool":"bash","input":{"command":"python3 - <<'PY'\nimport math\nBB=(465,470); r=46\ndef knee(H,F,L1=78,L2=96):\n    hx,hy=H; fx,fy=F\n    dx,dy=fx-hx,fy-hy\n    raw=math.hypot(dx,dy); d=min(raw,L1+L2-0.01)\n    a=(L1*L1-L2*L2+d*d)/(2*d)\n    h=math.sqrt(max(0,L1*L1-a*a))\n    ux,uy=dx/raw,dy/raw\n    bx,by=hx+a*ux,hy+a*uy\n    k1=(bx-h*uy, by+h*ux); k2=(bx+h*uy, by-h*ux)\n    return (k1 if k1[0]>k2[0] else k2), raw\nfor H in [(445,350),(430,345)]:\n print('H',H)\n for deg in [25,65,115,155,205,245,295,335]:\n  th=math.radians(deg); F=(BB[0]+r*math.cos(th),BB[1]+r*math.sin(th)-6)\n  k,d=knee(H,F)\n  print(deg, tuple(round(v,1) for v in F), tuple(round(v,1) for v in k), round(d,1))\nPY","description":"Recompute IK endpoints at ankles"}}
