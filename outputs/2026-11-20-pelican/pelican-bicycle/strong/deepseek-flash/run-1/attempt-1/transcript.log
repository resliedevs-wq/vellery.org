{"type":"tool_call","callId":"call_00_EltIL4UD74v7lNcluUEv9076","tool":"bash","input":{"command":"python3 - <<'PY'\nimport math\nBB=(465.0,470.0); r=46.0\ndef pose(H,deg,L1=78,L2=96):\n    th=math.radians(deg)\n    F=(BB[0]+r*math.cos(th), BB[1]+r*math.sin(th)-6)\n    hx,hy=H; fx,fy=F\n    dx,dy=fx-hx,fy-hy\n    raw=math.hypot(dx,dy); d=min(raw,L1+L2-0.01)\n    a=(L1*L1-L2*L2+d*d)/(2*d)\n    h=math.sqrt(max(0,L1*L1-a*a))\n    ux,uy=dx/raw,dy/raw\n    bx,by=hx+a*ux,hy+a*uy\n    k1=(bx-h*uy, by+h*ux); k2=(bx+h*uy, by-h*ux)\n    k=(k1 if k1[0]>k2[0] else k2)\n    return f\"M {hx:.1f} {hy:.1f} L {k[0]:.1f} {k[1]:.1f} L {fx:.1f} {fy:.1f}\"\nfor name,H in [('near',(445,350)),('far',(430,345))]:\n    vals=[pose(H,25+15*i) for i in range(25)]\n    print(name)\n    print('values=\"'+';'.join(vals)+'\"')\n    print()\nPY","description":"Generate leg morph path keyframe values"}}
