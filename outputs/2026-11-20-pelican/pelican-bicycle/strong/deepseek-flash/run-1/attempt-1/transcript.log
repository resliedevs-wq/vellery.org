{"type":"tool_call","callId":"call_00_JgLDSda2gRRG6YIXrzOx3828","tool":"bash","input":{"command":"python3 - <<'PY'\nimport math\nBB=(465,470); r=50\ndef knee(H,F,L1=82,L2=104):\n    hx,hy=H; fx,fy=F\n    dx,dy=fx-hx,fy-hy\n    d=math.hypot(dx,dy)\n    d=min(d,L1+L2-0.01)\n    a=(L1*L1-L2*L2+d*d)/(2*d)\n    h=math.sqrt(max(0,L1*L1-a*a))\n    ux,uy=dx/math.hypot(dx,dy),dy/math.hypot(dx,dy)\n    bx,by=hx+a*ux,hy+a*uy\n    # front-side knee (positive x)\n    k1=(bx-h*uy, by+h*ux)\n    k2=(bx+h*uy, by-h*ux)\n    return k1 if k1[0]>k2[0] else k2\n\nfor H in [(438,340),(420,344)]:\n    print('H',H)\n    for deg in [25,65,115,155,205,245,295,335]:\n        th=math.radians(deg)\n        F=(BB[0]+r*math.cos(th),BB[1]+r*math.sin(th))\n        k=knee(H,F)\n        d=math.hypot(F[0]-H[0],F[1]-H[1])\n        print(deg, 'F',tuple(round(v,1) for v in F),'K',tuple(round(v,1) for v in k),'d',round(d,1))\nPY","description":"Compute IK leg poses at sample crank angles"}}
