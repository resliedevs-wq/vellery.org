{"type":"tool_call","callId":"call_00_IBZTMvF2mSt8V8Z3DMCM6871","tool":"bash","input":{"command":"python3 - <<'PY'\nimport math\nBB=(505,527); r=38\nlegs={\n 'near': {'H':(452,378),'L1':100,'L2':95,'phase':0},\n 'far': {'H':(442,374),'L1':102,'L2':97,'phase':math.pi},\n}\nN=24\nfor name,cfg in legs.items():\n    H=cfg['H']; L1=cfg['L1']; L2=cfg['L2']; phase=cfg['phase']\n    alphas=[]; rels=[]; knees=[]; feet=[]\n    for i in range(N+1):\n        th=2*math.pi*i/N\n        # crank point (0,38) rotated clockwise by θ, then far offset phase\n        x = -r*math.sin(th+phase)\n        y = r*math.cos(th+phase)\n        foot=(BB[0]+x, BB[1]+y)\n        target=(foot[0], foot[1]-10)\n        dx=target[0]-H[0]; dy=target[1]-H[1]\n        d=math.hypot(dx,dy)\n        if d > L1+L2-0.01: print('unreachable',name,i,d)\n        d=min(d,L1+L2-0.01)\n        a=(L1*L1-L2*L2+d*d)/(2*d)\n        h=math.sqrt(max(0,L1*L1-a*a))\n        ux=dx/math.hypot(dx,dy); uy=dy/math.hypot(dx,dy)\n        base=(H[0]+a*ux, H[1]+a*uy)\n        px=-uy; py=ux\n        k1=(base[0]+h*px, base[1]+h*py)\n        k2=(base[0]-h*px, base[1]-h*py)\n        knee = k1 if k1[0] > k2[0] else k2\n        alpha=math.degrees(math.atan2(knee[1]-H[1],knee[0]-H[0]))\n        beta=math.degrees(math.atan2(target[1]-knee[1],target[0]-knee[0]))\n        if alphas:\n            while alpha-alphas[-1]>180: alpha-=360\n            while alpha-alphas[-1]<-180: alpha+=360\n        rel=beta-alpha\n        if rels:\n            while rel-rels[-1]>180: rel-=360\n            while rel-rels[-1]<-180: rel+=360\n        alphas.append(round(alpha,2)); rels.append(round(rel,2)); knees.append((round(knee[0],1),round(knee[1],1))); feet.append((round(target[0],1),round(target[1],1)))\n    print(name)\n    print('alpha=', ';'.join(map(str,alphas)))\n    print('rel=', ';'.join(map(str,rels)))\n    print('dmax', max(math.hypot(f[0]-H[0],f[1]-H[1]) for f in feet))\n    print('knees',knees[:5], '...', knees[12])\nPY","description":"Recompute leg IK for clockwise crank"}}
