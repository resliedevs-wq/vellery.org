{"type":"tool_call","callId":"call_00_k7zKbWNoyMgoEsH1I4PT1681","tool":"bash","input":{"command":"python3 - <<'PY'\nimport math\n\ndef ik(hip,L1,L2,target):\n    Hx,Hy=hip; Px,Py=target\n    dx,dy=Px-Hx,Py-Hy\n    d=math.hypot(dx,dy)\n    d=min(d,L1+L2-0.01)\n    a=(L1*L1-L2*L2+d*d)/(2*d)\n    h=math.sqrt(max(0,L1*L1-a*a))\n    mx,my=Hx+a*dx/d,Hy+a*dy/d\n    kx=mx+h*dy/d; ky=my-h*dx/d\n    return kx,ky,d\nBB=(610,565);R=36; Hf=(548,396)\nlast=None\nfor i in range(0,49):\n    t=i/48; th=2*math.pi*t+math.pi\n    P=(BB[0]+R*math.cos(th),BB[1]+R*math.sin(th))\n    kx,ky,d=ik(Hf,110,115,P)\n    if i%4==0 or (last and abs(kx-last)>8):\n        print(i, 'P',tuple(round(v) for v in P),'d',round(d,1),'K',round(kx,1),round(ky,1))\n    last=kx\nPY","description":"Check revised far leg IK smoothness"}}
