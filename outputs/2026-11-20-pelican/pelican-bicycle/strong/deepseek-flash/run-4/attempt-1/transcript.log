{"type":"tool_call","callId":"call_00_df7aCrliz827qhG6eKwe1550","tool":"bash","input":{"command":"cat > /tmp/make_frame.py <<'PY'\nimport re, math, sys\ns=open('pelican.svg').read()\n\ndef ik(hip,L1,L2,target):\n    Hx,Hy=hip;Px,Py=target;dx,dy=Px-Hx,Py-Hy;d=math.hypot(dx,dy);d=min(d,L1+L2-.01)\n    a=(L1*L1-L2*L2+d*d)/(2*d);h=math.sqrt(max(0,L1*L1-a*a));mx,my=Hx+a*dx/d,Hy+a*dy/d\n    return f\"M {Hx:.1f} {Hy:.1f} L {mx+h*dy/d:.1f} {my-h*dx/d:.1f} L {Px:.1f} {Py:.1f}\", mx+h*dy/d, my-h*dx/d\n\ndef frame_values(hip,L1,L2,phase,t):\n    vals=[]; kxs=[]; kys=[]\n    for i in range(49):\n        th=2*math.pi*i/48+phase\n        P=(610+36*math.cos(th),565+36*math.sin(th))\n        p,kx,ky=ik(hip,L1,L2,P)\n        vals.append(p);kxs.append(f'{kx:.1f}');kys.append(f'{ky:.1f}')\n    idx=round(t/2.4*48)%48\n    return vals[idx],kxs[idx],kys[idx]\n\ndef freeze_leg(block,hip,L1,L2,phase,t):\n    d,kx,ky=frame_values(hip,L1,L2,phase,t)\n    block=re.sub(r'<animate attributeName=\"d\"[^>]*/>','',block)\n    block=re.sub(r'd=\"[^\"]*\"', 'd=\"'+d+'\"', block)\n    block=re.sub(r'<animate attributeName=\"cx\"[^>]*/>','',block)\n    block=re.sub(r'<animate attributeName=\"cy\"[^>]*/>','',block)\n    # remove anim then set knee circle attrs\n    def repl(m):\n        tag=m.group(0)\n        tag=re.sub(r'(<circle\\b)', r'\\1 cx=\"'+kx+'\" cy=\"'+ky+'\"', tag, count=1)\n        return tag\n    block=re.sub(r'<circle r=\"[^\"]+\" fill=\"#[^\"]+\" stroke=\"#[^\"]+\" stroke-width=\"2.5\">', repl, block)\n    return block\n\nfar=re.search(r'<g id=\"far-leg\".*?</g>',s,re.S).group(0)\ns=s.replace(far, freeze_leg(far,(548,396),110,115,math.pi,0.6))\nnear=re.search(r'<g id=\"near-leg\".*?</g>',s,re.S).group(0)\ns=s.replace(near, freeze_leg(near,(550,398),108,113,0,0.6))\n\n# cranks and chainring rotate 90deg at t=0.6 (2.4s period)\ns=s.replace('<animateTransform attributeName=\"transform\" type=\"rotate\" values=\"0 610 565;360 610 565\" dur=\"2.4s\" repeatCount=\"indefinite\"/>',\n            '<animateTransform attributeName=\"transform\" type=\"rotate\" values=\"90 610 565;90 610 565\" dur=\"2.4s\" repeatCount=\"indefinite\"/>')\n# pedals counter-rotate\ns=s.replace('<animateTransform attributeName=\"transform\" type=\"rotate\" values=\"0;-360\" dur=\"2.4s\" repeatCount=\"indefinite\"/>',\n            '<animateTransform attributeName=\"transform\" type=\"rotate\" values=\"-90;-90\" dur=\"2.4s\" repeatCount=\"indefinite\"/>')\n# wheel rotation at t=.6: 144deg\ns=s.replace('<animateTransform attributeName=\"transform\" type=\"rotate\" values=\"0 390 545;360 390 545\" dur=\"1.5s\" repeatCount=\"indefinite\"/>',\n            '<animateTransform attributeName=\"transform\" type=\"rotate\" values=\"144 390 545;144 390 545\" dur=\"1.5s\" repeatCount=\"indefinite\"/>')\ns=s.replace('<animateTransform attributeName=\"transform\" type=\"rotate\" values=\"0 850 545;360 850 545\" dur=\"1.5s\" repeatCount=\"indefinite\"/>',\n            '<animateTransform attributeName=\"transform\" type=\"rotate\" values=\"144 850 545;144 850 545\" dur=\"1.5s\" repeatCount=\"indefinite\"/>')\nopen('frame90.svg','w').write(s)\nprint('frame90 written')\nPY\npython3 /tmp/make_frame.py\nrsvg-convert -w 1200 -h 800 frame90.svg -o frame90.png\nls -lh frame90.svg frame90.png","description":"Create and render 90-degree test frame"}}
