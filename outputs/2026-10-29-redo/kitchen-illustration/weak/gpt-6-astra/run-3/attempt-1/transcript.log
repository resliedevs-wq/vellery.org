{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"mkdir -p /tmp/artifacts && cat > /tmp/artifacts/draw_kitchen.py <<'PY'\nfrom PIL import Image, ImageDraw, ImageFilter\nimport math, random\nrandom.seed(8)\nS=3; W,H=1400,1100\nim=Image.new('RGB',(W*S,H*S),'#f3e5cb'); d=ImageDraw.Draw(im)\ndef box(b,c,r=0,outline=None,width=1):\n b=tuple(int(v*S) for v in b)\n if r:d.rounded_rectangle(b,int(r*S),fill=c,outline=outline,width=width*S)\n else:d.rectangle(b,fill=c,outline=outline,width=width*S)\ndef poly(p,c):d.polygon([(int(x*S),int(y*S)) for x,y in p],fill=c)\ndef ellipse(b,c,outline=None,width=1):d.ellipse(tuple(int(v*S) for v in b),fill=c,outline=outline,width=width*S)\ndef line(p,c,w=2):d.line([(int(x*S),int(y*S)) for x,y in p],fill=c,width=int(w*S),joint='curve')\ndef bez(p,c,w=2):\n pts=[]\n for i in range(101):\n  t=i/100;u=1-t\n  pts.append((u**3*p[0][0]+3*u*u*t*p[1][0]+3*u*t*t*p[2][0]+t**3*p[3][0],u**3*p[0][1]+3*u*u*t*p[1][1]+3*u*t*t*p[2][1]+t**3*p[3][1]))\n line(pts,c,w)\ndef leaf(x,y,ang,size,c):\n vx,vy=math.cos(ang)*size,math.sin(ang)*size;nx,ny=-vy*.38,vx*.38\n poly([(x,y),(x+vx*.45+nx,y+vy*.45+ny),(x+vx,y+vy),(x+vx*.45-nx,y+vy*.45-ny)],c)\n# plaster, floor, skirting\nbox((0,0,1400,790),'#f0dfbf')\nbox((0,790,1400,1100),'#c69568')\nbox((0,780,1400,805),'#997550');box((0,776,1400,786),'#d6b488')\nfor y in [865,945,1040]:line([(0,y),(1400,y)],'#ad7c55',3)\nfor x,y in [(150,805),(620,805),(1100,805),(380,865),(910,865),(150,945),(640,945),(1170,945),(390,1040),(910,1040)]:line([(x,y),(x,y+80)],'#ad7c55',2)\n# sunlight pools\npoly([(224,487),(530,477),(1160,1100),(555,1100)],'#e3b77d')\npoly([(272,497),(365,497),(902,1100),(729,1100)],'#edd09a')\npoly([(395,496),(488,496),(1122,1100),(943,1100)],'#edd09a')\n# left wall border\nbox((0,0,45,790),'#dec6a1');box((42,0,50,790),'#c9ac85')\n# arched window shadow and wooden surround\nbox((145,116,605,542),'#d8bd95',r=155)\nbox((130,103,584,527),'#a78055',r=151)\nbox((14