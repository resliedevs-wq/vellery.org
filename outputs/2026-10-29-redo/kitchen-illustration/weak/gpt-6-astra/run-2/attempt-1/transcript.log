{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"mkdir -p artifacts && cat > artifacts/draw_kitchen.py <<'PY'\nfrom PIL import Image, ImageDraw, ImageFilter\nimport math, random\nrandom.seed(12)\nS=2; W,H=1400,1080\nim=Image.new('RGB',(W*S,H*S),'#f3e5cc'); d=ImageDraw.Draw(im)\ndef poly(p,fill): d.polygon([(int(x*S),int(y*S)) for x,y in p],fill)\ndef line(p,fill,width=3): d.line([(int(x*S),int(y*S)) for x,y in p], fill,width*S,joint='curve')\ndef rect(b,fill,r=0,outline=None,width=2):\n b=tuple(int(a*S) for a in b)\n if r: d.rounded_rectangle(b,r*S,fill,outline,width*S)\n else: d.rectangle(b,fill,outline,width*S)\ndef ellipse(b,fill,outline=None,width=2): d.ellipse(tuple(int(a*S) for a in b),fill,outline,width*S)\ndef curve(p,fill,width=3):\n out=[]\n for i in range(81):\n  t=i/80;u=1-t\n  out.append((u**3*p[0][0]+3*u*u*t*p[1][0]+3*u*t*t*p[2][0]+t**3*p[3][0],u**3*p[0][1]+3*u*u*t*p[1][1]+3*u*t*t*p[2][1]+t**3*p[3][1]))\n line(out,fill,width)\ndef leaf(x,y,a,length=35,color='#708559'):\n vx,vy=math.cos(a),math.sin(a);nx,ny=-vy,vx\n pts=[]\n for i in range(25):\n  t=i/24;w=math.sin(t*math.pi)*length*.24\n  pts.append((x+vx*length*t+nx*w,y+vy*length*t+ny*w))\n for i in range(24,-1,-1):\n  t=i/24;w=math.sin(t*math.pi)*length*.24\n  pts.append((x+vx*length*t-nx*w,y+vy*length*t-ny*w))\n poly(pts,color)\n# plaster and broad, gentle morning light\nrect((0,0,1400,775),'#f0dfbd')\npoly([(0,30),(505,0),(1050,760),(455,760)],'#f6e8c9')\nrect((0,735,1400,1080),'#b58258')\nfor y in [788,853,929,1020]: line([(0,y),(1400,y)],'#a77350',3)\nfor x in range(-300,1600,240): line([(x,735),(x+250,1080)],'#a77350',2)\npoly([(240,735),(640,735),(1060,1080),(560,1080)],'#d7ac74')\npoly([(425,735),(452,735),(805,1080),(773,1080)],'#be925f')\n# backsplash\nrect((42,435,1356,594),'#f2e9d3')\nfor y in [435,487,539,591]: line([(42,y),(1356,y)],'#ded7bd',2)\nfor row in range(3):\n for x in range(45+(row%2)*54,1400,109): line([(x,435+row*52),(x,487+row*52)],'#ded7bd',2)\n# window frame and blue morning garden\nrect((140,98,622,476),'#d4b68b',10)\nrect((151,106,611,467),'#fff4d6',7)\nrect((170,125,591,445),'#bdd6cc',3)\nellipse((471,145,547,221),'#fff0b6')\npoly([(170,335),(225,304),(279,321),(326,290),(390,320),(448,281),(518,307),(591,280),(591,445),(170,445)],'#a9bfa0')\npoly([(170,390),(233,350),(306,379),(363,341),(425,377),(505,342),(591,369),(591,445),(170,445)],'#8fa887')\nfor x,y in [(195,360),(550,348),(294,371)]:\n line([(x,y+74),(x,y-20)],'#879776',5)\n for dx,dy in [(-25,-9),(13,-31),(-17,-45),(14,-58)]: leaf(x,y+dy+.5*abs(dx),math.atan2(-14,dx),38,'#8aa27e')\nrect((371,119,389,454),'#fff5d7');rect((161,276,599,291),'#fff5d7')\nrect((131,459,636,480),'#b28a60',4);rect((124,453,640,468),'#fff2cf',3)\n# curtain rod and soft linen curtains\nline([(111,89),(651,89)],'#876846',7)\nellipse((101,80,119,98),'#876846');ellipse((644,80,662,98),'#876846')\npoly([(123,96),(233,96),(221,196),(192,284),(164,364),(119,372)],'#fff8e4')\npoly([(527,96),(632,96),(646,374),(604,365),(572,285),(540,197)],'#fff8e4')\nfor x in [137,157,178,199,219]: curve([(x,99),(x-3,181),(x-20,289),(126+(x-137)*.39,361)],'#e9ddc0',3)\nfor x in [542,563,586,609,626]: curve([(x,99),(x+3,186),(x+18,289),(602+(x-542)*.45,365)],'#e9ddc0',3)\nline([(121,330),(179,324)],'#c8ad7b',6);line([(594,326),(642,334)],'#c8ad7b',6)\n# upper shelves\nfor y in [224,390]:\n rect((764,y+11,1307,y+23),'#d9c19b',3)\n rect((750,y,1315,y+14),'#a9774e',3)\n line([(784,y+17),(784,y+46),(819,y+17)],'#916440',7)\n line([(1276,y+17),(1276,y+46),(1241,y+17)],'#916440',7)\n# crockery and jars\nfor x,h,c in [(782,63,'#e4d4ad'),(844,81,'#d5b07a'),(908,57,'#f6ebcd')]:\n rect((x,224-h,x+45,223),c,9, '#b89a6e',2)\n rect((x-2,219-h,x+47,229-h),'#9c7951',3)\n rect((x+8,193-h//2,x+37,208-h//2),'#faf1d8',2)\nellipse((1007,126,1103,223),'#faf1d6','#c4b58c',3)\nellipse((1020,139,1090,211),None,'#97a68b',4)\nellipse((1032,151,1078,198),None,'#97a68b',2)\n# blue jug on shelf\nelli