and tall faucet\nellipse((279,564,558,585),'#7a8477')\nellipse((298,567,539,580),'#a9b6a0')\ncurve([(399,568),(399,483),(457,482),(457,536)],'#748578',12)\ncurve([(401,565),(401,490),(453,489),(454,530)],'#c5c8ab',4)\nline([(378,560),(378,542),(388,542)],'#7a8877',6)\n# herb at window\npoly([(203,519),(259,519),(251,571),(215,571)],'#bb7854')\nrect((199,513,262,526),'#cc8d62',4)\nfor x,y in [(229,477),(219,488),(245,487),(212,461),(243,457)]:\n line([(231,516),(x,y)],'#6f8354',3)\n leaf(x,y,-2.7,25,'#88985d');leaf(x,y,-.6,27,'#72874f')\n# cutting board, bread, oil\nrect((635,474,717,575),'#c29660',12, '#ac7d48',2)\nrect((663,447,689,488),'#c29660',8)\nellipse((671,457,680,466),'#916e48')\nrect((740,512,773,574),'#8a9a62',5);rect((749,489,764,520),'#8a9a62',3);rect((749,485,764,498),'#b9955a',2)\nrect((744,535,770,557),'#eee3b8',2)\n# stovetop and kettle\nrect((808,570,1078,580),'#555e50',3)\nfor x in [850,1017]:ellipse((x-31,561,x+31,574),None,'#414b42',4)\nellipse((919,473,995,551),None,'#525e50',12)\npoly([(902,535),(871,507),(862,510),(878,546),(904,557)],'#c09352')\nellipse((893,504,999,571),'#cfac64')\nrect((914,496,977,509),'#b18b49',5)\nellipse((937,482,954,500),'#616853')\ncurve([(909,524),(905,546),(914,555),(921,558)],'#e6cb89',4)\n# soft kettle steam\ncurve([(873,501),(843,474),(892,466),(869,438)],'#fff7df',4)\ncurve([(880,479),(897,456),(869,449),(882,428)],'#f9efda',3)\n# utensil pot\nrect((1195,522,1255,576),'#ddcda9',8)\nfor x,y in [(1205,479),(1225,471),(1246,483)]:\n line([(1223,545),(x,y)],'#9d7750',5)\n ellipse((x-8,y-19,x+8,y+7),'#b89562')\n# hanging cloth from countertop\npoly([(1116,593),(1175,593),(1179,701),(1119,708)],'#efdfbc')\nfor x in [1125,1140,1155,1170]:line([(x,598),(x+3,699)],'#c59370',2)\nfor y in [672,682,691]:line([(1120,y),(1176,y-4)],'#c59370',2)\n# light pendant\nline([(697,0),(697,97)],'#827251',4)\nrect((682,94,712,115),'#8e8b67',5)\npoly([(682,108),(710,108),(760,173),(632,173)],'#93a184')\nellipse((632,160,760,183),'#7686