 (48, 29, 18), 115, 7, (6, 6))\n# eggs\nfor (cx, cy, rx, ry, tilt) in [(458, 764, 24, 18, -8), (492, 758, 25, 19, 5), (520, 770, 22, 17, 12)]:\n    el(ImageDraw.Draw(base), (cx - rx, cy - ry, cx + rx, cy + ry), \"#c99863\")\n    el(ImageDraw.Draw(base), (cx - rx + 5, cy - ry + 2, cx + rx - 8, cy + ry - 6), \"#ddb17a\")\n    el(ImageDraw.Draw(base), (cx - 8, cy - 10, cx + 2, cy - 4), \"#f1d4a7\")\n    ln(ImageDraw.Draw(base), [(cx - rx + 7, cy + 8), (cx + rx - 10, cy + 2)], \"#b58353\", 1)\n# bowl\ngrad_rect(base, (428, 768, 540, 810), \"#e7dcc8\", \"#b7a78d\", radius=10)\nel(ImageDraw.Draw(base), (428, 756, 540, 790), \"#f0e7d5\")\nel(ImageDraw.Draw(base), (437, 761, 531, 784), \"#c9b99f\")\nln(ImageDraw.Draw(base), [(434, 782), (534, 782)], \"#a38f74\", 2)\nln(ImageDraw.Draw(base), [(440, 793), (528, 793)], \"#f7efdd\", 1)\n# tiny thyme sprig\nln(ImageDraw.Draw(base), [(526, 766), (536, 748)], \"#5f7854\", 2)\nfor lx, ly in [(530, 758), (534, 752), (528, 750)]:\n    el(ImageDraw.Draw(base), (lx - 5, ly - 3, lx + 4, ly + 3), \"#7d9166\")\n\n'''\ns=s.replace(marker, eggs+marker)\n# add curtain rings and deepen folds\nold='''    # tie-back\n    tc = tie_c'''\nnew='''    # rings at the curtain rod\n    xs = range(207, 330, 21) if side == \"left\" else range(972, 1092, 21)\n    for rx in xs:\n        d = ImageDraw.Draw(base)\n        d.ellipse(bx((rx - 5, 40, rx + 5, 54)), outline=C(\"#8a6a49\"), width=max(1, int(1.5 * S)))\n        d.arc(bx((rx - 5, 40, rx + 5, 54)), 190, 350, fill=C(\"#d4ae7b\"), width=max(1, int(1.2 * S)))\n    # tie-back\n    tc = tie_c'''\nassert old in s\ns=s.replace(old,new)\ns=s.replace('\"#9a6e45\", 5)\\n    el(ImageDraw.Draw(base), (tc[0] - 11', '\"#a96d47\", 7)\\n    el(ImageDraw.Draw(base), (tc[0] - 11')\n# stronger folds alphas\ns=s.replace('(118, 83, 54, a)', '(100, 68, 43, a)')\ns=s.replace('fold_specs = [(208, 210, 198, 630, 34, 32), (240, 170, 240, 630, 26, 26),\\n                      (272, 240, 278, 632, 24, 30), (306, 300, 320, 632, 17, 18)]',\n            'fold_specs = [(208, 210, 198, 630, 34, 48), (240, 170, 240, 630, 26, 38),\\n                      (272, 240, 278, 632, 24, 42), (306, 300, 320, 632, 17, 28)]')\ns=s.replace('fold_specs = [(1082, 210, 1090, 630, 34, 30), (1054, 170, 1052, 630, 26, 25),\\n                      (1024, 240, 1018, 632, 24, 28), (994, 300, 980, 632, 17, 16)]',\n            'fold_specs = [(1082, 210, 1090, 630, 34, 45), (1054, 170, 1052, 630, 26, 34),\\n                      (1024, 240, 1018, 632, 24, 38), (994, 300, 980, 632, 17, 25)]')\n# insert screen sunlight in atmosphere, before mullion shadows\nmarker='''# window mullion shadows on counter'''\nsun='''# stronger morning light, screened over the room\nlm = Image.new(\"L\", (CW, CH), 0); ld = ImageDraw.Draw(lm)\nld.polygon(pts([(265, 120), (505, 112), (1510, 930), (1180, 1200), (900, 1200)]), fill=64)\nld.polygon(pts([(400, 220), (640, 140), (1220, 1200), (960, 1200)]), fill=54)\nld.polygon(pts([(720, 790), (1040, 770), (1230, 1050), (920, 1120)]), fill=82)\nld.polygon(pts([(270, 640), (500, 630), (590, 810), (330, 815)]), fill=58)\nlm = lm.filter(ImageFilter.GaussianBlur(24 * S))\nbase = screen_light(base, lm, \"#ffd49a\", 255)\n\n# crisp sunlit edge on top of window and left curtain\nlm2 = Image.new(\"L\", (CW, CH), 0); ld = ImageDraw.Draw(lm2)\nld.polygon(pts([(210, 60), (340, 55), (320, 360), (245, 640), (195, 640)]), fill=38)\nld.polygon(pts([(930, 120), (1030, 120), (1010, 500), (960, 620), (1000, 620)]), fill=20)\nlm2 = lm2.filter(ImageFilter.GaussianBlur(12 * S))\nbase = screen_light(base, lm2, \"#ffe1b4\", 255)\n\n# window mullion shadows on counter'''\nassert marker in s\ns=s.replace(marker,sun)\n# strengthen mullion shadow values\ns=s.replace('fill=(91, 55, 31, 28))\\nmd.polygon(pts([(290, 790), (330, 790), (500, 1200), (450, 1200)]),\\n           fill=(91, 55, 31, 18))',\n            'fill=(70, 42, 24, 42))\\nmd.polygon(pts([(290, 790), (330, 790), (500, 1200), (450, 1200)]),\\n           fill=(70, 42, 24, 28))')\n# final color/contrast enhancement before save\nold='''# final downscale\nout = base.convert(\"RGB\").resize((W, H), Image.LANCZOS)\nout.save(\"cozy_kitchen_morning.png\", quality=95)'''\nnew='''# final downscale with a gentle color lift\nout = base.convert(\"RGB\").resize((W, H), Image.LANCZOS)\nfrom PIL import ImageEnhance\nout = ImageEnhance.Color(out).enhance(1.08)\nout = ImageEnhance.Contrast(out).enhance(1.035)\nout.save(\"cozy_kitchen_morning.png\", quality=95)'''\nassert old in s\ns=s.replace(old,new)\np.write_text(s)\nPY\npython3 draw_kitchen.py","description":"Add sunlight, eggs, oven glow, curtain details","timeoutMs":180000}}
