geDraw.Draw(base), [(fx, 398), (fx, 412)], colr, 2)\n    # soft edges, not a round wooden rod\n    ln(ImageDraw.Draw(base), [(bx0 + 2, 398), (270, 396), (282, 400)], \"#e0aa80\", 1)\n    ln(ImageDraw.Draw(base), [(bx0 + 2, 413), (270, 412), (282, 408)], \"#74452c\", 2)\n    # a soft bow at the gathered inner edge\n    el(ImageDraw.Draw(base), (knot_x - 15, tc[1] - 7, knot_x - 1, tc[1] + 6), \"#c38b65\")\n    el(ImageDraw.Draw(base), (knot_x - 13, tc[1] - 4, knot_x - 3, tc[1] + 3), \"#d7a17b\")\n    el(ImageDraw.Draw(base), (knot_x + 1, tc[1] - 7, knot_x + 15, tc[1] + 6), \"#a96c49\")\n    el(ImageDraw.Draw(base), (knot_x + 3, tc[1] - 4, knot_x + 13, tc[1] + 3), \"#c98f68\")\n    el(ImageDraw.Draw(base), (knot_x - 6, tc[1] - 5, knot_x + 5, tc[1] + 6), \"#995d3d\")\n    el(ImageDraw.Draw(base), (knot_x - 2, tc[1] - 3, knot_x + 3, tc[1] + 2), \"#d6a17c\")'''\nassert old in s\ns=s.replace(old,new)\np.write_text(s)\nPY\npython3 draw_kitchen.py","description":"Turn tiebacks into gathered fabric bows","timeoutMs":180000}}
