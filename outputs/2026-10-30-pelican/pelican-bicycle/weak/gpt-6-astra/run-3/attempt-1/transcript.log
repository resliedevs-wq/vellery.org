,width=round(w*S))\n# Sun, clouds and warm paper atmosphere\nellipse(727,202,92,92,'#f1dfaa')\npath('M 160 256 C 163 237 187 233 198 247 C 209 216 252 223 255 247 C 279 239 295 250 297 263 L 159 263 Z','#fffdf6',None)\npath('M 692 375 C 704 357 722 362 730 370 C 742 344 779 350 785 373 C 802 365 821 376 821 386 L 692 386 Z','#fffdf6',None)\nellipse(480,761,304,19,'#dfdfce')\npath('M 153 761 L 847 761',None,'#b7c8b1',3)\n# Wheels and spokes\nfor x in (297,660):\n    ellipse(x,637,113,113,'#f8f3e7',ink,13)\n    ellipse(x,637,101,101,None,'#b9c6b8',3)\n    for a in range(0,360,30):\n        r=math.radians(a)\n        path(f'M {x} 637 L {x+99*math.cos(r):.2f} {637+99*math.sin(r):.2f}',None,'#acbbb5',2)\n    ellipse(x,637,10,10,'#e3b56a',ink,3)\n# Far leg\npath('M 447 436 C 481 456 487 483 469 513 L 502 554',None,'#cf8b38',15)\npath('M 493 547 L 529 561 Q 538 567 533 572 L 492 570 L 482 561 Z','#e4a33e',ink,4)\npath('M 486 576 L 537 576',None,ink,7)\n# Bike frame\npath('M 297 637 L 404 523 L 468 637 L 297 637 L 404 523 L 600 523 L 468 637',None,ink,13)\npath('M 297 637 L 404 523 L 468 637 L 297 637 L 404 523 L 600 523 L 468 637',None,'#419c96',8)\npath('M 660 637 L 594 503 L 582 457 L 615 445',None,ink,13)\npath('M 660 637 L 594 503 L 582 457 L 615 445',None,'#419c96',8)\npath('M 404 523 L 389 486',None,ink,9)\npath('M 363 484 Q 383 475 414 481 Q 428 486 417 493 L 369 494 Q 359 492 363 484 Z','#a76546',ink,4)\npath('M 580 457 L 614 447 Q 636 440 640 454 Q 645 468 628 471',None,ink,8)\npath('M 624 470 L 635 467',None,'#a76546',10)\n# Chain crank\nellipse(468,637,25,25,'#f4e9ce',ink,5)\nellipse(468,637,7,7,'#419c96',ink,3)\npath('M 468 637 L 433 675',None,ink,7)\npath('M 412 677 L 452 677',None,ink,8)\n# Pelican tail and body\npath('M 349 391 L 270 358 Q 285 398 321 428 L 282 417 Q 309 458 366 466 Z','#e0e7dc',ink,5)\npath('M 342 376 C 381 348 433 350 471 371 C 495 354 494 305 496 267 C 481 254 483 225 499 207 C 517 183 560 187 578 214 C 592 234 580 255 560 265 C 551 288 5