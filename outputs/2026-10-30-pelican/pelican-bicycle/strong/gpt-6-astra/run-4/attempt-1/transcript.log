{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/create_pelican.py <<'PY'\nfrom pathlib import Path\nimport math\nimport xml.etree.ElementTree as ET\nN=80\nD='1.6s'\nC=(477,526)\ndef pedal(phase):\n    return [(C[0]+39*math.cos(2*math.pi*i/N+phase),C[1]+39*math.sin(2*math.pi*i/N+phase)) for i in range(N+1)]\ndef leg(hip, points):\n    paths=[]\n    for x,y in points:\n        dx,dy=x-hip[0],y-hip[1]\n        d=math.hypot(dx,dy)\n        a=(108**2-105**2+d*d)/(2*d)\n        h=math.sqrt(108**2-a*a)\n        kx=hip[0]+a*dx/d+h*dy/d\n        ky=hip[1]+a*dy/d-h*dx/d\n        paths.append(f'M {hip[0]} {hip[1]} L {kx:.2f} {ky:.2f} L {x:.2f} {y-3:.2f}')\n    return paths\ndef animleg(hip,points,color,width):\n    paths=leg(hip,points)\n    return f'<path d=\\\"{paths[0]}\\\" fill=\\\"none\\\" stroke=\\\"{color}\\\" stroke-width=\\\"{width}\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"><animate attributeName=\\\"d\\\" dur=\\\"{D}\\\" repeatCount=\\\"indefinite\\\" values=\\\"{\\\";\\\".join(paths)}\\\"/></path>'\ndef foot(points,far=False):\n    values=';'.join(f'{x:.2f} {y:.2f}' for x,y in points)\n    color='#d58b36' if far else '#f3ac48'\n    return f'''<g transform=\\\"translate({points[0][0]:.2f} {points[0][1]:.2f})\\\">\n      <animateTransform attributeName=\\\"transform\\\" type=\\\"translate\\\" dur=\\\"{D}\\\" repeatCount=\\\"indefinite\\\" values=\\\"{values}\\\"/>\n      <rect x=\\\"-16\\\" y=\\\"4\\\" width=\\\"38\\\" height=\\\"7\\\" rx=\\\"3.5\\\" fill=\\\"#233e44\\\"/>\n      <path d=\\\"M -5 -9 Q 0 -11 5 -5 L 23 0 L 28 5 L -10 5 Q -14 1 -5 -9 Z\\\" fill=\\\"{color}\\\" stroke=\\\"#523e35\\\" stroke-width=\\\"2.5\\\" stroke-linejoin=\\\"round\\\"/>\n      <path d=\\\"M 5 -3 L 17 3 M 0 -2 L 7 3\\\" fill=\\\"none\\\" stroke=\\\"#b7772f\\\" stroke-width=\\\"1.5\\\"/>\n    </g>'''\ndef wheel(x):\n    spokes=''.join(f'<path d=\\\"M 0 0 L {89*math.cos(i*math.pi/6):.3f} {89*math.sin(i*math.pi/6):.3f}\\\"/>' for i in range(12))\n    return f'''<g transform=\\\"translate({x} 548)\\\">\n      <circle r=\\\"102\\\" fill=\\\"#fffaf0\\\" fill-opacity=\\\".38\\\" stroke=\\\"#243f46\\\" stroke-width=\\\"13\\\"/>\n      <circle r=\\\"94\\\" fill=\\\"none\\\" stroke=\\\"#f4e6cb\\\" stroke-width=\\\"5\\\"/>\n      <g stroke=\\\"#7f9a98\\\" stroke-width=\\\"2\\\" opacity=\\\".8\\\">\n        <animateTransform attributeName=\\\"transform\\\" type=\\\"rotate\\\" from=\\\"0\\\" to=\\\"360\\\" dur=\\\"1.0666667s\\\" repeatCount=\\\"indefinite\\\"/>\n        {spokes}\n        <path d=\\\"M 0 -91 L 0 -81\\\" stroke=\\\"#efaa46\\\" stroke-width=\\\"6\\\" stroke-linecap=\\\"round\\\"/>\n        <circle r=\\\"89\\\" fill=\\\"none\\\" stroke=\\\"#b9c9be\\\" stroke-width=\\\"1.5\\\"/>\n      </g>\n      <circle r=\\\"10\\\" fill=\\\"#e5d5b8\\\" stroke=\\\"#243f46\\\" stroke-width=\\\"4\\\"/>\n    </g>'''\nfront=pedal(0)\nback=pedal(math.pi)\nsvg=f'''<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"1000\\\" height=\\\"760\\\" viewBox=\\\"0 0 1000 760\\\" role=\\\"img\\\" aria-labelledby=\\\"title description\\\">\n  <title id=\\\"title\\\">Pelican pedal club</title>\n  <desc id=\\\"description\\\">A white pelican sits on the saddle of a teal bicycle and actively pedals along a sunny coastal road. Both webbed feet follow the rotating cranks as its knees bend, the wheels spin, and the scenery drifts by. The animation loops continuously.</desc>\n  <defs>\n    <linearGradient id=\\\"sky\\\" x2=\\\"0\\\" y2=\\\"1\\\">\n      <stop stop-color=\\\"#f7f1df\\\"/>\n      <stop offset=\\\"1\\\" stop-color=\\\"#fff9eb\\\"/>\n    </linearGradient>\n    <linearGradient id=\\\"pouch\\\" x2=\\\"0\\\" y2=\\\"1\\\">\n      <stop stop-color=\\\"#f5ba62\\\"/>\n      <stop offset=\\\"1\\\" stop-color=\\\"#e58e55\\\"/>\n    </linearGradient>\n    <linearGradient id=\\\"feathers\\\" x2=\\\".2\\\" y2=\\\"1\\\">\n      <stop stop-color=\\\"#fffef5\\\"/>\n      <stop offset=\\\"1\\\" stop-color=\\\"#e7e8d8\\\"/>\n    </linearGradient>\n    <clipPath id=\\\"scene\\\"><rect x=\\\"24\\\" y=\\\"24\\\" width=\\\"952\\\" height=\\\"712\\\" rx=\\\"28\\\"/></clipPath>\n    <pattern id=\\\"roadmarks\\\" width=\\\"240\\\" height=\\\"36\\\" patternUnits=\\\"userSpaceOnUse\\\">\n      <path d=\\\"M 25 17 H 93\\\" stroke=\\\"#d6c6a8\\\" stroke-width=\\\"4\\\" stroke-linecap=\\\"round\\\"/>\n    </pattern>\n  </defs>\n  <rect width=\\\"1000\\\" height=\\\"760\\\" rx=\\\"34\\\" fill=\\\"#e8dec7\\\"/>\n  <g clip-path=\\\"url(#scene)\\\">\n    <rect x=\\\"24\\\" y=\\\"24\\\" width=\\\"952\\\" height=\\\"712\\\" fill=\\\"url(#sky)\\\"/>\n    <circle cx=\\\"793\\\" cy=\\\"164\\\" r=\\\"59\\\" fill=\\\"#efbc62\\\"/>\n    <circle cx=\\\"793\\\" cy=\\\"164\\\" r=\\\"74\\\" fill=\\\"none\\\" stroke=\\\"#efbc62\\\" stroke-opacity=\\\".2\\\"/>\n    <g fill=\\\"#fffdf4\\\" opacity=\\\".85\\\">\n      <path d=\\\"M 106 198 Q 108 179 128 179 Q 137 152 164 166 Q 181 158 192 179 Q 217 176 221 198 Z\\\">\n        <animateTransform attributeName=\\\"transform\\\" type=\\\"translate\\\" values=\\\"0 0;-22 0;0 0\\\" dur=\\\"14s\\\" repeatCount=\\\"indefinite\\\"/>\n      </path>\n      <path d=\\\"M 720 290 Q 726 268 745 274 Q 756 243 780 258 Q 805 253 814 277 Q 836 273 846 290 Z\\\"/>\n    </g>\n    <g fill=\\\"none\\\" stroke=\\\"#7a9692\\\" stroke-width=\\\"2.5\\\" stroke-linecap=\\\"round\\\" opacity=\\\".65\\\">\n      <path d=\\\"M 676 139 q 9 -8 18 0 q 9 -8 18 0\\\"/>\n      <path d=\\\"M 856 230 q 7 -6 14 0 q 7 -6 14 0\\\"/>\n    </g>\n    <text x=\\\"80\\\" y=\\\"91\\\" font-family=\\\"Verdana, sans-serif\\\" font-size=\\\"13\\\" font-weight=\\\"bold\\\" letter-spacing=\\\"4\\\" fill=\\\"#3a625f\\\">PELICAN PEDAL CLUB</text>\n    <path d=\\\"M 80 108 H 128\\\" stroke=\\\"#d59947\\\" stroke-width=\\\"3\\\" stroke-linecap=\\\"round\\\"/>\n    <path d=\\\"M 24 426 Q 200 396 340 426 T 670 422 T 976 407 V 568 H 24 Z\\\" fill=\\\"#b8d3c7\\\"/>\n    <path d=\\\"M 24 459 Q 233 432 423 460 T 976 449 V 581 H 24 Z\\\" fill=\\\"#d0dfcb\\\"/>\n    <g fill=\\\"none\\\" stroke=\\\"#f5f4df\\\" stroke-width=\\\"3\\\" stroke-linecap=\\\"round\\\" opacity=\\\".8\\\">\n      <path d=\\\"M 80 465 H 153 M 727 477 H 787 M 845 451 H 891 M 180 494 H 220\\\"/>\n    </g>\n    <path d=\\\"M 24 553 Q 210 508 403 553 T 976 525 V 667 H 24 Z\\\" fill=\\\"#e1dfb8\\\"/>\n    <path d=\\\"M 24 597 Q 258 571 488 600 T 976 586 V 736 H 24 Z\\\" fill=\\\"#eee2c8\\\"/>\n    <path d=\\\"M 24 652 H 976\\\" stroke=\\\"#c5b99b\\\" stroke-width=\\\"2\\\"/>\n    <g>\n      <animateTransform attributeName=\\\"transform\\\" type=\\\"translate\\\" from=\\\"0 0\\\" to=\\\"-240 0\\\" dur=\\\"1.3s\\\" repeatCount=\\\"indefinite\\\"/>\n      <rect x=\\\"0\\\" y=\\\"672\\\" width=\\\"1240\\\" height=\\\"36\\\" fill=\\\"url(#roadmarks)\\\"/>\n    </g>\n    <g stroke=\\\"#9eae83\\\" stroke-width=\\\"3\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\">\n      <path d=\\\"M 129 610 l -7 -23 m 7 23 l 5 -31 m -5 31 l 14 -17 M 863 614 l -5 -24 m 5 24 l 10 -18\\\"/>\n    </g>\n    <ellipse cx=\\\"514\\\" cy=\\\"651\\\" rx=\\\"281\\\" ry=\\\"12\\\" fill=\\\"#697a65\\\" opacity=\\\".13\\\"/>\n    <\"'!-- Bicycle wheels: rotating spokes and a golden rim marker make motion visible. -->\n    {wheel(330)}\n    {wheel(695)}\n    <!-- The far leg and pedal are behind the bicycle frame. -->\n    {animleg((422,375),back,'\"'#675444',13)}\n    {animleg((422,375),back,'#c08a4d',8)}\n    {foot(back,True)}\n    <\"'!-- Frame, fork, chain, saddle, and curved handlebars. -->\n    <path d=\"M 330 548 L 477 526\" stroke=\"#364b49\" stroke-width=\"8\"/>\n    <path d=\"M 330 536 L 477 504 A 22 22 0 0 1 482 548 L 332 560 A 12 12 0 0 1 330 536 Z\" fill=\"none\" stroke=\"#64766c\" stroke-width=\"3\"/>\n    <g fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <path d=\"M 330 548 L 430 420 L 477 526 L 330 548 M 430 420 L 631 420 L 477 526 M 631 420 L 695 548\" stroke=\"#22494b\" stroke-width=\"13\"/>\n      <path d=\"M 330 548 L 430 420 L 477 526 L 330 548 M 430 420 L 631 420 L 477 526 M 631 420 L 695 548\" stroke=\"#398984\" stroke-width=\"8\"/>\n      <path d=\"M 432 419 L 421 388 M 632 421 L 613 365\" stroke=\"#314e51\" stroke-width=\"8\"/>\n      <path d=\"M 612 366 L 607 349 Q 605 339 620 339 L 647 339 Q 663 340 662 354 Q 661 366 647 366\" stroke=\"#526c69\" stroke-width=\"7\"/>\n      <path d=\"M 644 339 L 651 339 Q 663 340 662 354 Q 661 363 651 365\" stroke=\"#b47349\" stroke-width=\"10\"/>\n      <path d=\"M 653 368 Q 682 402 667 454\" stroke=\"#52605a\" stroke-width=\"2\"/>\n      <path d=\"M 259 470 A 108 108 0 0 1 402 470 M 624 469 A 108 108 0 0 1 766 470\" stroke=\"#739b8e\" stroke-width=\"5\"/>\n    </g>\n    <path d=\"M 389 382 Q 412 377 433 382 L 452 383 Q 458 388 448 394 L 397 394 Q 383 392 389 382 Z\" fill=\"#674c3c\" stroke=\"#3e443c\" stroke-width=\"3\"/>\n    <path d=\"M 396 384 L 439 386\" fill=\"none\" stroke=\"#b58b5b\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n    <circle cx=\"477\" cy=\"526\" r=\"25\" fill=\"#e1d8bb\" stroke=\"#314e51\" stroke-width=\"4\"/>\n    <g>\n      <animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0 477 526\" to=\"360 477 526\" dur=\"{D}\" repeatCount=\"indefinite\"/>\n      <circle cx=\"477\" cy=\"526\" r=\"17\" fill=\"none\" stroke=\"#85958a\" stroke-width=\"4\" stroke-dasharray=\"5 6\"/>\n      <path d=\"M 438 526 H 516\" fill=\"none\" stroke=\"#2c4548\" stroke-width=\"7\" stroke-linecap=\"round\"/>\n      <path d=\"M 477 526 H 516\" fill=\"none\" stroke=\"#b6c6b8\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n    </g>\n    <circle cx=\"477\" cy=\"526\" r=\"6\" fill=\"#354e4c\"/>\n    {animleg((442,372),front,'\"'#634c37',14)}\n    {animleg((442,372),front,'#e4a64f',9)}\n    <\"'!-- The pelican'\"'s lower body rests directly on the saddle. -->\n    <path d=\\\"M 340 313 L 295 302 L 315 328 L 298 327 L 338 353 Z\\\" fill=\\\"#eeeedd\\\" stroke=\\\"#334e50\\\" stroke-width=\\\"3.5\\\" stroke-linejoin=\\\"round\\\"/>\n    <path d=\\\"M 330 295 C 320 327 342 368 387 380 Q 415 390 444 381 C 481 373 521 346 529 312 C 537 283 517 254 527 235 C 532 225 548 223 554 210 C 565 187 550 165 528 165 C 500 164 480 189 476 216 C 472 246 488 263 474 279 C 455 300 422 276 392 275 C 365 274 340 279 330 295 Z\\\" fill=\\\"url(#feathers)\\\" stroke=\\\"#334e50\\\" stroke-width=\\\"3.5\\\" stroke-linejoin=\\\"round\\\"/>\n    <path d=\\\"M 343 331 Q 362 365 405 369 Q 447 374 481 342\\\" fill=\\\"none\\\" stroke=\\\"#cbd5c7\\\" stroke-width=\\\"7\\\" stroke-linecap=\\\"round\\\"/>\n    <path d=\\\"M 487 215 Q 487 185 511 177\\\" fill=\\\"none\\\" stroke=\\\"#ffffff\\\" stroke-width=\\\"6\\\" stroke-linecap=\\\"round\\\"/>\n    <\"'!-- Bill and elastic throat pouch. -->\n    <path d=\"M 547 208 L 699 222 Q 663 248 616 261 Q 578 266 550 235 L 536 224 Z\" fill=\"url(#pouch)\" stroke=\"#6f573c\" stroke-width=\"3\" stroke-linejoin=\"round\"/>\n    <path d=\"M 557 222 Q 578 249 610 252\" fill=\"none\" stroke=\"#ffdc94\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n    <path d=\"M 548 202 Q 613 202 707 220 Q 718 223 708 234 L 700 225 L 546 219 Z\" fill=\"#f4bf56\" stroke=\"#6f573c\" stroke-width=\"3\" stroke-linejoin=\"round\"/>\n    <path d=\"M 554 216 L 699 223\" stroke=\"#a77835\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n    <ellipse cx=\"537\" cy=\"194\" rx=\"10\" ry=\"11\" fill=\"#fffdf0\"/>\n    <circle cx=\"540\" cy=\"194\" r=\"5.5\" fill=\"#213e43\"/>\n    <circle cx=\"542\" cy=\"192\" r=\"1.8\" fill=\"white\"/>\n    <path d=\"M 528 178 Q 537 174 545 180\" fill=\"none\" stroke=\"#334e50\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n    <!-- A small scarf trails in the sea breeze. -->\n    <path d=\"M 481 249 Q 501 261 527 248 L 531 258 Q 507 272 482 261 Z\" fill=\"#df7658\" stroke=\"#9e5844\" stroke-width=\"2\"/>\n    <path d=\"M 485 257 Q 458 248 437 264 L 447 273 L 433 280 Q 465 275 490 263 Z\" fill=\"#df7658\" stroke=\"#9e5844\" stroke-width=\"2\">\n      <animate attributeName=\"d\" dur=\".8s\" repeatCount=\"indefinite\" values=\"M 485 257 Q 458 248 437 264 L 447 273 L 433 280 Q 465 275 490 263 Z;M 485 257 Q 460 270 433 251 L 438 265 L 428 270 Q 460 285 490 263 Z;M 485 257 Q 458 248 437 264 L 447 273 L 433 280 Q 465 275 490 263 Z\"/>\n    </path>\n    <!-- Forward wing rests on the handlebars. -->\n    <path d=\"M 390 295 C 420 280 455 308 487 326 Q 529 344 603 341 Q 618 337 626 347 Q 630 353 620 355 L 607 354 Q 620 361 612 364 C 561 361 512 365 476 352 C 444 347 416 338 397 323\" fill=\"#f7f7e9\" stroke=\"#334e50\" stroke-width=\"3.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n    <path d=\"M 405 308 Q 445 314 477 339 M 410 320 Q 445 334 464 337\" fill=\"none\" stroke=\"#c4cebf\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n    {foot(front)}\n    <g fill=\"none\" stroke=\"#829c8b\" stroke-width=\"3\" stroke-linecap=\"round\" opacity=\".65\">\n      <path d=\"M 241 362 H 274 M 220 379 H 263 M 248 396 H 281\">\n        <animate attributeName=\"opacity\" values=\".25;.8;.25\" dur=\"1.6s\" repeatCount=\"indefinite\"/>\n      </path>\n    </g>\n    <text x=\"80\" y=\"718\" font-family=\"Verdana, sans-serif\" font-size=\"10\" letter-spacing=\"2.6\" fill=\"#768471\">SALT AIR. TWO WHEELS. NO HURRY.</text>\n    <g transform=\"translate(896 704)\" stroke=\"#768471\" stroke-width=\"1.5\" fill=\"none\">\n      <circle cx=\"-8\" cy=\"6\" r=\"6\"/><circle cx=\"14\" cy=\"6\" r=\"6\"/><path d=\"M -8 6 L -2 -4 L 4 6 H -8 M -2 -4 H 9 L 4 6 M 14 6 L 8 -8 H 12 M -5 -8 H 0\"/>\n    </g>\n  </g>\n</svg>\n'\"'''\nout=Path('/tmp/vellery-o4q5om4e/work/pelican.svg')\nout.write_text(svg)\nET.fromstring(svg)\n# Verify every animation closes at the starting pose and every crank endpoint is followed.\nfor points in [front,back]:\n    assert math.dist(points[0],points[-1]) < 1e-8\n    assert all(abs(math.dist(p,C)-39)<1e-8 for p in points)\nfor a,b in zip(front,back):\n    assert abs(a[0]+b[0]-2*C[0])<1e-8\n    assert abs(a[1]+b[1]-2*C[1])<1e-8\nroot=ET.fromstring(svg)\nassert not any('href' in k for el in root.iter() for k in el.attrib)\nprint(f'Created {out.name}: {out.stat().st_size:,} bytes. XML valid; pedal geometry and seamless loop verified.')\nPY\npython3 /tmp/create_pelican.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/create_pelican.py <<'PY'\nfrom pathlib import Path\nimport math\nimport xml.etree.ElementTree as ET\nN=80\nD='1.6s'\nC=(477,526)\ndef pedal(phase):\n    return [(C[0]+39*math.cos(2*math.pi*i/N+phase),C[1]+39*math.sin(2*math.pi*i/N+phase)) for i in range(N+1)]\ndef leg(hip, points):\n    paths=[]\n    for x,y in points:\n        dx,dy=x-hip[0],y-hip[1]\n        d=math.hypot(dx,dy)\n        a=(108**2-105**2+d*d)/(2*d)\n        h=math.sqrt(108**2-a*a)\n        kx=hip[0]+a*dx/d+h*dy/d\n        ky=hip[1]+a*dy/d-h*dx/d\n        paths.append(f'M {hip[0]} {hip[1]} L {kx:.2f} {ky:.2f} L {x:.2f} {y-3:.2f}')\n    return paths\ndef animleg(hip,points,color,width):\n    paths=leg(hip,points)\n    return f'<path d=\\\"{paths[0]}\\\" fill=\\\"none\\\" stroke=\\\"{color}\\\" stroke-width=\\\"{width}\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"><animate attributeName=\\\"d\\\" dur=\\\"{D}\\\" repeatCount=\\\"indefinite\\\" values=\\\"{\\\";\\\".join(paths)}\\\"/></path>'\ndef foot(points,far=False):\n    values=';'.join(f'{x:.2f} {y:.2f}' for x,y in points)\n    color='#d58b36' if far else '#f3ac48'\n    return f'''<g transform=\\\"translate({points[0][0]:.2f} {points[0][1]:.2f})\\\">\n      <animateTransform attributeName=\\\"transform\\\" type=\\\"translate\\\" dur=\\\"{D}\\\" repeatCount=\\\"indefinite\\\" values=\\\"{values}\\\"/>\n      <rect x=\\\"-16\\\" y=\\\"4\\\" width=\\\"38\\\" height=\\\"7\\\" rx=\\\"3.5\\\" fill=\\\"#233e44\\\"/>\n      <path d=\\\"M -5 -9 Q 0 -11 5 -5 L 23 0 L 28 5 L -10 5 Q -14 1 -5 -9 Z\\\" fill=\\\"{color}\\\" stroke=\\\"#523e35\\\" stroke-width=\\\"2.5\\\" stroke-linejoin=\\\"round\\\"/>\n      <path d=\\\"M 5 -3 L 17 3 M 0 -2 L 7 3\\\" fill=\\\"none\\\" stroke=\\\"#b7772f\\\" stroke-width=\\\"1.5\\\"/>\n    </g>'''\ndef wheel(x):\n    spokes=''.join(f'<path d=\\\"M 0 0 L {89*math.cos(i*math.pi/6):.3f} {89*math.sin(i*math.pi/6):.3f}\\\"/>' for i in range(12))\n    return f'''<g transform=\\\"translate({x} 548)\\\">\n      <circle r=\\\"102\\\" fill=\\\"#fffaf0\\\" fill-opacity=\\\".38\\\" stroke=\\\"#243f46\\\" stroke-width=\\\"13\\\"/>\n      <circle r=\\\"94\\\" fill=\\\"none\\\" stroke=\\\"#f4e6cb\\\" stroke-width=\\\"5\\\"/>\n      <g stroke=\\\"#7f9a98\\\" stroke-width=\\\"2\\\" opacity=\\\".8\\\">\n        <animateTransform attributeName=\\\"transform\\\" type=\\\"rotate\\\" from=\\\"0\\\" to=\\\"360\\\" dur=\\\"1.0666667s\\\" repeatCount=\\\"indefinite\\\"/>\n        {spokes}\n        <path d=\\\"M 0 -91 L 0 -81\\\" stroke=\\\"#efaa46\\\" stroke-width=\\\"6\\\" stroke-linecap=\\\"round\\\"/>\n        <circle r=\\\"89\\\" fill=\\\"none\\\" stroke=\\\"#b9c9be\\\" stroke-width=\\\"1.5\\\"/>\n      </g>\n      <circle r=\\\"10\\\" fill=\\\"#e5d5b8\\\" stroke=\\\"#243f46\\\" stroke-width=\\\"4\\\"/>\n    </g>'''\nfront=pedal(0)\nback=pedal(math.pi)\nsvg=f'''<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"1000\\\" height=\\\"760\\\" viewBox=\\\"0 0 1000 760\\\" role=\\\"img\\\" aria-labelledby=\\\"title description\\\">\n  <title id=\\\"title\\\">Pelican pedal club</title>\n  <desc id=\\\"description\\\">A white pelican sits on the saddle of a teal bicycle and actively pedals along a sunny coastal road. Both webbed feet follow the rotating cranks as its knees bend, the wheels spin, and the scenery drifts by. The animation loops continuously.</desc>\n  <defs>\n    <linearGradient id=\\\"sky\\\" x2=\\\"0\\\" y2=\\\"1\\\">\n      <stop stop-color=\\\"#f7f1df\\\"/>\n      <stop offset=\\\"1\\\" stop-color=\\\"#fff9eb\\\"/>\n    </linearGradient>\n    <linearGradient id=\\\"pouch\\\" x2=\\\"0\\\" y2=\\\"1\\\">\n      <stop stop-color=\\\"#f5ba62\\\"/>\n      <stop offset=\\\"1\\\" stop-color=\\\"#e58e55\\\"/>\n    </linearGradient>\n    <linearGradient id=\\\"feathers\\\" x2=\\\".2\\\" y2=\\\"1\\\">\n      <stop stop-color=\\\"#fffef5\\\"/>\n      <stop offset=\\\"1\\\" stop-color=\\\"#e7e8d8\\\"/>\n    </linearGradient>\n    <clipPath id=\\\"scene\\\"><rect x=\\\"24\\\" y=\\\"24\\\" width=\\\"952\\\" height=\\\"712\\\" rx=\\\"28\\\"/></clipPath>\n    <pattern id=\\\"roadmarks\\\" width=\\\"240\\\" height=\\\"36\\\" patternUnits=\\\"userSpaceOnUse\\\">\n      <path d=\\\"M 25 17 H 93\\\" stroke=\\\"#d6c6a8\\\" stroke-width=\\\"4\\\" stroke-linecap=\\\"round\\\"/>\n    </pattern>\n  </defs>\n  <rect width=\\\"1000\\\" height=\\\"760\\\" rx=\\\"34\\\" fill=\\\"#e8dec7\\\"/>\n  <g clip-path=\\\"url(#scene)\\\">\n    <rect x=\\\"24\\\" y=\\\"24\\\" width=\\\"952\\\" height=\\\"712\\\" fill=\\\"url(#sky)\\\"/>\n    <circle cx=\\\"793\\\" cy=\\\"164\\\" r=\\\"59\\\" fill=\\\"#efbc62\\\"/>\n    <circle cx=\\\"793\\\" cy=\\\"164\\\" r=\\\"74\\\" fill=\\\"none\\\" stroke=\\\"#efbc62\\\" stroke-opacity=\\\".2\\\"/>\n    <g fill=\\\"#fffdf4\\\" opacity=\\\".85\\\">\n      <path d=\\\"M 106 198 Q 108 179 128 179 Q 137 152 164 166 Q 181 158 192 179 Q 217 176 221 198 Z\\\">\n        <animateTransform attributeName=\\\"transform\\\" type=\\\"translate\\\" values=\\\"0 0;-22 0;0 0\\\" dur=\\\"14s\\\" repeatCount=\\\"indefinite\\\"/>\n      </path>\n      <path d=\\\"M 720 290 Q 726 268 745 274 Q 756 243 780 258 Q 805 253 814 277 Q 836 273 846 290 Z\\\"/>\n    </g>\n    <g fill=\\\"none\\\" stroke=\\\"#7a9692\\\" stroke-width=\\\"2.5\\\" stroke-linecap=\\\"round\\\" opacity=\\\".65\\\">\n      <path d=\\\"M 676 139 q 9 -8 18 0 q 9 -8 18 0\\\"/>\n      <path d=\\\"M 856 230 q 7 -6 14 0 q 7 -6 14 0\\\"/>\n    </g>\n    <text x=\\\"80\\\" y=\\\"91\\\" font-family=\\\"Verdana, sans-serif\\\" font-size=\\\"13\\\" font-weight=\\\"bold\\\" letter-spacing=\\\"4\\\" fill=\\\"#3a625f\\\">PELICAN PEDAL CLUB</text>\n    <path d=\\\"M 80 108 H 128\\\" stroke=\\\"#d59947\\\" stroke-width=\\\"3\\\" stroke-linecap=\\\"round\\\"/>\n    <path d=\\\"M 24 426 Q 200 396 340 426 T 670 422 T 976 407 V 568 H 24 Z\\\" fill=\\\"#b8d3c7\\\"/>\n    <path d=\\\"M 24 459 Q 233 432 42