>\n      <path d=\"M 330 548 L 430 420 L 477 526 L 330 548 M 430 420 L 631 420 L 477 526 M 631 420 L 695 548\" stroke=\"#398984\" stroke-width=\"8\"/>\n      <path d=\"M 432 419 L 421 388 M 632 421 L 613 365\" stroke=\"#314e51\" stroke-width=\"8\"/>\n      <path d=\"M 612 366 L 607 349 Q 605 339 620 339 L 647 339 Q 663 340 662 354 Q 661 366 647 366\" stroke=\"#526c69\" stroke-width=\"7\"/>\n      <path d=\"M 644 339 L 651 339 Q 663 340 662 354 Q 661 363 651 365\" stroke=\"#b47349\" stroke-width=\"10\"/>\n      <path d=\"M 653 368 Q 682 402 667 454\" stroke=\"#52605a\" stroke-width=\"2\"/>\n      <path d=\"M 259 470 A 108 108 0 0 1 402 470 M 624 469 A 108 108 0 0 1 766 470\" stroke=\"#739b8e\" stroke-width=\"5\"/>\n    </g>\n    <path d=\"M 389 382 Q 412 377 433 382 L 452 383 Q 458 388 448 394 L 397 394 Q 383 392 389 382 Z\" fill=\"#674c3c\" stroke=\"#3e443c\" stroke-width=\"3\"/>\n    <path d=\"M 396 384 L 439 386\" fill=\"none\" stroke=\"#b58b5b\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n    <circle cx=\"477\" cy=\"526\" r=\"25\" fill=\"#e1d8bb\" stroke=\"#314e51\" stroke-width=\"4\"/>\n    <g>\n      <animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0 477 526\" to=\"360 477 526\" dur=\"{D}\" repeatCount=\"indefinite\"/>\n      <circle cx=\"477\" cy=\"526\" r=\"17\" fill=\"none\" stroke=\"#85958a\" stroke-width=\"4\" stroke-dasharray=\"5 6\"/>\n      <path d=\"M 438 526 H 516\" fill=\"none\" stroke=\"#2c4548\" stroke-width=\"7\" stroke-linecap=\"round\"/>\n      <path d=\"M 477 526 H 516\" fill=\"none\" stroke=\"#b6c6b8\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n    </g>\n    <circle cx=\"477\" cy=\"526\" r=\"6\" fill=\"#354e4c\"/>\n    {animleg((442,372),front,'\"'#634c37',14)}\n    {animleg((442,372),front,'#e4a64f',9)}\n    <\"'!-- The pelican'\"'s lower body rests directly on the saddle. -->\n    <path d=\\\"M 340 313 L 295 302 L 315 328 L 298 327 L 338 353 Z\\\" fill=\\\"#eeeedd\\\" stroke=\\\"#334e50\\\" stroke-width=\\\"3.5\\\"