{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/make_pelican.py <<'PY'\nfrom math import sin, cos, pi, sqrt\nfrom pathlib import Path\n\nN=48\nDURATION='1.35s'\ndef leg(phase, hip, color, front=False):\n    paths=[]; positions=[]\n    for i in range(N+1):\n        a=2*pi*i/N+phase\n        x,y=465+36*cos(a),432+36*sin(a)\n        hx,hy=hip\n        dx,dy=x-hx,y-hy; d=sqrt(dx*dx+dy*dy)\n        upper,lower=86,91\n        along=(upper**2-lower**2+d*d)/(2*d)\n        side=sqrt(max(0,upper**2-along**2))\n        kx=hx+along*dx/d+side*dy/d\n        ky=hy+along*dy/d-side*dx/d\n        paths.append(f'M {hx} {hy} L {kx:.2f} {ky:.2f} L {x:.2f} {y-5:.2f}')\n        positions.append(f'{x:.2f} {y:.2f}')\n    return f'''<g stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\">\n      <path d=\\\"{paths[0]}\\\" fill=\\\"none\\\" stroke=\\\"#253f43\\\" stroke-width=\\\"13\\\">\n        <animate attributeName=\\\"d\\\" values=\\\"{';'.join(paths)}\\\" dur=\\\"{DURATION}\\\" repeatCount=\\\"indefinite\\\"/>\n      </path>\n      <path d=\\\"{paths[0]}\\\" fill=\\\"none\\\" stroke=\\\"{color}\\\" stroke-width=\\\"8\\\">\n        <animate attributeName=\\\"d\\\" values=\\\"{';'.join(paths)}\\\" dur=\\\"{DURATION}\\\" repeatCount=\\\"indefinite\\\"/>\n      </path>\n      <g transform=\\\"translate({positions[0]})\\\">\n        <animateTransform attributeName=\\\"transform\\\" type=\\\"translate\\\" values=\\\"{';'.join(positions)}\\\" dur=\\\"{DURATION}\\\" repeatCount=\\\"indefinite\\\"/>\n        <rect x=\\\"-17\\\" y=\\\"0\\\" width=\\\"34\\\" height=\\\"7\\\" rx=\\\"3\\\" fill=\\\"#253f43\\\"/>\n        <path d=\\\"M -9 -13 Q -2 -17 4 -10 L 20 -4 Q 24 0 18 1 L -15 1 Z\\\" fill=\\\"{color}\\\" stroke=\\\"#253f43\\\" stroke-width=\\\"2.5\\\"/>\n        <path d=\\\"M 3 -8 L 9 -1 M 9 -6 L 15 -1\\\" fill=\\\"none\\\" stroke=\\\"#a85f35\\\" stroke-width=\\\"1.5\\\"/>\n      </g>\n    </g>'''\n\ndef wheel(x):\n    spokes=