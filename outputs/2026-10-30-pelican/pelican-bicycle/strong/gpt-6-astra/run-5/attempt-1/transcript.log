{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/draw_pelican.py <<'PY'\nfrom pathlib import Path\nimport math\nimport xml.etree.ElementTree as ET\n\nN = 48\nDURATION = '1.35s'\ndef leg(phase, behind=False):\n    paths, feet = [], []\n    hip = (426, 316)\n    for i in range(N+1):\n        a = 2*math.pi*i/N + phase\n        x, y = 445 + 32*math.cos(a), 450 + 32*math.sin(a)\n        # Two rigid leg segments, solved against the rotating pedal spindle.\n        ankle = (x-3, y-9)\n        dx, dy = ankle[0]-hip[0], ankle[1]-hip[1]\n        d = math.hypot(dx,dy)\n        h = math.sqrt(88**2-(d/2)**2)\n        kx, ky = (hip[0]+ankle[0])/2 + dy*h/d, (hip[1]+ankle[1])/2-dx*h/d\n        paths.append(f'M {hip[0]} {hip[1]} L {kx:.2f} {ky:.2f} L {ankle[0]:.2f} {ankle[1]:.2f}')\n        feet.append(f'M {x-6:.2f} {y-12:.2f} Q {x+1:.2f} {y-7:.2f} {x+15:.2f} {y-3:.2f} Q {x+19:.2f} {y+2:.2f} {x+10:.2f} {y+3:.2f} L {x-10:.2f} {y+3:.2f} Q {x-15:.2f} {y-1:.2f} {x-6:.2f} {y-12:.2f} Z')\n    col = '#bf633d' if behind else '#ee944a'\n    return f'''<g stroke-linejoin=\\\"round\\\" stroke-linecap=\\\"round\\\">\n      <path d=\\\"{paths[0]}\\\" fill=\\\"none\\\" stroke=\\\"#734e3e\\\" stroke-width=\\\"12\\\"><animate attributeName=\\\"d\\\" dur=\\\"{DURATION}\\\" repeatCount=\\\"indefinite\\\" values=\\\"{';'.join(paths)}\\\"/></path>\n      <path d=\\\"{paths[0]}\\\" fill=\\\"none\\\" stroke=\\\"{col}\\\" stroke-width=\\\"8\\\"><animate attributeName=\\\"d\\\" dur=\\\"{DURATION}\\\" repeatCount=\\\"indefinite\\\" values=\\\"{';'.join(paths)}\\\"/></path>\n      <path d=\\\"{feet[0]}\\\" fill=\\\"{col}\\\" stroke=\\\"#734e3e\\\" stroke-width=\\\"2\\\"><animate attributeName=\\\"d\\\" dur=\\\"{DURATION}\\\" repeatCount=\\\"indefinite\\\" values=\\\"{';'.join(feet)}\\\"/></path>\n    </g>'''\n\ndef wheel(x):\n    spokes=''.join(f'<path d=\\\"M 0 0 L {77*math.cos(i*math.pi/6):.3f} {77*math.sin(i*math.pi/6):.3f}\\\"/>' for i in range(12))\n    return f'''<g transform=\\\"translate({x} 458)\\\">\n      <circle r=\\\"88\\\" fill=\\\"#fff8e7\\\" stroke=\\\"#233e42\\\" stroke-width=\\\"12\\\"/>\n      <circle r=\\\"80\\\" fill=\\\"none\\\" stroke=\\\"#8da8a2\\\" stroke-width=\\\"3\\\"/>\n      <g><animateTransform attributeName=\\\"transform\\\" type=\\\"rotate\\\" from=\\\"0\\\" to=\\\"360\\\" dur=\\\"{DURATION}\\\" repeatCount=\\\"indefinite\\\"/>\n        <g stroke=\\\"#a9bdb4\\\" stroke-width=\\\"2\\\">{spokes}</g>\n        <path d=\\\"M -45 -69 A 82 82 0 0 1 -12 -81\\\" fill=\\\"none\\\" stroke=\\\"#f7ead0\\\" stroke-width=\\\"4\\\" stroke-linecap=\\\"round\\\"/>\n        <rect x=\\\"-5\\\" y=\\\"-60\\\" width=\\\"10\\\" height=\\\"16\\\" rx=\\\"3\\\" fill=\\\"#efad58\\\" transform=\\\"rotate(35)\\\"/>\n      </g><circle r=\\\"8\\\" fill=\\\"#d3e0d1\\\" stroke=\\\"#233e42\\\" stroke-width=\\\"4\\\"/>\n    </g>'''\n\nsvg = '''<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"900\\\" height=\\\"640\\\" viewBox=\\\"0 0 900 640\\\" role=\\\"img\\\" aria-labelledby=\\\"title description\\\">\n  <title id=\\\"title\\\">Pelican pedal club</title>\n  <desc id=\\\"description\\\">A white pelican sits on the saddle of a coral bicycle, holding the handlebars with its wing. Its jointed legs actively pedal in time with the turning cranks and spinning wheels as the seaside scenery passes.</desc>\n  <defs>\n    <linearGradient id=\\\"sky\\\" x2=\\\"0\\\" y2=\\\"1\\\"><stop stop-color=\\\"#f9edce\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#fff8e7\\\"/></linearGradient>\n    <linearGradient id=\\\"sea\\\" x2=\\\"0\\\" y2=\\\"1\\\"><stop stop-color=\\\"#b5d5c9\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#d2e1cc\\\"/></linearGradient>\n    <linearGradient id=\\\"pouch\\\" x2=\\\"0.2\\\" y2=\\\"1\\\"><stop stop-color=\\\"#f9be67\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#e7984e\\\"/></linearGradient>\n    <pattern id=\\\"road\\\" width=\\\"180\\\" height=\\\"24\\\" patternUnits=\\\"userSpaceOnUse\\\"><path 