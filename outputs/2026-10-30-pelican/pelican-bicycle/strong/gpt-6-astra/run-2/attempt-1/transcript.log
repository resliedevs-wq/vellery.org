{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nfrom math import sin, cos, pi, sqrt\nN=72\n\ndef foot_positions(phase):\n    return [(468+39*cos(2*pi*i/N+phase),494+39*sin(2*pi*i/N+phase)) for i in range(N+1)]\n\ndef leg(phase, hip, color, width):\n    paths=[]\n    for x,y in foot_positions(phase):\n        ex,ey=x,y-12\n        dx,dy=ex-hip[0],ey-hip[1]\n        d=sqrt(dx*dx+dy*dy)\n        a=(112**2-108**2+d*d)/(2*d)\n        h=sqrt(max(0,112**2-a*a))\n        kx=hip[0]+a*dx/d+h*dy/d\n        ky=hip[1]+a*dy/d-h*dx/d\n        paths.append(f'M {hip[0]} {hip[1]} L {kx:.2f} {ky:.2f} L {ex:.2f} {ey:.2f}')\n    return f'''<path d=\\\"{paths[0]}\\\" fill=\\\"none\\\" stroke=\\\"{color}\\\" stroke-width=\\\"{width}\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"><animate attributeName=\\\"d\\\" values=\\\"{';'.join(paths)}\\\" dur=\\\"1.2s\\\" repeatCount=\\\"indefinite\\\"/></path>'''\n\ndef foot(phase, color):\n    vals=';'.join(f'{x:.2f} {y:.2f}' for x,y in foot_positions(phase))\n    x,y=foot_positions(phase)[0]\n    return f'''<g transform=\\\"translate({x} {y})\\\"><animateTransform attributeName=\\\"transform\\\" type=\\\"translate\\\" values=\\\"{vals}\\\" dur=\\\"1.2s\\\" repeatCount=\\\"indefinite\\\"/>\n      <rect x=\\\"-17\\\" y=\\\"-1\\\" width=\\\"38\\\" height=\\\"7\\\" rx=\\\"3\\\" fill=\\\"#243e46\\\"/>\n      <path d=\\\"M -6 -17 L 4 -17 L 6 -9 L 19 -6 Q 25 -2 18 -2 L -12 -2 Q -18 -3 -12 -9 Z\\\" fill=\\\"{color}\\\" stroke=\\\"#a85b32\\\" stroke-width=\\\"2\\\" stroke-linejoin=\\\"round\\\"/>\n      <path d=\\\"M 4 -8 L 11 -4 M -2 -7 L 1 -3\\\" stroke=\\\"#c7763d\\\" stroke-width=\\\"1.5\\\"/>\n    </g>'''\n\nspokes=''.join(f'<path d=\\\"M 0 0 L {99*cos(i*pi/6):.3f} {99*sin(i*pi/6):.3f}\\\"/>' for i in range(12))\nsvg='''<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"960\\\" height=\\\"720\\\" viewBox=\\\"0 0 960 720\\\" role=\\\"img\\\" aria-labelledby=\\\"title desc\\\">\n  <title id=\\\"title\\\">Pelican on a bicycle</title>\n  <desc id=\\\"desc\\\">A cheerful white pelican sits on the saddle of a sea-green bicycle, grips the handlebar with its wing, and pedals continuously. Its webbed feet follow the rotating cranks, both wheels spin, and the seaside scenery glides past.</desc>\n  <defs>\n    <linearGradient id=\\\"sky\\\" x2=\\\"0\\\" y2=\\\"1\\\"><stop stop-color=\\\"#eaf4ee\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#fff6df\\\"/></linearGradient>\n    <linearGradient id=\\\"pouch\\\" x1=\\\"0\\\" y1=\\\"0\\\" x2=\\\"0.2\\\" y2=\\\"1\\\"><stop stop-color=\\\"#ffcc79\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#f19a65\\\"/></linearGradient>\n    <linearGradient id=\\\"body\\\" x1=\\\"0\\\" y1=\\\"0\\\" x2=\\\"0.7\\\" y2=\\\"1\\\"><stop stop-color=\\\"#fffef7\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#e3ece6\\\"/></linearGradient>\n    <clipPath id=\\\"scene\\\"><rect width=\\\"960\\\" height=\\\"720\\\" rx=\\\"28\\\"/></clipPath>\n    <g id=\\\"wheel\\\">\n      <circle r=\\\"110\\\" fill=\\\"#f8f7e9\\\" fill-opacity=\\\".42\\\" stroke=\\\"#263f46\\\" stroke-width=\\\"13\\\"/>\n      <circle r=\\\"102\\\" fill=\\\"none\\\" stroke=\\\"#fffdf1\\\" stroke-width=\\\"3\\\"/>\n      <g stroke=\\\"#789b9d\\\" stroke-width=\\\"2\\\" opacity=\\\".8\\\">\n        <animateTransform attributeName=\\\"transform\\\" type=\\\"rotate\\\" from=\\\"0\\\" to=\\\"360\\\" dur=\\\"1.2s\\\" repeatCount=\\\"indefinite\\\"/>\n        SPOKES\n        <path d=\\\"M 0 -98 A 98 98 0 0 1 69.3 -69.3\\\" fill=\\\"none\\\" stroke=\\\"#f3b96f\\\" stroke-width=\\\"5\\\"/>\n        <rect x=\\\"-4\\\" y=\\\"65\\\" width=\\\"8\\\" height=\\\"19\\\" rx=\\\"3\\\" fill=\\\"#f6b45e\\\" stroke=\\\"#fff6df\\\" stroke-width=\\\"2\\\"/>\n      </g>\n      <circle r=\\\"11\\\" fill=\\\"#f7f4df\\\" stroke=\\\"#263f46\\\" stroke-width=\\\"4\\\"/>\n      <circle r=\\\"3\\\" fill=\\\"#263f46\\\"/>\n    </g>\n  </defs>\n  <g clip-path=\\\"url(#scene)\\\">\n    <rect width=\\\"960\\\" height=\\\"720\\\" fill=\\\"url(#sky)\\\"/>\n    <circle cx=\\\"748\\\" cy=\\\"155\\\" r=\\\"61\\\" fill=\\\"#f7d68a\\\" opacity=\\\".8\\\"/>\n    <circle cx=\\\"748\\\" cy=\\\"155\\\" r=\\\"80\\\" fill=\\\"none\\\" stroke=\\\"#f7d68a\\\" stroke-width=\\\"1.5\\\" opacity=\\\".45\\\"/>\n    <g fill=\\\"#fffef5\\\" opacity=\\\".85\\\">\n      <path d=\\\"M 109 167 Q 111 148 132 150 Q 143 119 171 135 Q 189 135 193 157 Q 215 156 220 170 L 111 170 Z\\\"/>\n      <path d=\\\"M 690 283 Q 699 262 718 272 Q 730 242 754 257 Q 771 251 782 275 Q 804 270 813 286 Z\\\"/>\n    </g>\n    <g fill=\\\"none\\\" stroke=\\\"#8ba9a5\\\" stroke-width=\\\"3\\\" stroke-linecap=\\\"round\\\" opacity=\\\".65\\\">\n      <path d=\\\"M 270 139 q 10 -10 20 0 q 10 -10 20 0\\\"/>\n      <path d=\\\"M 320 112 q 7 -7 14 0 q 7 -7 14 0\\\"/>\n    </g>\n    <path d=\\\"M 0 478 Q 160 428 320 472 T 640 464 T 960 472 L 960 620 L 0 620 Z\\\" fill=\\\"#d5e5d5\\\"/>\n    <path d=\\\"M 0 530 Q 140 477 330 526 T 680 517 T 960 526 L 960 628 L 0 628 Z\\\" fill=\\\"#bed8c5\\\"/>\n    <path d=\\\"M 0 586 Q 200 565 400 588 T 960 579 L 960 720 L 0 720 Z\\\" fill=\\\"#f3e6c7\\\"/>\n    <path d=\\\"M 0 616 H 960\\\" stroke=\\\"#d2c5a6\\\" stroke-width=\\\"2\\\"/>\n    <ellipse cx=\\\"492\\\" cy=\\\"623\\\" rx=\\\"322\\\" ry=\\\"16\\\" fill=\\\"#7e8973\\\" opacity=\\\".13\\\"/>\n    <g stroke=\\\"#c7b990\\\" stroke-width=\\\"3\\\" stroke-linecap=\\\"round\\\">\n      <animateTransform attributeName=\\\"transform\\\" type=\\\"translate\\\" from=\\\"0 0\\\" to=\\\"-240 0\\\" dur=\\\"1.2s\\\" repeatCount=\\\"indefinite\\\"/>\n      <path d=\\\"M 30 651 h 48 m 192 0 h 48 m 192 0 h 48 m 192 0 h 48 m 192 0 h 48 M 145 680 h 19 m 221 0 h 19 m 221 0 h 19 m 221 0 h 19 m 221 0 h 19\\\"/>\n    </g>\n    <g fill=\\\"none\\\" stroke=\\\"#91b49c\\\" stroke-width=\\\"3\\\" stroke-linecap=\\\"round\\\">\n      <path d=\\\"M 95 586 l -6 -15 m 6 15 l 10 -21 m -10 21 l 19 -8 M 836 585 l -7 -13 m 7 13 l 8 -21 m -8 21 l 18 -8\\\"/>\n    </g>\n    <\"'!-- Wheels rotate about their own hubs. -->\n    <use href=\"#wheel\" x=\"300\" y=\"500\"/>\n    <use href=\"#wheel\" x=\"690\" y=\"500\"/>\n    <!-- Far leg and pedal pass behind the bicycle frame. -->\n    FAR_LEG\n    <g transform=\"translate(468 494)\">\n      <g><animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0\" to=\"360\" dur=\"1.2s\" repeatCount=\"indefinite\"/>\n        <path d=\"M 0 0 H -39\" stroke=\"#637c7a\" stroke-width=\"9\" stroke-linecap=\"round\"/>\n      </g>\n    </g>\n    FAR_FOOT\n    <!-- Sea-green diamond frame. -->\n    <g fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <path d=\"M 300 500 L 429 382 L 468 494 Z M 429 382 L 626 382 L 468 494 M 626 382 L 690 500\" stroke=\"#263f46\" stroke-width=\"15\"/>\n      <path d=\"M 300 500 L 429 382 L 468 494 Z M 429 382 L 626 382 L 468 494 M 626 382 L 690 500\" stroke=\"#389e94\" stroke-width=\"10\"/>\n      <path d=\"M 433 382 L 621 382 M 475 483 L 621 387 M 636 394 L 685 484\" stroke=\"#81d0b5\" stroke-width=\"3\"/>\n      <path d=\"M 429 382 L 417 341\" stroke=\"#263f46\" stroke-width=\"10\"/>\n      <path d=\"M 429 379 L 419 346\" stroke=\"#b3c7be\" stroke-width=\"5\"/>\n      <path d=\"M 626 382 L 606 322 Q 602 307 618 303 L 647 297\" stroke=\"#263f46\" stroke-width=\"10\"/>\n      <path d=\"M 626 378 L 609 324 Q 605 309 620 307 L 636 303\" stroke=\"#b5c9c2\" stroke-width=\"5\"/>\n      <path d=\"M 638 299 L 656 295\" stroke=\"#a65e42\" stroke-width=\"12\"/>\n      <path d=\"M 648 305 Q 683 341 650 394\" stroke=\"#526b66\" stroke-width=\"2\"/>\n    </g>\n    <path d=\"M 386 335 Q 398 330 420 335 Q 441 338 463 334 Q 471 336 466 344 Q 427 353 391 346 Q 382 343 386 335 Z\" fill=\"#a76649\" stroke=\"#263f46\" stroke-width=\"3\"/>\n    <!-- Moving chain and chainring. -->\n    <path d=\"M 302 485 L 465 465 A 29 29 0 0 1 470 523 L 302 515 A 15 15 0 0 1 302 485 Z\" fill=\"#e2eadb\" fill-opacity=\".65\" stroke=\"#526d66\" stroke-width=\"5\"/>\n    <path d=\"M 302 485 L 465 465 A 29 29 0 0 1 470 523 L 302 515 A 15 15 0 0 1 302 485 Z\" fill=\"none\" stroke=\"#c9d7bf\" stroke-width=\"2\" stroke-dasharray=\"4 7\"><animate attributeName=\"stroke-dashoffset\" from=\"0\" to=\"-44\" dur=\"1.2s\" repeatCount=\"indefinite\"/></path>\n    <g transform=\"translate(468 494)\">\n      <circle r=\"27\" fill=\"#365b58\" stroke=\"#203e43\" stroke-width=\"3\"/>\n      <g><animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0\" to=\"360\" dur=\"1.2s\" repeatCount=\"indefinite\"/>\n        <circle r=\"19\" fill=\"none\" stroke=\"#b2c8b7\" stroke-width=\"3\" stroke-dasharray=\"8 7\"/>\n        <path d=\"M -14 0 H 39\" stroke=\"#263f46\" stroke-width=\"10\" stroke-linecap=\"round\"/>\n        <path d=\"M -13 -1 H 38\" stroke=\"#d5dfcb\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n      </g>\n      <circle r=\"6\" fill=\"#f6c46d\" stroke=\"#263f46\" stroke-width=\"2\"/>\n    </g>\n    NEAR_LEG\n    NEAR_FOOT\n    <!-- The body rests directly on the saddle; the wing reaches the handlebar. -->\n    <g stroke=\"#263f46\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <path d=\"M 371 275 L 309 248 L 327 282 L 306 278 Q 329 310 373 311\" fill=\"#e4ebe3\" stroke-width=\"4\"/>\n      <path d=\"M 364 234 Q 394 215 448 232 Q 477 238 486 222 Q 495 210 490 180 Q 481 136 510 118 Q 540 99 564 119 Q 586 140 567 163 Q 557 176 536 176 Q 531 196 543 222 Q 559 261 528 300 Q 502 331 452 337 Q 405 341 370 316 Q 340 296 344 267 Q 346 247 364 234 Z\" fill=\"url(#body)\" stroke-width=\"4\"/>\n      <path d=\"M 493 159 Q 503 186 511 190 Q 506 219 523 238\" fill=\"none\" stroke=\"#c1d6ce\" stroke-width=\"7\"/>\n      <path d=\"M 358 278 Q 370 313 410 320\" fill=\"none\" stroke=\"#fffef7\" stroke-width=\"6\"/>\n      <path d=\"M 384 255 Q 418 237 454 259 Q 481 276 508 281 L 553 304 Q 582 314 619 296 Q 629 289 636 294 L 647 300 Q 651 306 644 310 L 631 306 Q 595 331 557 325 L 490 308 Q 429 326 392 295 Q 377 281 384 255 Z\" fill=\"#f5f7ed\" stroke-width=\"4\"/>\n      <path d=\"M 398 271 Q 433 294 484 290 M 397 282 Q 431 306 478 300 M 511 300 Q 547 315 568 316\" fill=\"none\" stroke=\"#b9cec5\" stroke-width=\"3\"/>\n      <path d=\"M 637 300 L 644 304 M 631 303 L 637 308\" stroke-width=\"2\"/>\n      <!-- A long bill and a generous pelican throat pouch. -->\n      <path d=\"M 557 152 Q 612 159 710 176 Q 672 207 604 213 Q 565 211 547 171 Z\" fill=\"url(#pouch)\" stroke-width=\"3.5\"/>\n      <path d=\"M 555 147 Q 624 152 712 174 Q 722 177 709 182 L 555 165 Q 546 158 555 147 Z\" fill=\"#f7bd59\" stroke-width=\"3.5\"/>\n      <path d=\"M 570 160 L 695 176\" fill=\"none\" stroke=\"#ffe39a\" stroke-width=\"3\"/>\n      <path d=\"M 565 179 Q 590 204 623 201\" fill=\"none\" stroke=\"#ffd899\" stroke-width=\"3\"/>\n      <ellipse cx=\"543\" cy=\"144\" rx=\"12\" ry=\"14\" fill=\"#fffdf3\" stroke-width=\"2.5\"/>\n      <ellipse cx=\"547\" cy=\"145\" rx=\"5\" ry=\"7\" fill=\"#263f46\" stroke=\"none\"/>\n      <circle cx=\"548\" cy=\"142\" r=\"2\" fill=\"#fff\" stroke=\"none\"/>\n      <path d=\"M 530 122 Q 540 118 550 123\" fill=\"none\" stroke-width=\"3\"/>\n      <path d=\"M 514 115 Q 504 103 508 95 M 520 112 Q 517 98 523 91\" fill=\"none\" stroke-width=\"3\"/>\n    </g>\n    <!-- A scarf and wind marks add a little momentum. -->\n    <path d=\"M 498 211 Q 477 210 464 191 Q 440 181 416 196 L 430 202 L 417 213 Q 444 202 465 209 Q 482 229 504 226 Z\" fill=\"#df7152\" stroke=\"#ab523e\" stroke-width=\"2\">\n      <animate attributeName=\"d\" values=\"M 498 211 Q 477 210 464 191 Q 440 181 416 196 L 430 202 L 417 213 Q 444 202 465 209 Q 482 229 504 226 Z;M 498 211 Q 477 210 464 201 Q 440 209 413 198 L 429 192 L 419 183 Q 445 191 465 190 Q 482 229 504 226 Z;M 498 211 Q 477 210 464 191 Q 440 181 416 196 L 430 202 L 417 213 Q 444 202 465 209 Q 482 229 504 226 Z\" dur=\".6s\" repeatCount=\"indefinite\"/>\n    </path>\n    <path d=\"M 493 205 Q 502 215 516 215 L 518 227 Q 501 229 491 218 Z\" fill=\"#ed8661\" stroke=\"#ab523e\" stroke-width=\"2\"/>\n    <g fill=\"none\" stroke=\"#8cacaa\" stroke-width=\"3\" stroke-linecap=\"round\">\n      <path d=\"M 258 248 H 294 M 226 275 H 281 M 252 302 H 281\">\n        <animate attributeName=\"opacity\" values=\".35;.8;.35\" dur=\"1.2s\" repeatCount=\"indefinite\"/>\n      </path>\n    </g>\n  </g>\n</svg>\n'\"'''\nsvg=svg.replace('SPOKES',spokes).replace('FAR_LEG',leg(pi,(435,323),'#c58143',12)).replace('NEAR_LEG',leg(0,(454,322),'#edaa54',14)).replace('FAR_FOOT',foot(pi,'#d89549')).replace('NEAR_FOOT',foot(0,'#f1b75e'))\nPath('pelican.svg').write_text(svg)\nprint(f'Created pelican.svg ({len(svg):,} bytes)')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
