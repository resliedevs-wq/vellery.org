{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/make_pelican.py <<'PY'\nimport math\nfrom pathlib import Path\nfrom xml.sax.saxutils import escape\n\nN = 48\nDURATION = '1.6s'\nink = '#303f40'\n\ndef animation(attribute, values, duration=DURATION, extra=''):\n    return f'<animate attributeName=\\\"{attribute}\\\" values=\\\"{\\\";\\\".join(values)}\\\" dur=\\\"{duration}\\\" repeatCount=\\\"indefinite\\\" {extra}/>'\n\ndef leg(hip, phase, near=True):\n    paths, translations = [], []\n    for i in range(N+1):\n        a = 2*math.pi*i/N+phase\n        px, py = 475+37*math.cos(a), 558+37*math.sin(a)\n        ax, ay = px-8, py-13\n        dx, dy = ax-hip[0], ay-hip[1]\n        dist = math.hypot(dx, dy)\n        upper, lower = 85, 96\n        along = (upper**2-lower**2+dist**2)/(2*dist)\n        height = math.sqrt(max(0, upper**2-along**2))\n        kx = hip[0]+along*dx/dist+height*dy/dist\n        ky = hip[1]+along*dy/dist-height*dx/dist\n        paths.append(f'M {hip[0]} {hip[1]} L {kx:.2f} {ky:.2f} L {ax:.2f} {ay:.2f}')\n        translations.append(f'{px:.2f} {py:.2f}')\n    color = '#efac65' if near else '#cf8a53'\n    lines = ''.join(f'<path d=\\\"{paths[0]}\\\" fill=\\\"none\\\" stroke=\\\"{color_}\\\" stroke-width=\\\"{width}\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\">{animation(\\\"d\\\", paths)}</path>' for color_,width in [(ink,17),(color,11)])\n    foot = f'''<g transform=\\\"translate({translations[0]})\\\">\n      <animateTransform attributeName=\\\"transform\\\" type=\\\"translate\\\" values=\\\"{';'.join(translations)}\\\" dur=\\\"{DURATION}\\\" repeatCount=\\\"indefinite\\\"/>\n      <path d=\\\"M -13 -14 Q -9 -20 -4 -13 L 4 -7 L 21 -1 Q 24 3 17 4 L -13 3 Q -18 -2 -13 -14 Z\\\" fill=\\\"{color}\\\" stroke=\\\"{ink}\\\" stroke-width=\\\"3\\\" stroke-linejoin=\\\"round\\\"/>\n      <path d=\\\"M 1 -5 L 7 1 M 9 -3 L 14 2\\\" fill=\\\"none\\\" stroke=\\\"#aa6d43\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\"/>\n      <rect x=\\\"-17\\\" y=\\\"5\\\" width=\\\"39\\\" height=\\\"6\\\" rx=\\\"3\\\" fill=\\\"{ink}\\\"/>\n    </g>'''\n    return lines+foot\n\ndef wheel(cx,cy,r=103):\n    spokes=''.join(f'<path d=\\\"M {cx} {cy} L {cx+(r-10)*math.cos(i*math.pi/8):.2f} {cy+(r-10)*math.sin(i*math.pi/8):.2f}\\\"/>' for i in range(16))\n    return f'''<g>\n      <circle cx=\\\"{cx}\\\" cy=\\\"{cy}\\\" r=\\\"{r}\\\" fill=\\\"#f9f4e6\\\" stroke=\\\"{ink}\\\" stroke-width=\\\"15\\\"/>\n      <circle cx=\\\"{cx}\\\" cy=\\\"{cy}\\\" r=\\\"{r-3}\\\" fill=\\\"none\\\" stroke=\\\"#73817b\\\" stroke-width=\\\"2\\\"/>\n      <g>\n        <animateTransform attributeName=\\\"transform\\\" type=\\\"rotate\\\" from=\\\"0 {cx} {cy}\\\" to=\\\"360 {cx} {cy}\\\" dur=\\\"1.05s\\\" repeatCount=\\\"indefinite\\\"/>\n        <g stroke=\\\"#9da9a0\\\" stroke-width=\\\"2\\\">{spokes}</g>\n        <rect x=\\\"{cx+57}\\\" y=\\\"{cy-5}\\\" width=\\\"18\\\" height=\\\"10\\\" rx=\\\"4\\\" fill=\\\"#e7a34d\\\" stroke=\\\"#fff8e8\\\" stroke-width=\\\"2\\\"/>\n        <circle cx=\\\"{cx}\\\" cy=\\\"{cy}\\\" r=\\\"12\\\" fill=\\\"#f4e9cb\\\" stroke=\\\"{ink}\\\" stroke-width=\\\"4\\\"/>\n      </g>\n    </g>'''\n\nsvg=f'''<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"1000\\\" height=\\\"800\\\" viewBox=\\\"0 0 1000 800\\\" role=\\\"img\\\" aria-labelledby=\\\"title description\\\">\n  <title id=\\\"title\\\">Pelican Pedal Club</title>\n  <desc id=\\\"description\\\">An animated white pelican sits on the saddle of a teal bicycle, actively pedaling with its orange webbed feet. Its knees bend with the rotating cranks, both wheels spin, and seaside scenery drifts past.</desc>\n  <defs>\n    <pattern id=\\\"paper\\\" width=\\\"12\\\" height=\\\"12\\\" patternUnits=\\\"userSpaceOnUse\\\">\n      <circle cx=\\\"2\\\" cy=\\\"3\\\" r=\\\"0.65\\\" fill=\\\"#786e54\\\" opacity=\\\"0.08\\\"/>\n      <circle cx=\\\"9\\\" cy=\\\"9\\\" r=\\\"0.5\\\" fill=\\\"#786e54\\\" opacity=\\\"0.06\\\"/>\n    </pattern>\n    <clipPath id=\\\"scene\\\"><rect x=\\\"44\\\" y=\\\"154\\\" width=\\\"912\\\" height=\\\"568\\\" rx=\\\"36\\\"/></clipPath>\n    <pattern id=\\\"road\\\" width=\\\"220\\\" height=\\\"20\\\" patternUnits=\\\"userSpaceOnUse\\\">\n      <path d=\\\"M 5 10 H 64 M 151 10 H 167\\\" fill=\\\"none\\\" stroke=\\\"#bbb79d\\\" stroke-width=\\\"3\\\" stroke-linecap=\\\"round\\\"/>\n    </pattern>\n  </defs>\n  <rect width=\\\"1000\\\" height=\\\"800\\\" fill=\\\"#f8f3e7\\\"/>\n  <rect width=\\\"1000\\\" height=\\\"800\\\" fill=\\\"url(#paper)\\\"/>\n  <g fill=\\\"{ink}\\\" font-family=\\\"Arial, Helvetica, sans-serif\\\">\n    <text x=\\\"62\\\" y=\\\"66\\\" font-size=\\\"12\\\" font-weight=\\\"700\\\" letter-spacing=\\\"4\\\">THE COASTAL COMMUTE</text>\n    <text x=\\\"59\\\" y=\\\"116\\\" font-size=\\\"44\\\" font-weight=\\\"800\\\" letter-spacing=\\\"-2\\\">Pelican Pedal Club<tspan fill=\\\"#d88351\\\">.</tspan></text>\n    <g transform=\\\"translate(894 76)\\\" fill=\\\"none\\\" stroke=\\\"{ink}\\\" stroke-width=\\\"2\\\">\n      <circle r=\\\"26\\\"/><path d=\\\"M -13 5 Q 0 -10 13 5 M -13 -3 Q 0 -18 13 -3\\\"/>\n      <path d=\\\"M -11 13 H 11\\\"/>\n    </g>\n  </g>\n  <g clip-path=\\\"url(#scene)\\\">\n    <rect x=\\\"44\\\" y=\\\"154\\\" width=\\\"912\\\" height=\\\"568\\\" fill=\\\"#e5ede1\\\"/>\n    <circle cx=\\\"735\\\" cy=\\\"298\\\" r=\\\"109\\\" fill=\\\"#edba83\\\"/>\n    <circle cx=\\\"735\\\" cy=\\\"298\\\" r=\\\"87\\\" fill=\\\"#f1c693\\\"/>\n    <path d=\\\"M 44 448 Q 150 416 263 440 T 495 435 T 731 442 T 956 423 V 590 H 44 Z\\\" fill=\\\"#b5d2c4\\\"/>\n    <path d=\\\"M 44 491 Q 188 470 327 491 T 603 483 T 956 488 V 614 H 44 Z\\\" fill=\\\"#94bcae\\\"/>\n    <g stroke=\\\"#d7e6d8\\\" stroke-width=\\\"3\\\" stroke-linecap=\\\"round\\\" opacity=\\\"0.9\\\">\n      <g>\n        <animateTransform attributeName=\\\"transform\\\" type=\\\"translate\\\" from=\\\"0 0\\\" to=\\\"-180 0\\\" dur=\\\"4s\\\" repeatCount=\\\"indefinite\\\"/>\n        <path d=\\\"M 88 471 H 138 M 293 458 H 325 M 744 469 H 813 M 939 454 H 1008 M 1060 486 H 1112\\\"/>\n      </g>\n    </g>\n    <g fill=\\\"none\\\" stroke=\\\"#607f75\\\" stroke-width=\\\"2.5\\\" stroke-linecap=\\\"round\\\">\n      <path d=\\\"M 776 205 Q 785 195 794 205 Q 804 195 813 205\\\">\n        <animateTransform attributeName=\\\"transform\\\" type=\\\"translate\\\" values=\\\"0 0;-12 -4;0 0\\\" dur=\\\"5s\\\" repeatCount=\\\"indefinite\\\"/>\n      </path>\n      <path d=\\\"M 180 279 Q 186 273 192 279 Q 198 273 204 279\\\"/>\n    </g>\n    <path d=\\\"M 44 589 Q 427 568 956 590 V 722 H 44 Z\\\" fill=\\\"#e6ddbd\\\"/>\n    <path d=\\\"M 44 608 Q 476 586 956 610\\\" fill=\\\"none\\\" stroke=\\\"#f6efd9\\\" stroke-width=\\\"5\\\"/>\n    <ellipse cx=\\\"495\\\" cy=\\\"684\\\" rx=\\\"294\\\" ry=\\\"17\\\" fill=\\\"#626f5b\\\" opacity=\\\"0.12\\\">\n      <animate attributeName=\\\"rx\\\" values=\\\"294;284;294\\\" dur=\\\"1.6s\\\" repeatCount=\\\"indefinite\\\"/>\n    </ellipse>\n    <g>\n      <animateTransform attributeName=\\\"transform\\\" type=\\\"translate\\\" from=\\\"0 0\\\" to=\\\"-220 0\\\" dur=\\\"1.6s\\\" repeatCount=\\\"indefinite\\\"/>\n      <rect x=\\\"44\\\" y=\\\"693\\\" width=\\\"1132\\\" height=\\\"20\\\" fill=\\\"url(#road)\\\"/>\n    </g>\n    <\"'!-- Wheels rotate clockwise as the bicycle travels to the right. -->\n    {wheel(310,574)}\n    {wheel(665,574)}\n    <!-- Far leg and pedal are half a revolution behind the near pair. -->\n    {leg((426,414),math.pi,False)}\n    <!-- Bicycle frame and fork. -->\n    <g fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <path d=\"M 310 574 L 429 461 L 475 558 L 310 574 M 429 461 L 596 456 L 475 558 M 596 456 L 665 574\" stroke=\"{ink}\" stroke-width=\"16\"/>\n      <path d=\"M 310 574 L 429 461 L 475 558 L 310 574 M 429 461 L 596 456 L 475 558 M 596 456 L 665 574\" stroke=\"#368e88\" stroke-width=\"10\"/>\n      <path d=\"M 429 461 L 419 434 M 596 456 L 578 407\" stroke=\"{ink}\" stroke-width=\"10\"/>\n      <path d=\"M 590 437 L 580 408 Q 577 399 588 396 L 610 391 Q 624 389 627 400 Q 629 411 617 414\" stroke=\"{ink}\" stroke-width=\"7\"/>\n      <path d=\"M 609 392 Q 625 389 627 400 Q 629 411 617 414\" stroke=\"#b9774b\" stroke-width=\"10\"/>\n      <path d=\"M 617 414 Q 651 442 649 494\" stroke=\"#55635b\" stroke-width=\"2\"/>\n      <path d=\"M 289 461 L 340 461\" stroke=\"{ink}\" stroke-width=\"5\"/>\n    </g>\n    <path d=\"M 391 429 Q 405 425 419 430 L 458 430 Q 468 430 466 438 Q 464 445 450 446 L 405 445 Q 390 442 391 429 Z\" fill=\"#a66543\" stroke=\"{ink}\" stroke-width=\"4\"/>\n    <path d=\"M 402 433 L 454 435\" stroke=\"#d9a371\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n    <!-- Chain and crank: each foot stays directly above its own pedal. -->\n    <path d=\"M 309 558 L 474 525 A 33 33 0 1 1 475 591 L 310 589 A 16 16 0 0 1 309 558 Z\" fill=\"none\" stroke=\"{ink}\" stroke-width=\"4\"/>\n    <circle cx=\"475\" cy=\"558\" r=\"31\" fill=\"#f3e7ca\" stroke=\"{ink}\" stroke-width=\"5\"/>\n    <g>\n      <animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0 475 558\" to=\"360 475 558\" dur=\"{DURATION}\" repeatCount=\"indefinite\"/>\n      <g fill=\"#9dada0\">\n        <circle cx=\"475\" cy=\"538\" r=\"4\"/><circle cx=\"495\" cy=\"558\" r=\"4\"/>\n        <circle cx=\"475\" cy=\"578\" r=\"4\"/><circle cx=\"455\" cy=\"558\" r=\"4\"/>\n      </g>\n      <path d=\"M 438 558 H 512\" stroke=\"{ink}\" stroke-width=\"9\" stroke-linecap=\"round\"/>\n      <path d=\"M 475 558 H 512\" stroke=\"#c3c9b9\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n    </g>\n    <circle cx=\"475\" cy=\"558\" r=\"7\" fill=\"#f8edcf\" stroke=\"{ink}\" stroke-width=\"3\"/>\n    <!-- The pelican'\"'s belly rests on the saddle. -->\n    <path d=\\\"M 354 357 L 300 326 Q 299 352 315 372 L 287 362 Q 296 390 339 400 Z\\\" fill=\\\"#c4c9bd\\\" stroke=\\\"{ink}\\\" stroke-width=\\\"4\\\" stroke-linejoin=\\\"round\\\"/>\n    <path d=\\\"M 327 359 C 329 317 367 289 414 292 C 449 292 474 306 487 315 C 507 306 492 281 502 257 C 510 232 529 215 553 216 C 579 211 603 223 607 245 C 609 263 595 278 576 281 C 553 284 553 303 550 329 C 549 359 532 387 505 406 C 487 421 463 430 449 433 C 425 440 394 432 370 419 C 340 406 325 384 327 359 Z\\\" fill=\\\"#fff9e9\\\" stroke=\\\"{ink}\\\" stroke-width=\\\"4\\\" stroke-linejoin=\\\"round\\\"/>\n    <path d=\\\"M 515 271 C 506 313 530 324 513 352 C 499 376 479 384 474 406 C 492 396 512 384 522 363 C 540 328 530 304 542 283 Z\\\" fill=\\\"#e3e3d2\\\"/>\n    <path d=\\\"M 355 382 Q 375 420 425 427\\\" fill=\\\"none\\\" stroke=\\\"#e0decb\\\" stroke-width=\\\"10\\\" stroke-linecap=\\\"round\\\"/>\n    <path d=\\\"M 528 223 L 518 210 L 536 216 L 535 203 L 550 216\\\" fill=\\\"#fff9e9\\\" stroke=\\\"{ink}\\\" stroke-width=\\\"3\\\" stroke-linejoin=\\\"round\\\"/>\n    <\"'!-- Distinctively long bill and elastic throat pouch. -->\n    <path d=\"M 588 249 L 751 251 Q 719 274 678 300 Q 636 325 605 294 Q 594 280 588 249 Z\" fill=\"#e9b577\" stroke=\"{ink}\" stroke-width=\"3.5\" stroke-linejoin=\"round\"/>\n    <path d=\"M 609 263 Q 622 307 661 299 Q 701 282 731 263\" fill=\"#f3ce93\"/>\n    <path d=\"M 589 241 Q 652 232 753 249 Q 769 252 763 260 Q 758 267 748 260 L 591 258 Z\" fill=\"#e89a4f\" stroke=\"{ink}\" stroke-width=\"3.5\" stroke-linejoin=\"round\"/>\n    <path d=\"M 608 248 Q 680 245 743 253\" fill=\"none\" stroke=\"#ffce7d\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n    <path d=\"M 599 261 Q 602 275 610 279\" fill=\"none\" stroke=\"#b8804d\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n    <circle cx=\"578\" cy=\"239\" r=\"10\" fill=\"#e9b577\"/>\n    <g>\n      <animate attributeName=\"opacity\" values=\"1;1;0;1;1\" keyTimes=\"0;0.93;0.945;0.96;1\" dur=\"5.8s\" repeatCount=\"indefinite\"/>\n      <circle cx=\"579\" cy=\"239\" r=\"5.5\" fill=\"{ink}\"/>\n      <circle cx=\"581\" cy=\"237\" r=\"1.8\" fill=\"#fff9e9\"/>\n    </g>\n    <path d=\"M 572 224 Q 579 220 585 224\" fill=\"none\" stroke=\"{ink}\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n    <!-- Near leg bends at the knee using a two-link inverse-kinematic cycle. -->\n    {leg((446,418),0,True)}\n    <!-- Wing feathers conceal the hip and the forward wing rests on the handlebar. -->\n    <path d=\"M 368 336 C 395 315 438 322 457 349 C 468 366 479 389 503 396 L 578 394 Q 588 395 586 402 Q 586 410 575 412 L 513 423 C 475 434 437 411 411 399 C 392 390 367 368 368 336 Z\" fill=\"#d4d7c8\" stroke=\"{ink}\" stroke-width=\"4\" stroke-linejoin=\"round\"/>\n    <path d=\"M 379 342 C 407 331 433 341 445 361 C 460 383 478 404 509 411 C 475 415 447 399 423 384 C 400 369 389 353 379 342 Z\" fill=\"#aebcaf\"/>\n    <g fill=\"none\" stroke=\"#6f8a7c\" stroke-width=\"3\" stroke-linecap=\"round\">\n      <path d=\"M 392 345 Q 423 354 445 382\"/>\n      <path d=\"M 397 361 Q 426 375 445 395\"/>\n      <path d=\"M 413 384 Q 426 396 438 400\"/>\n    </g>\n    <path d=\"M 558 401 L 575 400 M 561 407 L 577 405\" fill=\"none\" stroke=\"#7a9384\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n    <!-- Little speed lines keep the rider firmly in the seaside scene. -->\n    <g fill=\"none\" stroke=\"#658a7c\" stroke-width=\"3\" stroke-linecap=\"round\" opacity=\"0.7\">\n      <path d=\"M 221 358 H 270 M 241 372 H 278 M 226 386 H 257\">\n        <animate attributeName=\"opacity\" values=\"0.4;0.9;0.4\" dur=\"1.6s\" repeatCount=\"indefinite\"/>\n      </path>\n    </g>\n  </g>\n  <g fill=\"{ink}\" font-family=\"Arial, Helvetica, sans-serif\" font-size=\"11\" font-weight=\"700\" letter-spacing=\"2.2\">\n    <text x=\"62\" y=\"760\">SALT AIR. TWO WHEELS. NO HURRY.</text>\n    <text x=\"937\" y=\"760\" text-anchor=\"end\" fill=\"#658377\">ENJOY THE RIDE ↗</text>\n  </g>\n</svg>\n'\"'''\nPath('/tmp/vellery-jmcfdj2s/work/pelican.svg').write_text(svg)\nPY\npython3 /tmp/make_pelican.py\npython3 - <<'PY'\nfrom pathlib import Path\nfrom xml.etree import ElementTree as E