-linecap=\"round\" stroke-linejoin=\"round\">\n    <path d=\"M 300 600 L 480 590\" stroke=\"#263f3b\" stroke-width=\"12\"/>\n    <path d=\"M 300 600 L 480 590\" stroke=\"#78887b\" stroke-width=\"7\"/>\n    <path d=\"M 300 590 L 480 567 A 24 24 0 0 1 480 614 L 300 610 A 10 10 0 0 1 300 590 Z\" stroke=\"#667b6f\" stroke-width=\"3\"/>\n    <g stroke=\"#263f3b\" stroke-width=\"13\">\n      <path d=\"M 300 600 L 437 466 L 480 590 L 634 466 Z M 437 466 L 480 590\"/>\n      <path d=\"M 634 466 L 710 600\"/>\n    </g>\n    <g stroke=\"#337f77\" stroke-width=\"8\">\n      <path d=\"M 300 600 L 437 466 L 480 590 L 634 466 Z M 437 466 L 480 590\"/>\n      <path d=\"M 634 466 L 710 600\"/>\n    </g>\n    <path d=\"M 450 479 L 477 559\" stroke=\"#73aaa0\" stroke-width=\"2.5\"/>\n    <path d=\"M 440 463 L 431 434\" stroke=\"#273f3b\" stroke-width=\"8\"/>\n    <path d=\"M 409 433 Q 435 425 468 432 Q 476 434 470 441 L 416 445 Q 403 443 409 433 Z\" fill=\"#a66445\" stroke=\"#273f3b\" stroke-width=\"3\"/>\n    <path d=\"M 633 468 L 618 420 Q 614 406 632 402 L 654 402\" stroke=\"#273f3b\" stroke-width=\"9\"/>\n    <path d=\"M 634 467 L 619 420 Q 615 407 632 403\" stroke=\"#9cad9d\" stroke-width=\"4\"/>\n    <path d=\"M 642 402 H 665\" stroke=\"#a66445\" stroke-width=\"12\"/>\n    <path d=\"M 650 410 Q 686 451 672 493\" stroke=\"#273f3b\" stroke-width=\"2\"/>\n    <path d=\"M 663 511 A 98 98 0 0 1 795 537\" stroke=\"#337f77\" stroke-width=\"6\"/>\n    <path d=\"M 215 535 A 105 105 0 0 1 350 506\" stroke=\"#337f77\" stroke-width=\"6\"/>\n  </g>\n  <!-- The crank arms rotate around the bottom bracket; pedals stay level. -->\n  <circle cx=\"480\" cy=\"590\" r=\"27\" fill=\"#e2b878\" stroke=\"#273f3b\" stroke-width=\"4\"/>\n  <g transform=\"translate(480 590)\">\n    <g>\n      <animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0\" to=\"360\" dur=\"{D}\" repeatCount=\"indefinite\"/>\n      <circle r=\"19\" fill=\"none\" stroke=\"#fff0cb\" stroke-width=\"3\" stroke-dasharray=\"3 7\"/>\n      <path d=\"M -37 0 H 37\" stroke=\"#273f3b\" stroke-width=\"8\" stroke-linecap=\"round\"/>\n      <path d=\"M -37 0 H 37\" stroke=\"#aab7a6\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n    </g>\n    <circle r=\"6\" fill=\"#273f3b\"/>\n  </g>\n  {leg(0,(466,425),'\"'#e9a357',11)}\n  <\"'!-- Pelican: its lower body rests directly on the leather saddle. -->\n  <g stroke=\"#354e49\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n    <!-- Tail feathers. -->\n    <path d=\"M 393 370 Q 359 366 336 343 Q 334 363 352 383 L 334 377 Q 347 402 382 402 Z\" fill=\"#354e49\" stroke-width=\"3\"/>\n    <!-- Rounded body with a long, folded pelican neck. -->\n    <path d=\"M 383 354 C 411 330 451 327 481 347 C 497 357 501 373 511 365 C 531 345 511 316 514 286 C 517 258 536 235 561 238 C 584 239 595 258 585 275 C 578 289 555 290 551 304 C 546 323 570 352 555 383 C 544 406 517 410 493 420 C 469 438 434 442 408 427 C 377 414 364 385 383 354 Z\" fill=\"#fffdf2\" stroke-width=\"3.5\"/>\n    <!-- Soft shadow along the chest and under the belly. -->\n    <path d=\"M 550 304 C 540 331 558 352 545 378 C 533 400 509 398 489 412 Q 446 440 411 420 Q 447 448 489 427 C 514 409 545 410 555 383 C 570 352 546 323 550 304 Z\" fill=\"#e2e6d9\" stroke=\"none\"/>\n    <!-- Folded wing, with dark primary feathers. -->\n    <path d=\"M 397 359 C 423 345 469 358 489 386 C 470 411 427 414 396 392 Q 383 376 397 359 Z\" fill=\"#e9ede1\" stroke-width=\"2.5\"/>\n    <path d=\"M 400 381 Q 428 401 472 389 L 490 386 Q 476 412 437 407 Q 414 402 400 391 Z\" fill=\"#354e49\" stroke-width=\"2\"/>\n    <path d=\"M 409 368 Q 434 362 459 379 M 405 378 Q 423 386 439 385 M 425 393 l 9 10 M 440 393 l 9 11 M 455 391 l 10 9\" fill=\"none\" stroke=\"#8fa59a\" stroke-width=\"2\"/>\n    <!-- A reaching wing holds the handlebar. -->\n    <path d=\"M 522 367 Q 552 369 581 387 Q 609 400 646 396 L 650 404 Q 608 415 575 402 Q 545 392 526 388\" fill=\"#fffdf2\" stroke-width=\"3\"/>\n    <path d=\"M 631 398 q 11 -7 17 -2 l 10 4 q 5 5 -1 7 l -14 -2 M 645 397 l 1 8\" fill=\"#e9ede1\" stroke-width=\"2\"/>\n    <!-- Head tuft and the unmistakably long bill and throat pouch. -->\n    <path d=\"M 533 249 Q 525 237 530 227 Q 537 240 547 241 M 544 241 Q 539 228 545 222 Q 549 235 557 239\" fill=\"#fffdf2\" stroke-width=\"2.5\"/>\n    <path d=\"M 572 270 L 733 278 Q 694 326 624 316 Q 587 310 570 285 Z\" fill=\"#eba16f\" stroke-width=\"3\"/>\n    <path d=\"M 580 283 Q 636 309 716 285 Q 677 319 624 309 Q 599 305 580 290 Z\" fill=\"#f1bc8a\" stroke=\"none\"/>\n    <path d=\"M 574 262 Q 646 257 738 275 Q 744 279 735 283 L 572 280 Q 565 271 574 262 Z\" fill=\"#edbb6f\" stroke-width=\"3\"/>\n    <path d=\"M 591 272 L 723 277\" fill=\"none\" stroke=\"#fff0c2\" stroke-width=\"2.5\"/>\n    <path d=\"M 729 275 Q 741 273 739 280 Q 737 286 733 285\" fill=\"#c48348\" stroke-width=\"2\"/>\n    <circle cx=\"565\" cy=\"257\" r=\"8\" fill=\"#efc67e\" stroke=\"none\"/>\n    <circle cx=\"566\" cy=\"256\" r=\"4.5\" fill=\"#273f3b\" stroke=\"none\"/>\n    <circle cx=\"567.5\" cy=\"254.5\" r=\"1.5\" fill=\"#fffdf2\" stroke=\"none\"/>\n    <path d=\"M 553 245 Q 560 241 568 244\" fill=\"none\" stroke-width=\"2.5\"/>\n    <path d=\"M 529 298 Q 526 322 536 338\" fill=\"none\" stroke=\"#c6d2c6\" stroke-width=\"3\"/>\n  </g>\n  <!-- Air passing the rider gives a quiet sense of forward motion. -->\n  <g fill=\"none\" stroke=\"#8ea99b\" stroke-width=\"3\" stroke-linecap=\"round\">\n    <g>\n      <animate attributeName=\"opacity\" values=\".3;.8;.3\" dur=\"1.4s\" repeatCount=\"indefinite\"/>\n      <path d=\"M 274 337 h 44 M 253 352 h 51 M 279 368 h 27\"/>\n    </g>\n  </g>\n  <g font-family=\"Arial, Helvetica, sans-serif\" font-size=\"10\" font-weight=\"700\" letter-spacing=\"2\" fill=\"#6a7e70\">\n    <text x=\"70\" y=\"769\">SALT AIR. TWO WHEELS. NO HURRY.</text>\n    <circle cx=\"815\" cy=\"765\" r=\"3\" fill=\"#337f77\"/>\n    <text x=\"829\" y=\"769\">ON THE COAST</text>\n  </g>\n</svg>\n'\"'''\nout.wr