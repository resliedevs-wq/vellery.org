{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/build_pelican.py <<'PY'\nfrom math import sin, cos, pi, sqrt\nfrom pathlib import Path\nfrom xml.etree import ElementTree as ET\n\nout=Path('/tmp/vellery-yn9w9zk4/work/pelican.svg')\nN=64\nD='1.4s'\ndef f(n): return f'{n:.2f}'\ndef leg(phase,hip,color,width):\n    poses=[]; feet=[]\n    for i in range(N+1):\n        a=2*pi*i/N+phase\n        px,py=480+37*cos(a),590+37*sin(a)\n        ax,ay=px-7,py-12\n        hx,hy=hip\n        dx,dy=ax-hx,ay-hy; dist=sqrt(dx*dx+dy*dy)\n        upper,lower=115,112\n        along=(upper*upper-lower*lower+dist*dist)/(2*dist)\n        high=sqrt(max(0,upper*upper-along*along))\n        kx=hx+dx*along/dist+dy*high/dist\n        ky=hy+dy*along/dist-dx*high/dist\n        poses.append(f'M {f(hx)} {f(hy)} L {f(kx)} {f(ky)} L {f(ax)} {f(ay)}')\n        feet.append(f'{f(px)} {f(py)}')\n    return f'''<g stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\">\n      <path d=\\\"{poses[0]}\\\" fill=\\\"none\\\" stroke=\\\"#354e49\\\" stroke-width=\\\"{width+4}\\\">\n        <animate attributeName=\\\"d\\\" dur=\\\"{D}\\\" repeatCount=\\\"indefinite\\\" values=\\\"{';'.join(poses)}\\\"/>\n      </path>\n      <path d=\\\"{poses[0]}\\\" fill=\\\"none\\\" stroke=\\\"{color}\\\" stroke-width=\\\"{width}\\\">\n        <animate attributeName=\\\"d\\\" dur=\\\"{D}\\\" repeatCount=\\\"indefinite\\\" values=\\\"{';'.join(poses)}\\\"/>\n      </path>\n      <g transform=\\\"translate({feet[0]})\\\">\n        <animateTransform attributeName=\\\"transform\\\" type=\\\"translate\\\" dur=\\\"{D}\\\" repeatCount=\\\"indefinite\\\" values=\\\"{';'.join(feet)}\\\"/>\n        <path d=\\\"M -12 -17 Q -5 -20 -2 -12 L 19 -6 L 11 -3 L 23 1 L -10 1 Q -18 -2 -12 -17 Z\\\" fill=\\\"{color}\\\" stroke=\\\"#354e49\\\" stroke-width=\\\"2.5\\\"/>\n        <path d=\\\"m -4 -8 15 5 M -3 -8 21 9\\\" stroke=\\\"#be6744\\\" stroke-width=\\\"1.5\\\" fill=\\\"none\\\" transform=\\\"translate(0 -1)\\\"/>\n        <path d=\\\"M -14 5 H 17\\\" stroke=\\\"#263f3b\\\" stroke-width=\\\"6\\\"/>\n      </g>\n    </g>'''\ndef wheel(x):\n    spokes=''.join(f'<path d=\\\"M 0 0 L {f(103*cos(a*pi/6))} {f(103*sin(a*pi/6))}\\\"/>' for a in range(12))\n    return f'''<g transform=\\\"translate({x} 600)\\\">\n      <circle r=\\\"117\\\" fill=\\\"#fffaf0\\\" stroke=\\\"#273f3b\\\" stroke-width=\\\"13\\\"/>\n      <circle r=\\\"108\\\" fill=\\\"none\\\" stroke=\\\"#96aca1\\\" stroke-width=\\\"3\\\"/>\n      <g>\n        <animateTransform attributeName=\\\"transform\\\" type=\\\"rotate\\\" from=\\\"0\\\" to=\\\"360\\\" dur=\\\"2.1s\\\" repeatCount=\\\"indefinite\\\"/>\n        <g stroke=\\\"#90a69d\\\" stroke-width=\\\"2\\\">{spokes}</g>\n        <path d=\\\"M 0 -102 V -94\\\" stroke=\\\"#263f3b\\\" stroke-width=\\\"4\\\" stroke-linecap=\\\"round\\\"/>\n        <path d=\\\"M 73 -80 A 108 108 0 0 1 100 -41\\\" fill=\\\"none\\\" stroke=\\\"#f5c779\\\" stroke-width=\\\"4\\\" stroke-linecap=\\\"round\\\"/>\n      </g>\n      <circle r=\\\"10\\\" fill=\\\"#e9bb73\\\" stroke=\\\"#273f3b\\\" stroke-width=\\\"4\\\"/>\n    </g>'''\nsvg=f'''<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"1000\\\" height=\\\"800\\\" viewBox=\\\"0 0 1000 800\\\" role=\\\"img\\\" aria-labelledby=\\\"title desc\\\">\n  <title id=\\\"title\\\">Pelican pedal club</title>\n  <desc id=\\\"desc\\\">An animated white pelican sits on the saddle of a teal bicycle and actively pedals along a sunny coastal road. Its orange webbed feet follow the revolving cranks, both wheels turn, and the road rolls underneath.</desc>\n  <defs>\n    <clipPath id=\\\"scene\\\"><rect x=\\\"65\\\" y=\\\"155\\\" width=\\\"870\\\" height=\\\"574\\\" rx=\\\"205\\\"/></clipPath>\n    <clipPath id=\\\"road\\\"><path d=\\\"M 65 691 H 935 V 730 H 65 Z\\\"/></clipPath>\n    <pattern id=\\\"chain\\\" width=\\\"9\\\" height=\\\"6\\\" patternUnits=\\\"userSpaceOnUse\\\"><path d=\\\"M 0 3 H 6\\\" stroke=\\\"#d5ddce\\\" stroke-width=\\\"2\\\"/></pattern>\n  </defs>\n  <rect width=\\\"1000\\\" height=\\\"800\\\" fill=\\\"#f9f4e8\\\"/>\n  <g font-family=\\\"Arial, Helvetica, sans-serif\\\" fill=\\\"#273f3b\\\">\n    <g transform=\\\"translate(71 51)\\\">\n      <circle cx=\\\"9\\\" cy=\\\"9\\\" r=\\\"8\\\" fill=\\\"none\\\" stroke=\\\"#273f3b\\\" stroke-width=\\\"2\\\"/>\n      <path d=\\\"M 3 9 H 15 M 9 3 V 15\\\" stroke=\\\"#273f3b\\\" stroke-width=\\\"1.5\\\"/>\n      <text x=\\\"29\\\" y=\\\"14\\\" font-size=\\\"12\\\" font-weight=\\\"700\\\" letter-spacing=\\\"3\\\">PELICAN PEDAL CLUB</text>\n    </g>\n    <text x=\\\"68\\\" y=\\\"119\\\" font-size=\\\"44\\\" font-weight=\\\"700\\\" letter-spacing=\\\"-1.8\\\">Easy does it.</text>\n    <text x=\\\"929\\\" y=\\\"62\\\" text-anchor=\\\"end\\\" font-size=\\\"11\\\" letter-spacing=\\\"2\\\">A RIDE BY THE SEA</text>\n    <path d=\\\"M 794 88 H 929\\\" stroke=\\\"#cccdb8\\\"/>\n    <text x=\\\"929\\\" y=\\\"112\\\" text-anchor=\\\"end\\\" font-size=\\\"12\\\" fill=\\\"#6c8073\\\">Wind in the feathers.</text>\n  </g>\n  <g clip-path=\\\"url(#scene)\\\">\n    <rect x=\\\"65\\\" y=\\\"155\\\" width=\\\"870\\\" height=\\\"574\\\" fill=\\\"#dfece3\\\"/>\n    <circle cx=\\\"737\\\" cy=\\\"275\\\" r=\\\"83\\\" fill=\\\"#efba74\\\"/>\n    <circle cx=\\\"737\\\" cy=\\\"275\\\" r=\\\"103\\\" fill=\\\"none\\\" stroke=\\\"#efba74\\\" stroke-opacity=\\\".25\\\" stroke-width=\\\"2\\\"/>\n    <g fill=\\\"#f9f7ec\\\">\n      <path d=\\\"M 111 290 C 119 278 131 278 139 283 C 143 264 168 259 179 276 C 196 269 211 280 212 290 Z\\\"/>\n      <path d=\\\"M 777 365 C 785 351 802 352 809 358 C 814 338 841 338 848 356 C 866 347 883 359 885 365 Z\\\"/>\n    </g>\n    <g fill=\\\"none\\\" stroke=\\\"#6c9189\\\" stroke-width=\\\"2.5\\\" stroke-linecap=\\\"round\\\">\n      <path d=\\\"M 825 231 q 10 -11 20 0 q 10 -11 20 0\\\">\n        <animate attributeName=\\\"d\\\" dur=\\\"3s\\\" repeatCount=\\\"indefinite\\\" values=\\\"M 825 231 q 10 -11 20 0 q 10 -