rcle cx=\"250\" cy=\"387\" r=\"3\"/></g>\n</svg>\n'\"'''\nPath('/tmp/vellery-o7ytbcon/work/pelican.svg').write_text(svg)\nPY\npython3 /tmp/make_pelican.py\npython3 - <<'PY'\nfrom pathlib import Path\nimport xml.etree.ElementTree as ET\np=Path('pelican.svg')\nr=ET.parse(p).getroot()\nns={'s':'http://www.w3.org/2000/svg'}\nanimations=r.findall('.//s:animate',ns)+r.findall('.//s:animateTransform',ns)\nassert all(a.attrib.get('repeatCount')=='indefinite' for a in animations)\nfor a in r.findall('.//s:animate[@attributeName=\\\"d\\\"]',ns):\n assert a.attrib['values'].split(';')[0]==a.attrib['values'].split(';')[-1]\nprint(f'Valid SVG: {p.stat().st_size:,} bytes; {len(animations)} looping animations; continuous leg and scarf loops.')\nPY\"","aggregated_output":"Valid SVG: 18,414 bytes; 15 looping animations; continuous leg and scarf loops.\n","exit_code":0,"status":"completed"}}
