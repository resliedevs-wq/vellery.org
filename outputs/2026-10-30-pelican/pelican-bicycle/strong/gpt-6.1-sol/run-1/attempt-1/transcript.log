{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/make_pelican.py <<'PY'\nimport math\nfrom pathlib import Path\n\nN=32\nD='1.6s'\n\ndef leg(phase, hip, far=False):\n    paths=[]; feet=[]\n    for i in range(N+1):\n        a=2*math.pi*i/N+phase\n        px=481+32*math.cos(a); py=572+32*math.sin(a)\n        ax,ay=px-6,py-9\n        hx,hy=hip\n        dx,dy=ax-hx,ay-hy\n        distance=math.hypot(dx,dy)\n        u=(125**2-115**2+distance**2)/(2*distance)\n        v=math.sqrt(max(0,125**2-u**2))\n        kx=hx+u*dx/distance+v*dy/distance\n        ky=hy+u*dy/distance-v*dx/distance\n        paths.append(f'M {hx} {hy} L {kx:.2f} {ky:.2f} L {ax:.2f} {ay:.2f}')\n        feet.append(f'{px:.2f} {py:.2f}')\n    color='#dc963b' if far else '#f7ad43'\n    return f'''<g>\n      <path d=\\\"{paths[0]}\\\" fill=\\\"none\\\" stroke=\\\"#203e43\\\" stroke-width=\\\"16\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"><animate attributeName=\\\"d\\\" dur=\\\"{D}\\\" repeatCount=\\\"indefinite\\\" values=\\\"{';'.join(paths)}\\\"/></path>\n      <path d=\\\"{paths[0]}\\\" fill=\\\"none\\\" stroke=\\\"{color}\\\" stroke-width=\\\"9\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"><animate attributeName=\\\"d\\\" dur=\\\"{D}\\\" repeatCount=\\\"indefinite\\\" values=\\\"{';'.join(paths)}\\\"/></path>\n      <g transform=\\\"translate({feet[0]})\\\"><animateTransform attributeName=\\\"transform\\\" type=\\\"translate\\\" dur=\\\"{D}\\\" repeatCount=\\\"indefinite\\\" values=\\\"{';'.join(feet)}\\\"/>\n        <path d=\\\"M -7 -13 Q 0 -11 6 -7 L 28 -3 Q 33 0 26 4 L -12 4 Q -17 1 -13 -4 Z\\\" fill=\\\"{color}\\\" stroke=\\\"#203e43\\\" stroke-width=\\\"3.5\\\" stroke-linejoin=\\\"round\\\"/>\n        <path d=\\\"M 4 -5 L 20 1 M 0 -3 L 9 2\\\" stroke=\\\"#bb752d\\\" stroke-width=\\\"1.7\\\" stroke-linecap=\\\"round\\\"/>\n        <path d=\\\"M -15 7 H 18\\\" stroke=\\\"#203e43\\\" stroke-width=\\\"6\\\" stroke-linecap=\\\"round\\\"/>\n      </g>\n    </g>'''\n\ndef wheel(cx):\n    spokes=''.join(f'<path d=\\\"M 0 0 L {113*math.cos(i*math.pi/6):.3f} {113*math.sin(i*math.pi/6):.3f}\\\"/>' for i in range(12))\n    return f'''<g transform=\\\"translate({cx} 572)\\\">\n      <circle r=\\\"126\\\" fill=\\\"#fcf7e9\\\" stroke=\\\"#203e43\\\" stroke-width=\\\"15\\\"/>\n      <circle r=\\\"116\\\" fill=\\\"none\\\" stroke=\\\"#92b5ad\\\" stroke-width=\\\"3\\\"/>\n      <g stroke=\\\"#a4beb4\\\" stroke-width=\\\"2.4\\\">{spokes}<animateTransform attributeName=\\\"transform\\\" type=\\\"rotate\\\" from=\\\"0\\\" to=\\\"360\\\" dur=\\\"0.8s\\\" repeatCount=\\\"indefinite\\\"/></g>\n      <g fill=\\\"none\\\" stroke=\\\"#f9d79b\\\" stroke-width=\\\"5\\\" stroke-linecap=\\\"round\\\"><path d=\\\"M -99 -54 A 113 113 0 0 1 -54 -99\\\"/><path d=\\\"M 99 54 A 113 113 0 0 1 54 99\\\"/><animateTransform attributeName=\\\"transform\\\" type=\\\"rotate\\\" from=\\\"0\\\" to=\\\"360\\\" dur=\\\"0.8s\\\" repeatCount=\\\"indefinite\\\"/></g>\n      <circle r=\\\"10\\\" fill=\\\"#f7b34d\\\" stroke=\\\"#203e43\\\" stroke-width=\\\"4\\\"/>\n    </g>'''\n\nsvg=f'''<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"1000\\\" height=\\\"800\\\" viewBox=\\\"0 0 1000 800\\\" role=\\\"img\\\" aria-labelledby=\\\"title desc\\\">\n  <title id=\\\"title\\\">Pelican on a bicycle</title>\n  <desc id=\\\"desc\\\">A cheerful white pelican sits on the saddle of a teal bicycle and actively pedals. Its articulated legs follow the rotating cranks, both wheels spin, its scarf flutters, and road markings slide beneath the bicycle.</desc>\n  <defs>\n    <linearGradient id=\\\"sun\\\" x1=\\\"0\\\" y1=\\\"0\\\" x2=\\\"0\\\" y2=\\\"1\\\"><stop stop-color=\\\"#f6ce94\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#f9e7c6\\\"/></linearGradient>\n    <linearGradient id=\\\"pouch\\\" x1=\\\"0\\\" y1=\\\"0\\\" x2=\\\"0.4\\\" y2=\\\"1\\\"><stop stop-color=\\\"#ffc366\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#ed9851\\\"/></linearGradient>\n    <pattern id=\\\"road\\\" width=\\\"200\\\" height=\\\"12\\\" patternUnits=\\\"userSpaceOnUse\\\"><path d=\\\"M 12 6 H 77 M 102 6 H 119\\\" stroke=\\\"#c6c9b4\\\" stroke-width=\\\"3\\\" stroke-linecap=\\\"round\\\"/><animateTransform attributeName=\\\"patternTransform\\\" type=\\\"translate\\\" from=\\\"0 0\\\" to=\\\"-200 0\\\" dur=\\\"1.1s\\\" repeatCount=\\\"indefinite\\\"/></pattern>\n  </defs>\n  <rect width=\\\"1000\\\" height=\\\"800\\\" rx=\\\"28\\\" fill=\\\"#fbf5e7\\\"/>\n  <circle cx=\\\"510\\\" cy=\\\"357\\\" r=\\\"294\\\" fill=\\\"url(#sun)\\\"/>\n  <circle cx=\\\"758\\\" cy=\\\"178\\\" r=\\\"32\\\" fill=\\\"#fbf5e7\\\" opacity=\\\".7\\\"/>\n  <g fill=\\\"none\\\" stroke=\\\"#e3b87f\\\" stroke-width=\\\"3\\\" stroke-linecap=\\\"round\\\" opacity=\\\".65\\\">\n    <path d=\\\"M 211 260 h 65 M 184 275 h 40 M 771 347 h 55 M 793 361 h 66\\\"/>\n    <path d=\\\"M 299 152 q 13 -13 26 0 q 13 -13 26 0 M 689 112 q 9 -10 18 0 q 9 -10 18 0\\\"/>\n  </g>\n  <ellipse cx=\\\"511\\\" cy=\\\"712\\\" rx=\\\"304\\\" ry=\\\"16\\\" fill=\\\"#263e3c\\\" opacity=\\\".09\\\"/>\n  <path d=\\\"M 142 705 H 879\\\" fill=\\\"none\\\" stroke=\\\"#c3c7b1\\\" stroke-width=\\\"2\\\"/>\n  <rect x=\\\"143\\\" y=\\\"725\\\" width=\\\"735\\\" height=\\\"12\\\" fill=\\\"url(#road)\\\"/>\n  <\"'!-- Far leg is behind the frame. Both ankles follow the same crank circle. -->\n  {leg(math.pi, (442,386), True)}\n  {wheel(290)}\n  {wheel(737)}\n  <!-- Chain, frame, fork and saddle. -->\n  <path d=\"M 290 559 L 479 546 A 27 27 0 0 1 482 599 L 290 585 A 13 13 0 0 1 290 559 Z\" fill=\"none\" stroke=\"#203e43\" stroke-width=\"6\"/>\n  <path d=\"M 290 559 L 479 546 A 27 27 0 0 1 482 599 L 290 585 A 13 13 0 0 1 290 559 Z\" fill=\"none\" stroke=\"#8ca39a\" stroke-width=\"2\" stroke-dasharray=\"3 5\"><animate attributeName=\"stroke-dashoffset\" from=\"0\" to=\"-32\" dur=\".4s\" repeatCount=\"indefinite\"/></path>\n  <g fill=\"none\" stroke=\"#203e43\" stroke-width=\"15\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n    <path d=\"M 290 572 L 444 435 L 481 572 L 290 572 M 444 435 L 653 448 L 481 572 M 653 448 L 737 572\"/>\n    <path d=\"M 444 435 L 433 401 M 653 448 L 670 397\"/>\n  </g>\n  <g fill=\"none\" stroke=\"#318e89\" stroke-width=\"9\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n    <path d=\"M 290 572 L 444 435 L 481 572 L 290 572 M 444 435 L 653 448 L 481 572 M 653 448 L 737 572\"/>\n    <path d=\"M 653 448 L 670 397\"/>\n  </g>\n  <path d=\"M 460 442 L 613 451\" fill=\"none\" stroke=\"#8cc7b5\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n  <path d=\"M 666 407 L 676 375 Q 680 359 661 359 H 636\" fill=\"none\" stroke=\"#203e43\" stroke-width=\"9\" stroke-linecap=\"round\"/>\n  <path d=\"M 637 359 H 657\" stroke=\"#bd7049\" stroke-width=\"12\" stroke-linecap=\"round\"/>\n  <path d=\"M 658 370 Q 700 398 692 473\" fill=\"none\" stroke=\"#203e43\" stroke-width=\"2.5\"/>\n  <path d=\"M 408 396 Q 430 392 445 397 Q 459 400 479 396 Q 487 396 485 404 Q 480 413 451 412 H 418 Q 406 410 408 396 Z\" fill=\"#203e43\"/>\n  <path d=\"M 416 399 Q 442 404 475 400\" fill=\"none\" stroke=\"#59807b\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n  <circle cx=\"481\" cy=\"572\" r=\"29\" fill=\"#f6d18c\" stroke=\"#203e43\" stroke-width=\"5\"/>\n  <g transform=\"translate(481 572)\">\n    <g><animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0\" to=\"360\" dur=\"{D}\" repeatCount=\"indefinite\"/>\n      <circle r=\"21\" fill=\"none\" stroke=\"#c8944f\" stroke-width=\"3\" stroke-dasharray=\"3 7\"/>\n      <path d=\"M -32 0 H 32\" stroke=\"#203e43\" stroke-width=\"8\" stroke-linecap=\"round\"/>\n      <path d=\"M 0 0 H 32\" stroke=\"#eef2dd\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n    </g>\n  </g>\n  {leg(0, (451,385))}\n  <circle cx=\"481\" cy=\"572\" r=\"6\" fill=\"#203e43\"/>\n  <!-- The bird'\"'s rump rests directly on the saddle. -->\n  <path d=\\\"M 392 339 Q 369 343 355 331 Q 366 364 395 373\\\" fill=\\\"#ebeddf\\\" stroke=\\\"#203e43\\\" stroke-width=\\\"4\\\" stroke-linejoin=\\\"round\\\"/>\n  <path d=\\\"M 392 300 C 357 323 377 379 411 394 C 430 405 464 407 488 389 C 519 367 523 333 520 301 L 495 278 C 457 275 416 280 392 300 Z\\\" fill=\\\"#fffdf1\\\" stroke=\\\"#203e43\\\" stroke-width=\\\"4.5\\\"/>\n  <path d=\\\"M 389 354 Q 416 395 471 386 Q 444 408 412 391 Q 391 381 389 354\\\" fill=\\\"#e2e7da\\\"/>\n  <\"'!-- Neck and head move subtly around the shoulder as the pelican pedals. -->\n  <g>\n    <animateTransform attributeName=\"transform\" type=\"rotate\" values=\"0 506 304;-1.2 506 304;0 506 304;1 506 304;0 506 304\" dur=\"{D}\" repeatCount=\"indefinite\"/>\n    <path d=\"M 471 311 C 500 281 488 246 500 213 C 506 192 522 178 546 179 C 570 180 581 198 574 218 C 568 234 550 242 536 237 C 524 258 545 301 520 329\" fill=\"#fffdf1\" stroke=\"#203e43\" stroke-width=\"4.5\" stroke-linecap=\"round\"/>\n    <path d=\"M 522 237 Q 508 278 520 307\" fill=\"none\" stroke=\"#dce4d8\" stroke-width=\"9\" stroke-linecap=\"round\"/>\n    <!-- Long bill and deep throat pouch are the pelican'\"'s characteristic silhouette. -->\n    <path d=\\\"M 556 214 L 721 213 C 703 237 662 271 615 268 C 588 266 567 246 556 228 Z\\\" fill=\\\"url(#pouch)\\\" stroke=\\\"#203e43\\\" stroke-width=\\\"4\\\" stroke-linejoin=\\\"round\\\"/>\n    <path d=\\\"M 570 214 Q 640 202 721 213 Q 724 219 715 222 L 563 224 Q 553 220 570 214 Z\\\" fill=\\\"#f6b74d\\\" stroke=\\\"#203e43\\\" stroke-width=\\\"4\\\" stroke-linejoin=\\\"round\\\"/>\n    <path d=\\\"M 580 235 Q 623 270 672 239\\\" fill=\\\"none\\\" stroke=\\\"#ffda8c\\\" stroke-width=\\\"4\\\" stroke-linecap=\\\"round\\\"/>\n    <circle cx=\\\"550\\\" cy=\\\"201\\\" r=\\\"10\\\" fill=\\\"#f3dfac\\\"/>\n    <circle cx=\\\"552\\\" cy=\\\"200\\\" r=\\\"5\\\" fill=\\\"#203e43\\\"/>\n    <circle cx=\\\"553.5\\\" cy=\\\"198.5\\\" r=\\\"1.6\\\" fill=\\\"white\\\"/>\n    <path d=\\\"M 540 182 Q 548 179 555 182\\\" fill=\\\"none\\\" stroke=\\\"#203e43\\\" stroke-width=\\\"3\\\" stroke-linecap=\\\"round\\\"/>\n    <\"'!-- A small cycling cap. -->\n    <path d=\"M 504 190 Q 502 162 526 157 Q 552 153 566 181 Z\" fill=\"#318e89\" stroke=\"#203e43\" stroke-width=\"4\"/>\n    <path d=\"M 531 158 Q 544 165 549 184\" fill=\"none\" stroke=\"#f5bd61\" stroke-width=\"9\"/>\n    <path d=\"M 502 191 Q 539 179 578 185 Q 580 190 566 193 L 505 197 Z\" fill=\"#203e43\"/>\n  </g>\n  <!-- Wind-blown scarf. -->\n  <path d=\"M 500 281 C 472 282 455 263 428 273 L 440 286 L 425 295 C 455 288 469 309 500 295 Z\" fill=\"#e87750\" stroke=\"#203e43\" stroke-width=\"3.5\" stroke-linejoin=\"round\">\n    <animate attributeName=\"d\" dur=\".8s\" repeatCount=\"indefinite\" values=\"M 500 281 C 472 282 455 263 428 273 L 440 286 L 425 295 C 455 288 469 309 500 295 Z;M 500 281 C 474 286 452 279 423 282 L 438 291 L 428 304 C 455 293 471 305 500 295 Z;M 500 281 C 472 282 455 263 428 273 L 440 286 L 425 295 C 455 288 469 309 500 295 Z\"/>\n  </path>\n  <path d=\"M 493 278 Q 507 287 525 282 L 526 296 Q 505 302 490 292 Z\" fill=\"#ef8254\" stroke=\"#203e43\" stroke-width=\"3.5\"/>\n  <!-- The forward wing reaches the handlebar. -->\n  <path d=\"M 419 316 C 443 302 477 313 503 330 C 539 352 577 367 635 352 Q 650 350 650 359 Q 650 369 634 371 C 604 386 568 390 541 381 Q 507 379 479 369 C 449 366 426 351 419 336\" fill=\"#fffdf1\" stroke=\"#203e43\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n  <path d=\"M 435 330 Q 460 352 494 354 M 454 325 Q 489 350 520 359 M 482 333 Q 511 353 542 365\" fill=\"none\" stroke=\"#c6d5c8\" stroke-width=\"3.5\" stroke-linecap=\"round\"/>\n  <path d=\"M 552 375 Q 595 384 633 365\" fill=\"none\" stroke=\"#e1e8dc\" stroke-width=\"6\" stroke-linecap=\"round\"/>\n  <path d=\"M 635 355 L 637 366 M 642 354 L 644 363\" stroke=\"#203e43\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n  <g fill=\"#318e89\" opacity=\".65\"><circle cx=\"174\" cy=\"579\" r=\"3\"/><circle cx=\"824\" cy=\"473\" r=\"4\"/><circle cx=\"250\" cy=\"387\" r=\"3\"/></g>\n</svg>\n'\"'''\nPath('/tmp/vellery-o7ytbcon/work/pelican.svg').write_text(svg)\nPY\npython3 /tmp/make_pelican.py\npython3 - <<'PY'\nfrom pathlib import Path\nimport xml.etree.ElementTree as ET\np=Path('pelican.svg')\nr=ET.parse(p).getroot()\nns={'s':'http://www.w3.org/2000/svg'}\nanimations=r.findall('.//s:animate',ns)+r.findall('.//s:animateTransform',ns)\nassert all(a.attrib.get('repeatCount')=='indefinite' for a in animations)\nfor a in r.findall('.//s:animate[@attributeName=\\\"d\\\"]',ns):\n assert a.attrib['values'].split(';')[0]==a.attrib['values'].split(';')[-1]\nprint(f'Valid SVG: {p.stat().st_size:,} bytes; {len(animations)} looping animations; continuous leg and scarf loops.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
