{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/create_pelican.py <<'PY'\nfrom pathlib import Path\nfrom math import sin, cos, pi, sqrt\n\nN = 48\nDUR = '1.8s'\n\ndef fmt(x):\n    return f'{x:.2f}'\n\ndef gait(phase):\n    paths, shifts, knees = [], [], []\n    hx, hy = 455, 404\n    upper, lower = 104, 112\n    for i in range(N + 1):\n        a = 2*pi*i/N + phase\n        px, py = 503 + 36*cos(a), 564 + 36*sin(a)\n        ax, ay = px - 8, py - 13\n        dx, dy = ax-hx, ay-hy\n        distance = sqrt(dx*dx + dy*dy)\n        along = (upper*upper - lower*lower + distance*distance)/(2*distance)\n        height = sqrt(max(0, upper*upper - along*along))\n        kx = hx + along*dx/distance + height*dy/distance\n        ky = hy + along*dy/distance - height*dx/distance\n        paths.append(f'M {hx} {hy} L {fmt(kx)} {fmt(ky)} L {fmt(ax)} {fmt(ay)}')\n        shifts.append(f'{fmt(px)} {fmt(py)}')\n        knees.append((kx,ky))\n        assert abs(sqrt((kx-hx)**2+(ky-hy)**2)-upper) < 1e-8\n        assert abs(sqrt((kx-ax)**2+(ky-ay)**2)-lower) < 1e-8\n    return paths, shifts, knees\n\ndef leg(phase, far=False):\n    paths, shifts, knees = gait(phase)\n    stroke = '#b46d43' if far else '#e69a4d'\n    return f'''<g aria-label=\\\"{'Far' if far else 'Near'} leg and webbed foot\\\">\n      <path d=\\\"{paths[0]}\\\" fill=\\\"none\\\" stroke=\\\"#263e43\\\" stroke-width=\\\"13\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\">\n        <animate attributeName=\\\"d\\\" values=\\\"{';'.join(paths)}\\\" dur=\\\"{DUR}\\\" repeatCount=\\\"indefinite\\\"/>\n      </path>\n      <path d=\\\"{paths[0]}\\\" fill=\\\"none\\\" stroke=\\\"{stroke}\\\" stroke-width=\\\"8\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\">\n        <animate attributeName=\\\"d\\\" values=\\\"{';'.join(paths)}\\\" dur=\\\"{DUR}\\\" repeatCount=\\\"indefinite\\\"/>\n      </path>\n      <g transform=\\\"translate({shifts[0]})\\\">\n        <animateTransform attributeName=\\\"transform\\\" type=\\\"translate\\\" values=\\\"{';'.join(shifts)}\\\" dur=\\\"{DUR}\\\" repeatCount=\\\"indefinite\\\"/>\n        <rect x=\\\"-20\\\" y=\\\"2\\\" width=\\\"41\\\" height=\\\"8\\\" rx=\\\"3\\\" fill=\\\"#263e43\\\"/>\n        <path d=\\\"M -10 -19 Q -3 -17 2 -10 L 24 -3 Q 29 3 19 4 L -14 4 Q -20 0 -14 -7 Z\\\" fill=\\\"{stroke}\\\" stroke=\\\"#263e43\\\" stroke-width=\\\"3\\\" stroke-linejoin=\\\"round\\\"/>\n        <path d=\\\"M -2 -6 L 13 0 M -7 -3 L 4 1\\\" fill=\\\"none\\\" stroke=\\\"#9c5c36\\\" stroke-width=\\\"1.5\\\" stroke-linecap=\\\"round\\\"/>\n      </g>\n    </g>'''\n\nspokes = '\\\\n'.join(f'<line x1=\\\"{fmt(16*cos(i*pi/8))}\\\" y1=\\\"{fmt(16*sin(i*pi/8))}\\\" x2=\\\"{fmt(99*cos(i*pi/8+.15))}\\\" y2=\\\"{fmt(99*sin(i*pi/8+.15))}\\\"/>' for i in range(16))\n\ndef wheel(x):\n    return f'''<g transform=\\\"translate({x} 582)\\\">\n      <circle r=\\\"109\\\" fill=\\\"#f8f3df\\\" fill-opacity=\\\".5\\\" stroke=\\\"#263e43\\\" stroke-width=\\\"12\\\"/>\n      <circle r=\\\"101\\\" fill=\\\"none\\\" stroke=\\\"#d7d9bd\\\" stroke-width=\\\"3\\\"/>\n      <g>\n        <animateTransform attributeName=\\\"transform\\\" type=\\\"rotate\\\" from=\\\"0\\\" to=\\\"360\\\" dur=\\\".9s\\\" repeatCount=\\\"indefinite\\\"/>\n        <use href=\\\"#spokes\\\"/>\n        <path d=\\\"M -26 -106 A 109 109 0 0 1 26 -106\\\" fill=\\\"none\\\" stroke=\\\"#fbf3d9\\\" stroke-width=\\\"3\\\" stroke-linecap=\\\"round\\\"/>\n        <rect x=\\\"-5\\\" y=\\\"-77\\\" width=\\\"10\\\" height=\\\"23\\\" rx=\\\"4\\\" fill=\\\"#ec9d4b\\\" stroke=\\\"#263e43\\\" stroke-width=\\\"2\\\"/>\n      </g>\n      <circle r=\\\"11\\\" fill=\\\"#f7f0da\\\" stroke=\\\"#263e43\\\" stroke-width=\\\"4\\\"/>\n      <circle r=\\\"3\\\" fill=\\\"#263e43\\\"/>\n    </g>'''\n\nsvg = '''<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" xmlns:xlink=\\\"http://www.w3.org/1999/xlink\\\" width=\\\"1000\\\" height=\\\"800\\\" viewBox=\\\"0 0 1000 800\\\" role=\\\"img\\\" aria-labelledby=\\\"title description\\\">\n  <title id=\\\"title\\\">Pelican on a bicycle</title>\n  <desc id=\\\"description\\\">An animated cream-colored pelican sits on the brown saddle of a teal bicycle by the sea. Its orange legs bend and its webbed feet follow the pedals as both cranks and spoked wheels continuously turn clockwise. A long orange bill points into the breeze.</desc>\n  <defs>\n    <pattern id=\\\"paper\\\" width=\\\"7\\\" height=\\\"7\\\" patternUnits=\\\"userSpaceOnUse\\\">\n      <circle cx=\\\"1\\\" cy=\\\"1\\\" r=\\\".55\\\" fill=\\\"#344c45\\\" opacity=\\\".045\\\"/>\n      <circle cx=\\\"5\\\" cy=\\\"4\\\" r=\\\".4\\\" fill=\\\"#344c45\\\" opacity=\\\".035\\\"/>\n    </pattern>\n    <clipPath id=\\\"scene-clip\\\"><rect width=\\\"1000\\\" height=\\\"800\\\" rx=\\\"32\\\"/></clipPath>\n    <g id=\\\"spokes\\\" stroke=\\\"#7f9990\\\" stroke-width=\\\"1.8\\\" stroke-linecap=\\\"round\\\">__SPOKES__</g>\n  </defs>\n  <g clip-path=\\\"url(#scene-clip)\\\">\n    <rect width=\\\"1000\\\" height=\\\"800\\\" fill=\\\"#f6f0df\\\"/>\n    <circle cx=\\\"804\\\" cy=\\\"188\\\" r=\\\"73\\\" fill=\\\"#ecad68\\\"/>\n    <circle cx=\\\"804\\\" cy=\\\"188\\\" r=\\\"87\\\" fill=\\\"none\\\" stroke=\\\"#ddbd8e\\\" stroke-width=\\\"1.5\\\" stroke-dasharray=\\\"2 10\\\" stroke-linecap=\\\"round\\\"/>\n\n    <\"'!-- The quiet coastline stays behind the moving bicycle. -->\n    <path d=\"M 0 475 Q 147 464 260 477 T 520 475 T 780 475 T 1040 475 L 1040 650 L 0 650 Z\" fill=\"#c7dcd0\"/>\n    <path d=\"M 0 503 Q 142 494 257 503 T 519 503 T 780 503 T 1040 503\" fill=\"none\" stroke=\"#e7ece0\" stroke-width=\"3\"/>\n    <path d=\"M 36 540 H 173 M 203 540 H 235 M 760 532 H 897 M 920 532 H 971 M 72 576 H 207 M 819 577 H 939\" fill=\"none\" stroke=\"#f4f1dc\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n    <path d=\"M 0 617 C 117 563 174 587 263 619 C 399 667 481 614 586 611 C 760 608 832 568 1000 611 L 1000 800 L 0 800 Z\" fill=\"#e5dbb8\"/>\n    <path d=\"M 0 665 Q 207 633 390 661 T 1000 653 L 1000 800 L 0 800 Z\" fill=\"#eee5cb\"/>\n    <path d=\"M 0 702 Q 260 695 500 702 T 1000 702\" fill=\"none\" stroke=\"#c5bfa3\" stroke-width=\"2\"/>\n    <g fill=\"none\" stroke=\"#9da88b\" stroke-width=\"2.5\" stroke-linecap=\"round\">\n      <path d=\"M 122 651 Q 126 630 115 616 M 122 651 Q 121 633 105 630 M 122 651 Q 130 631 137 629\"/>\n      <path d=\"M 876 645 Q 875 624 886 608 M 876 645 Q 866 628 858 624 M 876 645 Q 886 631 896 632\"/>\n    </g>\n    <g fill=\"#b7b199\"><ellipse cx=\"177\" cy=\"681\" rx=\"7\" ry=\"2\"/><ellipse cx=\"823\" cy=\"688\" rx=\"5\" ry=\"2\"/><ellipse cx=\"846\" cy=\"675\" rx=\"3\" ry=\"1.5\"/></g>\n\n    <!-- Wind lines drift left, with seamless repeat positions. -->\n    <g fill=\"none\" stroke=\"#b0bcb0\" stroke-width=\"3\" stroke-linecap=\"round\">\n      <g opacity=\"0\">\n        <path d=\"M 164 264 H 231 M 189 280 H 218\"/>\n        <animateTransform attributeName=\"transform\" type=\"translate\" values=\"35 0;-60 0\" dur=\"2.4s\" repeatCount=\"indefinite\"/>\n        <animate attributeName=\"opacity\" values=\"0;.65;.65;0\" keyTimes=\"0;.15;.7;1\" dur=\"2.4s\" repeatCount=\"indefinite\"/>\n      </g>\n      <g opacity=\"0\">\n        <path d=\"M 774 352 H 854 M 800 369 H 835\"/>\n        <animateTransform attributeName=\"transform\" type=\"translate\" values=\"40 0;-65 0\" dur=\"2.4s\" begin=\"-1.2s\" repeatCount=\"indefinite\"/>\n        <animate attributeName=\"opacity\" values=\"0;.65;.65;0\" keyTimes=\"0;.15;.7;1\" dur=\"2.4s\" begin=\"-1.2s\" repeatCount=\"indefinite\"/>\n      </g>\n    </g>\n    <g fill=\"none\" stroke=\"#657b72\" stroke-width=\"2.5\" stroke-linecap=\"round\">\n      <path d=\"M 156 185 Q 166 174 177 185 Q 187 175 197 185\"/>\n      <path d=\"M 231 153 Q 238 146 245 153 Q 252 146 259 153\"/>\n    </g>\n\n    <ellipse cx=\"532\" cy=\"699\" rx=\"296\" ry=\"13\" fill=\"#7c8270\" opacity=\".13\"/>\n    __BACK_WHEEL__\n    __FRONT_WHEEL__\n\n    <!-- Far crank and leg pass behind the frame. -->\n    <g transform=\"translate(503 564)\">\n      <g>\n        <animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0\" to=\"360\" dur=\"1.8s\" repeatCount=\"indefinite\"/>\n        <path d=\"M 0 0 H -36\" stroke=\"#263e43\" stroke-width=\"10\" stroke-linecap=\"round\"/>\n        <path d=\"M 0 0 H -36\" stroke=\"#94a49a\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n      </g>\n    </g>\n    __FAR_LEG__\n\n    <!-- Chain, frame, saddle, and handlebar. -->\n    <path d=\"M 339 563 L 500 525 A 39 39 0 1 1 502 603 L 339 601 A 19 19 0 0 1 339 563 Z\" fill=\"#45665b\" fill-opacity=\".08\" stroke=\"#263e43\" stroke-width=\"5\"/>\n    <path d=\"M 339 563 L 500 525 A 39 39 0 1 1 502 603 L 339 601 A 19 19 0 0 1 339 563 Z\" fill=\"none\" stroke=\"#9eac91\" stroke-width=\"2\" stroke-dasharray=\"3 5\">\n      <animate attributeName=\"stroke-dashoffset\" from=\"0\" to=\"-80\" dur=\"1.8s\" repeatCount=\"indefinite\"/>\n    </path>\n    <circle cx=\"340\" cy=\"582\" r=\"17\" fill=\"#8c9c85\" stroke=\"#263e43\" stroke-width=\"3\"/>\n    <g fill=\"none\" stroke-linejoin=\"round\" stroke-linecap=\"round\">\n      <path d=\"M 340 582 L 458 445 L 503 564 Z M 458 445 L 650 445 L 503 564 M 650 445 L 720 582\" stroke=\"#263e43\" stroke-width=\"15\"/>\n      <path d=\"M 340 582 L 458 445 L 503 564 Z M 458 445 L 650 445 L 503 564 M 650 445 L 720 582\" stroke=\"#438a82\" stroke-width=\"9\"/>\n      <path d=\"M 458 445 L 449 420 M 650 445 L 636 401 L 658 383\" stroke=\"#263e43\" stroke-width=\"11\"/>\n      <path d=\"M 458 440 L 451 421 M 649 440 L 638 402 L 660 385\" stroke=\"#a9b6a7\" stroke-width=\"5\"/>\n      <path d=\"M 653 385 Q 675 375 695 385 Q 703 391 698 404\" stroke=\"#263e43\" stroke-width=\"11\"/>\n      <path d=\"M 676 381 Q 691 380 697 387\" stroke=\"#b9784d\" stroke-width=\"11\"/>\n      <path d=\"M 690 405 C 688 435 674 459 685 484\" stroke=\"#263e43\" stroke-width=\"2\"/>\n    </g>\n    <path d=\"M 414 414 Q 425 411 446 416 L 479 414 Q 489 414 486 423 Q 472 432 440 429 L 414 425 Q 405 420 414 414 Z\" fill=\"#a96e49\" stroke=\"#263e43\" stroke-width=\"4\"/>\n    <path d=\"M 424 419 Q 446 424 476 419\" fill=\"none\" stroke=\"#d69b65\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n    <path d=\"M 519 448 L 583 448\" stroke=\"#87b6a1\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n    <path d=\"M 718 580 L 729 585\" stroke=\"#263e43\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n\n    <!-- The chainring and near crank rotate together. Pedals stay level. -->\n    <g transform=\"translate(503 564)\">\n      <g>\n        <animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0\" to=\"360\" dur=\"1.8s\" repeatCount=\"indefinite\"/>\n        <circle r=\"35\" fill=\"#698f7b\" stroke=\"#263e43\" stroke-width=\"4\"/>\n        <circle r=\"27\" fill=\"#e4ddc0\" stroke=\"#263e43\" stroke-width=\"2\"/>\n        <g stroke=\"#698f7b\" stroke-width=\"8\"><path d=\"M -26 0 H 26 M 0 -26 V 26\"/></g>\n        <circle r=\"35\" fill=\"none\" stroke=\"#263e43\" stroke-width=\"5\" stroke-dasharray=\"2 5\"/>\n        <path d=\"M 0 0 H 36\" stroke=\"#263e43\" stroke-width=\"11\" stroke-linecap=\"round\"/>\n        <path d=\"M 0 0 H 36\" stroke=\"#c0c7b2\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n      </g>\n      <circle r=\"7\" fill=\"#f7eed5\" stroke=\"#263e43\" stroke-width=\"3\"/>\n    </g>\n    __NEAR_LEG__\n\n    <!-- The forward wing rests on the handlebar. -->\n    <path d=\"M 481 324 C 524 319 548 336 574 355 L 646 382 Q 662 380 674 387 Q 681 392 673 397 L 651 397 C 614 392 575 387 544 375 L 495 361 Z\" fill=\"#e3e3cb\" stroke=\"#263e43\" stroke-width=\"4\" stroke-linejoin=\"round\"/>\n    <path d=\"M 544 357 Q 585 383 649 389 M 634 386 L 650 392 M 646 385 L 659 392\" fill=\"none\" stroke=\"#a4b3a1\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n\n    <!-- The underside is in contact with the saddle throughout the loop. -->\n    <path d=\"M 347 352 L 303 342 L 321 366 L 299 369 L 346 388\" fill=\"#d5dfcd\" stroke=\"#263e43\" stroke-width=\"4\" stroke-linejoin=\"round\">\n      <animate attributeName=\"d\" values=\"M 347 352 L 303 342 L 321 366 L 299 369 L 346 388;M 347 352 L 299 337 L 319 361 L 297 366 L 346 388;M 347 352 L 303 342 L 321 366 L 299 369 L 346 388\" dur=\"1.8s\" repeatCount=\"indefinite\"/>\n    </path>\n    <path d=\"M 338 350 C 324 317 347 284 380 279 C 426 269 457 294 480 310 C 486 282 488 256 505 233 C 502 207 522 187 545 187 C 575 185 592 206 588 230 C 586 251 573 263 555 267 C 545 299 550 340 519 373 C 500 398 474 419 444 419 C 400 420 362 403 346 384 C 333 373 331 361 338 350 Z\" fill=\"#fff8e4\" stroke=\"#263e43\" stroke-width=\"4.5\" stroke-linejoin=\"round\"/>\n    <path d=\"M 357 376 C 387 398 419 409 448 407 C 485 405 513 379 526 354 C 511 389 480 420 444 419 C 406 420 373 406 357 391 Z\" fill=\"#e3e6cf\"/>\n    <path d=\"M 512 251 Q 520 268 535 266\" fill=\"none\" stroke=\"#c7d3bb\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n\n    <!-- A folded wing, with dark flight feathers. -->\n    <path d=\"M 355 319 C 382 297 427 306 455 334 C 474 355 479 377 463 388 C 426 398 380 376 355 347 Q 343 333 355 319 Z\" fill=\"#dce3cc\" stroke=\"#263e43\" stroke-width=\"3.5\"/>\n    <path d=\"M 372 346 Q 405 370 450 375 M 384 335 Q 419 359 455 362 M 399 326 Q 428 344 451 346\" fill=\"none\" stroke=\"#a0b29e\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n    <path d=\"M 421 378 Q 446 382 464 375 L 463 387 Q 443 393 421 385 Z\" fill=\"#536f65\"/>\n\n    <!-- Long bill and expandable throat pouch identify the rider as a pelican. -->\n    <path d=\"M 580 234 L 741 245 C 720 278 670 295 624 278 C 600 269 588 254 580 234 Z\" fill=\"#e9ad79\" stroke=\"#263e43\" stroke-width=\"3.5\" stroke-linejoin=\"round\"/>\n    <path d=\"M 602 249 C 627 273 671 282 711 262\" fill=\"none\" stroke=\"#f9d49c\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n    <path d=\"M 582 216 C 625 213 692 228 741 240 Q 752 244 747 251 L 582 244 Q 575 232 582 216 Z\" fill=\"#edaa49\" stroke=\"#263e43\" stroke-width=\"3.5\" stroke-linejoin=\"round\"/>\n    <path d=\"M 593 223 C 631 222 691 234 725 241\" fill=\"none\" stroke=\"#ffda7c\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n    <path d=\"M 735 239 Q 757 241 748 256 L 739 260 L 741 248\" fill=\"#cf7541\" stroke=\"#263e43\" stroke-width=\"3\" stroke-linejoin=\"round\"/>\n    <path d=\"M 583 244 L 740 248\" fill=\"none\" stroke=\"#8f623b\" stroke-width=\"2\"/>\n    <ellipse cx=\"601\" cy=\"228\" rx=\"4\" ry=\"1.8\" fill=\"#9b663a\"/>\n\n    <!-- Eye, cheek, and a small wind-ruffled crest. -->\n    <path d=\"M 514 198 Q 503 188 512 177 Q 520 184 527 185 M 528 189 Q 522 174 533 170 Q 536 179 544 185\" fill=\"#fff8e4\" stroke=\"#263e43\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n    <circle cx=\"559\" cy=\"218\" r=\"12\" fill=\"#e6c47a\"/>\n    <circle cx=\"561\" cy=\"218\" r=\"6.5\" fill=\"#263e43\"/>\n    <circle cx=\"563\" cy=\"215.5\" r=\"2.2\" fill=\"#fffdf0\"/>\n    <path d=\"M 548 203 Q 559 198 569 204\" fill=\"none\" stroke=\"#263e43\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n    <path d=\"M 558 239 Q 566 244 573 239\" fill=\"none\" stroke=\"#d2ba8e\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n\n    <rect width=\"1000\" height=\"800\" fill=\"url(#paper)\" pointer-events=\"none\"/>\n  </g>\n</svg>\n'\"'''\nsvg = svg.replace('__SPOKES__',spokes).replace('__BACK_WHEEL__',wheel(340)).replace('__FRONT_WHEEL__',wheel(720)).replace('__FAR_LEG__',leg(pi,True)).replace('__NEAR_LEG__',leg(0))\nPath('/tmp/vellery-mtw5urmv/work/pelican.svg').write_text(svg)\nprint(f'Created pelican.svg ({len(svg):,} bytes); checked both leg segment lengths at all {2*(N+1)} keyframes.')\nPY\npython3 /tmp/create_pelican.py\npython3 - <<'PY'\nimport xml.etree.ElementTree as ET\nfrom pathlib import Path\np = Path('pelican.svg')\nr = ET.parse(p).getroot()\nns = {'s':'http://www.w3.org/2000/svg'}\nids = {el.get('id') for el in r.iter() if el.get('id')}\nanimations = r.findall('.//s:animate',ns) + r.findall('.//s:animateTransform',ns)\nassert len(animations) == 18, len(animations)\nfor el in r.iter():\n    href = el.get('href')\n    if href:\n        assert href[1:] in ids, href\nfor el in animations:\n    assert el.get('repeatCount') == 'indefinite'\n    values = el.get('values')\n    if values and el.get('attributeName') in ('d','transform') and el.get('dur') == '1.8s':\n        assert values.split(';')[0] == values.split(';')[-1], 'Loop does not close'\nassert '__' not in p.read_text()\nprint('SVG XML valid; all references resolve; 18 animations repeat; pedaling loops close seamlessly.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/create_pelican.py <<'PY'\nfrom pathlib import Path\nfrom math import sin, cos, pi, sqrt\n\nN = 48\nDUR = '1.8s'\n\ndef fmt(x):\n    return f'{x:.2f}'\n\ndef gait(phase):\n    paths, shifts, knees = [], [], []\n    hx, hy = 455, 404\n    upper, lower = 104, 112\n    for i in range(N + 1):\n        a = 2*pi*i/N + phase\n        px, py = 503 + 36*cos(a), 564 + 36*sin(a)\n        ax, ay = px - 8, py - 13\n        dx, dy = ax-hx, ay-hy\n        distance = sqrt(dx*dx + dy*dy)\n        along = (upper*upper - lower*lower + distance*distance)/(2*distance)\n        height = sqrt(max(0, upper*upper - along*along))\n        kx = hx + along*dx/distance + height*dy/distance\n        ky = hy + along*dy/distance - height*dx/distance\n        paths.append(f'M {hx} {hy} L {fmt(kx)} {fmt(ky)} L {fmt(ax)} {fmt(ay)}')\n        shifts.append(f'{fmt(px)} {fmt(py)}')\n        knees.append((kx,ky))\n        assert abs(sqrt((kx-hx)**2+(ky-hy)**2)-upper) < 1e-8\n        assert abs(sqrt((kx-ax)**2+(ky-ay)**2)-lower) < 1e-8\n    return paths, shifts, knees\n\ndef leg(phase, far=False):\n    paths, shifts, knees = gait(phase)\n    stroke = '#b46d43' if far else '#e69a4d'\n    return f'''<g aria-label=\\\"{'Far' if far else 'Near'} leg and webbed foot\\\">\n      <path d=\\\"{paths[0]}\\\" fill=\\\"none\\\" stroke=\\\"#263e43\\\" stroke-width=\\\"13\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\">\n        <animate attributeName=\\\"d\\\" values=\\\"{';'.join(paths)}\\\" dur=\\\"{DUR}\\\" repeatCount=\\\"indefinite\\\"/>\n      </path>\n      <path d=\\\"{paths[0]}\\\" fill=\\\"none\\\" stroke=\\\"{stroke}\\\" stroke-width=\\\"8\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\">\n        <animate attributeName=\\\"d\\\" values=\\\"{';'.join(paths)}\\\" dur=\\\"{DUR}\\\" repeatCount=\\\"indefinite\\\"/>\n      </path>\n      <g transform=\\\"translate({shifts[0]})\\\">\n        <animateTransform attributeName=\\\"transform\\\" type=\\\"translate\\\" values=\\\"{';'.join(shifts)}\\\" dur=\\\"{DUR}\\\" repeatCount=\\\"indefinite\\\"/>\n        <rect x=\\\"-20\\\" y=\\\"2\\\" width=\\\"41\\\" height=\\\"8\\\" rx=\\\"3\\\" fill=\\\"#263e43\\\"/>\n        <path d=\\\"M -10 -19 Q -3 -17 2 -10 L 24 -3 Q 29 3 19 4 L -14 4 Q -20 0 -14 -7 Z\\\" fill=\\\"{stroke}\\\" stroke=\\\"#263e43\\\" stroke-width=\\\"3\\\" stroke-linejoin=\\\"round\\\"/>\n        <path d=\\\"M -2 -6 L 13 0 M -7 -3 L 4 1\\\" fill=\\\"none\\\" stroke=\\\"#9c5c36\\\" stroke-width=\\\"1.5\\\" stroke-linecap=\\\"round\\\"/>\n      </g>\n    </g>'''\n\nspokes = '\\\\n'.join(f'<line x1=\\\"{fmt(16*cos(i*pi/8))}\\\" y1=\\\"{fmt(16*sin(i*pi/8))}\\\" x2=\\\"{fmt(99*cos(i*pi/8+.15))}\\\" y2=\\\"{fmt(99*sin(i*pi/8+.15))}\\\"/>' for i in range(16))\n\ndef wheel(x):\n    return f'''<g transform=\\\"translate({x} 582)\\\">\n      <circle r=\\\"109\\\" fill=\\\"#f8f3df\\\" fill-opacity=\\\".5\\\" stroke=\\\"#263e43\\\" stroke-width=\\\"12\\\"/>\n      <circle r=\\\"101\\\" fill=\\\"none\\\" stroke=\\\"#d7d9bd\\\" stroke-width=\\\"3\\\"/>\n      <g>\n        <animateTransform attributeName=\\\"transform\\\" type=\\\"rotate\\\" from=\\\"0\\\" to=\\\"360\\\" dur=\\\".9s\\\" repeatCount=\\\"indefinite\\\"/>\n        <use href=\\\"#spokes\\\"/>\n        <path d=\\\"M -26 -106 A 109 109 0 0 1 26 -106\\\" fill=\\\"none\\\" stroke=\\\"#fbf3d9\\\" stroke-width=\\\"3\\\" stroke-linecap=\\\"round\\\"/>\n        <rect x=\\\"-5\\\" y=\\\"-77\\\" width=\\\"10\\\" height=\\\"23\\\" rx=\\\"4\\\" fill=\\\"#ec9d4b\\\" stroke=\\\"#263e43\\\" stroke-width=\\\"2\\\"/>\n      </g>\n      <circle r=\\\"11\\\" fill=\\\"#f7f0da\\\" stroke=\\\"#263e43\\\" stroke-width=\\\"4\\\"/>\n      <circle r=\\\"3\\\" fill=\\\"#263e43\\\"/>\n    </g>'''\n\nsvg = '''<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" xmlns:xlink=\\\"http://www.w3.org/1999/xlink\\\" width=\\\"1000\\\" height=\\\"800\\\" viewBox=\\\"0 0 1000 800\\\" role=\\\"img\\\" aria-labelledby=\\\"title description\\\">\n  <title id=\\\"title\\\">Pelican on a bicycle</title>\n  <desc id=\\\"description\\\">An animated cream-colored pelican sits on the brown saddle of a teal bicycle by the sea. Its orange legs bend and its webbed feet follow the pedals as both cranks and spoked wheels continuously turn clockwise. A long orange bill points into the breeze.</desc>\n  <defs>\n    <pattern id=\\\"paper\\\" width=\\\"7\\\" height=\\\"7\\\" patternUnits=\\\"userSpaceOnUse\\\">\n      <circle cx=\\\"1\\\" cy=\\\"1\\\" r=\\\".55\\\" fill=\\\"#344c45\\\" opacity=\\\".045\\\"/>\n      <circle cx=\\\"5\\\" cy=\\\"4\\\" r=\\\".4\\\" fill=\\\"#344c45\\\" opacity=\\\".035\\\"/>\n    </pattern>\n    <clipPath id=\\\"scene-clip\\\"><rect width=\\\"1000\\\" height=\\\"800\\\" rx=\\\"32\\\"/></clipPath>\n    <g id=\\\"spokes\\\" stroke=\\\"#7f9990\\\" stroke-width=\\\"1.8\\\" stroke-linecap=\\\"round\\\">__SPOKES__</g>\n  </defs>\n  <g clip-path=\\\"url(#scene-clip)\\\">\n    <rect width=\\\"1000\\\" height=\\\"800\\\" fill=\\\"#f6f0df\\\"/>\n    <circle cx=\\\"804\\\" cy=\\\"188\\\" r=\\\"73\\\" fill=\\\"#ecad68\\\"/>\n    <circle cx=\\\"804\\\" cy=\\\"188\\\" r=\\\"87\\\" fill=\\\"none\\\" stroke=\\\"#ddbd8e\\\" stroke-width=\\\"1.5\\\" stroke-dasharray=\\\"2 10\\\" stroke-linecap=\\\"round\\\"/>\n\n    <\"'!-- The quiet coastline stays behind the moving bicycle. -->\n    <path d=\"M 0 475 Q 147 464 260 477 T 520 475 T 780 475 T 1040 475 L 1040 650 L 0 650 Z\" fill=\"#c7dcd0\"/>\n    <path d=\"M 0 503 Q 142 494 257 503 T 519 503 T 780 503 T 1040 503\" fill=\"none\" stroke=\"#e7ece0\" stroke-width=\"3\"/>\n    <path d=\"M 36 540 H 173 M 203 540 H 235 M 760 532 H 897 M 920 532 H 971 M 72 576 H 207 M 819 577 H 939\" fill=\"none\" stroke=\"#f4f1dc\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n    <path d=\"M 0 617 C 117 563 174 587 263 619 C 399 667 481 614 586 611 C 760 608 832 568 1000 611 L 1000 800 L 0 800 Z\" fill=\"#e5dbb8\"/>\n    <path d=\"M 0 665 Q 207 633 390 661 T 1000 653 L 1000 800 L 0 800 Z\" fill=\"#eee5cb\"/>\n    <path d=\"M 0 702 Q 260 695 500 702 T 1000 702\" fill=\"none\" stroke=\"#c5bfa3\" stroke-width=\"2\"/>\n    <g fill=\"none\" stroke=\"#9da88b\" stroke-width=\"2.5\" stroke-linecap=\"round\">\n      <path d=\"M 122 651 Q 126 630 115 616 M 122 651 Q 121 633 105 630 M 122 651 Q 130 631 137 629\"/>\n      <path d=\"M 876 645 Q 875 624 886 608 M 876 645 Q 866 628 858 624 M 876 645 Q 886 631 896 632\"/>\n    </g>\n    <g fill=\"#b7b199\"><ellipse cx=\"177\" cy=\"681\" rx=\"7\" ry=\"2\"/><ellipse cx=\"823\" cy=\"688\" rx=\"5\" ry=\"2\"/><ellipse cx=\"846\" cy=\"675\" rx=\"3\" ry=\"1.5\"/></g>\n\n    <!-- Wind lines drift left, with seamless repeat positions. -->\n    <g fill=\"none\" stroke=\"#b0bcb0\" stroke-width=\"3\" stroke-linecap=\"round\">\n      <g opacity=\"0\">\n        <path d=\"M 164 264 H 231 M 189 280 H 218\"/>\n        <animateTransform attributeName=\"transform\" type=\"translate\" values=\"35 0;-60 0\" dur=\"2.4s\" repeatCount=\"indefinite\"/>\n        <animate attributeName=\"opacity\" values=\"0;.65;.65;0\" keyTimes=\"0;.15;.7;1\" dur=\"2.4s\" repeatCount=\"indefinite\"/>\n      </g>\n      <g opacity=\"0\">\n        <path d=\"M 774 352 H 854 M 800 369 H 835\"/>\n        <animateTransform attributeName=\"transform\" type=\"translate\" values=\"40 0;-65 0\" dur=\"2.4s\" begin=\"-1.2s\" repeatCount=\"indefinite\"/>\n        <animate attributeName=\"opacity\" values=\"0;.65;.65;0\" keyTimes=\"0;.15;.7;1\" dur=\"2.4s\" begin=\"-1.2s\" repeatCount=\"indefinite\"/>\n      </g>\n    </g>\n    <g fill=\"none\" stroke=\"#657b72\" stroke-width=\"2.5\" stroke-linecap=\"round\">\n      <path d=\"M 156 185 Q 166 174 177 185 Q 187 175 197 185\"/>\n      <path d=\"M 231 153 Q 238 146 245 153 Q 252 146 259 153\"/>\n    </g>\n\n    <ellipse cx=\"532\" cy=\"699\" rx=\"296\" ry=\"13\" fill=\"#7c8270\" opacity=\".13\"/>\n    __BACK_WHEEL__\n    __FRONT_WHEEL__\n\n    <!-- Far crank and leg pass behind the frame. -->\n    <g transform=\"translate(503 564)\">\n      <g>\n        <animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0\" to=\"360\" dur=\"1.8s\" repeatCount=\"indefinite\"/>\n        <path d=\"M 0 0 H -36\" stroke=\"#263e43\" stroke-width=\"10\" stroke-linecap=\"round\"/>\n        <path d=\"M 0 0 H -36\" stroke=\"#94a49a\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n      </g>\n    </g>\n    __FAR_LEG__\n\n    <!-- Chain, frame, saddle, and handlebar. -->\n    <path d=\"M 339 563 L 500 525 A 39 39 0 1 1 502 603 L 339 601 A 19 19 0 0 1 339 563 Z\" fill=\"#45665b\" fill-opacity=\".08\" stroke=\"#263e43\" stroke-width=\"5\"/>\n    <path d=\"M 339 563 L 500 525 A 39 39 0 1 1 502 603 L 339 601 A 19 19 0 0 1 339 563 Z\" fill=\"none\" stroke=\"#9eac91\" stroke-width=\"2\" stroke-dasharray=\"3 5\">\n      <animate attributeName=\"stroke-dashoffset\" from=\"0\" to=\"-80\" dur=\"1.8s\" repeatCount=\"indefinite\"/>\n    </path>\n    <circle cx=\"340\" cy=\"582\" r=\"17\" fill=\"#8c9c85\" stroke=\"#263e43\" stroke-width=\"3\"/>\n    <g fill=\"none\" stroke-linejoin=\"round\" stroke-linecap=\"round\">\n      <path d=\"M 340 582 L 458 445 L 503 564 Z M 458 445 L 650 445 L 503 564 M 650 445 L 720 582\" stroke=\"#263e43\" stroke-width=\"15\"/>\n      <path d=\"M 340 582 L 458 445 L 503 564 Z M 458 445 L 650 445 L 503 564 M 650 445 L 720 582\" stroke=\"#438a82\" stroke-width=\"9\"/>\n      <path d=\"M 458 445 L 449 420 M 650 445 L 636 401 L 658 383\" stroke=\"#263e43\" stroke-width=\"11\"/>\n      <path d=\"M 458 440 L 451 421 M 649 440 L 638 402 L 660 385\" stroke=\"#a9b6a7\" stroke-width=\"5\"/>\n      <path d=\"M 653 385 Q 675 375 695 385 Q 703 391 698 404\" stroke=\"#263e43\" stroke-width=\"11\"/>\n      <path d=\"M 676 381 Q 691 380 697 387\" stroke=\"#b9784d\" stroke-width=\"11\"/>\n      <path d=\"M 690 405 C 688 435 674 459 685 484\" stroke=\"#263e43\" stroke-width=\"2\"/>\n    </g>\n    <path d=\"M 414 414 Q 425 411 446 416 L 479 414 Q 489 414 486 423 Q 472 432 440 429 L 414 425 Q 405 420 414 414 Z\" fill=\"#a96e49\" stroke=\"#263e43\" stroke-width=\"4\"/>\n    <path d=\"M 424 419 Q 446 424 476 419\" fill=\"none\" stroke=\"#d69b65\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n    <path d=\"M 519 448 L 583 448\" stroke=\"#87b6a1\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n    <path d=\"M 718 580 L 729 585\" stroke=\"#263e43\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n\n    <!-- The chainring and near crank rotate together. Pedals stay level. -->\n    <g transform=\"translate(503 564)\">\n      <g>\n        <animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0\" to=\"360\" dur=\"1.8s\" repeatCount=\"indefinite\"/>\n        <circle r=\"35\" fill=\"#698f7b\" stroke=\"#263e43\" stroke-width=\"4\"/>\n        <circle r=\"27\" fill=\"#e4ddc0\" stroke=\"#263e43\" stroke-width=\"2\"/>\n        <g stroke=\"#698f7b\" stroke-width=\"8\"><path d=\"M -26 0 H 26 M 0 -26 V 26\"/></g>\n        <circle r=\"35\" fill=\"none\" stroke=\"#263e43\" stroke-width=\"5\" stroke-dasharray=\"2 5\"/>\n        <path d=\"M 0 0 H 36\" stroke=\"#263e43\" stroke-width=\"11\" stroke-linecap=\"round\"/>\n        <path d=\"M 0 0 H 36\" stroke=\"#c0c7b2\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n      </g>\n      <circle r=\"7\" fill=\"#f7eed5\" stroke=\"#263e43\" stroke-width=\"3\"/>\n    </g>\n    __NEAR_LEG__\n\n    <!-- The forward wing rests on the handlebar. -->\n    <path d=\"M 481 324 C 524 319 548 336 574 355 L 646 382 Q 662 380 674 387 Q 681 392 673 397 L 651 397 C 614 392 575 387 544 375 L 495 361 Z\" fill=\"#e3e3cb\" stroke=\"#263e43\" stroke-width=\"4\" stroke-linejoin=\"round\"/>\n    <path d=\"M 544 357 Q 585 383 649 389 M 634 386 L 650 392 M 646 385 L 659 392\" fill=\"none\" stroke=\"#a4b3a1\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n\n    <!-- The underside is in contact with the saddle throughout the loop. -->\n    <path d=\"M 347 352 L 303 342 L 321 366 L 299 369 L 346 388\" fill=\"#d5dfcd\" stroke=\"#263e43\" stroke-width=\"4\" stroke-linejoin=\"round\">\n      <animate attributeName=\"d\" values=\"M 347 352 L 303 342 L 321 366 L 299 369 L 346 388;M 347 352 L 299 337 L 319 361 L 297 366 L 346 388;M 347 352 L 303 342 L 321 366 L 299 369 L 346 388\" dur=\"1.8s\" repeatCount=\"indefinite\"/>\n    </path>\n    <path d=\"M 338 350 C 324 317 347 284 380 279 C 426 269 457 294 480 310 C 486 282 488 256 505 233 C 502 207 522 187 545 187 C 575 185 592 206 588 230 C 586 251 573 263 555 267 C 545 299 550 340 519 373 C 500 398 474 419 444 419 C 400 420 362 403 346 384 C 333 373 331 361 338 350 Z\" fill=\"#fff8e4\" stroke=\"#263e43\" stroke-width=\"4.5\" stroke-linejoin=\"round\"/>\n    <path d=\"M 357 376 C 387 398 419 409 448 407 C 485 405 513 379 526 354 C 511 389 480 420 444 419 C 406 420 373 406 357 391 Z\" fill=\"#e3e6cf\"/>\n    <path d=\"M 512 251 Q 520 268 535 266\" fill=\"none\" stroke=\"#c7d3bb\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n\n    <!-- A folded wing, with dark flight feathers. -->\n    <path d=\"M 355 319 C 382 297 427 306 455 334 C 474 355 479 377 463 388 C 426 398 380 376 355 347 Q 343 333 355 319 Z\" fill=\"#dce3cc\" stroke=\"#263e43\" stroke-width=\"3.5\"/>\n    <path d=\"M 372 346 Q 405 370 450 375 M 384 335 Q 419 359 455 362 M 399 326 Q 428 344 451 346\" fill=\"none\" stroke=\"#a0b29e\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n    <path d=\"M 421 378 Q 446 382 464 375 L 463 387 Q 443 393 421 385 Z\" fill=\"#536f65\"/>\n\n    <!-- Long bill and expandable throat pouch identify the rider as a pelican. -->\n    <path d=\"M 580 234 L 741 245 C 720 278 670 295 624 278 C 600 269 588 254 580 234 Z\" fill=\"#e9ad79\" stroke=\"#263e43\" stroke-width=\"3.5\" stroke-linejoin=\"round\"/>\n    <path d=\"M 602 249 C 627 273 671 282 711 262\" fill=\"none\" stroke=\"#f9d49c\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n    <path d=\"M 582 216 C 625 213 692 228 741 240 Q 752 244 747 251 L 582 244 Q 575 232 582 216 Z\" fill=\"#edaa49\" stroke=\"#263e43\" stroke-width=\"3.5\" stroke-linejoin=\"round\"/>\n    <path d=\"M 593 223 C 631 222 691 234 725 241\" fill=\"none\" stroke=\"#ffda7c\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n    <path d=\"M 735 239 Q 757 241 748 256 L 739 260 L 741 248\" fill=\"#cf7541\" stroke=\"#263e43\" stroke-width=\"3\" stroke-linejoin=\"round\"/>\n    <path d=\"M 583 244 L 740 248\" fill=\"none\" stroke=\"#8f623b\" stroke-width=\"2\"/>\n    <ellipse cx=\"601\" cy=\"228\" rx=\"4\" ry=\"1.8\" fill=\"#9b663a\"/>\n\n    <!-- Eye, cheek, and a small wind-ruffled crest. -->\n    <path d=\"M 514 198 Q 503 188 512 177 Q 520 184 527 185 M 528 189 Q 522 174 533 170 Q 536 179 544 185\" fill=\"#fff8e4\" stroke=\"#263e43\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n    <circle cx=\"559\" cy=\"218\" r=\"12\" fill=\"#e6c47a\"/>\n    <circle cx=\"561\" cy=\"218\" r=\"6.5\" fill=\"#263e43\"/>\n    <circle cx=\"563\" cy=\"215.5\" r=\"2.2\" fill=\"#fffdf0\"/>\n    <path d=\"M 548 203 Q 559 198 569 204\" fill=\"none\" stroke=\"#263e43\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n    <path d=\"M 558 239 Q 566 244 573 239\" fill=\"none\" stroke=\"#d2ba8e\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n\n    <rect width=\"1000\" height=\"800\" fill=\"url(#paper)\" pointer-events=\"none\"/>\n  </g>\n</svg>\n'\"'''\nsvg = svg.replace('__SPOKES__',spokes).replace('__BACK_WHEEL__',wheel(340)).replace('__FRONT_WHEEL__',wheel(720)).replace('__FAR_LEG__',leg(pi,True)).replace('__NEAR_LEG__',leg(0))\nPath('/tmp/vellery-mtw5urmv/work/pelican.svg').write_text(svg)\nprint(f'Created pelican.svg ({len(svg):,} bytes); checked both leg segment lengths at all {2*(N+1)} keyframes.')\nPY\npython3 /tmp/create_pelican.py\npython3 - <<'PY'\nimport xml.etree.ElementTree as ET\nfrom pathlib import Path\np = Path('pelican.svg')\nr = ET.parse(p).getroot()\nns = {'s':'http://www.w3.org/2000/svg'}\nids = {el.get('id') for el in r.iter