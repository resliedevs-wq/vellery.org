M350 310 Q385 278 427 282 C470 275 501 303 520 335 C547 367 517 393 473 397 C424 401 375 386 354 364 Q334 344 350 310Z\" fill=\"url(#plumage)\" stroke=\"#526c64\" stroke-width=\"3.5\"/>\n    <path d=\"M356 342 Q385 380 438 383\" fill=\"none\" stroke=\"#d6dbc9\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n    <!-- The enormous bill and its soft hanging pouch make this unmistakably a pelican. -->\n    <path d=\"M568 219 757 235 Q735 263 677 282 C622 294 586 266 566 239Z\" fill=\"url(#pouch)\" stroke=\"#af7138\" stroke-width=\"3\" stroke-linejoin=\"round\"/>\n    <path d=\"M583 240 Q620 275 676 272\" fill=\"none\" stroke=\"#ffda92\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n    <path d=\"M568 212 Q643 216 756 232 Q767 235 755 240 L569 231 Q559 224 568 212Z\" fill=\"#efb74f\" stroke=\"#986632\" stroke-width=\"3\" stroke-linejoin=\"round\"/>\n    <path d=\"M585 219 738 233\" fill=\"none\" stroke=\"#ffe3a2\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n    <path d=\"M756 233q8 5-1 12\" fill=\"none\" stroke=\"#986632\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n    <path d=\"M570 220h10\" stroke=\"#bd803c\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n    <circle cx=\"555\" cy=\"209\" r=\"12\" fill=\"#ead4a1\"/>\n    <circle cx=\"555\" cy=\"209\" r=\"6.3\" fill=\"#263f42\"/>\n    <circle cx=\"557\" cy=\"207\" r=\"2\" fill=\"#fffef5\"/>\n    <path d=\"M543 190 Q553 186 562 192\" fill=\"none\" stroke=\"#526c64\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n    <path d=\"M503 198 Q500 190 507 183 M510 188Q510 177 519 175\" fill=\"none\" stroke=\"#526c64\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n    <!-- The near wing reaches forward and wraps around the handlebar. -->\n    <path d=\"M391 316 Q415 301 443 318 Q470 334 487 347 Q533 369 582 366 L627 360 Q640 357 648 365 Q653 372 642 377 L595 384 Q527 394 480 377 Q447 371 425 352\" fill=\"#fcfbef\" stroke=\"#526c64\" stroke-width=\"3.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n    <g fill=