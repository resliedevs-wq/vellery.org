{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"cat > kitchen.svg <<'EOF'\n<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"1120\\\" height=\\\"800\\\" viewBox=\\\"0 0 1120 800\\\" role=\\\"img\\\" aria-labelledby=\\\"title desc\\\">\n  <title id=\\\"title\\\">Monday morning in the kitchen</title>\n  <desc id=\\\"desc\\\">Morning light from a left-hand window falls across a small wooden table. Three red apples and a blue mug printed with MONDAY sit beside a folded newspaper, where a gray tabby sleeps.</desc>\n  <defs>\n    <clipPath id=\\\"glass\\\"><rect x=\\\"42\\\" y=\\\"-10\\\" width=\\\"323\\\" height=\\\"308\\\"/></clipPath>\n    <clipPath id=\\\"top\\\"><path d=\\\"M118 440H997L1052 510H68Z\\\"/></clipPath>\n    <pattern id=\\\"tiles\\\" width=\\\"98\\\" height=\\\"86\\\" patternUnits=\\\"userSpaceOnUse\\\" x=\\\"22\\\" y=\\\"302\\\">\n      <rect width=\\\"98\\\" height=\\\"86\\\" fill=\\\"#e4cdb0\\\"/>\n      <path d=\\\"M0 84.5H98M96.5 0V86\\\" fill=\\\"none\\\" stroke=\\\"#d9bfa1\\\" stroke-width=\\\"3\\\"/>\n    </pattern>\n    <g id=\\\"apple-shape\\\">\n      <path fill=\\\"#bc5544\\\" d=\\\"M0-24C-11-30-22-29-29-19C-39-5-32 18-20 28C-11 36-5 30 0 31C8 32 13 35 21 27C33 15 39-6 31-20C25-29 14-30 5-25C3-24 2-23 0-24Z\\\"/>\n      <path fill=\\\"#a34437\\\" d=\\\"M-25 21C-13 31-5 23 2 25C15 29 32 8 34-9C36 4 29 20 21 27C13 35 8 32 0 31C-5 30-11 36-20 28Z\\\"/>\n      <path d=\\\"M-22-9Q-21-17-14-18\\\" fill=\\\"none\\\" stroke=\\\"#e99671\\\" stroke-width=\\\"4.5\\\" stroke-linecap=\\\"round\\\"/>\n      <g fill=\\\"#eba27b\\\"><circle cx=\\\"-24\\\" cy=\\\"-1\\\" r=\\\"1.4\\\"/><circle cx=\\\"-18\\\" cy=\\\"2\\\" r=\\\"1\\\"/><circle cx=\\\"-16\\\" cy=\\\"-5\\\" r=\\\"1.1\\\"/></g>\n      <path d=\\\"M-5-23Q0-19 7-24\\\" fill=\\\"none\\\" stroke=\\\"#943f33\\\" stroke-width=\\\"2.2\\\" stroke-linecap=\\\"round\\\"/>\n      <path d=\\\"M1-23Q-2-32 5-41\\\" fill=\\\"none\\\" stroke=\\\"#674d3d\\\" stroke-width=\\\"4\\\" stroke-linecap=\\\"round\\\"/>\n    </g>\n  </defs>\n  <rect width=\\\"1120\\\" height=\\\"800\\\" fill=\\\"#eedbc0\\\"/>\n  <\"'!-- The light continues from the sill across the wall and floor. -->\n  <path d=\"M112 294L343 263L909 605H646Z\" fill=\"#f8e9c8\"/>\n  <rect x=\"0\" y=\"302\" width=\"1120\" height=\"297\" fill=\"url(#tiles)\"/>\n  <path d=\"M119 302H399L889 599H605Z\" fill=\"#fff0c9\" opacity=\".48\"/>\n  <path d=\"M158 302H172L658 599H643Z\" fill=\"#d8be9f\" opacity=\".5\"/>\n  <path d=\"M0 599H1120V800H0Z\" fill=\"#cdab88\"/>\n  <path d=\"M0 596H1120V612H0Z\" fill=\"#b99a7e\"/>\n  <path d=\"M0 596H1120\" fill=\"none\" stroke=\"#d9bda0\" stroke-width=\"4\"/>\n  <path d=\"M487 612H799L1120 786V800H837Z\" fill=\"#e6c89b\"/>\n  <g fill=\"none\" stroke=\"#bc9879\" stroke-width=\"2\">\n    <path d=\"M0 665H1120M0 750H1120M209 612L183 665M688 665L709 750M94 750L65 800M1022 612L1051 665\"/>\n  </g>\n  <!-- Painted window frame and the garden outside. -->\n  <path d=\"M23 0H387V301L407 319H30Z\" fill=\"#b99a7b\" opacity=\".38\"/>\n  <rect x=\"19\" y=\"-22\" width=\"368\" height=\"329\" fill=\"#c69d72\"/>\n  <rect x=\"26\" y=\"-20\" width=\"354\" height=\"320\" fill=\"#fbebce\"/>\n  <g clip-path=\"url(#glass)\">\n    <rect x=\"42\" y=\"-10\" width=\"323\" height=\"308\" fill=\"#cbd9cf\"/>\n    <circle cx=\"273\" cy=\"77\" r=\"36\" fill=\"#fff1c6\"/>\n    <path d=\"M20 222Q83 181 147 204T284 193Q337 175 384 182V308H20Z\" fill=\"#b6c5ad\"/>\n    <path d=\"M158 284L263 208L348 271V307H158Z\" fill=\"#edd3ad\"/>\n    <path d=\"M151 282L261 198L356 266L350 275L262 214L166 288Z\" fill=\"#bd9780\"/>\n    <path d=\"M249 246H269V268H249Z\" fill=\"#acb6a6\"/>\n    <g fill=\"#94a890\">\n      <path d=\"M41 113C64 108 83 120 86 147C111 136 134 152 135 176C162 173 179 193 172 216C194 225 193 257 171 269L170 301H38Z\"/>\n      <path d=\"M309 303Q300 277 322 268Q309 249 325 237Q338 227 349 237Q348 212 370 209V303Z\"/>\n    </g>\n    <g fill=\"none\" strok