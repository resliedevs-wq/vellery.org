{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/k2apkza4_preview.py <<'PY'\nimport re,xml.etree.ElementTree as ET\nfrom PIL import Image, ImageDraw, ImageFont, ImageColor\nfrom math import dist\nroot=ET.parse('kitchen.svg').getroot()\nS=2\nim=Image.new('RGB',(2000,1480),'white')\nclips={'url(#glass)':(0,0,252,260),'url(#panel)':(0,375,1000,608)}\ndef paths(s):\n    ts=iter(re.findall(r'[A-Za-z]|-?(?:\\\\d*\\\\.\\\\d+|\\\\d+)',s))\n    pts=[]; p=(0,0)\n    def xy(): return float(next(ts)),float(next(ts))\n    for op in ts:\n        if op=='M':\n            if pts: yield pts\n            p=xy(); pts=[p]\n        elif op in ('L','H','V','Z'):\n            p=xy() if op=='L' else (float(next(ts)),p[1]) if op=='H' else (p[0],float(next(ts))) if op=='V' else pts[0]\n            pts.append(p)\n        elif op in ('Q','C'):\n            controls=[p,xy(),xy()]\n            if op=='C': controls.append(xy())\n            for k in range(1,19):\n                f=k/18; a=controls\n                while len(a)>1: a=[tuple(x*(1-f)+y*f for x,y in zip(u,v)) for u,v in zip(a,a[1:])]\n                pts.append(a[0])\n            p=controls[-1]\n        else: raise ValueError(op)\n    if pts: yield pts\ndef draw(el, parent={}, target=im):\n    a=parent|el.attrib; tag=el.tag.split('}')[-1]; d=ImageDraw.Draw(target)\n    f=a.get('fill','black'); f=None if f=='none' else f\n    if tag in ('svg','g'):\n        clip=clips.get(a.pop('clip-path',None)); scratch=target.copy() if clip else target\n        for child in el: draw(child,a,scratch)\n        if clip:\n            bounds=tuple(v*S for v in clip);target.paste(scratch.crop(bounds),bounds[:2])\n    elif tag=='rect':\n        x,y,w,h=[float(el.get(k,0)) for k in ['x','y','width','height']]\n        d.rectangle((x*S,y*S,(x+w)*S,(y+h)*S),fill=f)\n    elif tag in ('ellipse','circle'):\n        x,y=[float(a[k]) for k in ('cx','cy')]; rx=float(a.get('rx',a.get('r',0))); ry=float(a.get('ry',a.get('r',0)))\n        d.ellipse(((x-rx)*S,(y-ry)*S,(x+rx)*S,(y+ry)*S),fill=f)\n    elif tag=='path':\n        for pts in paths(a['d']):\n            p=[(round(x*S),round(y*S)) for x,y in pts]\n            if f and len(p)>2: d.polygon(p,fill=f)\n            if a.get('stroke'): d.line(p,fill=a['stroke'],width=max(1,round(float(a.get('stroke-width',1))*S)),joint='curve')\n    elif tag=='text':\n        font=ImageFont.truetype('/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf',round(float(a['font-size'])*S))\n        d.text((S*float(a['x']),S*float(a['y'])),el.text,fill=f,font=font,anchor='ms')\ndraw(root); im.resize((900,666),Image.Resampling.LANCZOS).save('/tmp/k2apkza4_preview.png')\nassert [e.text for e in root.iter('{*}text')]==['MONDAY']\nassert sum(e.get('id','').endswith('-apple') for e in root.iter())==3\nPY\npython3 /tmp/k2apkza4_preview.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
