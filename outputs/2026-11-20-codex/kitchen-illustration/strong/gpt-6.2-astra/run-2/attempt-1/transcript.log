{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"cat > kitchen.svg <<'SVG'\n<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"960\\\" height=\\\"720\\\" viewBox=\\\"0 0 960 720\\\" role=\\\"img\\\" aria-labelledby=\\\"title desc\\\">\n  <title id=\\\"title\\\">Monday morning in the kitchen</title>\n  <desc id=\\\"desc\\\">Morning light falls through a window on the left. A small wooden table holds three red apples, a blue mug printed with MONDAY, and a folded newspaper where a gray tabby sleeps.</desc>\n  <defs>\n    <clipPath id=\\\"glass\\\"><path d=\\\"M0 0h262v241H0z\\\"/></clipPath>\n    <clipPath id=\\\"back\\\"><path d=\\\"M596 387c-4-37 22-74 66-83 40-9 88 1 112 31 18 23 20 55-1 69-23 15-71 16-112 14-37-1-62-7-65-31z\\\"/></clipPath>\n  </defs>\n  <\"'!-- Plaster, painted dado and floor -->\n  <path fill=\"#e8d6b8\" d=\"M0 0h960v720H0z\"/>\n  <path fill=\"#f7e6bd\" d=\"M0 129l278-48 682 320v67L0 312z\"/>\n  <path fill=\"#ecdbb8\" d=\"M0 174l269-34 691 300v14z\"/>\n  <path fill=\"#b7b49b\" d=\"M0 372h960v230H0z\"/>\n  <path fill=\"#c6c0a1\" d=\"M0 372h960v8H0z\"/>\n  <path fill=\"#a2a28a\" d=\"M0 380h960v3H0z\"/>\n  <path fill=\"#cfbda3\" d=\"M0 600h960v120H0z\"/>\n  <path fill=\"#a4a18a\" d=\"M0 586h960v14H0z\"/>\n  <path fill=\"#e8d3ab\" d=\"M0 612l628 108H357L0 650z\"/>\n  <path fill=\"#ac9b83\" d=\"M110 657l613-8 158 34-625 9z\" opacity=\".58\"/>\n  <!-- The garden through the sash -->\n  <path fill=\"#ccbb9c\" d=\"M0 0h290v250l31 18v12L0 270z\"/>\n  <g clip-path=\"url(#glass)\">\n    <path fill=\"#b7c7b9\" d=\"M0 0h262v241H0z\"/>\n    <circle cx=\"200\" cy=\"58\" r=\"26\" fill=\"#fff0c7\"/>\n    <path fill=\"#d4d4bb\" d=\"M0 147q37-16 66-11t58-3q32-16 74-16t79-16v153H0z\"/>\n    <path fill=\"#acb79d\" d=\"M0 181q53 4 95-14t70-18q49 2 101-23v124H0z\"/>\n    <g fill=\"#728a73\">\n      <path d=\"M-7 18C22 43 41 70 58 106s39 58 73 83c-42-23-64-48-83-82S14 49-7 36z\"/>\n      <path d=\"M18 53C18 36 12 2