{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"cat > kitchen.svg <<'SVG'\n<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"1080\\\" height=\\\"800\\\" viewBox=\\\"0 0 1080 800\\\" role=\\\"img\\\" aria-labelledby=\\\"title desc\\\">\n  <title id=\\\"title\\\">Monday morning at the kitchen table</title>\n  <desc id=\\\"desc\\\">Sunlight from an arched window falls across three red apples, a blue MONDAY mug, and a gray tabby asleep on a folded newspaper on a wooden kitchen table, viewed from the front.</desc>\n  <defs>\n    <clipPath id=\\\"window\\\"><path d=\\\"M65 312V163a124 124 0 0 1 248 0v149Z\\\"/></clipPath>\n    <clipPath id=\\\"body\\\"><path d=\\\"M648 433c2-41 36-86 94-98 71-16 138 14 150 68 11 46-22 70-86 72l-120-6Z\\\"/></clipPath>\n    <g id=\\\"apple\\\">\n      <path fill=\\\"#924038\\\" d=\\\"M0-27c13-11 33-8 40 8C49 0 38 28 25 37c-9 7-15 2-22 3-9 2-16 5-25-1C-37 29-46 8-43-9c2-19 21-29 37-20Z\\\"/>\n      <path fill=\\\"currentColor\\\" d=\\\"M0-27c14-10 29-7 35 5 7 17-1 39-15 50-12 9-26 11-38 7C-34 29-45 6-43-9c2-19 21-29 37-20Z\\\"/>\n      <path fill=\\\"#f1a27d\\\" d=\\\"M-33-9c1-9 8-15 16-14 4 1 4 4 0 6-6 2-10 8-12 13-2 4-5 1-4-5Z\\\"/>\n      <path d=\\\"M-8-25q8 6 18-1\\\" fill=\\\"none\\\" stroke=\\\"#933d35\\\" stroke-width=\\\"2.6\\\" stroke-linecap=\\\"round\\\"/>\n      <path d=\\\"M1-25q-2-11 6-21\\\" fill=\\\"none\\\" stroke=\\\"#644b38\\\" stroke-width=\\\"4.8\\\" stroke-linecap=\\\"round\\\"/>\n      <g fill=\\\"#f2ac83\\\"><circle cx=\\\"-26\\\" cy=\\\"12\\\" r=\\\"1.4\\\"/><circle cx=\\\"-20\\\" cy=\\\"15\\\" r=\\\"1\\\"/><circle cx=\\\"12\\\" cy=\\\"23\\\" r=\\\"1.2\\\"/></g>\n    </g>\n    <g id=\\\"leaf\\\" fill=\\\"#798261\\\"><path d=\\\"M0 0Q-20-1-24-17-6-17 0 0Z\\\"/></g>\n  </defs>\n  <\"'!-- Plaster wall, floor and the shapes cast by the window mullions. -->\n  <path fill=\"#e6c4a1\" d=\"M0 0h1080v800H0z\"/>\n  <g fill=\"#f6dcad\"><path d=\"m66 306 106-1 667 368H584Z\"/><path d=\"m188 305 126-1 766 329v40H884Z\"/><path d=\"m315 98 765 320v177L315 272Z\"/></g>\n  <path fill=\"#c49d7e\" d=\"M0 651h1080v149H0z\"/>\n  <path fill=\"#eed2ad\" d=\"M0 638h1080v13H0z\"/><path fill=\"#b99170\" d=\"M0 651h1080v4H0z\"/>\n  <path fill=\"#dbb991\" d=\"m578 655 246 0 256 108v37h-97Zm276 0h186l40 16v80Z\"/>\n  <!-- Arched sash and the garden beyond it. -->\n  <path fill=\"#cda885\" d=\"M47 328V166a142 142 0 0 1 284 0v162Z\"/>\n  <path fill=\"#f8e3bd\" d=\"M43 321V163a146 146 0 0 1 292 0v158Z\"/>\n  <path fill=\"#ae8967\" d=\"M58 316V163a131 131 0 0 1 262 0v153Z\"/>\n  <g clip-path=\"url(#window)\">\n    <path fill=\"#f3d89d\" d=\"M62 30h255v290H62z\"/>\n    <circle cx=\"250\" cy=\"128\" r=\"33\" fill=\"#fff0bd\"/>\n    <path fill=\"#d0c49a\" d=\"M53 259q41-51 102-30t105-8q38-26 73-18v125H53Z\"/>\n    <path fill=\"#acb18b\" d=\"M50 281q38-49 90-36t99 0q49-16 85-12v94H50Z\"/>\n    <g fill=\"none\" stroke=\"#838d6b\" stroke-width=\"4\" stroke-linecap=\"round\">\n      <path d=\"M71 323q54-46 69-122m-36 86q-6-35-32-57m44 36q29-7 46-29M78 309q45-10 62-21\"/>\n    </g>\n    <g fill=\"#828e6c\">\n      <path d=\"M137 216q-14-20 6-42 9 23-6 42Zm-7 19q-23-8-21-32 21 9 21 32Zm-7 15q4-24 27-30-2 23-27 30Zm-19 37q-23 0-38-21 26-1 38 21Zm-12-32q-21-4-26-28 21 6 26 28Zm48-2q5-22 28-28-1 22-28 28Zm-15 40q6-22 27-24-5 20-27 24Z\"/>\n    </g>\n    <path fill=\"#b99875\" d=\"M183 35h13v281h-13zM55 182h267v13H55z\"/>\n    <path fill=\"#f8e5bf\" d=\"M181 34h10v282h-10zM54 181h270v9H54z\"/>\n  </g>\n  <path fill=\"#ccaa84\" d=\"m33 327 314-2-6 16H51Z\"/><rect x=\"32\" y=\"314\" width=\"316\" height=\"14\" rx=\"3\" fill=\"#f7dfb4\"/>\n  <!-- A small framed pear print. -->\n  <g transform=\"translate(858 85)\">\n    <path fill=\"#cda988\" d=\"M5 5h112v140H5z\"/><path fill=\"#977053\" d=\"M0 0h112v140H0z\"/>\n    <path fill=\"#d3a980\" d=\"M3 3h106v134H3z\"/><path fill=\"#f8e7c6\" d=\"M8 8h96v124H8z\"/>\n    <path fill=\"#d9caa4\" d=\"M19 20h74v99H19z\"/>\n    <pat