0,53,283,390,'#fff1cc')\nrect(78,380,505,394,'#b59d75');rect(77,378,506,383,'#fcf0cc')\npoly([(42,392),(531,392),(551,403),(29,406)],'#ffeac0');poly([(29,406),(551,403),(549,413),(30,417)],'#c29a6f')\nline([(33,406),(547,403)],'#f5d5a3',2)\n# backsplash square glazed tiles\nrect(0,417,1040,466,'#ded7b7')\nfor x in range(-22,1042,55):\n rect(x,418,x+52,466,r.choice(['#e8dec0','#e5dfc1','#e7dabe','#efdfbf']))\n line([(x,418),(x+52,418)],'#f6e8cd',1.5)\nrect(554,360,1040,419,'#ddd2b1')\nfor x in range(554,1043,55):\n rect(x,362,x+52,415,r.choice(['#e7dbbf','#ebdfc1','#e5d8b9']));line([(x+2,363),(x+50,363)],'#f9e7c8',1)\n# shelf with crockery\npoly([(606,178),(1040,174),(1040,192),(618,199)],'#d0ad7d')\nfor x in (655,974):\n poly([(x,174),(x+36,173),(x+8,213),(x+1,214)],'#956e50')\n poly([(x+2,177),(x+27,177),(x+6,202)],'#c59766')\ndef bowl(x,y,scale,body,trim):\n def pt(a,b):return (x+a*scale,y+b*scale)\n p=[pt(-43,-15),pt(-40,-6),pt(-33,2),pt(-21,11),pt(-10,14),pt(12,14),pt(24,10),pt(37,-1),pt(43,-15)]\n poly(p,body);el(x,y-15*scale,43*scale,5*scale,trim);el(x,y-15.7*scale,38*scale,2.5*scale,body)\n line([pt(-38,-7),pt(-16,-3),pt(10,-3),pt(38,-8)],trim,2*scale)\nfor i in range(3):bowl(697,157-i*7,.93,'#ece1ba','#7e9a8e')\nbowl(697,135,.91,'#e7daba','#6e9084')\n# storage canisters\nfor x,y,w,h,col in [(788,110,47,58,'#bf8254'),(846,94,54,74,'#d19a64'),(916,112,47,55,'#aa714e')]:\n rr(x,y,x+w,y+h,7,col);rr(x+4,y-3,x+w-4,y+5,3,'#88654c');rr(x+1,y-9,x+w-1,y-2,3,'#a78258')\n rect(x+7,y+9,x+9,y+h-8,'#deb582');rr(x+9,y+h*.34,x+w-8,y+h*.70,4,'#f0dfb6')\n line([(x+15,y+h*.53),(x+w-14,y+h*.53)],'#9c8a68',1.6)\npoly([(595,168),(1040,165),(1040,176),(596,181)],'#9c7050');poly([(595,166),(1040,162),(1040,166),(595,171)],'#e6b67b')\n# hooks and suspended pans\nrr(679,221,1007,229,4,'#aa835c');line([(684,222),(1000,222)],'#dab581',2)\nfor x in [712,775,847,925,981]:\n el(x,225,3.5,3.5,'#725d49')\n path(f'M {x} 224 Q {x-5} 241 {x+4} 237', '#806951',2)\n# ladle, spatula\nline([(715,23