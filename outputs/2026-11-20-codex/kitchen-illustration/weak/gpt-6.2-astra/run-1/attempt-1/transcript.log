{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/kitchen.py <<'PY'\nfrom PIL import Image, ImageDraw, ImageChops, ImageFilter\nimport math, random, re\nr=random.Random(303)\nW,H=1040,780\nS=2\nim=Image.new('RGB',(W*S,H*S),'#e9cb93')\nd=ImageDraw.Draw(im)\ndef pts(p):return [(round(x*S),round(y*S)) for x,y in p]\ndef poly(p,c):d.polygon(pts(p),fill=c)\ndef el(x,y,rx,ry,c):d.ellipse((int((x-rx)*S),int((y-ry)*S),int((x+rx)*S),int((y+ry)*S)),fill=c)\ndef line(p,c,w=1):\n d.line(pts(p),fill=c,width=max(1,round(w*S)),joint='curve')\ndef path(s,c,w=0):\n tokens=re.findall(r'[MLQCZ]|-?\\\\d+(?:\\\\.\\\\d+)?',s); i=0; p=[]\n def n():\n  nonlocal i\n  a,b=map(float,tokens[i:i+2]);i+=2;return a,b\n while i<len(tokens):\n  cmd=tokens[i];i+=1\n  if cmd=='Z':p.append(p[0]);continue\n  if cmd in 'ML':p.append(n());continue\n  a=p[-1];b=n();e=n()\n  if cmd=='C':f=n()\n  for j in range(1,25):\n   t=j/24;u=1-t\n   p.append(tuple(u*u*a[k]+2*u*t*b[k]+t*t*e[k] if cmd=='Q' else u**3*a[k]+3*u*u*t*b[k]+3*u*t*t*e[k]+t**3*f[k] for k in (0,1)))\n if w:line(p,c,w)\n else:poly(p,c)\ndef rect(x,y,x2,y2,c):poly([(x,y),(x2,y),(x2,y2),(x,y2)],c)\ndef rr(x,y,x2,y2,rad,c):d.rounded_rectangle((x*S,y*S,x2*S,y2*S),radius=rad*S,fill=c)\n# limed plaster\nfor y in range(H):\n t=y/H\n line([(0,y),(W,y)],tuple(int(a*(1-t)+b*t) for a,b in zip((242,222,183),(217,178,126))),1.5)\nfor _ in range(4400):\n x,y=r.randrange(W),r.randrange(455);el(x,y,r.uniform(.2,1.0),r.uniform(.2,.8),r.choice(['#ebd3a7','#f2dfb9','#e8cea1']))\n# broad slants of sunlight on plaster\npoly([(532,90),(698,440),(573,440),(509,288)],'#f8e6b8')\npoly([(539,277),(614,440),(547,440),(519,365)],'#f8e5b3')\n# window shadow and casing\narch='M 51 400 L 51 109 Q 55 46 145 34 Q 314 13 451 39 Q 529 51 533 111 L 533 400 Z'\npath('M 49 408 L 48 111 Q 52 50 142 38 Q 309 14 455 42 Q 536 54 541 114 L 544 409 Z','#c5a476')\npath(arch,'#87694e')\npath('M 57 399 L 58 111 Q 65 55 147 44 Q 311 