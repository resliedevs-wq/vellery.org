{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/morning_art.py <<'PY'\nfrom PIL import Image,ImageDraw,ImageChops,ImageFilter\nimport re,random,math\nrandom.seed(12)\nS=2\nW,H=1000,760\nim=Image.new('RGB',(W*S,H*S),'#efd7af')\nd=ImageDraw.Draw(im)\ndef pt(x,y):return (round(x*S),round(y*S))\ndef poly(v,c):d.polygon([pt(*u) for u in v],fill=c)\ndef rect(x,y,u,v,c):d.rectangle([pt(x,y),pt(u,v)],fill=c)\ndef oval(x,y,rx,ry,c):d.ellipse([pt(x-rx,y-ry),pt(x+rx,y+ry)],fill=c)\ndef line(v,c,w=1):\n d.line([pt(*u) for u in v],fill=c,width=max(1,round(w*S)),joint='curve')\ndef path(s,c,w=0):\n t=iter(re.findall(r'[MLQCZ]|-?(?:\\\\d+\\\\.?\\\\d*|\\\\.\\\\d+)',s));v=[]\n def p():return float(next(t)),float(next(t))\n for a in t:\n  if a in ('M','L'): v.append(p())\n  elif a in ('C','Q'):\n   ps=[v[-1]]+[p() for i in range(3 if a=='C' else 2)]\n   for i in range(1,25):\n    f=i/24; z=ps\n    while len(z)>1:z=[(x*(1-f)+u*f,y*(1-f)+v1*f) for (x,y),(u,v1) in zip(z,z[1:])]\n    v.append(z[0])\n  elif a=='Z':v.append(v[0])\n if w:line(v,c,w)\n else:poly(v,c)\ndef shadow(x,y,rx,ry):oval(x,y,rx,ry,'#a96c42')\n# plaster wall with minute flecks\nfor i in range(12000):\n x=random.random()*W;y=random.random()*500;line([(x,y),(x+random.random()*1.9,y+.6)],random.choice(['#e8cda7','#f4dfbc','#edd3ae']),.65)\n# backsplash half wall, off-white rectangular tiles\nrect(0,344,1000,486,'#bda88e')\nfor j in range(3):\n for i in range(-1,12):\n  x=i*96+(j%2)*48;y=346+j*49\n  rect(x,y,x+93,y+46,random.choice(['#ebdcc3','#e4d2b8','#e9d8bf','#e6d6bf']))\n# shelf shaded underside\npoly([(0,235),(260,235),(213,264),(0,267)],'#d8b994')\nfor x in (32,202):\n poly([(x,230),(x+16,230),(x,263)],'#986344')\nrect(0,220,261,232,'#714a37');rect(0,217,262,224,'#bb8050')\n# stacked stoneware left\nfor i in range(4):\n y=214-i*7\n path(f'M 11 {y-7} Q 50 {y-12} 91 {y-7} Q 90 {y+4} 28 {y+3} Q 15 {y+2} 11 {y-7}', '#8a9985')\n oval(51,y-7,40,4,'#f7e7c6')\n# crock jars\ndef jar(x,y,w,h,color,lid):\n path(f'M {x+2} {y+8} Q {x-1} {y+12} {x} {y+h-4} Q {x} {y+h+1} {x+w/2} {y+h} Q {x+w} {y+h} {x+w} {y+h-5} L {x+w} {y+12} L {x+w-3} {y+8} Z',color)\n oval(x+w/2,y+7,w/2,3,lid);rect(x-1,y,x+w+1,y+6,lid);oval(x+w/2,y,w/2+1,3,'#bd9461')\n rect(x+5,y+16,x+7,y+h-8,'#efe3c6')\njar(107,158,34,58,'#b56e4b','#79563c');jar(151,176,30,40,'#c4b990','#74533f')\n# shelf little blue bowl\npath('M 194 195 Q 216 191 243 195 Q 240 215 221 217 Q 200 216 194 195','#587e7b');oval(218,195,25,3,'#a9c1a9')\n# window extruded arch + sky gradient clipped to opening\ndef arch(x,y,rx,b,c):\n oval(x,y,rx,rx,c);rect(x-rx,y,x+rx,b,c)\narch(492,215,189,409,'#ccad84')\narch(500,207,190,402,'#977454')\narch(500,207,185,399,'#f8e7c6')\narch(500,207,174,391,'#b69d77')\nbg=im.copy()\nfor y in range(27,397):\n f=(y-27)/370; c=tuple(int(a*(1-f)+b*f) for a,b in zip((145,190,185),(255,224,157)))\n rect(320,y,680,y+1,c)\noval(555,202,36,36,'#ffefb2')\npath('M 310 300 Q 365 255 405 267 Q 458 285 502 256 Q 565 216 610 238 Q 643 251 681 224 L 687 403 L 310 403 Z','#a4b5a0')\npath('M 310 333 Q 384 274 438 299 Q 476 317 530 292 Q 593 256 690 272 L 690 400 L 310 400 Z','#879c84')\n# village houses\nfor x,y,z in [(480,297,.9),(530,288,.58),(441,312,.52),(589,284,.67)]:\n poly([(x,y),(x+32*z,y),(x+32*z,y+24*z),(x,y+24*z)],'#f4d8a6')\n poly([(x-5*z,y),(x+9*z,y-14*z),(x+29*z,y-14*z),(x+38*z,y)],'#b77955')\n rect(x+19*z,y+7*z,x+24*z,y+15*z,'#647e75')\n# tree canopy branches leaning in\nfor x,y in [(327,247),(337,281),(663,213),(679,287)]:\n for i in range(100):\n  dx=random.gauss(0,19);dy=random.gauss(0,30)\n  oval(x+dx,y+dy,random.randrange(3,9),random.randrange(3,8),random.choice(['#6e8f74','#88a37e','#a3b38c','#b1bd90']))\nfor i in range(95):\n x=random.uniform(316,687);y=random.uniform(338,395);r=random.uniform(2,7)\n oval(x,y,r,r*.8,random.choice(['#789578','#90a67f','#a7b689']))\nmask=Image.new('L',im.size);md=ImageDraw.Draw(mask);md.ellipse([pt(330,37),pt(670,377)],fill=25