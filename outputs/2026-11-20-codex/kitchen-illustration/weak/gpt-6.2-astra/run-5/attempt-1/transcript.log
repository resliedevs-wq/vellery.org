\npath('M 938 89 L 965 89 L 963 103 Q 982 123 973 150 Q 967 160 940 155 Q 923 147 930 124 Q 940 101 938 98 L 931 91 Z','#a6ad8e')\nfor X,Y,b in [(914,22,-9),(946,0,2),(984,19,7),(1011,45,4)]:\n stem(950,92,X,Y,b,'#63735a',2)\n for i in range(2,8):\n  r=i/9;x=950+(X-950)*r+2*b*r*(1-r);y=92+(Y-92)*r;sg=1 if i%2 else -1\n  leaf(x,y,x+sg*random.randint(10,20),y-random.randint(9,19),5,random.choice(['#738669','#8c9976','#9ca482']))\n# cookbooks \nfor x,y,w,c in [(1054,63,15,'#667e72'),(1071,49,23,'#b86f53'),(1097,69,13,'#c9a167')]:\n rect(x,y,x+w,157,c)\n for Y in [y+9,147]:rect(x+2,Y,x+w-2,Y+2,'#ead4a5')\npoly([(1112,66),(1129,63),(1151,153),(1135,157)],'#858e6f')\nrect(613,156,1200,170,'#aa7852');rect(613,154,1200,159,'#dcb686');rect(618,168,1200,173,'#8e6b4f')\n# hanging mugs\nfor x,y,c,shadow in [(729,215,'#eee4c6','#b7b89c'),(813,217,'#c27f60','#a46852')]:\n stem(x,173,x,193,0,'#766b50',2)\n arc(x-5,187,x+6,200,0,220,'#766b50',2)\n path(f'M {x-4} {y-7} Q {x-12} {y-31} {x+1} {y-24} Q {x+9} {y-19} {x+10} {y-9}',None,shadow,5)\n path(f'M {x-16} {y-9} L {x+19} {y-14} L {x+20} {y+13} Q {x+17} {y+27} {x-2} {y+25} Q {x-12} {y+22} {x-13} {y+15} Z',c,shadow,1.4)\n# counter\npoly([(0,462),(1200,462),(1200,516),(0,516)],'#cfad80')\npoly([(0,467),(525,467),(654,499),(0,501)],'#edcea1')\nrect(0,503,1200,520,'#aa805b');rect(0,502,1200,508,'#e6c397')\nrect(0,521,1200,880,'#70877a')\n# paneled cabinet doors\nfor x,X in [(-35,177),(190,404),(418,628),(642,852)]:\n rect(x,534,X,840,'#94a594');rect(x+10,545,X-11,828,'#647e71');rect(x+14,549,X-14,825,'#8b9f8e')\n for xx in range(x+44,X-18,37):\n  line([(xx,551),(xx,823)],'#829885',1.2)\n k=X-27 if x in [-35,418] else x+26\n oval(k-6,562,k+7,576,'#5b6a5b');oval(k-6,561,k+5,572,'#c2a06a');oval(k-4,562,k,565,'#e8ca8c')\n# sink/faucet\npoly([(148,479),(387,479),(414,494),(130,494)],'#f3ddbb')\npoly([(159,481),(382,481),(396,490),(146,490)],'#79918a')\npoly([(160,481),(381,481),(384,484),(156,484)],'#536e66')\npath('M 272 480 L 272 435 C 27