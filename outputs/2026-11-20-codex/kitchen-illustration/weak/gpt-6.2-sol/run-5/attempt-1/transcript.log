{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/vellery-2u3f0sxi/paint.py <<'PY'\nfrom PIL import Image, ImageDraw, ImageColor, ImageFilter, ImageChops\nfrom math import sin, cos, pi\nfrom random import Random\nimport re\n\nW, H, S = 1200, 900, 2\nrng = Random(573)\nim = Image.new('RGB',(W*S,H*S),'#f0d4a2')\ndef col(c):\n    return ImageColor.getrgb(c) if isinstance(c,str) else c\ndef pts(p):\n    return [(round(x*S),round(y*S)) for x,y in p]\ndef box(x,y,w,h):\n    return tuple(round(i*S) for i in (x,y,x+w,y+h))\ndef rect(x,y,w,h,c,r=0,edge=None,sw=1):\n    d=ImageDraw.Draw(im)\n    if r: d.rounded_rectangle(box(x,y,w,h),radius=round(r*S),fill=c,outline=edge,width=max(1,round(sw*S)))\n    else: d.rectangle(box(x,y,w,h),fill=c,outline=edge,width=max(1,round(sw*S)))\ndef ell(x,y,w,h,c,edge=None,sw=1):\n    ImageDraw.Draw(im).ellipse(box(x,y,w,h),fill=c,outline=edge,width=max(1,round(sw*S)))\ndef poly(p,c):\n    ImageDraw.Draw(im).polygon(pts(p),fill=c)\ndef line(p,c,w=1):\n    p=pts(p); d=ImageDraw.Draw(im); sw=max(1,round(w*S))\n    d.line(p,fill=c,width=sw,joint='curve')\n    if sw>2:\n        r=sw/2\n        for x,y in (p[0],p[-1]): d.ellipse((x-r,y-r,x+r,y+r),fill=c)\ndef path(spec):\n    vox=iter(re.findall(r'[MLCQZ]|-?(?:\\\\d*\\\\.)?\\\\d+', spec))\n    def xy(): return float(next(vox)),float(next(vox))\n    p=[]\n    for op in vox:\n        if op in 'ML': p.append(xy())\n        elif op=='Z': p.append(p[0])\n        elif op=='Q':\n            a=p[-1]; b=xy(); c=xy()\n            for k in range(1,19):\n                t=k/18; s=1-t\n                p.append(tuple(s*s*a[i]+2*s*t*b[i]+t*t*c[i] for i in range(2)))\n        elif op=='C':\n            a=p[-1]; b=xy(); c=xy(); d=xy()\n            for k in range(1,23):\n                t=k/22; s=1-t\n                p.append(tuple(s**3*a[i]+3*s*s*t*b[i]+3*s*t*t*c[i]+t**3*d[i] for i in range(2)))\n    return p\ndef shape(s,c,edge=None,w=1):\n    p=path(s); poly(p,c)\n    if edge: line(p,edge,w)\ndef stroke(s,c,w=1):\n    line(path(s),c,w)\ndef gradient(y,height,a,b):\n    a,b=col(a),col(b)\n    d=ImageDraw.Draw(im)\n    for yy in range(round(y*S),round((y+height)*S)):\n        t=(yy/S-y)/height\n        d.line((0,yy,W*S,yy),fill=tuple(round(x+(z-x)*t) for x,z in zip(a,b)))\ndef gradshape(s,a,b):\n    p=path(s); pp=pts(p)\n    x,y=min(v[0] for v in pp),min(v[1] for v in pp)\n    right,bot=max(v[0] for v in pp)+1,max(v[1] for v in pp)+1\n    mask=Image.new('L',(right-x,bot-y))\n    ImageDraw.Draw(mask).polygon([(xx-x,yy-y) for xx,yy in pp],fill=255)\n    layer=Image.new('RGB',mask.size)\n    d=ImageDraw.Draw(layer)\n    a,b=col(a),col(b)\n    for yy in range(bot-y):\n        t=yy/(bot-y)\n        d.line((0,yy,right-x,yy),fill=tuple(round(v+(u-v)*t) for v,u in zip(a,b)))\n    im.paste(layer,(x,y),mask)\ndef soft(p,c,opacity=90,blur=10):\n    mask=Image.new('L',im.size)\n    ImageDraw.Draw(mask).polygon(pts(p),fill=opacity)\n    im.paste(col(c),(0,0,W*S,H*S),mask.filter(ImageFilter.GaussianBlur(blur*S)))\ndef flecks(bounds,n,colors,length=(.7,4),take=None):\n    x,y,w,h=bounds\n    for _ in range(n):\n        a,b=rng.uniform(x,x+w),rng.uniform(y,y+h)\n        if take and not take(a,b): continue\n        z=rng.uniform(*length)\n        line([(a,b),(a+z,b+rng.uniform(-.35,.35))],rng.choice(colors),rng.choice([.55,.7,1]))\ndef oval(x,y,rx,ry,angle,c):\n    co,si=cos(angle),sin(angle)\n    poly([(x+rx*cos(t)*co-ry*sin(t)*si,y+rx*cos(t)*si+ry*sin(t)*co) for t in (i*pi/20 for i in range(40))],c)\n\n# Plaster, floor, and the side wall.\ngradient(0,620,'#d8a887','#f5d5a3')\nsoft([(0,5),(625,5),(785,540),(0,538)],'#ffe1a4',126,85)\npoly([(1091,0),(1200,0),(1200,618),(1091,542)],'#bd8b73')\npoly([(1093,0),(1106,0),(1101,547),(1090,553)],'#c39174')\ngradient(583,317,'#be7756','#985441')\nfor j in range(8):\n    x=95+j*133\n    p=[(x,647),(x+5,663),(620+(x-620)*2.15,900)]\n    line(p,'#915443',2); line([(a+4,b) for a,b in p],'#cd89