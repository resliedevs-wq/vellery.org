9,'#674d40')\nrect(289,89,21,304,'#775542')\nrect(291,87,12,310,'#d4a073')\nrect(292,89,3,310,'#f0c494')\nrect(121,235,369,15,'#8a5f45')\nrect(120,235,370,10,'#c99a6d')\nline([(122,236),(484,237)],'#e9bc89',2)\npoly([(106,388),(510,386),(534,399),(92,405)],'#efc38e')\nrect(92,401,442,13,'#a06b4b',3)\nline([(96,402),(526,399)],'#e4ad77',2)\n\n# Short striped linen curtains pushed open.\nline([(87,66),(531,63)],'#744d3c',5)\nell(78,61,12,12,'#8b5a42'); ell(529,58,13,12,'#8b5a42')\ndef curtain(s,a,b,creases):\n    gradshape(s,a,b)\n    for sp,c,w in creases: stroke(sp,c,w)\ncurtain('M 99 74 C 112 69 123 72 130 70 C 140 79 146 70 165 73 C 174 100 165 147 155 185 C 150 211 148 247 158 288 Q 142 295 137 289 Q 125 300 114 293 Q 98 300 84 292 C 101 259 99 228 102 193 C 105 141 92 104 99 74 Z',\n        '#fce4c0','#e4b38a',[\n    ('M 111 80 C 102 131 130 169 115 224 Q 119 261 103 286','#e0aa81',4),\n    ('M 140 77 C 151 119 139 166 130 207 Q 125 253 134 284','#d1a283',4),\n    ('M 154 78 C 159 121 152 162 144 197 Q 133 246 147 280','#f7d4ad',4),\n    ('M 124 78 C 120 120 138 154 125 208 Q 121 250 115 286','#ffebc5',4),\n    ('M 90 286 Q 105 290 116 285 Q 130 291 141 283 Q 148 287 154 282','#b86e58',2)])\ncurtain('M 444 71 C 453 68 467 75 474 71 Q 488 68 496 71 Q 506 65 517 69 C 529 103 514 151 513 187 C 508 229 524 262 533 282 Q 525 291 514 286 Q 502 296 487 286 Q 472 290 462 284 C 475 250 471 221 465 190 C 454 143 432 100 444 71 Z',\n        '#fff0cd','#e1b083',[\n    ('M 451 77 C 440 109 479 170 481 216 Q 490 254 474 281','#e3b48a',4),\n    ('M 470 77 C 468 114 493 156 492 214 Q 496 253 490 281','#d29c76',5),\n    ('M 489 76 C 500 118 496 155 500 210 Q 504 250 506 281','#fff0ca',5),\n    ('M 507 74 C 518 118 501 158 507 209 Q 506 255 521 283','#d79e7a',4),\n    ('M 468 280 Q 481 284 489 279 Q 502 286 514 280 Q 523 284 529 277','#b86e58',2)])\nfor x in (105,123,143,161,451,472,492,512):\n    stroke(f'M {x} 74 Q {x-4} 63 {x+2} 65 Q {x+5} 67 {x+4} 73','#a57259',2)\n\n# Glazed