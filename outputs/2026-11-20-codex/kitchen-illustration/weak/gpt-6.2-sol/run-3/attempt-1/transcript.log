{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/draw-vellery-sxgeokav.py <<'PY'\nfrom PIL import Image, ImageDraw, ImageFilter, ImageChops\nimport math, random\n\nW,H,S = 1200,850,2\nimg = Image.new('RGB',(W*S,H*S),'#ecd4aa')\nd = ImageDraw.Draw(img)\nrng = random.Random(8301)\n\ndef pts(p): return [(round(x*S),round(y*S)) for x,y in p]\ndef poly(p,c): d.polygon(pts(p),fill=c)\ndef box(b,c): d.rectangle(tuple(round(n*S) for n in b),fill=c)\ndef pill(b,r,c,ol=None,w=1): d.rounded_rectangle(tuple(round(n*S) for n in b),radius=round(r*S),fill=c,outline=ol,width=round(w*S))\ndef oval(b,c,ol=None,w=1): d.ellipse(tuple(round(n*S) for n in b),fill=c,outline=ol,width=round(w*S))\ndef line(p,c,w=1):\n    d.line(pts(p),fill=c,width=max(1,round(w*S)),joint='curve')\n    if w>=2:\n        for x,y in [p[0],p[-1]]:\n            oval((x-w/2,y-w/2,x+w/2,y+w/2),c)\ndef path(p,fill=None,stroke=None,w=1,close=False):\n    out=[p[0]]\n    for item in p[1:]:\n        if len(item)==2: out.append(item)\n        else:\n            x,y=out[-1]; a,b,c,e,u,v=item\n            count=max(8,int((math.hypot(a-x,b-y)+math.hypot(c-a,e-b)+math.hypot(u-c,v-e))/5))\n            for i in range(1,count+1):\n                t=i/count; q=1-t\n                out.append((q**3*x+3*q*q*t*a+3*q*t*t*c+t**3*u,q**3*y+3*q*q*t*b+3*q*t*t*e+t**3*v))\n    if fill: poly(out,fill)\n    if stroke: line(out+[out[0]] if close else out,stroke,w)\n    return out\ndef gradient(b,top,bottom,vertical=True):\n    from PIL import ImageColor\n    x0,y0,x1,y1=b\n    a,z=ImageColor.getrgb(top),ImageColor.getrgb(bottom)\n    n=(y1-y0 if vertical else x1-x0)*S\n    strip=Image.new('RGB',(1,n) if vertical else (n,1))\n    strip.putdata([tuple(round(u+(v-u)*i/max(1,n-1)) for u,v in zip(a,z)) for i in range(n)])\n    img.paste(strip.resize(((x1-x0)*S,(y1-y0)*S)),(x0*S,y0*S))\ndef light(p,c,opacity,blur=0):\n    mask=Image.new('L',img.size)\n    ImageDraw.Draw(mask).polygon(pts(p),fill=opacity)\n    if blur: mask=mask.filter(ImageFilter.GaussianBlur(blur*S))\n    img.paste(c,(0,0),mask)\ndef leaf(x,y,ang,n,width,c,vein=None):\n    a=math.radians(ang); u=(math.cos(a),math.sin(a)); v=(-u[1],u[0])\n    def g(l,k): return (x+l*u[0]+k*v[0],y+l*u[1]+k*v[1])\n    path([(x,y),(*g(n*.28,width),*g(n*.7,width),*g(n,0)),(*g(n*.73,-width*.7),*g(n*.28,-width),x,y)],c)\n    if vein: path([(x,y),(*g(n*.29,0),*g(n*.57,width*.15),*g(n*.8,0))],stroke=vein,w=.65)\n\n# Limewash wall and a tiled backsplash.\ngradient((0,0,W,520),'#bf937c','#edd2a2',False)\nlight([(70,0),(554,0),(718,481),(155,470)],'#ffe5b4',115,68)\nfor i in range(1550):\n    x=rng.uniform(0,W); y=rng.uniform(0,530)\n    c=rng.choice(['#ebc6a1','#e8bf9d','#d8ad8e','#f3d3a9','#d3ab91'])\n    line([(x,y),(x+rng.uniform(.4,3),y+rng.uniform(-.3,.6))],c,.55)\ngradient((0,378,W,536),'#e4bc95','#d2ab88')\nbox((0,376,1200,379),'#bf9277')\nline([(0,380),(1200,380)],'#f2d3a8',2)\nfor row,y in enumerate([382,423,464,505]):\n    for x in range(-88+(row%2)*45,W,91):\n        shade=rng.choice(['#e0ba98','#e6c2a0','#edd0a8','#e5c3a2','#deb594','#e9c49e'])\n        pill((x+1,y+1,x+89,y+39),2,shade)\n        line([(x+5,y+2),(x+85,y+2)],'#f6d8ad',.8)\n        for _ in range(2):\n            a=x+rng.randrange(10,78); b=y+rng.randrange(5,34)\n            line([(a,b),(a+rng.randint(3,9),b-.4)],'#e1bb9a',.65)\n\n# Recessed window and the orchard beyond.\nlight([(100,57),(537,58),(573,423),(90,422)],'#825d51',120,12)\npill((101,52,545,412),5,'#8e5d49')\npill((105,53,541,408),4,'#9b6e54')\nbox((114,60,531,400),'#d19a72')\nbox((125,69,521,391),'#765c48')\ngradient((136,78,511,387),'#8eb4ab','#f6cd90')\noval((348,115,426,193),'#f6d89a')\noval((356,123,418,185),'#ffe7af')\nclouds=[\n [(147,137),(172,126,187,130,200,136),(217,133,228,143,252,147),(217,151,173,149,145,149)],\n [(274,109),(291,97,319,99,328,106),(337,107,345,109,353,114),(327,116,299,115,271,116)],\n [(415,210),(438,194,465,196,476,202),(488,200,502,20