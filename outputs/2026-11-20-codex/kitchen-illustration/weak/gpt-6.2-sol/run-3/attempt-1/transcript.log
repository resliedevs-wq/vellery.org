,(814,522),(741,505),(425,423)],'#ffe1aa',48,1.4)\n\n# Old breadboards, utensil crock and a bowl of pears.\npath([(30,502),(22,489,24,450,30,421),(32,409,49,405,61,410),(68,400,68,391,71,377),(72,370,85,369,89,375),(93,386,86,397,93,416),(113,426,115,469,109,495),(99,503,55,507,30,502)],'#98684e')\npath([(34,500),(27,470,30,426,40,419),(56,413,67,414,71,399),(74,392,74,380,76,376),(81,375,86,376,85,380),(84,397,82,409,93,420),(107,431,109,462,104,496)],'#c69166','#775948',1.4,True)\noval((76,378,83,386),'#8d684e')\nfor i in range(40):\n    x=rng.uniform(34,101); y=rng.uniform(434,494); ll=rng.uniform(3,min(16,500-y))\n    path([(x,y),(x-1,y+ll*.3,x-1,y+ll*.7,x+.4,y+ll)],stroke=rng.choice(['#ae7b58','#d7a477','#c28c63']),w=.75)\noval((62,504,185,515),'#b18462')\nfor x,y,k in [(108,453,-1),(135,449,0),(153,457,1)]:\n    line([(x+11*k,y-25),(x-3*k,484)],'#895f48',4)\n    line([(x+11*k-1,y-24),(x-3*k-1,479)],'#c7986f',1.1)\n    path([(x+7*k,y-22),(x+5*k-7,y-31,x+15*k-9,y-49,x+19*k,y-49),(x+20*k+7,y-48,x+17*k+9,y-24,x+11*k,y-22)],'#b3815b','#8d644c',1,True)\npath([(89,462),(89,488,94,509,106,510),(118,513,149,512,159,507),(167,497,168,482,170,461)],'#ad7861','#86634f',1.2,True)\noval((88,456,171,468),'#d7a486','#8e6953',1)\noval((94,458,165,464),'#816351')\nfor x,offset in [(98,3),(114,2),(129,0),(145,-2),(159,-5)]:\n    path([(x,471),(x,487,x+offset,497,x+offset+3,506)],stroke='#cf9e7d',w=1.3)\n\ndef pear(x,y,s,c,hi,sh):\n    def pp(p,*args,**kwargs):\n        return path([tuple((x+n*s if i%2==0 else y+n*s) for i,n in enumerate(t)) for t in p],*args,**kwargs)\n    pp([(0,0),(17,-3,27,-13,18,-30),(11,-42,9,-36,6,-52),(3,-63,-10,-61,-14,-50),(-16,-40,-17,-38,-25,-29),(-37,-11,-21,4,0,0)],c,sh,1.1,True)\n    pp([(-21,-27),(-19,-35,-15,-33,-12,-43),(-17,-25,-19,-21,-13,-16),(-17,-11,-25,-16,-21,-27)],hi)\n    pp([(2,-57),(4,-62,2,-66,-1,-69)],stroke='#72543d',w=2)\n    leaf(x+1*s,y-58*s,-26,17*s,4*s,'#758154')\n    for _ in range(30):\n        a=rng.uniform(-17,12); b=rng.uniform(-32,-6)\n        line([(x+a*s,y+b*s),(x+(a+.7)*s,y+b*s)],sh,.55)\noval((568,505,744,524),'#b1845f')\nbowl(653,493,151,27,'#ac7861','#e6af82','#956b53','#865d4b')\npear(618,493,.64,'#abb070','#c9c285','#879053')\npear(655,493,.8,'#cbab67','#edd092','#ac874d')\npear(682,493,.62,'#aaa96f','#d0c486','#8d925e')\npath([(580,492),(616,506,684,506,727,492),(721,508,697,518,671,520),(631,524,589,515,580,492)],'#b67e63','#a27458',1.1,True)\npath([(585,496),(623,510,679,510,721,496)],stroke='#e7b38b',w=1.4)\nfor i in range(19):\n    x=601+i*5.6\n    path([(x,505),(x+1,509,x+3,511,x+6,513)],stroke='#cc9879',w=.85)\n\n# A cream enamel range with a copper kettle.\nlight([(830,539),(1059,539),(1073,850),(818,850)],'#374c44',130,7)\npill((824,508,1068,861),7,'#8d8473')\ngradient((828,526,1064,850),'#d7c1a2','#afa68a',False)\npill((823,508,1068,538),5,'#5b5c51','#484c45',1.5)\nbox((825,515,1066,520),'#777669')\nfor a,b in [(853,931),(951,1040)]:\n    path([(a,514),(a+6,500,a+14,499,a+23,500),(b-22,500),(b-8,500,b-1,505,b,514)],stroke='#56584d',w=3.7)\n    line([(a+9,506),(b-10,506)],'#8b8572',1.2)\nbox((829,542,1063,580),'#d9c5a3')\nline([(828,579),(1060,579)],'#9f9077',2)\nfor x in [854,899,945,990,1036]:\n    oval((x-10,551,x+11,572),'#9e8a72')\n    oval((x-11,549,x+9,568),'#ece0b9','#8e7d67',1.2)\n    line([(x-2,556),(x+2,560)],'#a67d59',1.5)\npill((848,603,1045,760),8,'#8c8371')\npill((854,609,1039,751),7,'#b5ac93')\npill((873,635,1020,727),6,'#747569')\npill((877,639,1016,723),6,'#515950')\nlight([(883,647),(925,645),(991,721),(959,721)],'#9c9d87',35,1.7)\npill((867,615,1026,628),5,'#6e6b5e')\npill((877,616,1016,622),2,'#a29a82')\nline([(831,776),(1060,776)],'#938971',2)\npill((904,794,987,801),3,'#8a8270')\noval((847,500,992,515),'#5e5e50')\npath([(897,457),(885,407,964,406,965,453)],stroke='#654e42',w=8)\npath([(898,445),(896,414,958,417,963,445)],stroke='#ae7958',w=2)\npath([(894,482),(878,481,866,470,864,455),(859,451,853,453,851,449),(856,445,869,446,875,450),(877,4