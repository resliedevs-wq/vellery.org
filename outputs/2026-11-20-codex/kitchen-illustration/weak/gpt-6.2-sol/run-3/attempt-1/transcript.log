{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"cat >> /tmp/draw-vellery-sxgeokav.py <<'PY'\n\n# The wash basin below the window.\npath([(218,512),(244,504,461,503,479,509),(488,518,444,522,348,522),(278,523,218,520,218,512)],'#b3a38a','#9a765d',1.05,True)\npath([(229,513),(251,506,451,506,468,511),(460,519,269,522,229,513)],'#80857a')\npath([(244,513),(287,516,405,515,461,512)],stroke='#a4a592',w=1.2)\noval((327,504,367,509),'#9e7754')\noval((332,501,362,507),'#c69763','#836d52',1)\npath([(346,503),(345,490,347,476,347,468),(347,438,383,438,389,463),(390,468,389,474,389,478)],stroke='#7b6249',w=8)\npath([(345,501),(344,487,346,479,346,466),(347,438,383,437,388,463),(389,466,388,474,388,477)],stroke='#bd9862',w=5.2)\npath([(344,495),(344,483,345,474,345,467),(346,440,380,439,386,461)],stroke='#e4bb7e',w=1.45)\nline([(383,478),(392,478)],'#80674e',3.5)\nline([(344,489),(333,487),(331,483)],'#a17f53',3)\n\n# A big, close farmhouse table. The near edge is just out of frame.\nlight([(-58,649),(75,615),(510,615),(718,692),(808,850),(-50,850)],'#453b36',114,20)\npath([(-55,667),(51,622,153,605,274,606),(451,601,600,619,700,657),(782,690,811,762,811,850),(-90,895)],'#7e4e3e','#604e41',2,True)\ntable=path([(-55,654),(48,611,149,593,273,593),(461,587,605,608,704,650),(785,687,799,751,786,802),(773,830,752,848,718,861),(-80,861)])\ntable_mask=Image.new('L',img.size); ImageDraw.Draw(table_mask).polygon(pts(table),fill=255)\nunder=img.copy()\ngradient((0,584,810,850),'#dda879','#aa7356')\nimg.paste(under,(0,0),ImageChops.invert(table_mask))\ndef table_detail():\n    for y in [629,676,745,828]:\n        path([(-15,y+31),(145,y-15,467,y-36,805,y+10)],stroke='#996548',w=1.55)\n        path([(-15,y+34),(145,y-12,467,y-33,805,y+13)],stroke='#e5ad79',w=.85)\n    for i in range(870):\n        x=rng.uniform(-8,802); y=rng.uniform(594,851)\n        length=rng.uniform(1.4,32)\n        c=rng.choice(['#c68d63','#d6a171','#daa271','#b47d58