+h*.43,x+w-3,y+h-4),4,contents)\n    for _ in range(35):\n        xx=rng.uniform(x+5,x+w-5); yy=rng.uniform(y+h*.47,y+h-6)\n        ell((xx,yy,xx+1.5,yy+1.1),mix(contents,'#634f40',rng.uniform(.1,.4)))\n    rr((x-1,y,x+w+1,y+9),3,lid,'#956c4a',1)\n    line([(x+4,y+12),(x+4,y+h-7)],'#f2d5a0',1.2)\n    line([(x+4,y+2),(x+w-4,y+2)],'#ecc58e',1)\nshelf(107,192,416)\nshelf(123,344,394)\ncanister(143,125,43,64,'#c7b98e','#a97951','#ac8b63')\ncanister(194,114,53,75,'#d8c8a4','#a97951','#d5ba82')\nrr((204,143,237,163),3,'#e6d1a1')\npath((212,157),(218,147,221,158,228,149),stroke='#977450',w=1)\nbowl(293,174,70,15,'#ad694f','#d39b70','#936046')\nbowl(292,163,74,14,'#c48664','#e4b187','#9c694d')\nbowl(295,150,78,15,'#dfb182','#f1ca98','#a77b55')\n# Book cloth, gilded rules, and a small portrait on the shelf.\nfor x,y,w,c in [(366,129,15,'#826f51'),(383,119,15,'#a6624e'),(399,133,13,'#777759')]:\n    rr((x,y,x+w,189),2,c,'#695a46',1)\n    for dy in [7,10,47]:\n        if y+dy<187: line([(x+3,y+dy),(x+w-3,y+dy)],'#c9a170',.8)\npoly([(413,188),(430,184),(415,127),(400,132)],'#c29261','#8d674a')\nline([(413,139),(404,142)],'#eac693',1)\npoly([(448,188),(493,189),(500,131),(452,125)],'#8d6147','#705541')\npoly([(456,181),(486,183),(491,139),(459,135)],'#e8cea0')\npath((469,176),(470,163,479,152,482,146),stroke='#798260',w=1.1)\nleaf(473,163,201,13,3,'#93976b')\nleaf(476,157,-42,11,3,'#869066')\nleaf(470,168,21,14,3,'#a69f70')\n\n# Lower shelf cups and striped plates.\nfor x,y,s in [(186,323,1),(160,326,.72)]:\n    ell((x-11*s,y-29*s,x+26*s,y+19*s),'#d7a878','#8f684e')\n    ell((x-7*s,y-25*s,x+22*s,y+16*s),'#f0ca94','#a77f57')\n    arc((x-4*s,y-22*s,x+19*s,y+13*s),65,303,'#b4745c',1.5)\nfor x,c,lip in [(225,'#b97253','#efd0a0'),(272,'#d5b37e','#f1d4a1'),(320,'#82927b','#c4c4a0')]:\n    path((x+25,303),(x+48,295,x+49,325,x+29,328),stroke='#815e4c',w=6)\n    path((x+25,303),(x+46,295,x+47,324,x+29,327),stroke=c,w=4)\n    path((x,298),(x+1,310,x+1,326,x+6,335),(x+10,341,x+25,341,x+29,