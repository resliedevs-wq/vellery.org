{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/draw_morning_kitchen.py <<'PY'\nfrom PIL import Image, ImageDraw, ImageFilter, ImageChops\nfrom random import Random\nfrom math import sin, cos, pi, hypot\nfrom pathlib import Path\n\nW,H,S=1200,900,2\nim=Image.new('RGB',(W*S,H*S))\nd=ImageDraw.Draw(im)\nrng=Random(225)\ndef co(v): return round(v*S)\ndef pts(p): return [(co(x),co(y)) for x,y in p]\ndef box(b): return tuple(co(v) for v in b)\ndef rgb(c):\n    if isinstance(c, tuple): return c\n    c=c.lstrip('#')\n    return tuple(int(c[n:n+2],16) for n in (0,2,4))\ndef mix(a,b,t): return tuple(round(x+(y-x)*t) for x,y in zip(rgb(a),rgb(b)))\ndef rect(b,c): d.rectangle(box(b),fill=c)\ndef ell(b,c,stroke=None,w=1): d.ellipse(box(b),fill=c,outline=stroke,width=co(w))\ndef rr(b,r,c,stroke=None,w=1): d.rounded_rectangle(box(b),radius=co(r),fill=c,outline=stroke,width=co(w))\ndef line(p,c,w=1):\n    d.line(pts(p),fill=c,width=max(1,co(w)),joint='curve')\ndef poly(p,c,stroke=None,w=1):\n    d.polygon(pts(p),fill=c)\n    if stroke: line(p+[p[0]],stroke,w)\ndef path(start,*segments,fill=None,stroke=None,w=1):\n    p=[start]\n    for sg in segments:\n        if len(sg)==2:\n            p.append(sg)\n        else:\n            x,y=p[-1]\n            a,b,c,e,f,g=sg\n            for i in range(1,21):\n                t=i/20; z=1-t\n                p.append((z**3*x+3*z*z*t*a+3*z*t*t*c+t**3*f,z**3*y+3*z*z*t*b+3*z*t*t*e+t**3*g))\n    if fill: poly(p,fill)\n    if stroke: line(p,stroke,w)\n    return p\ndef grad(b,top,bottom):\n    x,y,xx,yy=b\n    for j in range(co(y),co(yy)+1):\n        d.line((co(x),j,co(xx),j),fill=mix(top,bottom,(j-co(y))/max(1,co(yy-y))))\ndef arc(b,a,z,c,w=1): d.arc(box(b),a,z,fill=c,width=co(w))\ndef leaf(x,y,angle,L,B,c,vein=None):\n    a=angle*pi/180; u=(cos(a),sin(a)); v=(-u[1],u[0])\n    def q(s,t): return x+s*u[0]+t*v[0], y+s*u[1]+t*v[1]\n    path((x,y),(*q(L*.28,-B),*q(L*.79,-B*.62),*q(L,0)),(*q(L*.71,B*.65),*q(L*.27,B*.72),x,y),fill=c)\n    if vein: path((x,y),(*q(L*.3,-B*.09),*q(L*.58,-B*.1),*q(L*.85,0)),stroke=vein,w=.7)\ndef shade(shapes,blur):\n    global d\n    lay=Image.new('RGBA',im.size)\n    d=ImageDraw.Draw(lay)\n    shapes()\n    d=ImageDraw.Draw(im)\n    if blur: lay=lay.filter(ImageFilter.GaussianBlur(co(blur)))\n    im.paste(lay,(0,0),lay)\n\n# Plaster, a worn backsplash, and a warm corner.\ngrad((0,0,W,561),'#c99c78','#eed2a0')\nshade(lambda:ell((390,-185,1420,710),(255,224,163,135)),90)\nshade(lambda:poly([(0,0),(136,0),(226,530),(0,690)],(109,70,57,65)),36)\npoly([(0,0),(53,0),(53,514),(0,565)],'#b28b6d')\nline([(53,0),(53,511)],'#e7b790',2)\nfor _ in range(3200):\n    x=rng.uniform(56,W); y=rng.uniform(0,531)\n    if rng.random()<.64:\n        c=im.getpixel((co(x),co(y)))\n        line([(x,y),(x+rng.uniform(.2,2.5),y+.2)],mix(c,'#8a604e',rng.uniform(.04,.14)),.5)\ngrad((53,404,1200,551),'#ddc194','#e7cb9f')\nfor row,y in enumerate(range(405,552,29)):\n    line([(53,y),(1200,y)],'#b79b78',1)\n    line([(53,y+1.7),(1200,y+1.7)],'#f1d7aa',1)\n    for x in range(58-((row%2)*43),1200,86):\n        if x>=53:\n            line([(x,y+2),(x,y+27)],'#bf9f7d',.9)\nline([(53,403),(1200,403)],'#f7ddab',2)\n\n# Framing and the view of a little orchard.\nshade(lambda:rr((589,108,1099,538),18,(88,61,46,87)),15)\nrr((583,87,1093,514),9,'#8e674c')\nrr((590,90,1089,509),6,'#e4b789')\nrr((607,105,1070,496),3,'#967453')\ngrad((615,115,1063,490),'#a7bfaf','#f8dba1')\nshade(lambda:ell((808,150,1014,346),(255,228,164,210)),33)\nell((871,192,956,277),'#ffe7aa')\nfor yy in range(283,319,6):\n    path((727,yy),(782,yy-4,824,yy+1,862,yy-1),stroke='#ead5a7',w=1)\npath((615,331),(697,288,745,287,804,311),(869,335,911,315,954,293),(1000,278,1031,287,1063,305),(1063,490),(615,490),fill='#a8ad85')\npath((615,352),(693,326,745,296,800,329),(854,361,903,334,953,322),(997,311,1020,327,1063,336),(1063,490),(615,490),fill='#879676')\npath((615,385),(718,325,806,382,855,37