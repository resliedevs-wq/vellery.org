{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/draw_morning_kitchen.py <<'PY'\nfrom PIL import Image, ImageDraw, ImageFilter, ImageChops\nfrom random import Random\nfrom math import sin, cos, pi, hypot\nfrom pathlib import Path\n\nW,H,S=1200,900,2\nim=Image.new('RGB',(W*S,H*S))\nd=ImageDraw.Draw(im)\nrng=Random(225)\ndef co(v): return round(v*S)\ndef pts(p): return [(co(x),co(y)) for x,y in p]\ndef box(b): return tuple(co(v) for v in b)\ndef rgb(c):\n    if isinstance(c, tuple): return c\n    c=c.lstrip('#')\n    return tuple(int(c[n:n+2],16) for n in (0,2,4))\ndef mix(a,b,t): return tuple(round(x+(y-x)*t) for x,y in zip(rgb(a),rgb(b)))\ndef rect(b,c): d.rectangle(box(b),fill=c)\ndef ell(b,c,stroke=None,w=1): d.ellipse(box(b),fill=c,outline=stroke,width=co(w))\ndef rr(b,r,c,stroke=None,w=1): d.rounded_rectangle(box(b),radius=co(r),fill=c,outline=stroke,width=co(w))\ndef line(p,c,w=1):\n    d.line(pts(p),fill=c,width=max(1,co(w)),joint='curve')\ndef poly(p,c,stroke=None,w=1):\n    d.polygon(pts(p),fill=c)\n    if stroke: line(p+[p[0]],stroke,w)\ndef path(start,*segments,fill=None,stroke=None,w=1):\n    p=[start]\n    for sg in segments:\n        if len(sg)==2:\n            p.append(sg)\n        else:\n            x,y=p[-1]\n            a,b,c,e,f,g=sg\n            for i in range(1,21):\n                t=i/20; z=1-t\n                p.append((z**3*x+3*z*z*t*a+3*z*t*t*c+t**3*f,z**3*y+3*z*z*t*b+3*z*t*t*e+t**3*g))\n    if fill: poly(p,fill)\n    if stroke: line(p,stroke,w)\n    return p\ndef grad(b,top,bottom):\n    x,y,xx,yy=b\n    for j in range(co(y),co(yy)+1):\n        d.line((co(x),j,co(xx),j),fill=mix(top,bottom,(j-co(y))/max(1,co(yy-y))))\ndef arc(b,a,z,c,w=1): d.arc(box(b),a,z,fill=c,width=co(w))\ndef leaf(x,y,angle,L,B,c,vein=None):\n    a=angle*pi/180; u=(cos(a),sin(a)); v=(-u[1],u[0])\n    def q(s,t): return x+s*u[0]+t*v[0], y+s*u[1]+t*v[1]\n    path((x,y),(*q(L*.28,-B),*q(L*.79,-B*.62),*q(L,0)),(*q(L*.71,B*.65),*q(L*.27,B*.72),x,y),fill=c)\n    if vein: path((x,y),(*q(L*.3,-B*.09),*q(L*.58,-B*.1),*q(L*.85,0)),stroke=vein,w=.7)\ndef shade(shapes,blur):\n    global d\n    lay=Image.new('RGBA',im.size)\n    d=ImageDraw.Draw(lay)\n    shapes()\n    d=ImageDraw.Draw(im)\n    if blur: lay=lay.filter(ImageFilter.GaussianBlur(co(blur)))\n    im.paste(lay,(0,0),lay)\n\n# Plaster, a worn backsplash, and a warm corner.\ngrad((0,0,W,561),'#c99c78','#eed2a0')\nshade(lambda:ell((390,-185,1420,710),(255,224,163,135)),90)\nshade(lambda:poly([(0,0),(136,0),(226,530),(0,690)],(109,70,57,65)),36)\npoly([(0,0),(53,0),(53,514),(0,565)],'#b28b6d')\nline([(53,0),(53,511)],'#e7b790',2)\nfor _ in range(3200):\n    x=rng.uniform(56,W); y=rng.uniform(0,531)\n    if rng.random()<.64:\n        c=im.getpixel((co(x),co(y)))\n        line([(x,y),(x+rng.uniform(.2,2.5),y+.2)],mix(c,'#8a604e',rng.uniform(.04,.14)),.5)\ngrad((53,404,1200,551),'#ddc194','#e7cb9f')\nfor row,y in enumerate(range(405,552,29)):\n    line([(53,y),(1200,y)],'#b79b78',1)\n    line([(53,y+1.7),(1200,y+1.7)],'#f1d7aa',1)\n    for x in range(58-((row%2)*43),1200,86):\n        if x>=53:\n            line([(x,y+2),(x,y+27)],'#bf9f7d',.9)\nline([(53,403),(1200,403)],'#f7ddab',2)\n\n# Framing and the view of a little orchard.\nshade(lambda:rr((589,108,1099,538),18,(88,61,46,87)),15)\nrr((583,87,1093,514),9,'#8e674c')\nrr((590,90,1089,509),6,'#e4b789')\nrr((607,105,1070,496),3,'#967453')\ngrad((615,115,1063,490),'#a7bfaf','#f8dba1')\nshade(lambda:ell((808,150,1014,346),(255,228,164,210)),33)\nell((871,192,956,277),'#ffe7aa')\nfor yy in range(283,319,6):\n    path((727,yy),(782,yy-4,824,yy+1,862,yy-1),stroke='#ead5a7',w=1)\npath((615,331),(697,288,745,287,804,311),(869,335,911,315,954,293),(1000,278,1031,287,1063,305),(1063,490),(615,490),fill='#a8ad85')\npath((615,352),(693,326,745,296,800,329),(854,361,903,334,953,322),(997,311,1020,327,1063,336),(1063,490),(615,490),fill='#879676')\npath((615,385),(718,325,806,382,855,372),(943,351,981,335,1063,367),(1063,490),(615,490),fill='#9da174')\npath((615,404),(705,367,756,410,825,407),(906,400,984,355,1063,386),(1063,490),(615,490),fill='#7f8a60')\npath((615,444),(718,394,800,452,866,437),(949,418,996,397,1063,412),(1063,490),(615,490),fill='#697b56')\npath((615,462),(738,446,752,472,818,466),(885,465,952,438,1063,431),(1063,490),(615,490),fill='#858858')\npath((912,490),(894,473,899,460,911,449),(937,427,990,415,1037,411),(980,424,950,445,941,457),(931,472,952,483,963,490),fill='#c6b27e')\nfor x,y,s in [(720,375,.65),(754,381,.56),(803,397,.86),(1006,386,.8),(1034,379,.56),(670,412,1.02),(696,404,.74),(645,430,1.17),(966,411,.56)]:\n    line([(x,y),(x+2*s,y-22*s)],'#5d654a',2*s)\n    for ox,oy,r in [(-7,-16,8),(6,-19,8),(0,-26,9),(3,-13,9)]:\n        ell((x+(ox-r)*s,y+(oy-r)*s,x+(ox+r)*s,y+(oy+r)*s),rng.choice(['#748154','#65794f','#8d9263']))\nfor _ in range(420):\n    x=rng.uniform(617,1060); y=rng.uniform(350,489)\n    if rng.random()<.72:\n        c=im.getpixel((co(x),co(y)))\n        line([(x,y),(x+rng.uniform(1,5),y-rng.uniform(0,1.1))],mix(c,'#ead6a0',rng.uniform(.12,.32)),.7)\nfor x,y in [(754,223),(772,215),(785,230)]:\n    path((x-6,y),(x-3,y-2,x-1,y-2,x,y),(x+2,y-2,x+4,y-3,x+7,y-2),stroke='#6c8173',w=1.25)\n# Crossbars and trim.\nfor b in [(611,113,622,494),(1055,113,1067,494),(829,113,841,494),(614,295,1063,308),(614,483,1063,496)]:\n    rect(b,'#a7825c')\nfor b in [(614,113,619,494),(1058,113,1065,494),(832,113,838,494),(617,296,1060,302),(617,484,1060,491)]:\n    rect(b,'#f0d09d')\nrect((826,472,841,483),'#ad8c63')\nrr((824,468,845,475),3,'#d1aa71')\nline([(597,102),(597,493)],'#f2c99b',2)\nline([(1081,103),(1081,496)],'#ac7c57',2)\npoly([(578,496),(1096,496),(1109,509),(568,509)],'#f3c892')\nrr((567,507,1110,520),3,'#b1835b')\nline([(572,509),(1103,509)],'#f7d4a3',2)\n\n# Gathered linen curtains with sewn edges.\nline([(575,91),(1102,91)],'#715747',5)\nell((565,85,579,98),'#8b634a')\nell((1097,84,1112,97),'#8b634a')\nleft=path((591,87),(611,93,640,85,664,90),(650,150,657,219,645,272),(633,316,645,353,663,402),(644,414,617,401,592,409),(603,344,596,323,587,300),(580,232,591,164,591,87),fill='#ebc78e',stroke='#b68a64',w=1.6)\nfor p,c,w in [\n    ((598,94,605,171,587,233,603,292,610,321,610,363,602,403),'#f6dca9',6),\n    ((611,92,620,183,602,242,613,295,627,337,616,371,619,402),'#d7ac7c',4),\n    ((625,95,623,188,630,246,622,293,628,322,639,362,631,402),'#f8dbab',6),\n    ((641,94,633,162,646,246,633,288,623,320,646,359,648,402),'#d4a77a',4),\n    ((651,94,640,167,652,218,639,274,630,317,651,374,655,400),'#f2d49f',3)]:\n    path(tuple(p[:2]),tuple(p[2:8]),tuple(p[8:]),stroke=c,w=w)\npath((589,307),(602,317,629,320,642,307),stroke='#9c6550',w=4)\npath((623,317),(633,326,642,329,650,330),(640,333,632,330,623,317),(622,329,619,339,614,343),(614,327,621,324,623,317),stroke='#aa6d53',w=2)\n# The opposite curtain catches a lighter glow.\npath((1029,90),(1045,87,1071,95,1090,87),(1086,158,1101,248,1088,301),(1078,334,1086,367,1096,403),(1072,397,1059,414,1028,407),(1046,364,1056,328,1045,290),(1033,246,1046,152,1029,90),fill='#f1d3a1',stroke='#bb9066',w=1.5)\nfor a,c,w in [(1039,'#d8b184',4),(1048,'#f9e0b1',5),(1057,'#dbb78a',4),(1067,'#f9e0b1',6),(1079,'#d8b285',4)]:\n    path((a,95),(a+15,174,a-3,254,a+5,297),(a+10,332,a-3,365,a-3,403),stroke=c,w=w)\npath((1048,311),(1061,319,1082,315,1090,305),stroke='#aa6d53',w=4)\npath((1068,317),(1066,332,1056,334,1052,337),(1056,324,1060,321,1068,317),(1077,324,1081,333,1083,339),(1072,333,1072,326,1068,317),stroke='#aa6d53',w=2)\nfor x in [597,616,636,654,1037,1053,1070,1085]:\n    arc((x-4,82,x+4,97),175,375,'#987457',1.3)\n\n# Lower cabinets, a butcher-block worktop, and the inset range.\nrect((53,552,1200,814),'#53624c')\ngrad((56,564,1200,783),'#75826a','#4c5c4a')\nfor a,b in [(54,227),(506,659),(666,823),(830,982),(989,1166),(1173,1270)]:\n    rr((a,573,b,797),3,'#67765f','#495745',2)\n    rr((a+10,589,b-10,790),3,'#748168','#53634f',2)\n    rr((a+1