        path(f'M0 -21Q{cx} {cy} {ex} {ey}',stroke='#526d53',sw=2.2)\n        for j in [1,2]:\n            t=j*.27+.20\n            lx=(1-t)**2*0+2*(1-t)*t*cx+t*t*ex\n            ly=(1-t)**2*-21+2*(1-t)*t*cy+t*t*ey\n            for side in [-1,1]:\n                tx=lx+(10+j*3)*side; ty=ly-9-j\n                color=['#668359','#788d5d','#466d53','#9ba16b'][(i+j+(side>0))%4]\n                path(f'M{lx:.2f} {ly:.2f}Q{lx+3*side:.2f} {ty-4:.2f} {tx:.2f} {ty:.2f}Q{tx+1*side:.2f} {ly-2:.2f} {lx:.2f} {ly:.2f}Z',color)\n                path(f'M{lx:.2f} {ly:.2f}l{(tx-lx)*.74:.2f} {(ty-ly)*.72:.2f}',stroke='#c2bd7a',sw=.6,op=.63)\n        ell(ex,ey,4.5,9.5,['#8c9e63','#587850','#94a06a'][i%3],rot=(ex+2)*1.1)\n    edge,fill,rim,highlight = ('#94614d','#bd7c5e','#d79b72','#e2a27b') if style=='terra' else ('#6e7861','#9da384','#c0bd98','#d8c8a1')\n    path('M-21 -27H21L16 -2Q0 4-16-2Z',fill,edge,1.4)\n    path('M-17-23L-13-4Q-6-1-1-2L-5-23Z',highlight,op=.67)\n    rect(-23,-29,46,7,rim,2,edge,1.2)\n    path('M-17-27H18',stroke=highlight,sw=1.3)\n    end()\nplant(365,447,.91)\nplant(1083,213,.99,'sage')\n# right upper shelf pottery and trailing vine\ndef jar(x,y,w,h,c,band=True):\n    group(f'translate({x} {y}) scale({w/38} {h/57})')\n    ell(0,1,22,3,'#795b49',.22)\n    path('M-14 -49H14V-42Q19-40 19-32V-5Q19 0 13 0H-13Q-19 0-19-5V-32Q-19-40-14-42Z',c,'#937a61',1.4)\n    path('M-14 -39Q-16-36-16-32v25',stroke='#fff0c5',sw=2,op=.62)\n    ell(0,-51,17,4,'#ae8059',stroke='#88664d',sw=1.2)\n    path('M-15-51q15 3 30 0',stroke='#e5ac75',sw=1.4)\n    if band:\n        rect(-15,-27,30,15,'#eee0ba',1,'#a69577',.8)\n        path('M-8-20h16m-11 3h6',stroke='#9b8e6c',sw=.9)\n    end()\njar(844,213,36,52,'#bcc0a0')\njar(886,213,38,65,'#e2bd87')\njar(931,213,39,57,'#c58b71')\n# stacked bowls on upper shelf\nfor i in range(3):\n    y=210-i*8\n    path(f'M959 {y-6}h75q-5 10-15 10h-44q-10-2-16-10Z',['#e5c69b','#bb826a','#e7d4af'][i],'#9e7056',1.1)\n    path(f'M961 {y-5}h71',stroke='#f6dfb3',