{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/finish-vellery-kitchen.py <<'PY'\nfrom pathlib import Path\nfrom random import Random\nfrom PIL import Image, ImageFilter, ImageMath\n\nrng = Random(610)\nimage = Image.open('/tmp/vellery-kitchen-flat.png').convert('RGB')\nw, h = image.size\n\ndef texture(size, spread, blur=0):\n    field = Image.new('L', size)\n    field.putdata([max(0, min(255, round(rng.gauss(128, spread)))) for _ in range(size[0]*size[1])])\n    field = field.resize(image.size, Image.Resampling.BICUBIC) if size \"'!= image.size else field\n    return field.filter(ImageFilter.GaussianBlur(blur)) if blur else field\n\ngrain = texture((w, h), 3.8)\npaper = texture((w//4, h//4), 2.4)\nmottle = texture((w//41, h//41), 2.2, 5)\nbands = [ImageMath.eval('\"'convert(c + (g-128) + (p-128) + (m-128), \\\"L\\\")',\n                       c=c, g=grain, p=paper, m=mottle) for c in image.split()]\nfinished = Image.merge('RGB', bands)\nfinished.save('cozy-morning-kitchen.png', optimize=True)\nfinished.resize((1000,708),Image.Resampling.LANCZOS).save('/tmp/vellery-kitchen-preview.png')\nPY\npython3 /tmp/finish-vellery-kitchen.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
