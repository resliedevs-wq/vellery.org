{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/cozy_kitchen_draw.py <<'PY'\nfrom PIL import Image, ImageDraw, ImageFilter, ImageChops\nfrom contextlib import contextmanager\nimport math, random, re\n\nW, H, S = 1480, 1080, 2\nrandom.seed(27)\nim = Image.new('RGB', (W*S,H*S))\nd = ImageDraw.Draw(im)\n\ndef color(c):\n    return '#'+c if isinstance(c,str) and not c.startswith('#') else c\n\ndef xy(pts):\n    return [(round(a*S),round(b*S)) for a,b in pts]\n\ndef box(x1,y1,x2,y2):\n    return tuple(round(a*S) for a in (x1,y1,x2,y2))\n\ndef ln(pts, c, w=1):\n    d.line(xy(pts), fill=color(c), width=max(1,round(w*S)), joint='curve')\n\ndef poly(pts,c):\n    d.polygon(xy(pts),fill=color(c))\n\ndef rect(x1,y1,x2,y2,c):\n    d.rectangle(box(x1,y1,x2,y2),fill=color(c))\n\ndef oval(x1,y1,x2,y2,c,outline=None,w=1):\n    d.ellipse(box(x1,y1,x2,y2),fill=color(c),outline=color(outline),width=round(w*S))\n\ndef linespec(spec):\n    t=re.findall(r'[MLHVCQZ]|-?\\\\d+(?:\\\\.\\\\d+)?',spec)\n    pts=[]; p=(0,0); i=0\n    while i<len(t):\n        op=t[i]; i+=1\n        if op=='Z':\n            pts.append(pts[0]); continue\n        n={'M':2,'L':2,'H':1,'V':1,'C':6,'Q':4}[op]\n        a=list(map(float,t[i:i+n])); i+=n\n        if op in 'ML':\n            p=tuple(a); pts.append(p)\n        elif op=='H':\n            p=(a[0],p[1]); pts.append(p)\n        elif op=='V':\n            p=(p[0],a[0]); pts.append(p)\n        else:\n            step=max(8, min(64, round(sum(abs(j-k) for j,k in zip(p,a[-2:]))/5)))\n            x,y=p; u,v=a[:2]\n            for j in range(1,step+1):\n                s=j/step; r=1-s\n                if op=='Q':\n                    pts.append((r*r*x+2*r*s*u+s*s*a[2],r*r*y+2*r*s*v+s*s*a[3]))\n                else:\n                    pts.append((r**3*x+3*r*r*s*u+3*r*s*s*a[2]+s**3*a[4],r**3*y+3*r*r*s*v+3*r*s*s*a[3]+s**3*a[5]))\n            p=tuple(a[-2:])\n    return pts\n\ndef path(spec,c=None,stroke=None,w=1):\n    pts=linespec(spec)\n    if c: poly(pts,c)\n    if stroke: ln(pts,stroke,w)\n\n@contextmanager\ndef clip(spec):\n    global d\n    prior=im.copy()\n    yield\n    m=Image.new('L',im.size)\n    ImageDraw.Draw(m).polygon(xy(linespec(spec)), fill=255)\n    im.paste(prior,(0,0),ImageChops.invert(m))\n    d=ImageDraw.Draw(im)\n\ndef rgb(h):\n    return tuple(bytes.fromhex(h))\n\ndef gradient(y1,y2,left,right):\n    a,b=rgb(left),rgb(right)\n    for y in range(y1*S,y2*S+1):\n        t=(y-y1*S)/max(1,(y2-y1)*S)\n        d.line((0,y,W*S,y),fill=tuple(round(u+(v-u)*t) for u,v in zip(a,b)))\n\ndef leaf(x,y,angle,length,width,c,vein=None):\n    a=math.radians(angle); ux,uy=math.cos(a),math.sin(a); vx,vy=-uy,ux\n    def at(t,u): return f'{x+length*t*ux+width*u*vx:.2f} {y+length*t*uy+width*u*vy:.2f}'\n    path(f'M {at(0,0)} C {at(.24,-.8)} {at(.69,-.51)} {at(1,0)} C {at(.73,.17)} {at(.31,.67)} {at(0,0)} Z',c)\n    if vein: path(f'M {at(.03,0)} Q {at(.46,-.07)} {at(.86,0)}',stroke=vein,w=.95)\n\ndef specks(count,bounds,palette,scale=(.4,1.8)):\n    x0,y0,x1,y1=bounds\n    for _ in range(count):\n        x=random.uniform(x0,x1); y=random.uniform(y0,y1); r=random.uniform(*scale)\n        oval(x,y,x+r*1.5,y+r,random.choice(palette))\n\ndef glint(x,y,c,s=1):\n    path(f'M {x-8*s} {y} Q {x} {y-s} {x} {y-10*s} Q {x+s} {y} {x+8*s} {y} Q {x} {y+s} {x} {y+10*s} Q {x-s} {y} {x-8*s} Z',c)\n\nink='533e36'\n# Warm plaster and the wide patch of daylight from the window.\ngradient(0,H,'e7b88b','f4d9a9')\npath('M 643 218 L 1480 617 V 779 H 979 L 638 545 Z','f1ca91')\npath('M 684 303 L 1480 681 V 755 L 690 419 Z','f6d4a0')\npath('M 0 0 H 1480 V 28 H 0 Z','e4b083')\npath('M 0 34 H 1480',stroke='efc398',w=2)\nspecks(1700,(0,0,1480,744),['edc397','f1cca1','e3b88d','f4d0a5'],(.45,2.0))\n# Tile backsplash.\ngradient_shape='M 0 569 H 1480 V 751 H 0 Z'\nwith clip(gradient_shape):\n    gradient(569,751,'e7b993','dca981')\n    path('M 464 567 H 966 L 1302 753 H 742 Z','f0c69a')\n    path('M 940 572 H 1039 L 1381 753 H 1292 Z','efc89c')\n    for y in (569,630,689,749):\n        ln([(0,y),(1480,y)],'cb966f',2)\n        ln([(0,y+3),(1480,y+3)],'f4d1a4',1.5)\n    for row,y in enumerate((570,631,690)):\n        for x in range(-40+row*57,1480,117):\n            ln([(x,y),(x,y+58)],'ce9b76',2)\n            ln([(x+2,y+1),(x+2,y+56)],'f1c79a',1)\n    specks(600,(0,570,1480,750),['edc199','dba882','e4b28b'],(.5,1.8))\n# Arched casement.\npath('M 132 652 V 333 C 132 174 249 88 413 88 C 576 88 703 173 703 333 V 652 Z','b77a59')\npath('M 117 639 V 322 C 117 171 245 79 407 79 C 573 79 692 177 692 321 V 639 Z','f8deb0','a86f53',2)\npath('M 133 632 V 324 C 133 181 251 96 407 96 C 563 96 676 183 676 327 V 632 Z','ca9167','fce9bc',3)\nglass='M 154 616 V 331 C 154 196 262 114 407 114 C 552 114 654 197 654 332 V 616 Z'\nwith clip(glass):\n    gradient(112,622,'edaa83','ffe2a6')\n    oval(229,217,393,381,'f2bb88')\n    oval(243,231,379,367,'f8c990')\n    oval(258,246,364,352,'ffdda0')\n    oval(269,257,353,341,'fff0b8')\n    for q in [(468,233,66),(506,269,97),(204,348,93),(529,347,104),(358,317,51),(149,255,55)]:\n        x,y,l=q\n        path(f'M {x} {y+9} Q {x+21} {y-3} {x+39} {y+2} Q {x+65} {y} {x+l} {y+8} Q {x+40} {y+12} {x} {y+9} Z','f8cca0')\n    path('M 124 460 C 229 398 293 381 353 392 C 417 402 435 423 503 397 C 577 366 615 378 685 417 V 620 H 114 Z','d99677')\n    path('M 114 477 C 215 447 257 413 317 419 C 372 417 417 450 475 456 C 562 469 611 411 704 423 V 627 H 111 Z','bc8d70')\n    path('M 121 506 C 206 485 254 461 316 464 C 379 465 434 498 487 483 C 571 459 620 451 688 481 L 677 637 H 120 Z','9b9872')\n    path('M 132 557 C 252 485 328 481 410 520 C 505 564 567 528 675 519 V 640 H 124 Z','788469')\n    path('M 251 573 C 347 536 423 535 489 553 Q 579 579 663 542 V 645 H 219 Z','a7aa78')\n    path('M 347 625 C 387 592 421 569 476 558 Q 502 552 501 546 Q 514 551 492 563 C 447 580 429 606 423 625 Z','e4bc85')\n    path('M 134 581 C 220 544 283 558 372 589 Q 452 6