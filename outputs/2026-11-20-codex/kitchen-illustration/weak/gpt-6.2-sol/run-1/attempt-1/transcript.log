n    ln([(a+6,y+4),(b-7,y+4)],'efbc83',2)\n    path(f'M {a+31} {y+11} Q {a+125} {y+7} {a+213} {y+11}',stroke='c28b60',1.3)\n    path(f'M {b-247} {y+11} Q {b-160} {y+7} {b-52} {y+10}',stroke='87573e',1)\n# Jar silhouettes on the top shelf.\ndef jar(x,y,w,h,base,shade,hi,contents,style=0):\n    b=y+h\n    outline=f'M {x+5} {y+22} Q {x+7} {y+16} {x+18} {y+12} H {x+w-18} Q {x+w-7} {y+16} {x+w-4} {y+26} L {x+w-3} {b-11} Q {x+w-4} {b-3} {x+w-14} {b} H {x+14} Q {x+3} {b-2} {x+3} {b-13} Z'\n    path(outline,base,'985f49',1.5)\n    with clip(outline):\n        path(f'M {x+4} {y+h*.54} Q {x+w*.5} {y+h*.46} {x+w} {y+h*.53} V {b+1} H {x} Z',contents)\n        specks(160,(x+4,y+h*.55,x+w-4,b-4),[hi,shade,contents],(.55,2.4))\n        path(f'M {x+w-20} {y+17} Q {x+w-7} {y+79} {x+w-15} {b+5} H {x+w} V {y+13} Z',shade)\n    path(f'M {x+13} {y+38} Q {x+10} {y+h*.53} {x+12} {b-16}',stroke=hi,w=3)\n    path(f'M {x+19} {y+31} Q {x+15} {y+30} {x+13} {y+37}',stroke=hi,w=2)\n    path(f'M {x+12} {y+14} V {y+4} Q {x+12} {y} {x+22} {y} H {x+w-21} Q {x+w-11} {y} {x+w-11} {y+4} V {y+14} Q {x+w*.5} {y+22} {x+12} {y+14} Z','986043','8a563e',1.5)\n    ln([(x+19,y+4),(x+w-17,y+4)],'c58e5c',2)\n    if style:\n        path(f'M {x+21} {y+h*.57} H {x+w-19} V {y+h*.78} Q {x+w*.5} {y+h*.82} {x+21} {y+h*.78} Z','f0d0a1')\n        leaf(x+w/2-7,y+h*.73,-34,15,5,'a86d51')\n        leaf(x+w/2-1,y+h*.71,-130,10,3,'bd8865')\n\noval(831,260,1013,274,'8f5c42')\njar(839,161,78,108,'dca175','ba8057','f5ce98','a66a4a',1)\njar(924,183,69,86,'e3be8c','bb895f','f4d0a1','ca995f')\n# Oil bottle and hanging plant.\noval(1030,258,1129,274,'8f5c42')\npath('M 1050 268 Q 1035 265 1036 251 V 179 Q 1037 159 1058 151 L 1060 125 H 1081 L 1084 151 Q 1104 159 1105 180 V 252 Q 1105 265 1095 269 Z','798364','6e664b',2)\npath('M 1041 199 Q 1062 191 1104 197 V 253 Q 1102 266 1095 267 H 1052 Q 1041 265 1041 251 Z','93946a')\npath('M 1091 160 Q 1103 166 1103 182 V 257 Q 1100 267 1091 267 Z','677457')\npath('M 1047 217 H 1092 V 245 Q 106