{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom PIL import Image\nfrom pathlib import Path\nPath('/tmp/night-sky-rgb').write_bytes(Image.open('night-sky.png').tobytes())\nPY\ncat > /tmp/night-sky-scan.cpp <<'CPP'\n#include <algorithm>\n#include <array>\n#include <cctype>\n#include <fstream>\n#include <iostream>\n#include <iterator>\n#include <string>\n#include <vector>\nusing namespace std;\nint main() {\n ifstream input(\\\"/tmp/night-sky-rgb\\\",ios::binary);\n vector<unsigned char> raw((istreambuf_iterator<char>(input)),{});\n vector<string> chans={\\\"0\\\",\\\"1\\\",\\\"2\\\",\\\"01\\\",\\\"02\\\",\\\"10\\\",\\\"12\\\",\\\"20\\\",\\\"21\\\",\\\"012\\\",\\\"021\\\",\\\"102\\\",\\\"120\\\",\\\"201\\\",\\\"210\\\"};\n for(int axis=0;axis<=1;axis++) for(int fx=0;fx<=1;fx++) for(int fy=0;fy<=1;fy++)\n for(auto &cs:chans) for(int n=1;n<=2;n++) for(int bit=0;bit+n<=3;bit++)\n for(int e=0;e<2;e++) {\n  vector<unsigned char> packed;\n  packed.reserve(raw.size()*n/8);\n  unsigned accum=0,nb=0;\n  int w=axis?500:800,h=axis?800:500;\n  for(int j=0;j<h;j++) for(int i=0;i<w;i++) {\n    int x=axis?j:i,y=axis?i:j;\n    if(fx) x=799-x;\n    if(fy) y=499-y;\n    for(char c:cs) for(int k=0;k<n;k++) {\n      unsigned b=(raw[3*(800*y+x)+c-'0']>>(bit+(e?n-1-k:k)))&1;\n      accum=(accum<<1)|b;\n      if(++nb==8){packed.push_back(accum);nb=0;}\n    }\n  }\n  for(int shift=0;shift<8;shift++) for(int rev=0;rev<2;rev++) {\n   string s;\n   int alpha=0, spaces=0;\n   for(size_t i=0;i+1<packed.size();i++) {\n     unsigned char a=(packed[i]<<shift)|(packed[i+1]>>(8-shift));\n     if(rev){a=(a>>4)|(a<<4);a=((a&0xcc)>>2)|((a&0x33)<<2);a=((a&0xaa)>>1)|((a&0x55)<<1);}\n     if(a>=32&&a<=126) {\n       s+=a;\n       alpha+=isalpha(a)\"'!=0;\n       spaces+=a=='\"' ';\n     } else {\n       if((s.size()>=12&&alpha>=8&&spaces>=1&&s.find_first_of(\\\"aeiouAEIOU\\\")\"'!=string::npos)||\n          (s.find(\"flag{\")!=string::npos||s.find(\"FLAG{\")!=string::npos||s.find(\"CTF{\")!=string::npos)||\n          (s.size()>=16&&alpha>=12&&s.find_first_of(\"aeiouAEIOU\")!=string::npos)) {\n         string t=s;\n         sort(t.begin(),t.end());\n         if(unique(t.begin(),t.end())-t.begin()>=8)\n           cout<<s.size()<<\" \"<<alpha<<\" \"<<axis<<fx<<fy<<\" \"<<cs<<\" \"<<n<<\" \"<<bit<<\" \"<<e<<shift<<rev<<\" \"<<i-s.size()<<\" \"<<s.substr(0,250)<<\"'\"\\\\n\\\";\n       }\n       s.clear();alpha=spaces=0;\n     }\n   }\n  }\n }\n}\nCPP\ng++ -O3 /tmp/night-sky-scan.cpp -o /tmp/night-sky-scan && /tmp/night-sky-scan > /tmp/night-sky-scan.txt\nwc -l /tmp/night-sky-scan.txt\nsort -nr /tmp/night-sky-scan.txt | head -70\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
