{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nfrom PIL import Image\nfrom collections import Counter\nimport struct,zlib\nb=Path('night-sky.png').read_bytes(); i=8; d=b'';z=zlib.decompressobj(); prev=0;r=b''\nwhile i+12<=len(b):\n n,t=struct.unpack_from('>I4s',b,i)\n if t==b'IDAT':\n  for j in range(i+8,i+8+n):\n   if j in (78352,78391,78788,78843,100245,100270): print(j,len(r),divmod(len(r),2401))\n   r+=z.decompress(b[j:j+1])\n i+=n+12\nim=Image.open('night-sky.png')\nfor i, p in enumerate(im.split()):\n p.point([255*(v&1) for v in range(256)]).save('/tmp/night-sky-lsb'+str(i)+'.png')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom PIL import Image\nfrom collections import defaultdict\nim=Image.open('night-sky.png')\np=im.load()\npixels={(x,y) for x in range(im.width) for y in range(150) if min(p[x,y])>150}\nclusters=[]\nwhile pixels:\n xy=pixels.pop(); adj=[xy]; c=[xy]\n for x,y in adj:\n  for q in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):\n   if q in pixels:\n    pixels.remove(q); adj.append(q); c.append(q)\n x=sum(x for x,y in c)/len(c); y=sum(y for x,y in c)/len(c)\n clusters.append((round(x,1),round(y,1),len(c),p[round(x),round(y)],min(x for x,y in c),max(x for x,y in c)))\nfor c in sorted(clusters): print(c)\nPY\nwc -l /tmp/night-sky-scan.txt\nsort -nr /tmp/night-sky-scan.txt | head -30\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
