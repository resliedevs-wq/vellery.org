{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom PIL import Image\nim = Image.open(\\\"night-sky.png\\\")\npixels = {(x, y) for y in range(150) for x in range(im.width)\n          if min(im.getpixel((x, y))) > 150}\nstars = []\nwhile pixels:\n    component = [pixels.pop()]\n    for x, y in component:\n        for p in ((x - 1, y), (x + 1, y), (x, y - 1), (x, y + 1)):\n            if p in pixels:\n                pixels.remove(p)\n                component.append(p)\n    xs, ys = zip(*component)\n    if len(component) >= 4 and max(xs) - min(xs) < 15:\n        x = sum(xs) / len(xs)\n        y = 5 * round((sum(ys) / len(ys)) / 5)\n        stars.append((x, y))\nalphabet = \\\" ABCDEFGHIJKLMNOPQRSTUVWXYZ\\\"\nprint(len(stars), \\\"stars\\\")\nprint(\\\"\\\".join(alphabet[(y - 30) // 5] for x, y in sorted(stars)))\nprint([y for x, y in sorted(stars)])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
