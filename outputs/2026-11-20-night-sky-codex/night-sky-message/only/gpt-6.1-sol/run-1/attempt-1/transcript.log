{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/findpacked.py <<'PY'\nfrom PIL import Image\nimport re,zlib,itertools\nim=Image.open('night-sky.png')\nfor trans in [False,True]:\n a=im.transpose(Image.Transpose.TRANSPOSE) if trans else im\n raw=a.tobytes();cs=[raw[i::3] for i in range(3)]\n for cc in [(0,),(1,),(2,),(0,1,2),(2,1,0)]:\n  data=cs[cc[0]] if len(cc)==1 else bytes(x for t in zip(*(cs[c] for c in cc)) for x in t)\n  for bit in range(8):\n   st=data.translate(bytes(48+((x>>bit)&1) for x in range(256)))\n   for reverse in [False,True]:\n    ss=st[::-1] if reverse else st\n    for off in range(8):\n     n=(len(ss)-off)//8;d=int(ss[off:off+8*n],2).to_bytes(n,'big')\n     for m in re.finditer(rb'\\\\x78[\\\\x01\\\\x9c\\\\xda\\\\x5e]|\\\\x1f\\\\x8b|PK\\\\x03\\\\x04|\\\\x89PNG',d):\n      pos=m.start()\n      if m.group()[:1]\"'!=b'\"'x': print('MAGIC',trans,cc,bit,reverse,off,pos,m.group(),flush=True);continue\n      try:\n       obj=zlib.decompressobj();out=obj.decompress(d[pos:pos+32768],4096)\n       if len(out)>15:print('ZLIB',trans,cc,bit,reverse,off,pos,repr(out[:1000]),flush=True)\n      except zlib.error:pass\nPY\npython3 /tmp/findpacked.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
