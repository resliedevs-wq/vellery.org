{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport csv, io\nfrom datetime import datetime\nfrom decimal import Decimal\nfrom pathlib import Path\nsource = '''Date,Description,Category,Amount\n2026-03-02,Office chairs,Furniture,\\\"\"'$1,240.00\"\n03/04/2026,Printer paper,office supplies,48.5\nMarch 5 2026,Team lunch,Meals,$212.40\n2026-03-02,Office chairs,Furniture,\"$1,240.00\"\n3/9/26,Zoom subscription,Software,149\n2026-03-10,Taxi to client,travel,$36.20\n10/03/2026,Train tickets,Travel,\"$184.00\"\n2026-03-12,Coffee beans,Meals,27.99\nMar 13,Monitor,Equipment,$329.00\n2026-03-15,Notebooks,Office Supplies,$22.75\n03/04/2026,Printer paper,office supplies,48.5\n2026-03-18,Figma seats,software,$90.00\n18/03/2026,Client dinner,Meals,\"$318.60\"\n2026-03-20,Desk lamp,furniture,$64\n2026-03-22,Hotel (2 nights),Travel,\"$412.00\"\n3/24/2026,USB-C cables,Equipment,$31.96\n2026-03-25,Team lunch,Meals,$212.40\n2026-03-27,Pens,Office supplies,$9.80\n2026-03-30,Taxi to airport,Travel,$58.00\n2026-03-31,Notion subscription,Software,$96.00\n'\"'''\nformats = {'03/04/2026': '%m/%d/%Y', '10/03/2026': '%d/%m/%Y', '18/03/2026': '%d/%m/%Y'}\nrows, seen = [], set()\nraw = list(csv.DictReader(io.StringIO(source)))\nfor row in raw:\n    key = tuple(row.values())\n    if key in seen:\n        continue\n    seen.add(key)\n    date = row['Date']\n    if date == 'Mar 13':\n        date = '2026-03-13'\n    elif date in formats:\n        date = datetime.strptime(date, formats[date]).date().isoformat()\n    else:\n        for fmt in ['%Y-%m-%d', '%B %d %Y', '%m/%d/%y', '%m/%d/%Y']:\n            try:\n                date = datetime.strptime(date, fmt).date().isoformat()\n                break\n            except ValueError:\n                pass\n        else:\n            raise ValueError(date)\n    amount = Decimal(row['Amount'].replace('\"'$'\"', '').replace(',', ''))\n    rows.append([date, row['Description'], row['Category'].title(), f'{amount:.2f}'])\nrows.sort(key=lambda r: r[0])\npath = Path('cleaned_expenses.csv')\nwith path.open('w', newline='') as f:\n    writer = csv.writer(f)\n    writer.writerow(['Date', 'Description', 'Category', 'Amount'])\n    writer.writerows(rows)\nwith path.open(newline='') as f:\n    saved = list(csv.DictReader(f))\nassert len(saved) == 18\nassert all(datetime.strptime(r['Date'], '%Y-%m-%d').month == 3 for r in saved)\nassert len({tuple(r.values()) for r in saved}) == 18\nprint(f'Created: {path.resolve()}')\nprint(f'Rows: {len(saved)}; duplicates removed: {len(raw)-len(saved)}')\nprint(f'Total: \"'${sum(Decimal(r[\"Amount\"]) for r in saved):,.2f}'\"')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
