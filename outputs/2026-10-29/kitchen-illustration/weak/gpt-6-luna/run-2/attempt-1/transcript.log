{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"cat > cozy-kitchen-morning.svg <<'EOF'\n<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 1200 800\\\" role=\\\"img\\\" aria-labelledby=\\\"title desc\\\">\n  <title id=\\\"title\\\">Cozy kitchen in the morning</title>\n  <desc id=\\\"desc\\\">A warm illustrated kitchen with morning sunlight, a checked table, fresh flowers, and a steaming cup of coffee.</desc>\n  <defs>\n    <linearGradient id=\\\"wall\\\" x2=\\\"0\\\" y2=\\\"1\\\"><stop stop-color=\\\"#f7dfb6\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#f1c997\\\"/></linearGradient>\n    <linearGradient id=\\\"sun\\\" x2=\\\"1\\\" y2=\\\"1\\\"><stop stop-color=\\\"#fff3bd\\\" stop-opacity=\\\".85\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#ffd882\\\" stop-opacity=\\\".08\\\"/></linearGradient>\n    <linearGradient id=\\\"floor\\\" x2=\\\"0\\\" y2=\\\"1\\\"><stop stop-color=\\\"#c58b5d\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#a96845\\\"/></linearGradient>\n    <pattern id=\\\"checks\\\" width=\\\"44\\\" height=\\\"44\\\" patternUnits=\\\"userSpaceOnUse\\\"><rect width=\\\"44\\\" height=\\\"44\\\" fill=\\\"#f5e7c9\\\"/><rect width=\\\"22\\\" height=\\\"22\\\" fill=\\\"#d98268\\\"/><rect x=\\\"22\\\" y=\\\"22\\\" width=\\\"22\\\" height=\\\"22\\\" fill=\\\"#d98268\\\"/></pattern>\n    <filter id=\\\"soft\\\"><feGaussianBlur stdDeviation=\\\"18\\\"/></filter>\n  </defs>\n  <\"'!-- room -->\n  <rect width=\"1200\" height=\"570\" fill=\"url(#wall)\"/>\n  <rect y=\"570\" width=\"1200\" height=\"230\" fill=\"url(#floor)\"/>\n  <path d=\"M0 570H1200\" stroke=\"#9a6446\" stroke-width=\"8\"/>\n  <path d=\"M0 690H1200M0 770H1200M220 570L160 800M500 570L470 800M800 570L820 800M1060 570L1120 800\" stroke=\"#8f5c40\" stroke-width=\"4\" opacity=\".45\"/>\n  <!-- morning light -->\n  <path d=\"M95 68H510V420L90 555Z\" fill=\"url(#sun)\"/>\n  <ellipse cx=\"335\" cy=\"465\" rx=\"250\" ry=\"85\" fill=\"#ffe9a8\" opacity=\".28\" filter=\"url(#soft)\"/>\n  <!-- window -->\n  <rect x=\"75\" y=\"55\" width=\"440\" height=\"370\" rx=\"10\" fill=\"#fff0d5\" stroke=\"#8b5b43\" stroke-width=\"15\"/>\n  <rect x=\"96\" y=\"76\" width=\"398\" height=\"328\" fill=\"#a9d5d2\"/>\n  <path d=\"M96 300Q180 240 260 302T494 280V404H96Z\" fill=\"#88b58c\"/>\n  <path d=\"M96 345Q180 300 280 347T494 324V404H96Z\" fill=\"#739c71\"/>\n  <path d=\"M295 76V404M96 240H494\" stroke=\"#fff0d5\" stroke-width=\"16\"/>\n  <path d=\"M58 50Q295 0 532 50L513 80Q298 35 78 82Z\" fill=\"#b86e55\"/>\n  <path d=\"M75 427H515\" stroke=\"#8b5b43\" stroke-width=\"18\" stroke-linecap=\"round\"/>\n  <!-- cabinets -->\n  <rect x=\"650\" y=\"95\" width=\"470\" height=\"275\" rx=\"12\" fill=\"#789080\" stroke=\"#526c60\" stroke-width=\"8\"/>\n  <path d=\"M885 100V365\" stroke=\"#526c60\" stroke-width=\"8\"/>\n  <rect x=\"676\" y=\"120\" width=\"190\" height=\"220\" rx=\"5\" fill=\"#8ea293\" stroke=\"#d8c29c\" stroke-width=\"5\"/>\n  <rect x=\"910\" y=\"120\" width=\"183\" height=\"220\" rx=\"5\" fill=\"#8ea293\" stroke=\"#d8c29c\" stroke-width=\"5\"/>\n  <circle cx=\"842\" cy=\"235\" r=\"8\" fill=\"#e5c18a\"/><circle cx=\"930\" cy=\"235\" r=\"8\" fill=\"#e5c18a\"/>\n  <!-- shelf and jars -->\n  <path d=\"M610 390H1145\" stroke=\"#875b43\" stroke-width=\"18\" stroke-linecap=\"round\"/>\n  <rect x=\"705\" y=\"320\" width=\"58\" height=\"64\" rx=\"9\" fill=\"#f1d89e\" stroke=\"#a87556\" stroke-width=\"4\"/>\n  <path d=\"M713 320V308H755V320\" fill=\"#a87556\"/>\n  <rect x=\"780\" y=\"337\" width=\"48\" height=\"47\" rx=\"8\" fill=\"#c8a77f\" stroke=\"#a87556\" stroke-width=\"4\"/>\n  <path d=\"M785 337V327H823V337\" fill=\"#a87556\"/>\n  <rect x=\"1010\" y=\"315\" width=\"68\" height=\"69\" rx=\"9\" fill=\"#fff2da\" stroke=\"#a87556\" stroke-width=\"4\"/>\n  <path d=\"M1017 315V303H1070V315\" fill=\"#a87556\"/>\n  <!-- counter -->\n  <rect x=\"580\" y=\"410\" width=\"590\" height=\"28\" rx=\"8\" fill=\"#f0d9b0\"/>\n  <rect x=\"600\" y